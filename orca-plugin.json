{
  "manifestVersion": 1,
  "id": "orca-wa-inbox",
  "publisher": "ab2web",
  "name": "WA Inbox",
  "version": "4.13.0",
  "description": "Orca Lab's official WhatsApp plugin, built by Ab2Web. Pair your line with a QR code, turn client conversations into tracked work, and decide per conversation how far your agent may act. Optional and off by default: with your own TypeSafe key, the text of messages is sent to api.typesafe.ai to help decide what needs your attention.",
  "engines": {
    "orca": ">=1.4.160"
  },
  "pluginApi": 1,
  "main": "main.mjs",
  "contributes": {
    "panels": [
      {
        "id": "wa-inbox-activity",
        "title": "WhatsApp",
        "icon": "icons/whatsapp.svg",
        "entry": "activity.html",
        "surface": "nav"
      },
      {
        "id": "wa-inbox-config",
        "title": "WhatsApp Inbox",
        "icon": "icons/whatsapp.svg",
        "entry": "config.html",
        "surface": "settings"
      }
    ],
    "commands": [
      {
        "id": "wa-inbox.sync",
        "title": "WhatsApp: Refresh conversations"
      },
      {
        "id": "wa-inbox.scope.list",
        "title": "WhatsApp: View scope"
      },
      {
        "id": "wa-inbox.scope.set",
        "title": "WhatsApp: Map conversation"
      },
      {
        "id": "wa-inbox.inbox",
        "title": "WhatsApp: Messages addressed to me"
      },
      {
        "id": "wa-inbox.settings",
        "title": "WhatsApp: Agent settings"
      },
      {
        "id": "wa-inbox.doctor",
        "title": "WhatsApp: Check requirements"
      }
    ],
    "events": [
      {
        "on": "agent.status.changed"
      }
    ],
    "automations": [
      {
        "id": "tick",
        "title": "WhatsApp: every minute (no agent)",
        "trigger": "* * * * *",
        "timezone": "America/Bogota",
        "command": "WA=\"$(cat .wa-bin 2>/dev/null)\"; [ -x \"$WA/wa-scope\" ] || exit 1; \"$WA/wa-scope\" tick --json",
        "workspace": "plugin-owned"
      },
      {
        "id": "triage",
        "title": "WhatsApp: triage",
        "provider": "claude",
        "trigger": "*/5 * * * *",
        "timezone": "America/Bogota",
        "precheck": "WA=\"$(cat .wa-bin 2>/dev/null)\"; [ -x \"$WA/wa-scope\" ] || exit 1; \"$WA/wa-scope\" pending --needs-agent --precheck",
        "prompt": "prompts/triage.md",
        "workspace": "plugin-owned"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "process:spawn"
    },
    {
      "kind": "workspace:read"
    },
    {
      "kind": "notifications:show"
    },
    {
      "kind": "storage"
    },
    {
      "kind": "settings:own"
    },
    {
      "kind": "events:subscribe"
    },
    {
      "kind": "secrets"
    },
    {
      "kind": "net:fetch",
      "hosts": [
        "api.typesafe.ai"
      ]
    }
  ]
}
