           t and t["title"].startswith("@duenio la clave es"), f"{t and t['title']}")
        ok("recortado", t and len(t["title"]) <= 81 and t["title"].endswith("…"),
           f"{t and len(t['title'])}")
        ok("y sin la credencial", t and "Hunter2xx" not in t["title"], f"{t and t['title']}")


print(f"\n{pruebas - len(fallos)}/{pruebas} en verde")
if fallos:
