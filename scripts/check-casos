        con.commit()
        con.close()
        ingiere(home)
        ok("juzgar el mismo mensaje otra vez no devuelve la excepcion",
           not json.loads(fila_de(home, cid)["excepciones"] or "[]"),
           f"{fila_de(home, cid)['excepciones']}")
        llegan(home, A, [msg(SOPORTE, "AJ2", "@duenio y la clave nueva es Qq8otrasecreta", 5,
                             mencion=True)])
        ingiere(home)
        ok("un mensaje NUEVO si la vuelve a levantar",
           "credential" in json.loads(fila_de(home, cid)["excepciones"] or "[]"),
           f"{fila_de(home, cid)['excepciones']}")
        corre(home, "tick", "--json")
        ok("y el caso vuelve al dueno aunque ya hubiera pasado por decision",
           fila_de(home, cid)["etapa"] == "decision", fila_de(home, cid)["etapa"])

