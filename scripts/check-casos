        os.environ.clear()
        os.environ.update(antes)


# ── 16. El piso fijo de excepciones (T19) ────────────────────────────────────────
# Sin la llave de Jev nada marcaba dinero, credenciales ni compromisos, y la aprobacion
# por regla dejaba salir una respuesta con un precio sin el dueno. El piso es codigo
# determinista: siempre corre, y Jev solo puede sumar.
def carga_reglas():
    sys.dont_write_bytecode = True
    sys.path.insert(0, str(WA_SCOPE.parent))
    import wa_reglas  # noqa: E402
    return wa_reglas


print("\nel piso fijo: el modulo")
reglas = carga_reglas()
ok("usa los nombres de excepcion de Jev",
   set(reglas.EXCEPCIONES_PISO) <= set(carga_jev().ORDEN_EXCEPCIONES)
   and set(reglas.EXCEPCIONES_PISO) == {"money", "credential", "commitment"})
for texto, direccion, esperado in (
        # dinero (T22.2): un monto o un precio en lo que SALE. Lo que pide el cliente no
        # es una excepcion: lo que se le contesta con un precio si.
        ("el precio es $1.400", "salida", ["money"]),
        ("son 250.000 COP", "salida", ["money"]),
        ("queda un saldo de 1,250.50", "salida", ["money"]),
        ("el plan cuesta 50 al mes", "salida", ["money"]),
        ("le hacemos un descuento del 10%", "salida", ["money"]),
        ("son 300 mil pesos", "salida", ["money"]),
        ("the fee is 30 USD", "salida", ["money"]),
        ("€ 40 per month", "salida", ["money"]),
        ("custa R$ 99", "salida", ["money"]),
