        ok("el hilo trae los mensajes y la respuesta enviada, en orden de llegada y no alfabetico",
           hilo and [x["stanza_id"] for x in hilo] == ["Z1", "A1", "Y1", "B1"], f"{hilo}")
        ok("la respuesta enviada va marcada como mia",
           hilo[2]["from_me"] is True and hilo[0]["from_me"] is False)
        ok("lo anterior a la ultima respuesta va marcado `respondido`; lo posterior, no",
           [x["respondido"] for x in hilo] == [True, True, False, False], f"{hilo}")
        ok("con la hora y el texto para leerlos", all(x.get("date") and "text" in x for x in hilo))
        ver = js(home, "caso", "ver", str(c["case_id"]))[0]
        ok("y `mensajes` sigue el mismo orden",
           [x["stanza_id"] for x in ver["mensajes"]] == ["Z1", "A1", "B1"],
           f"{ver['mensajes']}")

