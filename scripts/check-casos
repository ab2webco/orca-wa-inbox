# ── Los audios se transcriben al entrar, y los adjuntos se ven en el hilo ───────────────
# `wa-scope ingest` transcribe la nota de voz que llega con `bin/wa-transcribe` (aqui, uno
# falso que nunca toca un modelo) y guarda el texto por mensaje: el texto que juzga Jev, el
# piso fijo y el hilo del agente salen de ahi. Los adjuntos salen en el hilo con tipo,
# tamano y la ruta que da el almacen.
print("\nlos audios se transcriben al entrar")
TRANSCRIPTOR_FALSO = """#!/usr/bin/env python3
import json, os, sys, time
ruta = [a for a in sys.argv[1:] if not a.startswith("-")][0]
nombre = os.path.basename(ruta)
with open(os.environ["FAKE_LOG"], "a") as f:
    f.write(nombre + "\\n")
if nombre.startswith("lento"):
    time.sleep(30)
if nombre.startswith("falla"):
    print(json.dumps({"ok": False, "codigo": "sin_motor", "razon": "no engine"}))
    sys.exit(1)
if nombre.startswith("clave"):
    print(json.dumps({"ok": True, "texto": "la clave es Zx9secreta"}))
else:
    print(json.dumps({"ok": True, "texto": "revisa este caso: dijo " + nombre}))
"""


def prepara_transcriptor(home):
    """Un wa-transcribe falso y el registro de a que audios se lo pidieron."""
    ruta = pathlib.Path(home) / "wa-transcribe-falso"
    ruta.write_text(TRANSCRIPTOR_FALSO, encoding="utf-8")
    ruta.chmod(0o755)
    registro = pathlib.Path(home) / "llamadas.log"
    registro.write_text("", encoding="utf-8")
    return {"WA_INBOX_TRANSCRIBE_CLI": str(ruta), "FAKE_LOG": str(registro)}, registro


def archivo_media(home, nombre, contenido=b"OPUS-BYTES-0001"):
    ruta = pathlib.Path(home) / ".wa-inbox" / "media" / nombre
    ruta.parent.mkdir(parents=True, exist_ok=True)
    ruta.write_bytes(contenido)
    return str(ruta)


def audio(home, mid, nombre, minutos=3, **extra):
    return msg(PERSONA, mid, "", minutos, media="audio", ruta=archivo_media(home, nombre),
               bytes=15, **extra)


def llamadas(registro):
    return [x for x in registro.read_text(encoding="utf-8").splitlines() if x]


def hilo_de(home, stanza):
    c = caso_de_stanza(home, stanza)
    return next((x for x in (c or {}).get("hilo", []) if x["stanza_id"] == stanza), None)


def ingiere_con(home, env):
    p = subprocess.run([str(WA_SCOPE), "ingest", "--json"], capture_output=True, text=True,
                       env=dict(os.environ, HOME=str(home),
                                XDG_CONFIG_HOME=str(pathlib.Path(home) / ".config"),
                                APPDATA=str(pathlib.Path(home) / "AppData" / "Roaming"),
                                ORCA_CLI_COMMAND=SIN_ORCA, **env), timeout=120)
    if p.returncode != 0:
        raise AssertionError(f"ingest salio {p.returncode}: {p.stderr.strip()}")
    return json.loads(p.stdout)[0]


