                       "Listo, la contraseña es Hunter2xx", "--resumen", "Hecho",
                       "--actor", "trabajador")[0]
            ver = js(home, "caso", "ver", cid)[0]
            ok("una credencial en el resultado queda retenida para el dueno",
               ver["etapa"] == "listo" and not ver["aprobada"]
               and not any(x.startswith(f"caso-{cid}-") for x in sidecar.entregados)
               and (hecho.get("envio") or {}).get("estado") == "retenido",
               f"{ver['etapa']} {hecho.get('envio')}")
        finally:
            sidecar.cerrar()

    # La cuenta de Claude: primero sin elegir (manda el pin del espacio o la global); si esa
    # esta tomada por otro espacio o sin sesion, UNA vez con la autenticada de menos uso.
    print("\nT8: la cuenta de Claude del lanzamiento")
    CUENTAS = [cuenta_claude("acct-activa", 5, activa=True),
               cuenta_claude("acct-llena", 97),
               cuenta_claude("acct-sin-login", 1, estado="unauthenticated"),
               cuenta_claude("acct-codex", 0, proveedor="codex"),
               cuenta_claude("acct-b", 40),
               cuenta_claude("acct-c", 12)]
    with tempfile.TemporaryDirectory() as home, tempfile.TemporaryDirectory() as carpeta:
        linea_lista(home)
        acepta_proyectos(home, "alfa-demo")
        orca_despacho(carpeta, cuentas=CUENTAS, rechaza={"": f"runtime_error {EN_USO}"})
        cid = trabajo_firmado(home, "C1")
        p, r = tick_orca(home, carpeta)
        creadas = llamadas_orca(carpeta, "terminal create")
        ok("cuenta tomada por otro espacio: reintenta una vez con otra cuenta",
           len(creadas) == 2 and "--claude-account" not in creadas[0]
           and len(llamadas_orca(carpeta, "account list")) == 1, f"{creadas} {p.stderr[-300:]}")
        ok("la elegida es la Claude autenticada de menos uso bajo 95%, nunca la activa",
           len(creadas) == 2 and bandera(creadas[1], "--claude-account") == "acct-c"
           and bandera(creadas[1], "--agent") == "claude"
           and bandera(creadas[1], "--worktree") == f"id:{WT_ALFA['id']}", f"{creadas}")
        fila = (despachos(home, cid) or [{}])[-1]
        ok("y la fila guarda la cuenta usada (el id, nada mas) y sigue el lanzamiento",
           fila.get("cuenta_claude") == "acct-c" and fila.get("estado") == "activo"
           and len(lanzamientos(carpeta)) == 1 and r.get("despachados") == 1
           and js(home, "caso", "ver", cid)[0]["etapa"] == "trabajo", f"{fila} {r}")
    with tempfile.TemporaryDirectory() as home, tempfile.TemporaryDirectory() as carpeta:
        linea_lista(home)
        acepta_proyectos(home, "alfa-demo")
        orca_despacho(carpeta, cuentas=[cuenta_claude("acct-activa", 5, activa=True),
                                        cuenta_claude("acct-b", 40)],
                      rechaza={"": "Claude is not logged in. Please run /login"})
        cid = trabajo_firmado(home, "C2")
        tick_orca(home, carpeta)
        creadas = llamadas_orca(carpeta, "terminal create")
        ok("una cuenta sin sesion tambien prueba otra cuenta",
           [bandera(x, "--claude-account") for x in creadas] == [None, "acct-b"]
           and (despachos(home, cid) or [{}])[-1].get("cuenta_claude") == "acct-b",
           f"{creadas} {despachos(home, cid)}")
    with tempfile.TemporaryDirectory() as home, tempfile.TemporaryDirectory() as carpeta:
        linea_lista(home)
        acepta_proyectos(home, "alfa-demo")
        orca_despacho(carpeta, cuentas=CUENTAS[:4], rechaza={"": f"runtime_error {EN_USO}"})
        cid = trabajo_firmado(home, "C3")
        p, r = tick_orca(home, carpeta)
        ok("sin otra cuenta usable: bloqueado, ninguna cuenta de Claude disponible",
           js(home, "caso", "ver", cid)[0]["etapa"] == "bloqueado"
           and "ninguna cuenta de Claude disponible" in motivo_bloqueo(home, cid)
           and "in use by an assigned worktree" in motivo_bloqueo(home, cid)
           and len(llamadas_orca(carpeta, "terminal create")) == 1
           and r.get("bloqueados_por_despacho") == 1, f"{motivo_bloqueo(home, cid)} {r}")
    with tempfile.TemporaryDirectory() as home, tempfile.TemporaryDirectory() as carpeta:
        linea_lista(home)
        acepta_proyectos(home, "alfa-demo")
        orca_despacho(carpeta, cuentas=CUENTAS, rechaza={"": f"runtime_error {EN_USO}",
                                                         "acct-c": "quota exhausted"})
        cid = trabajo_firmado(home, "C4")
        tick_orca(home, carpeta)
        tick_orca(home, carpeta)
        ok("si la otra cuenta tambien falla: bloqueado con su texto, sin un tercer intento",
           js(home, "caso", "ver", cid)[0]["etapa"] == "bloqueado"
           and "quota exhausted" in motivo_bloqueo(home, cid)
           and len(llamadas_orca(carpeta, "terminal create")) == 2, motivo_bloqueo(home, cid))

    # La terminal abre pero el agente no queda listo, o no se le puede escribir: Bloqueado
    # con el motivo, y la terminal que abrio el despacho se cierra.
    with tempfile.TemporaryDirectory() as home, tempfile.TemporaryDirectory() as carpeta:
        linea_lista(home)
        acepta_proyectos(home, "alfa-demo")
        orca_despacho(carpeta, listo=False)
        cid = trabajo_firmado(home, "C5")
        p, r = tick_orca(home, carpeta)
        ok("sin composer listo: bloqueado, sin escribirle y cerrando su terminal",
           js(home, "caso", "ver", cid)[0]["etapa"] == "bloqueado"
           and "no quedó listo" in motivo_bloqueo(home, cid)
           and not llamadas_orca(carpeta, "terminal send")
           and cerradas(carpeta) == ["term_worker1"]
           and despachos(home, cid)[-1]["estado"] == "bloqueado", f"{motivo_bloqueo(home, cid)}")
    with tempfile.TemporaryDirectory() as home, tempfile.TemporaryDirectory() as carpeta:
        linea_lista(home)
        acepta_proyectos(home, "alfa-demo")
        orca_despacho(carpeta, falla={"terminal send": "terminal_not_writable"})
        cid = trabajo_firmado(home, "C6")
        tick_orca(home, carpeta)
        ok("si no se le puede escribir: bloqueado con el texto y su terminal cerrada",
           js(home, "caso", "ver", cid)[0]["etapa"] == "bloqueado"
           and "terminal_not_writable" in motivo_bloqueo(home, cid)
           and cerradas(carpeta) == ["term_worker1"], f"{motivo_bloqueo(home, cid)}")

    # La linea del brief se pierde: `composer-ready` llega mientras Claude todavia arranca,
    # Orca ve el Enter sin turno y el agente queda con el composer vacio. El despacho mira
    # `terminal state` despues de escribir: sin turno, espera `tui-idle` y la escribe de
    # nuevo (dos veces por tick a lo mas); un tick siguiente sigue intentando, y con los
    # reenvios agotados va a Bloqueado. Con un turno empezado no vuelve a escribir nunca.
    print("\nT8: la linea del brief que el agente no recibio")
    NO_RECIBIO = "el agente del proyecto no recibió el trabajo"

    def esperas(carpeta, para):
        return [x for x in llamadas_orca(carpeta, "terminal wait") if bandera(x, "--for") == para]

    with tempfile.TemporaryDirectory() as home, tempfile.TemporaryDirectory() as carpeta:
        linea_lista(home)
        acepta_proyectos(home, "alfa-demo")
        orca_despacho(carpeta, arranca_en=2)
        cid = trabajo_firmado(home, "L1")
        p, r = tick_orca(home, carpeta)
        fila = (despachos(home, cid) or [{}])[-1]
        envios_l1 = lanzamientos(carpeta)
        ok("la primera linea se pierde: la escribe otra vez y el turno empieza",
           p.returncode == 0 and len(envios_l1) == 2
           and len({bandera(x, "--text") for x in envios_l1}) == 1
           and fila.get("estado") == "activo" and r.get("despachados") == 1
           and js(home, "caso", "ver", cid)[0]["etapa"] == "trabajo",
           f"{envios_l1} {fila} {r} {p.stderr[-400:]}")
        orden = [" ".join(x[:2]) + (f" {bandera(x, '--for')}" if x[:2] == ["terminal", "wait"]
                                    else "") for x in llamadas_orca(carpeta)
                 if " ".join(x[:2]) in ("terminal wait", "terminal send", "terminal state")]
        entre = orden[2:orden.index("terminal send", 2)] if orden.count("terminal send") > 1 \
            else []
        ok("mira el estado, espera tui-idle y recien ahi reenvia",
           orden[:2] == ["terminal wait composer-ready", "terminal send"]
           and "terminal state" in entre and "terminal wait tui-idle" in entre, f"{orden}")
        ok("la fila anota el reenvio y que el turno empezo",
           fila.get("reenvios") == 1 and fila.get("turno_at"), f"{fila}")
        estados_antes = len(llamadas_orca(carpeta, "terminal state"))
        tick_orca(home, carpeta)
        tick_orca(home, carpeta)
        ok("con el turno visto, los ticks siguientes no reenvian ni vuelven a mirar",
           len(lanzamientos(carpeta)) == 2
           and len(llamadas_orca(carpeta, "terminal state")) == estados_antes
           and despachos(home, cid)[-1]["estado"] == "activo", f"{lanzamientos(carpeta)}")

    with tempfile.TemporaryDirectory() as home, tempfile.TemporaryDirectory() as carpeta:
        linea_lista(home)
        acepta_proyectos(home, "alfa-demo")
        orca_despacho(carpeta)
        cid = trabajo_firmado(home, "L2")
        tick_orca(home, carpeta)
        tick_orca(home, carpeta)
        fila = (despachos(home, cid) or [{}])[-1]
        ok("con el turno empezado a la primera: una sola linea, sin tui-idle ni reenvios",
           len(lanzamientos(carpeta)) == 1 and not esperas(carpeta, "tui-idle")
           and fila.get("reenvios") == 0 and fila.get("turno_at")
           and fila.get("estado") == "activo", f"{fila} {lanzamientos(carpeta)}")

    with tempfile.TemporaryDirectory() as home, tempfile.TemporaryDirectory() as carpeta:
        linea_lista(home)
        acepta_proyectos(home, "alfa-demo")
        orca_despacho(carpeta, arranca_en=None, idle=False)
        cid = trabajo_firmado(home, "L3")
        tick_orca(home, carpeta)
        tick_orca(home, carpeta)
        fila = (despachos(home, cid) or [{}])[-1]
        ok("sin tui-idle (el agente esta ocupado) no le escribe encima",
           len(lanzamientos(carpeta)) == 1 and esperas(carpeta, "tui-idle")
           and fila.get("reenvios") == 0 and fila.get("estado") == "activo", f"{fila}")

    with tempfile.TemporaryDirectory() as home, tempfile.TemporaryDirectory() as carpeta:
        linea_lista(home)
        acepta_proyectos(home, "alfa-demo")
        orca_despacho(carpeta, arranca_en=None)
        cid = trabajo_firmado(home, "L4")
        p, r = tick_orca(home, carpeta)
        fila = (despachos(home, cid) or [{}])[-1]
        ok("nunca empieza: dos reenvios en el tick, y el despacho sigue activo",
           p.returncode == 0 and len(lanzamientos(carpeta)) == 3 and fila.get("reenvios") == 2
           and fila.get("estado") == "activo" and not fila.get("turno_at"), f"{fila}")
        tick_orca(home, carpeta)
        tick_orca(home, carpeta)
        fila = (despachos(home, cid) or [{}])[-1]
        ok("los ticks siguientes reenvian uno por vuelta hasta el tope",
           len(lanzamientos(carpeta)) == 5 and fila.get("reenvios") == 4
           and fila.get("estado") == "activo", f"{fila}")
        p, r = tick_orca(home, carpeta)
        fila = (despachos(home, cid) or [{}])[-1]
        ok("agotados los reenvios: bloqueado con el motivo, su terminal cerrada",
           len(lanzamientos(carpeta)) == 5 and fila.get("estado") == "bloqueado"
           and js(home, "caso", "ver", cid)[0]["etapa"] == "bloqueado"
           and NO_RECIBIO in motivo_bloqueo(home, cid)
           and cerradas(carpeta) == ["term_worker1"]
           and r.get("bloqueados_por_despacho") == 1, f"{fila} {motivo_bloqueo(home, cid)}")

    # El despacho que ya quedo trabado en vivo (lanzado por la version de antes, sin mirar el
    # estado): el siguiente tick lo cura solo, sin que el dueno haga nada.
