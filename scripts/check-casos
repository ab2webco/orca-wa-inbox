    cid, _ = caso_en_decision(home, "RC1")
    con = db_de(home)
    con.execute("update caso set etapa='respondido' where case_id=?", (int(cid),))
    con.commit()
    con.close()
    # Un caso que ya paso por decision (el evento esta en su historia) y salio respondido.
    js(home, "caso", "mover", cid, "recibido", "--actor", "automatizacion")
