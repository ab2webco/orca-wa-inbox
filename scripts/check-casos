            env, registro = prepara_transcriptor(home)
            pon_llave(home)
            llegan(home, A, [audio(home, "V1", "uno.ogg")])
            listo_persona(home)
            ingiere_con(home, env)
            ok("el audio se transcribe una vez", llamadas(registro) == ["uno.ogg"],
               f"{llamadas(registro)}")
            ok("y Jev juzga el texto de la transcripcion",
               falso.textos() == ["revisa este caso: dijo uno.ogg"], f"{falso.textos()}")
            x = hilo_de(home, "V1")
            ok("el hilo muestra la transcripcion como el texto del mensaje, marcada",
               x and x["text"] == "revisa este caso: dijo uno.ogg" and x["transcripcion"] is True,
               f"{x}")
            con = db_de(home)
            con.execute("delete from caso_mensaje")
            con.commit()
            con.close()
            ingiere_con(home, env)
            ok("un reintento no vuelve a transcribir el mismo mensaje",
               llamadas(registro) == ["uno.ogg"], f"{llamadas(registro)}")

        falso.pedidos.clear()
        with tempfile.TemporaryDirectory() as home:
            env, registro = prepara_transcriptor(home)
            pon_llave(home)
            llegan(home, A, [audio(home, "R1", "clave.ogg")])
            listo_persona(home)
