# ── Acuse de recibo y saludo: el motor contesta solo lo que no necesita criterio ────────
# Un pedido nuevo dirigido al asistente, en un chat `responder`, recibe UN acuse al
# instante (tick, por wa-send, con id `caso-<id>-acuse`); un saludo dirigido recibe un
# saludo (`caso-<id>-saludo`) en vez de cerrarse en silencio. Lo que Jev o el piso fijo
# marcaron con riesgo, y la charla que no es para el asistente, no reciben nada.
print("\nacuse de recibo y saludo")
SIN_DIRIGIR = "120363000000000010@g.us"
CON_CLAVE = "120363000000000011@g.us"


def jev_y_borradores(cuerpo):
    """Jev de mentira que tambien revisa borradores: sin banderas."""
    if "message_to_evaluate" in cuerpo["state"]:
        return jev_segun_texto(cuerpo)
    if "aseguramos" in cuerpo["state"].get("reply_to_review", ""):
        return 200, respuestas(cuerpo["questions"], promises_a_date=0.9)
    if "escuchado" in cuerpo["state"].get("reply_to_review", ""):
        return 200, respuestas(cuerpo["questions"], states_status_not_verified=0.9)
    return 200, respuestas(cuerpo["questions"])


def entregas(sidecar, tipo):
    return [r for r in sidecar.entregados if r.endswith(f"-{tipo}")]


def cuerpo_de(home, req):
    return next((e["body"] for e in envios(home) if e["req_id"] == req), None)


