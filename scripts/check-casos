    # O4: el aviso de "termino", desde el tick, despues de la espera.
    with tempfile.TemporaryDirectory() as home:
        ahora_ms = int(time.time() * 1000)
        ws, con, enviados, falsa = prepara_orca(home, finished="on", finishedDelaySeconds="30")
        base = {"worktreeId": WT_ALFA, "agentType": "codex", "workingAt": ahora_ms - 600000}
