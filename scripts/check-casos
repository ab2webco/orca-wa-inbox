#!/usr/bin/env python3
"""El caso del tablero, ejercitado de verdad contra una base temporal
(odd/tasks/kanban-casos.md, T1).

Lo que se prueba aca no se ve leyendo el codigo: que una base con trabajo abierto de
antes no pierda nada al migrar, que una transicion prohibida no escriba ni una fila, y
que una aprobacion quede congelada a la propuesta que el dueno vio — triage
re-propone cada cinco minutos, y "nada corre sin tu clic" depende de eso.

Cada caso corre en su propio HOME temporal, como scripts/check-closing: la base vive en
~/.wa-inbox/scope.db y no hay variable para moverla.
"""
import argparse
import datetime
import hashlib
import importlib.machinery
import importlib.util
import inspect
import json
import os
import pathlib
import re
import shutil
import sqlite3
import subprocess
import sys
import tempfile
import time

RAIZ = pathlib.Path(__file__).resolve().parent.parent
WA_SCOPE = RAIZ / "bin" / "wa-scope"
CHAT = "120363000000000001@g.us"
OTRO = "120363000000000002@g.us"

fallos = []
pruebas = 0


def ok(nombre, condicion, detalle=""):
    global pruebas
    pruebas += 1
    if condicion:
        print(f"  ok    {nombre}")
        return True
    fallos.append(f"{nombre}{f' — {detalle}' if detalle else ''}")
    print(f"  FALLA {nombre}{f' — {detalle}' if detalle else ''}")
    return False


# Una CLI de Orca que no existe: ninguna prueba toca la de verdad (el tick la usa para
# limpiar espacios de trabajo). Las que necesitan una CLI ponen la suya en `extra`.
SIN_ORCA = "/nonexistent/orca-no-existe"


def firma_como_dueno(args):
    """`caso aprobar ... --actor dueno`: la firma del dueno, que el worker lanza con la llave
    del aprobador en el env de ESE proceso (approve-solo-dueno). Cualquier otro actor no la
    lleva, como en el plugin."""
    args = list(args)
    return args[:2] == ["caso", "aprobar"] and "--actor" in args \
        and args[args.index("--actor") + 1:args.index("--actor") + 2] == ["dueno"]


def corre(home, *args, extra=None):
    env = dict(os.environ, HOME=str(home),
               XDG_CONFIG_HOME=str(pathlib.Path(home) / ".config"),
               APPDATA=str(pathlib.Path(home) / "AppData" / "Roaming"),
               ORCA_CLI_COMMAND=os.environ.get("ORCA_CLI_COMMAND", SIN_ORCA))
    env.pop("WA_INBOX_APPROVER", None)
    if firma_como_dueno(args):
        env["WA_INBOX_APPROVER"] = llave_del_plugin(home) or ""
    env.update(extra or {})
    return subprocess.run([str(WA_SCOPE), *args, "--json"], capture_output=True,
                          text=True, env=env, timeout=120)


def llave_del_plugin(home):
    """La llave del aprobador como la deja el plugin al arrancar: el worker corre
    `aprobador.mjs` (approve-solo-dueno). Es la unica forma en que una prueba la consigue."""
    env = dict(os.environ, HOME=str(home))
    p = subprocess.run([shutil.which("node") or "node", str(RAIZ / "aprobador.mjs")],
                       capture_output=True, text=True, env=env, timeout=60)
    return json.loads(p.stdout or "{}").get("llave")


def js(home, *args):
    p = corre(home, *args)
    if p.returncode != 0:
        raise AssertionError(f"wa-scope {' '.join(args)} salio {p.returncode}: "
                             f"{p.stderr.strip() or p.stdout.strip()}")
    return json.loads(p.stdout or "[]")


def db_de(home):
    con = sqlite3.connect(pathlib.Path(home) / ".wa-inbox" / "scope.db")
    con.row_factory = sqlite3.Row
    return con


def cuenta(home, sql, *params):
    con = db_de(home)
    n = con.execute(sql, params).fetchone()[0]
    con.close()
    return n


# ── 1. La migracion: el trabajo abierto de antes pasa a ser casos ─────────────────
# Una base como la que ya tiene el usuario: sin tablas de casos y con `work` abierto.
# Dos mensajes sobre la misma tarjeta, uno sobre otra, uno sin tarjeta, y uno cerrado.
print("\nla migracion")
# Recientes: `wa-scope work` da por abandonado lo que lleva una semana sin moverse, y
# lo que se mide aca es que lo abierto SIGA abierto despues de migrar.
HACE = {f"h{n}": time.strftime("%Y-%m-%d %H:%M", time.localtime(time.time() - n * 3600))
        for n in (1, 2, 3, 4, 5)}
with tempfile.TemporaryDirectory() as home:
    (pathlib.Path(home) / ".wa-inbox").mkdir(parents=True)
    vieja = db_de(home)
    vieja.executescript("""
      create table work (
        stanza_id text primary key, chat_jid text, chat_name text, issue text,
        step text, next_step text, status text not null default 'open',
        opened_at text, updated_at text);
      insert into work values ('VIEJO1','%(c)s','Soporte Norte','SOP-1','tarjeta abierta',
        'seguir', 'open', '%(h5)s', '%(h5)s');
      insert into work values ('VIEJO2','%(c)s','Soporte Norte','SOP-1','tarjeta abierta',
        'seguir', 'open', '%(h4)s', '%(h4)s');
      insert into work values ('VIEJO3','%(c)s','Soporte Norte','SOP-2','tarjeta abierta',
        'seguir', 'open', '%(h3)s', '%(h3)s');
      insert into work values ('VIEJO4','%(c)s','Soporte Norte',null,'leido',
        'contestar', 'open', '%(h2)s', '%(h2)s');
      insert into work values ('HECHO1','%(c)s','Soporte Norte','SOP-3','listo',
        null, 'done', '2026-01-01 08:00', '2026-01-02 08:00');
      insert into work values ('RANCIO','%(c)s','Soporte Norte','SOP-4','tarjeta abierta',
        'seguir', 'open', '%(d8)s', '%(d8)s');
    """ % dict(HACE, c=CHAT, d8=time.strftime(
        "%Y-%m-%d %H:%M", time.localtime(time.time() - 8 * 86400))))
    vieja.commit()
    vieja.close()

    casos = js(home, "caso", "listar")
    por_issue = {c["plane_issue"]: c for c in casos}
    ok("cada trabajo abierto queda en un caso", sorted(por_issue, key=str) ==
       sorted(["SOP-1", "SOP-2", None], key=str), f"listo {casos}")
    ok("los backfill quedan en trabajo", all(c["etapa"] == "trabajo" for c in casos),
       f"etapas {[c['etapa'] for c in casos]}")
    ok("el trabajo terminado no se migra", "SOP-3" not in por_issue)
    # `wa-scope work` lo da por abandonado; migrado, dejaria un caso en trabajo para
    # siempre.
    ok("el trabajo abierto de mas de una semana no se migra",
       "SOP-4" not in por_issue
       and cuenta(home, "select count(*) from work where stanza_id='RANCIO' "
                        "and case_id is not null") == 0)
    ok("dos mensajes de la misma tarjeta son un solo caso",
       cuenta(home, "select count(*) from caso_mensaje where case_id=?",
              (por_issue.get("SOP-1") or {}).get("case_id")) == 2)
    ok("cada caso migrado tiene un evento backfill de la automatizacion",
       cuenta(home, "select count(*) from caso_evento where actor='automatizacion' "
                    "and detalle='backfill' and a='trabajo'") == 3)
    ok("work queda colgando de su caso",
       cuenta(home, "select count(*) from work where status='open' "
                    "and case_id is null and stanza_id <> 'RANCIO'") == 0)

    # Correrla de nuevo no duplica nada.
    js(home, "caso", "listar")
    ok("la migracion es idempotente",
       cuenta(home, "select count(*) from caso") == 3
       and cuenta(home, "select count(*) from caso_evento") == 3)

    # work y closing siguen funcionando sobre la base migrada.
    abiertos = js(home, "work")
    ok("wa-scope work sigue listando lo abierto",
       sorted(r["stanza_id"] for r in abiertos) ==
       ["VIEJO1", "VIEJO2", "VIEJO3", "VIEJO4"], f"listo {abiertos}")
    ok("y el rancio queda abandonado, sin caso",
       cuenta(home, "select count(*) from work where stanza_id='RANCIO' "
                    "and status='abandoned' and case_id is null") == 1)
    js(home, "agent", "Watson")
    js(home, "set", CHAT, "--provider", "plane", "--target", "SOP", "--mode", "responder")
    ok("wa-scope closing no avisa el backlog migrado", js(home, "closing") == [])
    js(home, "work", "--stanza", "NUEVO1", "--chat", CHAT, "--name", "Soporte Norte",
       "--issue", "SOP-9", "--step", "tarjeta abierta", "--next", "seguir")
    ok("wa-scope closing sigue avisando lo nuevo",
       [r["issue"] for r in js(home, "closing")] == ["SOP-9"])
    ok("el trabajo nuevo no se convierte en caso a escondidas",
       cuenta(home, "select count(*) from caso") == 3)

    detalle = js(home, "caso", "ver", str(por_issue["SOP-1"]["case_id"]))[0]
    ok("ver trae los mensajes y los eventos",
       sorted(m["stanza_id"] for m in detalle["mensajes"]) == ["VIEJO1", "VIEJO2"]
       and len(detalle["eventos"]) == 1, f"vio {detalle}")


# ── 2. Las etapas: solo las transiciones del plan, y ninguna sin evento ──────────
# La tabla se copia del plan y no se importa de wa-scope: comparar el codigo consigo
# mismo no prueba nada.
PERMITIDAS = {
    "recibido":    {"clasificado", "bloqueado", "cerrado"},
    "clasificado": {"decision", "bloqueado", "cerrado"},
    "decision":    {"trabajo", "respondido", "clasificado", "bloqueado", "cerrado"},
    "trabajo":     {"listo", "bloqueado", "cerrado"},
    "listo":       {"respondido", "trabajo", "decision", "bloqueado", "cerrado"},
    "respondido":  {"cerrado", "recibido"},
    "cerrado":     {"recibido"},
    "bloqueado":   {"recibido", "clasificado", "decision", "cerrado"},
}
print("\nlas etapas")
with tempfile.TemporaryDirectory() as home:
    nuevo = js(home, "caso", "crear", "--chat", CHAT, "--stanza", "S1",
               "--titulo", "Revisar el login", "--actor", "agente")[0]
    cid = str(nuevo["case_id"])
    ok("crear deja el caso en recibido con su mensaje",
       nuevo["etapa"] == "recibido" and nuevo["mensajes"] == 1
       and nuevo["titulo"] == "Revisar el login", f"creo {nuevo}")
    ev = js(home, "caso", "ver", cid)[0]["eventos"]
    ok("crear deja un evento sin etapa de origen y con su actor",
       len(ev) == 1 and ev[0]["de"] is None and ev[0]["a"] == "recibido"
       and ev[0]["actor"] == "agente", f"eventos {ev}")

    ok("una mutacion sin --actor se rechaza",
       corre(home, "caso", "crear", "--chat", CHAT).returncode != 0)
    ok("un actor fuera del vocabulario se rechaza",
       corre(home, "caso", "crear", "--chat", CHAT, "--actor", "cualquiera"
             ).returncode != 0)
    ok("un mensaje que ya es de un caso no abre otro",
       corre(home, "caso", "crear", "--chat", CHAT, "--stanza", "S1",
             "--actor", "agente").returncode != 0
       and cuenta(home, "select count(*) from caso") == 1)

    p = corre(home, "caso", "mover", cid, "trabajo", "--actor", "agente")
    ok("recibido -> trabajo se rechaza con un error claro",
       p.returncode != 0 and "recibido" in p.stderr and "trabajo" in p.stderr,
       f"salio {p.returncode}: {p.stderr.strip()}")
    ok("y no escribe nada",
       cuenta(home, "select count(*) from caso_evento") == 1
       and js(home, "caso", "ver", cid)[0]["etapa"] == "recibido")

    p = corre(home, "caso", "mover", cid, "cerrado", "--actor", "dueno")
    ok("cerrar sin motivo se rechaza", p.returncode != 0 and "--motivo" in p.stderr,
       p.stderr.strip())
    p = corre(home, "caso", "mover", cid, "bloqueado", "--actor", "automatizacion")
    ok("bloquear sin motivo se rechaza", p.returncode != 0)
    ok("y tampoco escribe", cuenta(home, "select count(*) from caso_evento") == 1)

    js(home, "caso", "mover", cid, "bloqueado", "--motivo", "envio rechazado",
       "--actor", "automatizacion")
    ultimo = js(home, "caso", "ver", cid)[0]["eventos"][-1]
    ok("el motivo queda en el detalle del evento",
       ultimo["de"] == "recibido" and ultimo["a"] == "bloqueado"
       and ultimo["detalle"] == "envio rechazado"
       and ultimo["actor"] == "automatizacion", f"evento {ultimo}")
    js(home, "caso", "mover", cid, "recibido", "--actor", "dueno")

    clasificado = js(home, "caso", "clasificar", cid, "--clase", "revision",
                     "--prioridad", "high", "--actor", "jev")[0]
    ok("clasificar pasa a clasificado y guarda clase y prioridad",
       clasificado["etapa"] == "clasificado" and clasificado["clase"] == "revision"
       and clasificado["prioridad"] == "high", f"quedo {clasificado}")
    ultimo = js(home, "caso", "ver", cid)[0]["eventos"][-1]
    ok("clasificar deja su evento", ultimo["de"] == "recibido"
       and ultimo["a"] == "clasificado" and ultimo["actor"] == "jev", f"evento {ultimo}")
    ok("una prioridad fuera del vocabulario se rechaza",
       corre(home, "caso", "clasificar", cid, "--clase", "revision", "--prioridad",
             "altisima", "--actor", "jev").returncode != 0)
    ok("un caso que no existe se rechaza",
       corre(home, "caso", "mover", "999", "cerrado", "--motivo", "x",
             "--actor", "dueno").returncode != 0)

    # Cada par (de, a) del plan, recorrido de verdad. La etapa se pone a mano en la base
    # para no depender de los otros comandos; el motivo va siempre, para que lo que se
    # mida sea la transicion y no la falta de motivo.
    # Con una propuesta aprobada en su version vigente: las transiciones que ejecutan
    # algo la exigen (seccion siguiente), y aca se mide la tabla, no la firma.
    malas = []
    for de in PERMITIDAS:
        for a in PERMITIDAS:
            if de == a:
                continue
            con = db_de(home)
            con.execute("update caso set etapa=?, propuesta=?, propuesta_version='v', "
                        "propuesta_aprobada='v' where case_id=?",
                        (de, '{"tipo":"trabajar","instrucciones":"x"}', int(cid)))
            con.commit()
            antes = con.execute("select count(*) from caso_evento").fetchone()[0]
            con.close()
            p = corre(home, "caso", "mover", cid, a, "--motivo", "prueba",
                      "--actor", "dueno")
            despues = cuenta(home, "select count(*) from caso_evento")
            esperada = a in PERMITIDAS[de]
            if (p.returncode == 0) != esperada or (despues - antes) != int(esperada):
                malas.append(f"{de}->{a}: salio {p.returncode}, "
                             f"{despues - antes} eventos")
    ok("todas las transiciones del plan, y solo esas", not malas, "; ".join(malas))

    # Lo que EJECUTA algo (lanzar el trabajo, dar por enviada una respuesta) no se
    # puede hacer con `mover` sin la firma del dueno en la version vigente: si no,
    # "nada corre sin tu clic" se salta con un comando.
    sin_firma = []
    for de, a in (("decision", "trabajo"), ("decision", "respondido"),
                  ("listo", "respondido"), ("listo", "trabajo")):
        for aprobada in (None, "vieja"):
            con = db_de(home)
            con.execute("update caso set etapa=?, propuesta=?, propuesta_version='v', "
                        "propuesta_aprobada=? where case_id=?",
                        (de, '{"tipo":"trabajar","instrucciones":"x"}', aprobada,
                         int(cid)))
            con.commit()
            antes = con.execute("select count(*) from caso_evento").fetchone()[0]
            con.close()
            p = corre(home, "caso", "mover", cid, a, "--actor", "automatizacion")
            if (p.returncode == 0
                    or cuenta(home, "select count(*) from caso_evento") != antes
                    or "aprob" not in p.stderr):
                sin_firma.append(f"{de}->{a} con firma {aprobada}: salio {p.returncode}"
                                 f" {p.stderr.strip()[:80]}")
    ok("mover a lo que ejecuta exige la version vigente aprobada, y sin ella no escribe",
       not sin_firma, "; ".join(sin_firma))

    # Un caso de OTRA linea no existe para esta (T9).
    con = db_de(home)
    con.execute("insert into caso (account, chat_jid, etapa, created_at, updated_at) "
                "values ('pn:573000000001', ?, 'recibido', '2026-01-01 00:00:00', "
                "'2026-01-01 00:00:00')", (CHAT,))
    ajeno = con.execute("select max(case_id) from caso").fetchone()[0]
    con.commit()
    con.close()
    ok("un caso de otra linea no se ve", corre(home, "caso", "ver", str(ajeno)
                                              ).returncode != 0)
    ok("ni se lista", ajeno not in [c["case_id"] for c in js(home, "caso", "listar")])
    ok("ni se mueve", corre(home, "caso", "mover", str(ajeno), "clasificado",
                            "--actor", "dueno").returncode != 0)



# ── 3. La propuesta y la aprobacion congelada ────────────────────────────────────
# Triage re-propone cada cinco minutos. Lo que el dueno aprueba es una VERSION, y una
# aprobacion de una version que ya no es la vigente no puede escribir nada.
def caso_clasificado(home, stanza="S1", chat=CHAT):
    cid = str(js(home, "caso", "crear", "--chat", chat, "--stanza", stanza,
                 "--actor", "agente")[0]["case_id"])
    js(home, "caso", "clasificar", cid, "--clase", "revision", "--prioridad", "high",
       "--actor", "agente")
    return cid


print("\nla propuesta")
with tempfile.TemporaryDirectory() as home:
    cid = caso_clasificado(home)
    p = js(home, "caso", "propuesta", cid, "--tipo", "responder", "--respuesta",
           "Ya lo revisamos, queda en curso.", "--actor", "agente")[0]
    v1 = p["propuesta_version"]
    ok("proponer mueve clasificado -> decision y devuelve la version",
       p["etapa"] == "decision" and bool(v1) and len(v1) == 64, f"quedo {p}")
    ok("la propuesta queda guardada, con su tipo y su texto",
       p["propuesta"] == {"tipo": "responder",
                          "respuesta": "Ya lo revisamos, queda en curso."},
       f"propuesta {p['propuesta']}")
    esperada = hashlib.sha256(json.dumps(
        p["propuesta"], sort_keys=True, separators=(",", ":"),
        ensure_ascii=False).encode()).hexdigest()
    ok("la version es el sha256 del JSON canonico (llaves ordenadas, sin espacios)",
       v1 == esperada, f"{v1} != {esperada}")
    ev = js(home, "caso", "ver", cid)[0]["eventos"][-1]
    ok("proponer deja su evento con el actor y la version",
       ev["de"] == "clasificado" and ev["a"] == "decision" and ev["actor"] == "agente"
       and v1 in ev["detalle"], f"evento {ev}")

    antes = cuenta(home, "select count(*) from caso_evento")
    otra = js(home, "caso", "propuesta", cid, "--tipo", "responder", "--respuesta",
              "Ya lo revisamos, queda en curso.", "--actor", "agente")[0]
    ok("proponer lo mismo da la misma version", otra["propuesta_version"] == v1)
    ok("y no escribe un evento por cada repaso de triage",
       cuenta(home, "select count(*) from caso_evento") == antes)
    # La misma letra puede llegar compuesta o descompuesta segun quien la tipeo (macOS
    # entrega NFD): es el mismo texto y tiene que ser la misma version.
    nfc = js(home, "caso", "propuesta", cid, "--tipo", "responder", "--respuesta",
             "Revisé el acceso.", "--actor", "agente")[0]
    nfd = js(home, "caso", "propuesta", cid, "--tipo", "responder", "--respuesta",
             "Revisé el acceso.", "--actor", "agente")[0]
    ok("el mismo texto en NFC y en NFD es la misma version",
       nfc["propuesta_version"] == nfd["propuesta_version"]
       and nfd["propuesta"]["respuesta"] == "Revisé el acceso.", f"quedo {nfd}")
    # Un byte que no es UTF-8 en argv llega como un sustituto suelto: no puede tumbar
    # el comando con un traceback a mitad de la corrida de triage.
    p = corre(home, "caso", "propuesta", cid, "--tipo", "responder", "--respuesta",
              "Hola \udcff", "--actor", "agente")
    ok("un byte invalido en la respuesta no revienta: se guarda reemplazado",
       p.returncode == 0 and "Traceback" not in p.stderr
       and json.loads(p.stdout)[0]["propuesta"]["respuesta"].startswith("Hola "),
       p.stderr.strip()[-200:])

    nueva = js(home, "caso", "propuesta", cid, "--tipo", "responder", "--respuesta",
               "Lo vemos manana.", "--actor", "agente")[0]
    ok("otro texto es otra version, y el caso sigue en decision",
       nueva["propuesta_version"] != v1 and nueva["etapa"] == "decision")
    ok("proponer sin tipo, o con un tipo desconocido, se rechaza",
       corre(home, "caso", "propuesta", cid, "--actor", "agente").returncode != 0
       and corre(home, "caso", "propuesta", cid, "--tipo", "volar", "--actor",
                 "agente").returncode != 0)
    ok("responder sin respuesta se rechaza",
       corre(home, "caso", "propuesta", cid, "--tipo", "responder", "--actor",
             "agente").returncode != 0)
    ok("trabajar sin instrucciones se rechaza",
       corre(home, "caso", "propuesta", cid, "--tipo", "trabajar", "--actor",
             "agente").returncode != 0)
    ok("proponer sin actor se rechaza",
       corre(home, "caso", "propuesta", cid, "--tipo", "descartar").returncode != 0)

    # Un caso sin clasificar no puede saltar a decision: la tabla de transiciones.
    crudo = str(js(home, "caso", "crear", "--chat", CHAT, "--stanza", "S9",
                   "--actor", "agente")[0]["case_id"])
    p = corre(home, "caso", "propuesta", crudo, "--tipo", "descartar", "--actor",
              "agente")
    ok("desde recibido no se propone", p.returncode != 0 and "recibido" in p.stderr,
       p.stderr.strip())

print("\nla aprobacion congelada")
with tempfile.TemporaryDirectory() as home:
    cid = caso_clasificado(home)
    v1 = js(home, "caso", "propuesta", cid, "--tipo", "trabajar", "--instrucciones",
            "Corregir el login", "--repo", "ejemplo/app", "--actor", "agente"
            )[0]["propuesta_version"]
    p = js(home, "caso", "ver", cid)[0]
    ok("el repo y las instrucciones van en la propuesta",
       p["propuesta"] == {"tipo": "trabajar", "instrucciones": "Corregir el login",
                          "repo": "ejemplo/app"}, f"propuesta {p['propuesta']}")
    ok("sin aprobar no figura aprobada", p["aprobada"] is False)

    # Triage re-propone mientras el dueno mira la tarjeta.
    v2 = js(home, "caso", "propuesta", cid, "--tipo", "trabajar", "--instrucciones",
            "Corregir el login y el registro", "--actor", "agente"
            )[0]["propuesta_version"]
    eventos = cuenta(home, "select count(*) from caso_evento")
    p = corre(home, "caso", "aprobar", cid, "--version", v1, "--actor", "dueno")
    ok("aprobar una version que ya no es la vigente sale distinto de cero",
       p.returncode != 0 and "version" in p.stderr, f"salio {p.returncode}: {p.stderr}")
    caso = js(home, "caso", "ver", cid)[0]
    ok("y no escribe nada: ni evento, ni etapa, ni marca",
       cuenta(home, "select count(*) from caso_evento") == eventos
       and caso["etapa"] == "decision" and caso["aprobada"] is False
       and caso["propuesta_version"] == v2, f"quedo {caso}")

    ok("aprobar sin --version se rechaza",
       corre(home, "caso", "aprobar", cid, "--actor", "dueno").returncode != 0)
    ok("aprobar solo lo puede firmar el dueno",
       corre(home, "caso", "aprobar", cid, "--version", v2, "--actor", "agente"
             ).returncode != 0)

    # approve-solo-dueno: `--actor dueno` es una bandera que cualquiera escribe. Firmar como
    # el dueno exige la llave del plugin, que el worker pasa solo al clic del tablero.
    eventos = cuenta(home, "select count(*) from caso_evento")
    for nombre, llave in (("sin la llave", ""), ("con una llave ajena", "f" * 64)):
        p = corre(home, "caso", "aprobar", cid, "--version", v2, "--actor", "dueno",
                  extra={"WA_INBOX_APPROVER": llave})
        try:
            dicho = json.loads(p.stderr.strip() or "{}").get("error")
        except ValueError:
            dicho = None
        ok(f"firmar como dueno {nombre} se niega con E_NOT_OWNER y una razon de una linea",
           p.returncode == 2 and dicho == "E_NOT_OWNER"
           and "board" in p.stderr and len(p.stderr.strip().splitlines()) == 1,
           f"salio {p.returncode}: {p.stderr.strip()}")
    caso = js(home, "caso", "ver", cid)[0]
    ok("y no escribe nada: ni evento ni firma", caso["aprobada"] is False
       and cuenta(home, "select count(*) from caso_evento") == eventos, f"quedo {caso}")

    p = js(home, "caso", "aprobar", cid, "--version", v2, "--actor", "dueno")[0]
    ok("aprobar la vigente de un trabajo pasa decision -> trabajo",
       p["etapa"] == "trabajo" and p["aprobada"] is True, f"quedo {p}")
    ev = js(home, "caso", "ver", cid)[0]["eventos"][-1]
    ok("el evento guarda la version aprobada y al dueno",
       ev["actor"] == "dueno" and ev["de"] == "decision" and ev["a"] == "trabajo"
       and v2 in ev["detalle"], f"evento {ev}")
    antes = cuenta(home, "select count(*) from caso_evento")
    again = js(home, "caso", "aprobar", cid, "--version", v2, "--actor", "dueno")[0]
    ok("aprobar dos veces lo mismo (doble clic) no escribe de nuevo",
       again["etapa"] == "trabajo"
       and cuenta(home, "select count(*) from caso_evento") == antes)
    p = corre(home, "caso", "propuesta", cid, "--tipo", "descartar", "--actor",
              "agente")
    ok("con el trabajo en marcha ya no se re-propone", p.returncode != 0
       and "trabajo" in p.stderr, p.stderr.strip())

with tempfile.TemporaryDirectory() as home:
    cid = caso_clasificado(home)
    v1 = js(home, "caso", "propuesta", cid, "--tipo", "responder", "--respuesta",
            "Listo, ya quedo.", "--actor", "agente")[0]["propuesta_version"]
    p = js(home, "caso", "aprobar", cid, "--version", v1, "--actor", "dueno")[0]
    ok("aprobar una respuesta solo deja la marca: enviar es del ejecutor",
       p["etapa"] == "decision" and p["aprobada"] is True
       and p["propuesta_aprobada"] == v1, f"quedo {p}")
    v2 = js(home, "caso", "propuesta", cid, "--tipo", "responder", "--respuesta",
            "Listo, ya quedo, gracias.", "--actor", "agente")[0]
    ok("re-proponer distinto limpia la marca: lo aprobado era otra cosa",
       v2["aprobada"] is False and v2["propuesta_aprobada"] is None, f"quedo {v2}")
    ok("y la version vieja ya no se puede aprobar",
       corre(home, "caso", "aprobar", cid, "--version", v1, "--actor", "dueno"
             ).returncode != 0)

    # Una firma vieja no sobrevive a la vuelta por clasificado: lo que vuelve a decision
    # es otra decision, aunque la propuesta haya quedado igual.
    v3 = v2["propuesta_version"]
    js(home, "caso", "aprobar", cid, "--version", v3, "--actor", "dueno")
    js(home, "caso", "mover", cid, "clasificado", "--actor", "agente")
    vuelta = js(home, "caso", "mover", cid, "decision", "--actor", "agente")[0]
    ok("aprobar, volver a clasificado y otra vez a decision deja el caso sin firma",
       vuelta["aprobada"] is False and vuelta["propuesta_aprobada"] is None,
       f"quedo {vuelta}")
    p = corre(home, "caso", "mover", cid, "respondido", "--actor", "automatizacion")
    ok("y con esa firma vieja ya no se da por respondido", p.returncode != 0)
    js(home, "caso", "aprobar", cid, "--version", v3, "--actor", "dueno")
    js(home, "caso", "mover", cid, "respondido", "--actor", "automatizacion")
    js(home, "caso", "mover", cid, "recibido", "--actor", "agente")
    reabierto = js(home, "caso", "ver", cid)[0]
    ok("reabrir un caso respondido tambien borra la firma",
       reabierto["propuesta_aprobada"] is None, f"quedo {reabierto}")

    # Un trabajo que llego a listo sin resultado del trabajador (movido a mano) conserva
    # la propuesta `trabajar`: firmarla ahi no es lanzar otro trabajo.
    con = db_de(home)
    con.execute("update caso set etapa='listo', propuesta=?, propuesta_version='vt', "
                "propuesta_aprobada=null where case_id=?",
                ('{"tipo":"trabajar","instrucciones":"x"}', int(cid)))
    con.commit()
    con.close()
    p = js(home, "caso", "aprobar", cid, "--version", "vt", "--actor", "dueno")[0]
    ok("aprobar en listo solo deja la marca, aunque la propuesta sea trabajar",
       p["etapa"] == "listo" and p["aprobada"] is True, f"quedo {p}")

    # Un caso que no esta esperando decision no se aprueba.
    crudo = str(js(home, "caso", "crear", "--chat", CHAT, "--stanza", "S7",
                   "--actor", "agente")[0]["case_id"])
    ok("aprobar un caso sin propuesta se rechaza",
       corre(home, "caso", "aprobar", crudo, "--version", v1, "--actor", "dueno"
             ).returncode != 0)


# Una base que ya creo `caso` con el primer commit del tablero, sin la marca de
# aprobacion: tiene que ganar la columna sin perder el caso que ya tenia.
print("\nla migracion de la marca de aprobacion")
with tempfile.TemporaryDirectory() as home:
    (pathlib.Path(home) / ".wa-inbox").mkdir(parents=True)
    vieja = db_de(home)
    vieja.executescript("""
      create table caso (
        case_id integer primary key autoincrement, account text not null default 'local',
        chat_jid text not null, etapa text not null default 'recibido', clase text,
        prioridad text, titulo text, resumen text, propuesta text,
        propuesta_version text, plane_issue text, created_at text not null,
        updated_at text not null);
      insert into caso (account, chat_jid, etapa, clase, prioridad, created_at, updated_at)
        values ('local', '%s', 'clasificado', 'revision', 'high',
                '2026-01-01 08:00:00', '2026-01-01 08:00:00');
    """ % CHAT)
    vieja.commit()
    vieja.close()
    p = js(home, "caso", "propuesta", "1", "--tipo", "descartar", "--actor", "agente")
    ok("la base con `caso` anterior gana la columna y sigue sirviendo",
       p[0]["etapa"] == "decision" and p[0]["aprobada"] is False, f"quedo {p}")
    ok("y gana tambien la ruta, todavia sin enrutar",
       p[0]["ruta"] is None and cuenta(home, "select count(*) from pragma_table_info"
                                             "('caso') where name='ruta'") == 1,
       f"quedo {p}")


# ── 4. El resultado del trabajador ───────────────────────────────────────────────
# El agente desplegado termina con `caso resultado`: su respuesta es una propuesta
# NUEVA, y la firma que lanzo el trabajo no puede servir para enviarla.
def caso_en_trabajo(home, stanza="S1", chat=CHAT):
    cid = caso_clasificado(home, stanza, chat)
    v = js(home, "caso", "propuesta", cid, "--tipo", "trabajar", "--instrucciones",
           "Corregir el login", "--actor", "agente")[0]["propuesta_version"]
    js(home, "caso", "aprobar", cid, "--version", v, "--actor", "dueno")
    return cid, v


print("\nel resultado del trabajador")
with tempfile.TemporaryDirectory() as home:
    cid, v_trabajo = caso_en_trabajo(home)
    r = js(home, "caso", "resultado", cid, "--respuesta", "Ya quedo el login.",
           "--resumen", "Se corrigio la validacion del formulario.",
           "--actor", "trabajador")[0]
    ok("resultado pasa trabajo -> listo",
       r["etapa"] == "listo", f"quedo {r}")
    ok("la respuesta es la propuesta nueva, de tipo responder",
       r["propuesta"] == {"tipo": "responder", "respuesta": "Ya quedo el login."},
       f"propuesta {r['propuesta']}")
    ok("con una version nueva", r["propuesta_version"] not in (None, v_trabajo)
       and len(r["propuesta_version"]) == 64, f"version {r['propuesta_version']}")
    ok("y sin la firma del trabajo: lo aprobado era otra cosa",
       r["aprobada"] is False and r["propuesta_aprobada"] is None, f"quedo {r}")
    ok("el resumen queda en el caso",
       r["resumen"] == "Se corrigio la validacion del formulario.")
    ev = js(home, "caso", "ver", cid)[0]["eventos"][-1]
    ok("resultado deja su evento del trabajador con la version",
       ev["de"] == "trabajo" and ev["a"] == "listo" and ev["actor"] == "trabajador"
       and r["propuesta_version"] in ev["detalle"], f"evento {ev}")

    eventos = cuenta(home, "select count(*) from caso_evento")
    p = corre(home, "caso", "aprobar", cid, "--version", v_trabajo, "--actor", "dueno")
    ok("la version del trabajo ya no se aprueba despues del resultado",
       p.returncode != 0 and "version" in p.stderr, p.stderr.strip())
    ok("y no escribe nada", cuenta(home, "select count(*) from caso_evento") == eventos
       and js(home, "caso", "ver", cid)[0]["aprobada"] is False)
    a = js(home, "caso", "aprobar", cid, "--version", r["propuesta_version"],
           "--actor", "dueno")[0]
    ok("la respuesta del resultado se aprueba con su version y queda en listo",
       a["etapa"] == "listo" and a["aprobada"] is True, f"quedo {a}")

    antes = cuenta(home, "select count(*) from caso_evento")
    otra = js(home, "caso", "resultado", cid, "--respuesta", "Ya quedo el login.",
              "--resumen", "Se corrigio la validacion del formulario.",
              "--actor", "trabajador")[0]
    ok("el mismo resultado dos veces (reintento del trabajador) no escribe",
       otra["etapa"] == "listo" and otra["aprobada"] is True
       and cuenta(home, "select count(*) from caso_evento") == antes)

    ok("resultado sin respuesta se rechaza",
       corre(home, "caso", "resultado", cid, "--resumen", "x", "--actor",
             "trabajador").returncode != 0)
    ok("resultado sin resumen se rechaza",
       corre(home, "caso", "resultado", cid, "--respuesta", "x", "--actor",
             "trabajador").returncode != 0)
    ok("resultado solo lo firma el trabajador",
       corre(home, "caso", "resultado", cid, "--respuesta", "x", "--resumen", "x",
             "--actor", "agente").returncode != 0)
    crudo = caso_clasificado(home, "S5")
    eventos = cuenta(home, "select count(*) from caso_evento")
    p = corre(home, "caso", "resultado", crudo, "--respuesta", "x", "--resumen", "x",
              "--actor", "trabajador")
    ok("un caso que no esta en trabajo no recibe resultado, y nada se escribe",
       p.returncode != 0 and "clasificado" in p.stderr
       and cuenta(home, "select count(*) from caso_evento") == eventos, p.stderr.strip())


# ── 4b. Editar la propuesta en listo (cli-huecos, C1) ────────────────────────────
# La respuesta que dejo el trabajador es una propuesta como cualquier otra: el dueno (o
# el agente) puede cambiarla. Cambiada es otra decision: vuelve a `decision` con su
# version nueva y sin la firma de la de antes, y eso deja su evento.
print("\neditar la propuesta en listo")
with tempfile.TemporaryDirectory() as home:
    cid, _ = caso_en_trabajo(home)
    r = js(home, "caso", "resultado", cid, "--respuesta", "Ya quedo el login.",
           "--resumen", "Se corrigio la validacion del formulario.",
           "--actor", "trabajador")[0]
    v_listo = r["propuesta_version"]
    js(home, "caso", "aprobar", cid, "--version", v_listo, "--actor", "dueno")
    antes = cuenta(home, "select count(*) from caso_evento")
    p = corre(home, "caso", "propuesta", cid, "--tipo", "responder", "--respuesta",
              "Ya quedo el login: pruebe de nuevo, por favor.", "--actor", "dueno")
    e = json.loads(p.stdout or "[{}]")[0] if p.returncode == 0 else {}
    ok("proponer sobre un caso en listo se acepta", p.returncode == 0, p.stderr.strip())
    ok("y lo devuelve a decision", e.get("etapa") == "decision", f"quedo {e}")
    ok("con la propuesta y la version nuevas",
       e.get("propuesta") == {"tipo": "responder",
                              "respuesta": "Ya quedo el login: pruebe de nuevo, por favor."}
       and e.get("propuesta_version") not in (None, v_listo), f"quedo {e}")
    ok("y sin la firma de la version de listo",
       e.get("aprobada") is False and e.get("propuesta_aprobada") is None, f"quedo {e}")
    ev = js(home, "caso", "ver", cid)[0]["eventos"][-1]
    ok("deja UN evento listo -> decision con el actor y la version nueva",
       cuenta(home, "select count(*) from caso_evento") == antes + 1
       and ev["de"] == "listo" and ev["a"] == "decision" and ev["actor"] == "dueno"
       and (e.get("propuesta_version") or "-") in ev["detalle"], f"evento {ev}")
    p = corre(home, "caso", "aprobar", cid, "--version", e.get("propuesta_version") or "-",
              "--actor", "dueno")
    a = json.loads(p.stdout or "[{}]")[0] if p.returncode == 0 else {}
    ok("la version editada se aprueba en decision",
       a.get("etapa") == "decision" and a.get("aprobada") is True, p.stderr.strip() or f"quedo {a}")

    # Repetir en listo la MISMA propuesta que ya tiene no es un cambio: ni mueve la
    # tarjeta ni le quita la firma (el agente repasa lo que ya dejo).
    cid2, _ = caso_en_trabajo(home, "S2")
    r2 = js(home, "caso", "resultado", cid2, "--respuesta", "Listo, ya funciona.",
            "--resumen", "Se reinicio el servicio.", "--actor", "trabajador")[0]
    js(home, "caso", "aprobar", cid2, "--version", r2["propuesta_version"],
       "--actor", "dueno")
    antes = cuenta(home, "select count(*) from caso_evento")
    igual = js(home, "caso", "propuesta", cid2, "--tipo", "responder", "--respuesta",
               "Listo, ya funciona.", "--actor", "agente")[0]
    ok("la misma propuesta en listo no mueve ni escribe nada",
       igual["etapa"] == "listo" and igual["aprobada"] is True
       and cuenta(home, "select count(*) from caso_evento") == antes, f"quedo {igual}")


# ── 4c. Reclasificar (cli-huecos, C2) ────────────────────────────────────────────
# Clasificar no es solo la primera vez: desde clasificado se corrige en el lugar, y desde
# decision vuelve a clasificado (la propuesta de antes ya no vale como firmada). Cada
# vez deja su evento con la clase y la prioridad nuevas.
print("\nreclasificar")
with tempfile.TemporaryDirectory() as home:
    cid = caso_clasificado(home)
    antes = cuenta(home, "select count(*) from caso_evento")
    r = js(home, "caso", "clasificar", cid, "--clase", "card", "--prioridad", "low",
           "--actor", "dueno")[0]
    ev = js(home, "caso", "ver", cid)[0]["eventos"][-1]
    ok("reclasificar en clasificado cambia la clase y la prioridad",
       r["etapa"] == "clasificado" and r["clase"] == "card" and r["prioridad"] == "low",
       f"quedo {r}")
    ok("y deja su evento clasificado -> clasificado con lo nuevo",
       cuenta(home, "select count(*) from caso_evento") == antes + 1
       and ev["de"] == "clasificado" and ev["a"] == "clasificado"
       and ev["actor"] == "dueno" and ev["detalle"] == "card · low", f"evento {ev}")

    v = js(home, "caso", "propuesta", cid, "--tipo", "responder", "--respuesta",
           "Ya lo revisamos.", "--actor", "agente")[0]["propuesta_version"]
    js(home, "caso", "aprobar", cid, "--version", v, "--actor", "dueno")
    antes = cuenta(home, "select count(*) from caso_evento")
    r = js(home, "caso", "clasificar", cid, "--clase", "alert", "--prioridad", "high",
           "--actor", "dueno")[0]
    ev = js(home, "caso", "ver", cid)[0]["eventos"][-1]
    ok("reclasificar en decision vuelve a clasificado sin la firma",
       r["etapa"] == "clasificado" and r["clase"] == "alert" and r["aprobada"] is False,
       f"quedo {r}")
    ok("y deja su evento decision -> clasificado",
       cuenta(home, "select count(*) from caso_evento") == antes + 1
       and ev["de"] == "decision" and ev["a"] == "clasificado"
       and ev["detalle"] == "alert · high", f"evento {ev}")


# ── 5. Listar y ver ──────────────────────────────────────────────────────────────
# El panel pide una columna (una etapa) o una conversacion: el filtro tiene que ser
# exacto, y los eventos de una tarjeta se leen de arriba abajo, el ultimo al final.
print("\nlistar y ver")
with tempfile.TemporaryDirectory() as home:
    uno = caso_clasificado(home, "L1")
    dos = str(js(home, "caso", "crear", "--chat", CHAT, "--stanza", "L2",
                 "--actor", "agente")[0]["case_id"])
    tres = str(js(home, "caso", "crear", "--chat", OTRO, "--stanza", "L3",
                  "--actor", "agente")[0]["case_id"])
    ids = lambda filas: sorted(str(c["case_id"]) for c in filas)  # noqa: E731
    ok("sin filtro lista los tres", ids(js(home, "caso", "listar")) ==
       sorted([uno, dos, tres]))
    ok("--etapa deja solo esa columna",
       ids(js(home, "caso", "listar", "--etapa", "recibido")) == sorted([dos, tres])
       and ids(js(home, "caso", "listar", "--etapa", "clasificado")) == [uno])
    ok("--chat deja solo esa conversacion",
       ids(js(home, "caso", "listar", "--chat", OTRO)) == [tres])
    ok("--etapa y --chat se combinan",
       ids(js(home, "caso", "listar", "--etapa", "recibido", "--chat", CHAT)) == [dos])
    ok("una etapa fuera del vocabulario se rechaza",
       corre(home, "caso", "listar", "--etapa", "inventada").returncode != 0)
    ok("listar viene de lo mas reciente a lo mas viejo",
       str(js(home, "caso", "listar")[0]["case_id"]) == tres)
    ev = js(home, "caso", "ver", uno)[0]["eventos"]
    ok("ver trae los eventos en orden, el ultimo al final",
       [e["a"] for e in ev] == ["recibido", "clasificado"], f"eventos {ev}")
    ok("ver de un caso que no existe se rechaza",
       corre(home, "caso", "ver", "999").returncode != 0)


# ── 6. Unir y separar ────────────────────────────────────────────────────────────
# La regla de agrupacion se equivoca a veces; el agente lo corrige a mano. Ningun
# mensaje se pierde ni queda en dos casos, y los dos casos cuentan lo que paso.
def mensajes_de(home, cid):
    return sorted(m["stanza_id"] for m in js(home, "caso", "ver", cid)[0]["mensajes"])


print("\nunir")
with tempfile.TemporaryDirectory() as home:
    destino = caso_clasificado(home, "U1")
    origen = str(js(home, "caso", "crear", "--chat", CHAT, "--stanza", "U2",
                    "--actor", "agente")[0]["case_id"])
    con = db_de(home)
    con.execute("insert into caso_mensaje (account, stanza_id, case_id, at) "
                "values ('local', 'U3', ?, '2026-01-01 00:00:00')", (int(origen),))
    con.commit()
    con.close()
    u = js(home, "caso", "unir", destino, origen, "--actor", "agente")[0]
    ok("unir pasa los mensajes del origen al destino",
       mensajes_de(home, destino) == ["U1", "U2", "U3"] and u["mensajes"] == 3,
       f"quedo {mensajes_de(home, destino)}")
    o = js(home, "caso", "ver", origen)[0]
    ok("el origen queda cerrado y vacio",
       o["etapa"] == "cerrado" and o["mensajes"] == [], f"quedo {o}")
    ok("con el motivo 'unido a <destino>'",
       o["eventos"][-1]["detalle"] == f"unido a {destino}"
       and o["eventos"][-1]["de"] == "recibido" and o["eventos"][-1]["a"] == "cerrado"
       and o["eventos"][-1]["actor"] == "agente", f"evento {o['eventos'][-1]}")
    d = js(home, "caso", "ver", destino)[0]["eventos"][-1]
    ok("el destino tambien deja su evento, sin cambiar de etapa",
       d["de"] == "clasificado" and d["a"] == "clasificado" and origen in d["detalle"]
       and d["actor"] == "agente", f"evento {d}")

    eventos = cuenta(home, "select count(*) from caso_evento")
    ok("unir un caso consigo mismo se rechaza",
       corre(home, "caso", "unir", destino, destino, "--actor", "agente"
             ).returncode != 0)
    ok("unir un origen ya cerrado se rechaza",
       corre(home, "caso", "unir", destino, origen, "--actor", "agente"
             ).returncode != 0)
    ajeno = str(js(home, "caso", "crear", "--chat", OTRO, "--stanza", "U9",
                   "--actor", "agente")[0]["case_id"])
    eventos += 1
    ok("unir casos de dos conversaciones distintas se rechaza",
       corre(home, "caso", "unir", destino, ajeno, "--actor", "agente"
             ).returncode != 0)
    ok("unir hacia un caso cerrado se rechaza",
       corre(home, "caso", "unir", origen, destino, "--actor", "agente"
             ).returncode != 0)
    ok("unir sin actor se rechaza",
       corre(home, "caso", "unir", destino, ajeno).returncode != 0)
    ok("ninguno de los rechazos escribe",
       cuenta(home, "select count(*) from caso_evento") == eventos
       and mensajes_de(home, destino) == ["U1", "U2", "U3"])

print("\nseparar")
with tempfile.TemporaryDirectory() as home:
    cid = caso_clasificado(home, "P1")
    con = db_de(home)
    for s in ("P2", "P3"):
        con.execute("insert into caso_mensaje (account, stanza_id, case_id, at) "
                    "values ('local', ?, ?, '2026-01-01 00:00:00')", (s, int(cid)))
    con.commit()
    con.close()
    nuevo = js(home, "caso", "separar", cid, "P2", "P3", "--actor", "agente")[0]
    nid = str(nuevo["case_id"])
    ok("separar abre un caso nuevo en recibido, en la misma conversacion",
       nid != cid and nuevo["etapa"] == "recibido" and nuevo["chat_jid"] == CHAT,
       f"creo {nuevo}")
    ok("con esos mensajes, que salen del original",
       mensajes_de(home, nid) == ["P2", "P3"] and mensajes_de(home, cid) == ["P1"])
    ev_nuevo = js(home, "caso", "ver", nid)[0]["eventos"]
    ev_orig = js(home, "caso", "ver", cid)[0]["eventos"][-1]
    ok("el caso nuevo nace con un evento que dice de donde salio",
       len(ev_nuevo) == 1 and ev_nuevo[0]["a"] == "recibido"
       and cid in ev_nuevo[0]["detalle"], f"eventos {ev_nuevo}")
    ok("el original deja su evento, sin cambiar de etapa",
       ev_orig["de"] == "clasificado" and ev_orig["a"] == "clasificado"
       and nid in ev_orig["detalle"], f"evento {ev_orig}")

    casos = cuenta(home, "select count(*) from caso")
    eventos = cuenta(home, "select count(*) from caso_evento")
    p = corre(home, "caso", "separar", cid, "P2", "--actor", "agente")
    ok("separar un mensaje que no es de ese caso se rechaza con un error claro",
       p.returncode != 0 and "P2" in p.stderr, p.stderr.strip())
    p = corre(home, "caso", "separar", cid, "P1", "NADA", "--actor", "agente")
    ok("si uno solo no es del caso, no se separa ninguno", p.returncode != 0
       and mensajes_de(home, cid) == ["P1"])
    ok("separar todos los mensajes dejaria un caso vacio: se rechaza",
       corre(home, "caso", "separar", cid, "P1", "--actor", "agente").returncode != 0)
    ok("ningun rechazo escribe",
       cuenta(home, "select count(*) from caso") == casos
       and cuenta(home, "select count(*) from caso_evento") == eventos)


# ── 7. La regla de agrupacion ────────────────────────────────────────────────────
# Un mensaje nuevo va al caso abierto de su conversacion si ese caso se movio en las
# ultimas N horas (default 12); si no, abre uno. Cinco mensajes del mismo pedido son UNA
# tarjeta, y el pedido de manana es otra.
def envejece(home, cid, horas):
    sello = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(time.time() - horas * 3600))
    con = db_de(home)
    con.execute("update caso set updated_at=? where case_id=?", (sello, int(cid)))
    con.commit()
    con.close()


def asigna(home, stanza, chat=CHAT):
    return js(home, "caso", "asignar", stanza, "--chat", chat, "--actor", "agente")[0]


print("\nla regla de agrupacion")
with tempfile.TemporaryDirectory() as home:
    ok("la ventana arranca en 12 horas",
       js(home, "config", "case_window_hours")[0]["value"] == "12")
    primero = asigna(home, "G1")
    cid = str(primero["case_id"])
    ok("el primer mensaje de una conversacion abre un caso en recibido",
       primero["etapa"] == "recibido" and primero["mensajes"] == 1, f"creo {primero}")
    envejece(home, cid, 11)
    segundo = asigna(home, "G2")
    ok("dentro de la ventana se suma al caso abierto",
       str(segundo["case_id"]) == cid and segundo["mensajes"] == 2, f"quedo {segundo}")
    ev = js(home, "caso", "ver", cid)[0]["eventos"][-1]
    ok("sumarse deja un evento sin mover la etapa",
       ev["de"] == "recibido" and ev["a"] == "recibido" and "G2" in ev["detalle"]
       and ev["actor"] == "agente", f"evento {ev}")

    antes = (cuenta(home, "select count(*) from caso"),
             cuenta(home, "select count(*) from caso_evento"))
    otra_vez = asigna(home, "G2")
    ok("asignar un mensaje ya asignado devuelve su caso y no escribe",
       str(otra_vez["case_id"]) == cid and antes ==
       (cuenta(home, "select count(*) from caso"),
        cuenta(home, "select count(*) from caso_evento")))

    otro_chat = asigna(home, "G3", OTRO)
    ok("otra conversacion abre su propio caso", str(otro_chat["case_id"]) != cid)

    envejece(home, cid, 13)
    fuera = asigna(home, "G4")
    ok("fuera de la ventana abre un caso nuevo",
       str(fuera["case_id"]) != cid and fuera["etapa"] == "recibido", f"quedo {fuera}")

    js(home, "config", "case_window_hours", "24")
    envejece(home, str(fuera["case_id"]), 30)
    envejece(home, cid, 13)
    ancha = asigna(home, "G5")
    ok("la ventana configurada manda: con 24 horas, 13 todavia agrupa",
       str(ancha["case_id"]) == cid, f"quedo {ancha}")

with tempfile.TemporaryDirectory() as home:
    cid = str(asigna(home, "R1")["case_id"])
    con = db_de(home)
    con.execute("update caso set etapa='respondido' where case_id=?", (int(cid),))
    con.commit()
    con.close()
    r = asigna(home, "R2")
    ok("sumarse a un caso respondido lo devuelve a recibido",
       str(r["case_id"]) == cid and r["etapa"] == "recibido", f"quedo {r}")
    ev = js(home, "caso", "ver", cid)[0]["eventos"][-1]
    ok("con su evento respondido -> recibido",
       ev["de"] == "respondido" and ev["a"] == "recibido" and "R2" in ev["detalle"],
       f"evento {ev}")

    con = db_de(home)
    con.execute("update caso set etapa='trabajo' where case_id=?", (int(cid),))
    con.commit()
    con.close()
    t = asigna(home, "R3")
    ok("sumarse a un caso en otra etapa no la cambia",
       str(t["case_id"]) == cid and t["etapa"] == "trabajo", f"quedo {t}")

    js(home, "caso", "mover", cid, "cerrado", "--motivo", "resuelto", "--actor", "dueno")
    c = asigna(home, "R4")
    ok("un caso cerrado, aunque sea reciente, no recibe mensajes",
       str(c["case_id"]) != cid, f"quedo {c}")

    # Un caso de OTRA linea, de la misma conversacion y recien movido, no existe aca.
    con = db_de(home)
    con.execute("insert into caso (account, chat_jid, etapa, created_at, updated_at) "
                "values ('pn:573000000001', ?, 'recibido', ?, ?)",
                (OTRO, time.strftime("%Y-%m-%d %H:%M:%S"),
                 time.strftime("%Y-%m-%d %H:%M:%S")))
    ajeno = con.execute("select max(case_id) from caso").fetchone()[0]
    con.commit()
    con.close()
    propio = asigna(home, "R5", OTRO)
    ok("la agrupacion no se suma a un caso de otra linea",
       propio["case_id"] != ajeno and propio["account"] == "local", f"quedo {propio}")
    ok("asignar sin --chat o sin actor se rechaza",
       corre(home, "caso", "asignar", "R6", "--actor", "agente").returncode != 0
       and corre(home, "caso", "asignar", "R6", "--chat", CHAT).returncode != 0)



# La carrera: triage re-propone MIENTRAS el clic del dueno esta en camino. La lectura de
# la version y la escritura de la firma tienen que ser una sola transaccion; si no, el
# clic lee la version vieja y firma encima de la nueva. Como proceso no se puede
# intercalar a voluntad, asi que se corre la funcion de wa-scope y triage escribe justo
# despues de que el clic leyo el caso.
def carga_wa_scope(home):
    os.environ.update(HOME=str(home), XDG_CONFIG_HOME=str(pathlib.Path(home) / ".config"),
                      APPDATA=str(pathlib.Path(home) / "AppData" / "Roaming"))
    sys.dont_write_bytecode = True
    sys.path.insert(0, str(WA_SCOPE.parent))
    cargador = importlib.machinery.SourceFileLoader("wa_scope_carrera", str(WA_SCOPE))
    spec = importlib.util.spec_from_loader("wa_scope_carrera", cargador)
    modulo = importlib.util.module_from_spec(spec)
    cargador.exec_module(modulo)
    return modulo


print("\nla historia del tablero: que paso, en codigos (T22)")
with tempfile.TemporaryDirectory() as home:
    ws = carga_wa_scope(home)
    v64 = "a" * 64
    for detalle, medios, esperado in (
            ("mensaje S9", {}, ("message", [])),
            ("mensaje S9", {"S9": "sticker"}, ("sticker", [])),
            ("mensaje S9", {"S9": "audio"}, ("audio", [])),
            ("jev: necesita agente", {}, ("jev", ["agent"])),
            ("jev: excepciones money, credential; necesita agente", {},
             ("jev", ["agent", "money", "credential"])),
            ("regla fija: la respuesta lleva money, commitment", {},
             ("rule", ["money", "commitment"])),
            ("regla fija: excepciones credential", {}, ("rule", ["credential"])),
            ("envio frenado: send-needs-approval caso-1-abc Held this reply to 'X' (rule: "
             "money; jev: states_status_not_verified): it was written and is waiting", {},
             ("held", ["money", "states_status_not_verified"])),
            ("Jev pidio revisar: states_status_not_verified · propuesta anterior, no enviada: "
             "responder " + v64, {}, ("revision", ["states_status_not_verified"])),
            ("La regla pidio revisar 3 veces (money): lo decide el dueno · abc", {},
             ("owner_decides", ["money"])),
            ("trabajo espera al dueno: delete, deploy · abc123", {},
             ("work_waits", ["delete", "deploy"])),
            ("responder " + v64, {}, ("proposal", ["responder"])),
            ("card · none · jev support_request", {}, ("classified", ["card"])),
            ("aprobada " + v64, {}, ("approved", [])),
            ("algo que nadie conoce", {}, (None, []))):
        salio = ws.que_del_evento(detalle, medios)
        ok(f"evento {detalle[:40]!r} -> {esperado[0]}", salio == esperado, f"salio {salio}")


print("\nla carrera entre aprobar y re-proponer")
with tempfile.TemporaryDirectory() as home:
    cid = caso_clasificado(home)
    v1 = js(home, "caso", "propuesta", cid, "--tipo", "trabajar", "--instrucciones",
            "Corregir el login", "--actor", "agente")[0]["propuesta_version"]
    entorno_antes = dict(os.environ)
    wa = carga_wa_scope(home)
    leer = wa.caso_de
    triage_escribio = []

    def caso_de_y_triage(con, case_id):
        caso = leer(con, case_id)
        if not triage_escribio:
            triage = sqlite3.connect(pathlib.Path(home) / ".wa-inbox" / "scope.db",
                                     timeout=0.2)
            try:
                triage.execute("update caso set propuesta=?, propuesta_version='v2', "
                               "propuesta_aprobada=null where case_id=?",
                               ('{"tipo":"trabajar","instrucciones":"Otra cosa"}',
                                int(cid)))
                triage.commit()
                triage_escribio.append(True)
            except sqlite3.OperationalError:
                triage_escribio.append(False)
            finally:
                triage.close()
        return caso

    wa.caso_de = caso_de_y_triage
    con = wa.db()
    try:
        wa.cmd_caso_aprobar(con, argparse.Namespace(id=int(cid), version=v1,
                                                    actor="dueno"))
    except SystemExit:
        pass
    con.close()
    os.environ.clear()
    os.environ.update(entorno_antes)
    caso = js(home, "caso", "ver", cid)[0]
    firmo_otra = (caso["propuesta_aprobada"] == v1 and caso["propuesta_version"] != v1)
    ok("el clic no firma una propuesta que cambio entre su lectura y su escritura",
       not firmo_otra and not (caso["etapa"] == "trabajo" and not caso["aprobada"]),
       f"triage escribio {triage_escribio}; quedo {caso['etapa']} "
       f"{caso['propuesta_version']} firmada {caso['propuesta_aprobada']}")
    ok("y triage no pudo escribir en medio: el clic tenia la base tomada",
       triage_escribio == [False], f"triage escribio {triage_escribio}")


# ── 8. El caso sigue al trabajo que cuelga de el ─────────────────────────────────
# `work --done`, el aviso de cierre y el abandono de una semana cierran `work`. Si el
# caso migrado no los sigue, queda en trabajo para siempre en el tablero.
print("\nel caso sigue al trabajo")
with tempfile.TemporaryDirectory() as home:
    (pathlib.Path(home) / ".wa-inbox").mkdir(parents=True)
    vieja = db_de(home)
    vieja.executescript("""
      create table work (
        stanza_id text primary key, chat_jid text, chat_name text, issue text,
        step text, next_step text, status text not null default 'open',
        opened_at text, updated_at text);
      insert into work values ('A1','%(c)s','Soporte Norte','SOP-1','abierta','x','open',
        '%(h3)s', '%(h3)s');
      insert into work values ('A2','%(c)s','Soporte Norte','SOP-1','abierta','x','open',
        '%(h2)s', '%(h2)s');
      insert into work values ('B1','%(c)s','Soporte Norte','SOP-2','abierta','x','open',
        '%(h2)s', '%(h2)s');
      insert into work values ('C1','%(c)s','Soporte Norte','SOP-3','abierta','x','open',
        '%(h1)s', '%(h1)s');
    """ % dict(HACE, c=CHAT))
    vieja.commit()
    vieja.close()
    por_issue = {c["plane_issue"]: str(c["case_id"]) for c in js(home, "caso", "listar")}
    etapa = lambda issue: js(home, "caso", "ver", por_issue[issue])[0]["etapa"]  # noqa: E731

    js(home, "work", "--done", "A1")
    ok("terminar uno de dos mensajes no cierra el caso", etapa("SOP-1") == "trabajo")
    js(home, "work", "--done", "A2")
    ultimo = js(home, "caso", "ver", por_issue["SOP-1"])[0]["eventos"][-1]
    ok("terminar el ultimo trabajo del caso lo cierra, con motivo y la automatizacion",
       etapa("SOP-1") == "cerrado" and ultimo["de"] == "trabajo"
       and ultimo["a"] == "cerrado" and ultimo["actor"] == "automatizacion"
       and ultimo["detalle"], f"evento {ultimo}")

    # El backlog migrado quedo como ya avisado (closing_baseline) y el aviso no lo
    # toca. Lo que si avisa es trabajo abierto despues, colgado de un caso.
    js(home, "agent", "Watson")
    js(home, "set", CHAT, "--provider", "plane", "--target", "SOP", "--mode", "responder")
    nuevo = str(js(home, "caso", "crear", "--chat", CHAT, "--stanza", "N1",
                   "--actor", "agente")[0]["case_id"])
    js(home, "work", "--stanza", "N1", "--chat", CHAT, "--name", "Soporte Norte",
       "--issue", "SOP-9", "--step", "tarjeta abierta", "--next", "seguir")
    con = db_de(home)
    con.execute("update work set case_id=? where stanza_id='N1'", (int(nuevo),))
    con.commit()
    con.close()
    js(home, "closing", "--result", "avisado", "--issue", "SOP-9", "--chat", CHAT)
    caso_n = js(home, "caso", "ver", nuevo)[0]
    ok("el aviso de cierre de la tarjeta cierra su caso",
       caso_n["etapa"] == "cerrado" and "SOP-9" in caso_n["eventos"][-1]["detalle"],
       f"quedo {caso_n}")

    con = db_de(home)
    con.execute("update work set updated_at=? where stanza_id='C1'", (time.strftime(
        "%Y-%m-%d %H:%M", time.localtime(time.time() - 8 * 86400)),))
    con.commit()
    con.close()
    js(home, "work")
    ok("el trabajo abandonado por una semana cierra su caso", etapa("SOP-3") == "cerrado")
    antes = cuenta(home, "select count(*) from caso_evento")
    js(home, "work")
    js(home, "work", "--done", "A2")
    ok("y nada de eso vuelve a escribir sobre un caso ya cerrado",
       cuenta(home, "select count(*) from caso_evento") == antes)


# ── 9. Las lineas: re-clave y otra linea activa ──────────────────────────────────
# El backfill crea los casos con la cuenta de `work`, que en una maquina de antes es
# `local`; la re-clave anotada por el sidecar pasa `work` a su numero en la misma
# apertura. Si los casos no la acompanan, desaparecen del tablero de esa linea.
VIEJA = "pn:573001112233"
NUEVA = "pn:573000000012"


def almacen(home, linea, reclave=None):
    """Lo minimo de capture.db que wa-scope lee: la linea activa y la re-clave."""
    con = sqlite3.connect(pathlib.Path(home) / ".wa-inbox" / "capture.db")
    con.executescript("create table if not exists store_meta (key text primary key, "
                      "value text); create table if not exists reclave (at text, "
                      "desde text, hacia text, chats integer, mensajes integer);")
    con.execute("insert or replace into store_meta values ('linea_activa', ?)", (linea,))
    if reclave:
        con.execute("insert into reclave values ('2026-01-01 00:00:00', 'local', ?, 1, 1)",
                    (reclave,))
    con.commit()
    con.close()


print("\nlas lineas")
with tempfile.TemporaryDirectory() as home:
    (pathlib.Path(home) / ".wa-inbox").mkdir(parents=True)
    vieja = db_de(home)
    vieja.executescript("""
      create table work (
        stanza_id text primary key, chat_jid text, chat_name text, issue text,
        step text, next_step text, status text not null default 'open',
        opened_at text, updated_at text);
      insert into work values ('K1','%(c)s','Soporte Norte','SOP-1','tarjeta abierta',
        'seguir', 'open', '%(h2)s', '%(h2)s');
      insert into work values ('K2','%(c)s','Soporte Norte','SOP-2','tarjeta abierta',
        'seguir', 'open', '%(h1)s', '%(h1)s');
    """ % dict(HACE, c=CHAT))
    vieja.commit()
    vieja.close()
    almacen(home, VIEJA, reclave=VIEJA)
    casos = js(home, "caso", "listar")
    ok("con la re-clave anotada, los casos del backfill pasan al numero con su trabajo",
       sorted(c["plane_issue"] for c in casos) == ["SOP-1", "SOP-2"]
       and all(c["account"] == VIEJA for c in casos), f"listo {casos}")
    ok("y sus mensajes tambien",
       cuenta(home, "select count(*) from caso_mensaje where account=?", VIEJA) == 2
       and cuenta(home, "select count(*) from caso_mensaje where account='local'") == 0)
    cid = str(casos[0]["case_id"])
    ok("el caso re-clavado se puede ver y mover desde su linea",
       js(home, "caso", "ver", cid)[0]["case_id"] == int(cid))

    # Otro numero vinculado: lo de la linea anterior queda guardado y no se ve.
    almacen(home, NUEVA)
    ok("otra linea activa no lista los casos de la anterior",
       js(home, "caso", "listar") == [])
    ok("ni los puede ver", corre(home, "caso", "ver", cid).returncode != 0)
    propio = asigna(home, "K9")
    ok("ni la agrupacion se suma a ellos: abre su propio caso",
       propio["account"] == NUEVA and str(propio["case_id"]) != cid
       and cuenta(home, "select count(*) from caso where account=?", VIEJA) == 2,
       f"quedo {propio}")
    ok("un mensaje de la otra linea se puede asignar tambien en esta",
       asigna(home, "K1")["account"] == NUEVA)



# ── 10. La entrada: `wa-scope ingest` ────────────────────────────────────────────
# Lo estructurado (agrupar, deduplicar, clasificar lo determinista, enrutar, aplicar lo
# que decidio el dueno) deja de ser trabajo del agente y corre en codigo apenas llega el
# mensaje (kanban-casos, T2). Se ejercita contra un capture.db armado por el escritor de
# verdad, el sidecar: el esquema es suyo y copiarlo a mano es como se desincroniza.
A = "pn:573000000001"
B = "pn:573000000002"
PN = {A: "573000000001:7@s.whatsapp.net", B: "573000000002:7@s.whatsapp.net"}
SOPORTE = "120363000000000001@g.us"
OPERACIONES = "120363000000000003@g.us"
FACTURACION = "120363000000000004@g.us"
PERSONA = "573000000002@s.whatsapp.net"
NODE = shutil.which("node")

ALMACEN_JS = """
import { abrirAlmacen, rutaAlmacen } from %r;
const d = JSON.parse(process.env.DATOS);
const a = abrirAlmacen(rutaAlmacen({ HOME: process.env.HOME }));
a.registrarLinea({ cuenta: d.cuenta, pn: d.pn, nombre: 'Prueba' });
for (const c of d.chats) {
  a.anotarChat({ cuenta: d.cuenta, chatJid: c.jid, nombre: c.nombre, esGrupo: c.grupo ? 1 : 0 });
}
for (const m of d.mensajes) {
  a.guardarMensaje({ cuenta: d.cuenta, chatJid: m.chat, stanzaId: m.id, ts: m.ts,
    fromMe: m.yo ? 1 : 0, senderJid: m.de || null, senderName: m.nombre || 'Ana',
    body: m.texto || '', mediaTipo: m.media || null, mediaBytes: m.bytes ?? null,
    mencionaMe: m.mencion ? 1 : 0, citaMe: m.cita ? 1 : 0 }, { mediaPath: m.ruta || null });
}
if (d.activar) a.activarLinea(d.cuenta);
a.latir(); a.cerrar();
""" % (RAIZ / "sidecar" / "src" / "almacen.js").as_uri()

AJENO = "120363000000000009@g.us"
CHATS = [{"jid": SOPORTE, "nombre": "Soporte Norte", "grupo": True},
         {"jid": AJENO, "nombre": "Sin autorizar", "grupo": True},
         {"jid": OPERACIONES, "nombre": "Operaciones", "grupo": True},
         {"jid": FACTURACION, "nombre": "Facturacion", "grupo": True},
         {"jid": PERSONA, "nombre": "Cliente Uno", "grupo": False}]


def msg(chat, mid, texto="", minutos=1, **extra):
    """Un mensaje que llego hace `minutos`. Por defecto es una linea suelta del chat."""
    return dict(chat=chat, id=mid, texto=texto, ts=int(time.time() - minutos * 60), **extra)


def llegan(home, cuenta, mensajes, activar=True):
    env = dict(os.environ, HOME=str(home), XDG_CONFIG_HOME=str(pathlib.Path(home) / ".config"),
               APPDATA=str(pathlib.Path(home) / "AppData" / "Roaming"),
               DATOS=json.dumps({"cuenta": cuenta, "pn": PN[cuenta], "chats": CHATS,
                                 "mensajes": mensajes, "activar": activar}))
    (pathlib.Path(home) / ".wa-inbox").mkdir(parents=True, exist_ok=True)
    subprocess.run([NODE, "--input-type=module", "-e", ALMACEN_JS], env=env, check=True,
                   capture_output=True, timeout=120)


def storage_de(home):
    man = json.loads((RAIZ / "orca-plugin.json").read_text(encoding="utf-8"))
    base = (pathlib.Path(home) / "Library" / "Application Support" / "orca"
            if sys.platform == "darwin" else pathlib.Path(home) / ".config" / "orca")
    return base / "plugins-data" / f"{man['publisher']}.{man['id']}" / "storage.json"


def decide(home, stanza, decision, cuenta):
    """Lo que el panel deja en storage cuando el dueno aprieta Tomar o Ignorar."""
    ruta = storage_de(home)
    datos = json.loads(ruta.read_text(encoding="utf-8")) if ruta.exists() else {}
    datos.setdefault("decisions", {})[stanza] = {
        "decision": decision, "at": "2026-10-01 09:00", "account": cuenta}
    ruta.parent.mkdir(parents=True, exist_ok=True)
    ruta.write_text(json.dumps(datos), encoding="utf-8")


def ingiere(home):
    return js(home, "ingest")[0]


def caso_de_stanza(home, stanza):
    fila = db_de(home).execute(
        "select case_id from caso_mensaje where stanza_id=?", (stanza,)).fetchone()
    return js(home, "caso", "ver", str(fila["case_id"]))[0] if fila else None


def evento(caso, a):
    """El evento con que el caso llego a la etapa `a`: el ultimo no es una llave estable,
    porque la ruta tambien deja el suyo."""
    return next(e for e in caso["eventos"] if e["a"] == a and e["de"] != a)


def autoriza(home):
    js(home, "set", SOPORTE, "--provider", "plane", "--target", "SOP", "--mode", "borrador")
    js(home, "set", OPERACIONES, "--provider", "plane", "--target", "OPS", "--mode", "observar")
    js(home, "set", PERSONA, "--provider", "ninguno", "--mode", "observar")
    js(home, "set", FACTURACION, "--provider", "plane", "--target", "FAC", "--mode", "observar")


print("\nla entrada")
if not NODE:
    print("  aviso: sin node, no se armo el almacen de mensajes", file=sys.stderr)
else:
    with tempfile.TemporaryDirectory() as home:
        llegan(home, A, [msg(SOPORTE, "E0", "@duenio revisa el login", 50, mencion=True)])
