                (json.dumps(["credential", "commitment"]), int(cid)))
    con.commit()
    con.close()
    ok("la credencial no despierta al agente", int(cid) not in para_el_agente(home),
       f"{para_el_agente(home)}")
    corre(home, "tick", "--json")
