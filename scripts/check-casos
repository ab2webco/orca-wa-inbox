        r = orca_aviso(ws, con, "tab-1:p1", at + 20000, state="waiting")
        ok("blocked -> waiting en la misma ventana no avisa otra vez",
           r.get("reason") == "duplicate" and len(enviados) == 1, f"{r} {len(enviados)}")
        orca_aviso(ws, con, "tab-2:p2", at, state="waiting")
        r = orca_aviso(ws, con, "tab-2:p2", at + 20000, state="blocked")
        ok("waiting -> blocked en la misma ventana tampoco",
           r.get("reason") == "duplicate" and len(enviados) == 2, f"{r} {len(enviados)}")
        orca_aviso(ws, con, "tab-1:p1", at + 6 * 60 * 1000, state="blocked")
        ok("blocked: pasada la ventana, si", len(enviados) == 3, f"{len(enviados)}")
        pon_orca(home, waiting="off")
        r = orca_aviso(ws, con, "tab-3:p3", at, state="blocked")
        ok("blocked: va por el interruptor de la espera; apagado, nada",
           r.get("reason") == "off" and len(enviados) == 3, f"{r}")
        con.close()
    for idioma, frase in (("en", "is blocked"), ("pt", "esta bloqueado")):
        with tempfile.TemporaryDirectory() as home:
