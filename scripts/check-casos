               len(envios_t) == 1 and "term_worker1" in envios_t[0]
               and respuesta_cliente in " ".join(envios_t[0]) and "--enter" in envios_t[0],
               f"{envios_t} {p.stderr[-300:]}")
            ok("sin otro agente: el mismo despacho sigue activo",
               len(llamadas_orca(carpeta, "terminal create")) == 1
               and despachos(home, cid)[-1]["estado"] == "activo"
               and js(home, "caso", "ver", cid)[0]["etapa"] == "trabajo",
               f"{despachos(home, cid)}")
            tick_orca(home, carpeta)
            ok("y no se entrega dos veces", len(respuestas_a_terminal(carpeta)) == 1)
            hecho = js(home, "caso", "resultado", cid, "--respuesta",
                       "Ya quedó; ¿puedes verificar el reporte?", "--resumen",
                       "Corregido el reporte del 30", "--actor", "trabajador")[0]
            tick_orca(home, carpeta)
            ok("y despues resuelve: la respuesta sale y el trabajador se suelta",
               js(home, "caso", "ver", cid)[0]["etapa"] == "respondido"
               and f"caso-{cid}-{hecho['propuesta_version'][:12]}" in sidecar.entregados
               and despachos(home, cid)[-1]["estado"] == "reportado"
               and cerradas(carpeta) == ["term_worker1"],
               f"{despachos(home, cid)}")
        finally:
            sidecar.cerrar()

    # Si su terminal ya no esta, la respuesta abre otro despacho con el hilo entero y lo que
    # el agente anterior reporto.
    with tempfile.TemporaryDirectory() as home, tempfile.TemporaryDirectory() as carpeta:
        linea_lista(home)
        acepta_proyectos(home, "alfa-demo")
        orca_despacho(carpeta)
        sidecar = SidecarFalso(home)
        try:
            cid = trabajo_firmado(home, "D16")
            tick_orca(home, carpeta)
            js(home, "caso", "resultado", cid, "--estado", "necesita", "--respuesta",
               "¿Cuál reporte es el que falla?", "--resumen", "Falta la fecha del reporte",
               "--actor", "trabajador")
            tick_orca(home, carpeta)
            cambia_orca(carpeta, vivos=[])
            llegan(home, A, [msg(PERSONA, "D16b", "Del 30 de septiembre", 0)])
            p, r = tick_orca(home, carpeta)
            arranques = llamadas_orca(carpeta, "terminal create")
