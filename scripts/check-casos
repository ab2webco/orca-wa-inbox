           and estado_orca(carpeta)["aceptadas"] == 1
           and despachos(home, cid)[-1]["estado"] == "activo", f"{envios_crudos(carpeta)}")

    with tempfile.TemporaryDirectory() as home, tempfile.TemporaryDirectory() as carpeta:
