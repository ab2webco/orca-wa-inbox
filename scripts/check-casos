                          cuenta(home, "select count(*) from caso"))
        r2 = ingiere(home)
        ok("correrlo otra vez no cambia nada y no escribe eventos",
           r2["nuevos"] == 0 and r2["casos_creados"] == 0 and r2["casos"] == []
           and cuenta(home, "select count(*) from caso_evento") == eventos
           and cuenta(home, "select count(*) from caso") == casos, f"salio {r2}")

        # Una cita al dueno (respuesta) y un directo: tambien son suyos.
        llegan(home, A, [msg(SOPORTE, "M2", "sigue fallando", 45, cita=True),
