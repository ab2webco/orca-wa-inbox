            ok("y la clave no sale del equipo",
               not any("Zx9secreta" in t for t in falso.textos()), f"{falso.textos()}")
            ok("ni queda en un evento",
               cuenta(home, "select count(*) from caso_evento where detalle like '%Zx9secreta%'")
               == 0)
    finally:
        falso.cerrar()
        os.environ.clear()
        os.environ.update(antes)

    # Sin Jev: lo que falla, o se apaga, queda dicho y el caso no se adivina.
    with tempfile.TemporaryDirectory() as home:
        env, registro = prepara_transcriptor(home)
        llegan(home, A, [audio(home, "F1", "falla1.ogg")])
        listo_persona(home)
        ingiere_con(home, env)
        x = hilo_de(home, "F1")
        ok("si no se pudo, el hilo lo dice con el codigo",
           x and x["text"] == "audio sin transcribir: sin_motor"
           and x["transcripcion"] is False, f"{x}")
        c = caso_de_stanza(home, "F1")
        ok("y el caso queda como dudoso, sin adivinar",
           c["clase"] == "doubtful" and "audio sin transcribir: sin_motor"
           in evento(c, "clasificado")["detalle"], f"{c}")

    with tempfile.TemporaryDirectory() as home:
        env, registro = prepara_transcriptor(home)
        js(home, "config", "transcribe", "off")
        llegan(home, A, [audio(home, "O1", "uno.ogg")])
        listo_persona(home)
        ingiere_con(home, env)
        x = hilo_de(home, "O1")
        ok("con transcribe off no se llama al transcriptor y se marca",
           llamadas(registro) == [] and x and x["text"] == "audio sin transcribir: off",
           f"{llamadas(registro)} {x}")

    with tempfile.TemporaryDirectory() as home:
        env, registro = prepara_transcriptor(home)
        llegan(home, A, [audio(home, "L1", "lento1.ogg")])
        listo_persona(home)
        ingiere_con(home, dict(env, WA_INBOX_TRANSCRIBE_TIMEOUT_S="1"))
        x = hilo_de(home, "L1")
