# ── Un caso reabierto muestra lo nuevo, no lo de la primera vez ─────────────────────
# Visto en vivo: un caso de las 17:19, respondido y reabierto a las 20:24 por otra
# pregunta, seguia con el titulo y el resumen de la primera: lo que esperaba era
# invisible. El titulo y el resumen pasan al mensaje nuevo; el titulo viejo queda en
# el evento. Una credencial no se copia: el titulo sale enmascarado y sin resumen.
print("\nun caso reabierto muestra el mensaje nuevo")
if NODE:
    falso = JevFalso(jev_segun_texto)
    antes = dict(os.environ)
    os.environ["WA_INBOX_JEV_ENDPOINT"] = falso.url
    try:
        with tempfile.TemporaryDirectory() as home:
            pon_llave(home)
            cid = caso_respondido(home, "T1")
            con = db_de(home)
            con.execute("update caso set titulo='Pedido de ayer', resumen='Lo de ayer' "
                        "where case_id=?", (cid,))
            con.commit()
            con.close()
            llegan(home, A, [msg(SOPORTE, "T2", "@duenio no funciono lo de ayer", 5,
                                 mencion=True)])
            ingiere(home)
            fila = fila_de(home, cid)
            ok("al reabrir, el titulo y el resumen son los del mensaje nuevo",
               fila["etapa"] == "clasificado"
               and fila["titulo"] == "@duenio no funciono lo de ayer"
               and fila["resumen"] == "@duenio no funciono lo de ayer", f"{fila}")
            ver = js(home, "caso", "ver", str(cid))[0]
            ok("el titulo de antes queda en la historia",
               any("Pedido de ayer" in e["detalle"] for e in ver["eventos"]),
               f"{ver['eventos']}")
            ok("la tarjeta del tablero lo muestra",
               tarjeta(home, cid)["title"] == "@duenio no funciono lo de ayer",
               f"{tarjeta(home, cid)}")

        with tempfile.TemporaryDirectory() as home:
            pon_llave(home)
            cid = caso_respondido(home, "T3")
            llegan(home, A, [msg(SOPORTE, "T4", "@duenio no funciono, la clave del panel es Hunter2xx",
                                 5, mencion=True)])
            ingiere(home)
            fila = fila_de(home, cid)
            ok("con una credencial el titulo sale enmascarado y no hay resumen",
               "Hunter2xx" not in json.dumps(fila) and fila["titulo"] and fila["resumen"] is None,
               f"{fila}")
            ok("y la tarjeta tampoco la lleva", "Hunter2xx" not in json.dumps(tarjeta(home, cid)))
    finally:
        falso.cerrar()
        os.environ.clear()
        os.environ.update(antes)

    with tempfile.TemporaryDirectory() as home:
        cid = caso_respondido(home, "T5")
        antes_t = fila_de(home, cid)["titulo"]
        js(home, "caso", "mover", str(cid), "recibido", "--actor", "dueno")
        ok("reabrir a mano no inventa un titulo", fila_de(home, cid)["titulo"] == antes_t)

# ── Lo que lee el agente: el hilo del caso, en orden de llegada y con lo ya contestado ──
# `caso ver` trae `hilo`: los mensajes del caso y las respuestas que se enviaron (from_me)
# intercaladas, por la hora del mensaje y no por el momento en que se agrupo; los empates los
# decide el orden de captura. Todo mensaje de antes de la ultima respuesta lleva
# `respondido`: es contexto, no algo por atender de nuevo.
print("\nel hilo del caso, en orden de llegada")
if NODE:
    with tempfile.TemporaryDirectory() as home:
        llegan(home, A, [msg(PERSONA, "Z1", "primero de todos", 12), msg(PERSONA, "A1", "segundo, mismo segundo", 12),
                         msg(PERSONA, "Y1", "mi respuesta de entonces", 10, yo=True),
                         msg(PERSONA, "B1", "despues de la respuesta", 4)])
        listo_persona(home)
        ingiere(home)
        c = caso_de_stanza(home, "Z1")
        ok("los de antes y los de despues de la respuesta caen en el mismo caso",
           c is not None and caso_de_stanza(home, "B1")["case_id"] == c["case_id"]
           and caso_de_stanza(home, "A1")["case_id"] == c["case_id"], f"{c}")
        hilo = js(home, "caso", "ver", str(c["case_id"]))[0].get("hilo")
        ok("el hilo trae los mensajes y la respuesta enviada, en orden de llegada y no alfabetico",
           hilo and [x["stanza_id"] for x in hilo] == ["Z1", "A1", "Y1", "B1"], f"{hilo}")
        ok("la respuesta enviada va marcada como mia",
           hilo[2]["from_me"] is True and hilo[0]["from_me"] is False)
        ok("lo anterior a la ultima respuesta va marcado `respondido`; lo posterior, no",
           [x["respondido"] for x in hilo] == [True, True, False, False], f"{hilo}")
        ok("con la hora y el texto para leerlos", all(x.get("date") and "text" in x for x in hilo))
        ver = js(home, "caso", "ver", str(c["case_id"]))[0]
        ok("y `mensajes` sigue el mismo orden",
           [x["stanza_id"] for x in ver["mensajes"]] == ["Z1", "A1", "B1"],
           f"{ver['mensajes']}")

    with tempfile.TemporaryDirectory() as home:
        cid = str(js(home, "caso", "crear", "--chat", PERSONA, "--stanza", "S1",
                     "--actor", "automatizacion")[0]["case_id"])
        ver = js(home, "caso", "ver", cid)[0]
        ok("sin el almacen de mensajes `caso ver` sigue funcionando, sin hilo",
           ver["mensajes"][0]["stanza_id"] == "S1" and not ver.get("hilo"), f"{ver}")

