# ── 17. El tick: la automatizacion solo-comando (T7) ─────────────────────────────
# `wa-scope tick` corre cada minuto sin modelo: ingest de respaldo, aprobacion por regla
# de las respuestas limpias en chats `responder`, envio por `wa-send --send` (Jev y el
# piso fijo siguen mandando) con un id por caso y version, y el tablero al dia. Aca el
# sidecar es de mentira: late en store_meta y da por enviado lo pendiente, como
# `atenderSalida`. El envio de verdad lo prueba test/envio.test.mjs.
class SidecarFalso:
    """Late y entrega: lo `pendiente` pasa a `enviado` una vez, como `tomarEnvio`."""

    def __init__(self, home, demora=0.0, late=True):
        self.ruta = pathlib.Path(home) / ".wa-inbox" / "capture.db"
        self.entregados = []
        self.demora = demora
        self.late = late
        self.parar = threading.Event()
        self.hilo = threading.Thread(target=self._vuelta, daemon=True)
        self.hilo.start()

    def _vuelta(self):
        con = sqlite3.connect(self.ruta, timeout=10)
        while not self.parar.is_set():
            ahora = int(time.time())
            if self.late:
                con.execute("insert into store_meta (key, value) values ('sidecar_beat', ?) "
                            "on conflict(key) do update set value=excluded.value",
                            (str(ahora),))
                con.commit()
            filas = [r[0] for r in con.execute(
                "select req_id from envio where estado='pendiente'")]
            for req in filas:
                if self.demora:
                    time.sleep(self.demora)
                cur = con.execute("update envio set estado='enviado', stanza_id=?, "
                                  "settled_at=? where req_id=? and estado='pendiente'",
                                  (f"STANZA-{req}", ahora, req))
                con.commit()
                if cur.rowcount == 1:
                    self.entregados.append(req)
            time.sleep(0.05)
        con.close()

    def cerrar(self):
        self.parar.set()
        self.hilo.join(timeout=5)


LIMPIA = "Recibido, ya lo estamos revisando."


def tick(home, *extra):
    """Una corrida del tick: (salida, resumen). El resumen es UNA linea JSON. Con la CLI de
    Orca que no existe, como `corre`: el tick despacha y limpia con ella, y una prueba nunca
    puede llegar a la de verdad."""
    env = dict(os.environ, HOME=str(home),
               XDG_CONFIG_HOME=str(pathlib.Path(home) / ".config"),
               APPDATA=str(pathlib.Path(home) / "AppData" / "Roaming"),
               ORCA_CLI_COMMAND=os.environ.get("ORCA_CLI_COMMAND", SIN_ORCA))
    p = subprocess.run([str(WA_SCOPE), "tick", "--json", *extra], capture_output=True,
                       text=True, env=env, timeout=300)
    lineas = [l for l in p.stdout.splitlines() if l.strip()]
    try:
        resumen = json.loads(lineas[0]) if len(lineas) == 1 else None
    except ValueError:
        resumen = None
    return p, resumen


def linea_lista(home, modo_persona="responder", modo_soporte="borrador"):
    """Un almacen con la linea A activa, el nombre del agente y dos chats autorizados. Y la
    llave del aprobador, que el plugin crea al arrancar (approve-solo-dueno): sin ella el
    tick no puede entregar lo que el dueno aprueba por WhatsApp."""
    llave_del_plugin(home)
    llegan(home, A, [])
    js(home, "agent", "Agente De Ejemplo")
    js(home, "set", PERSONA, "--provider", "ninguno", "--mode", modo_persona)
    js(home, "set", SOPORTE, "--provider", "ninguno", "--mode", modo_soporte)


def propuesta_lista(home, stanza, chat=PERSONA, texto=LIMPIA, tipo="responder"):
    cid = str(js(home, "caso", "crear", "--chat", chat, "--stanza", stanza,
                 "--actor", "agente")[0]["case_id"])
    js(home, "caso", "clasificar", cid, "--clase", "card", "--prioridad", "none",
       "--actor", "agente")
    campo = "--respuesta" if tipo == "responder" else "--instrucciones"
    v = js(home, "caso", "propuesta", cid, "--tipo", tipo, campo, texto,
           "--actor", "agente")[0]["propuesta_version"]
    return cid, v


def envios(home):
    ruta = pathlib.Path(home) / ".wa-inbox" / "capture.db"
    if not ruta.exists():
        return []
    con = sqlite3.connect(ruta)
    con.row_factory = sqlite3.Row
    filas = [dict(r) for r in con.execute("select req_id, estado, body from envio")]
    con.close()
    return filas


print("\nel tick")
with tempfile.TemporaryDirectory() as home:
    p, r = tick(home)
    ok("sobre un HOME vacio el tick no hace nada y sale 0", p.returncode == 0,
       f"salio {p.returncode}: {p.stderr.strip()[:300]}")
    ok("y dice lo que hizo en UNA linea JSON con conteos", isinstance(r, dict)
       and r.get("enviados") == 0 and r.get("busy") is False, f"{p.stdout[:300]}")
    ok("sin traceback", "Traceback" not in p.stderr, p.stderr[-300:])

# El id del envio es el mismo que usa el tablero (acciones.mjs, `entregar`): si el tick
# deja un borrador frenado, el clic del dueno aprueba ESE y no encola otro.
ok("el id del envio del tick es el del tablero: caso-<id>-<version12>",
   "`caso-${c.case_id}-${version.slice(0, 12)}`"
   in (RAIZ / "acciones.mjs").read_text(encoding="utf-8"))

if NODE:
    with tempfile.TemporaryDirectory() as home:
        linea_lista(home)
        sidecar = SidecarFalso(home)
        try:
            cid, v = propuesta_lista(home, "T1")
            p, r = tick(home)
            caso = js(home, "caso", "ver", cid)[0]
            req = f"caso-{cid}-{v[:12]}"
            ok("una respuesta limpia en un chat responder sale una vez, con el id del caso",
               sidecar.entregados == [req], f"entregados {sidecar.entregados} {p.stderr[-300:]}")
            ok("y el caso queda respondido", caso["etapa"] == "respondido",
               f"quedo {caso['etapa']} {p.stderr[-300:]}")
            ok("aprobada por la regla, con su evento",
               any(e["actor"] == "regla" and e["detalle"] == f"aprobada {v}"
                   for e in caso["eventos"]), f"{caso['eventos']}")
            ok("el resumen cuenta el envio", r and r.get("enviados") == 1, f"{p.stdout[:300]}")
            ok("y no imprime el texto del mensaje", LIMPIA not in p.stdout + p.stderr)
            t = tarjeta(home, cid)
            ok("el tablero queda al dia", t and t["stage"] == "respondido", f"{t}")
            antes = cuenta(home, "select count(*) from caso_evento")
            p, r = tick(home)
            ok("un segundo tick no manda nada ni escribe eventos",
               sidecar.entregados == [req]
               and cuenta(home, "select count(*) from caso_evento") == antes
               and r and r.get("enviados") == 0, f"{sidecar.entregados} {p.stdout[:200]}")

            cid, v = propuesta_lista(home, "T2")
            con = db_de(home)
            con.execute("update caso set excepciones='[\"money\"]' where case_id=?",
                        (int(cid),))
            con.commit()
            con.close()
            p, r = tick(home)
            caso = js(home, "caso", "ver", cid)[0]
            ok("con una excepcion no sale nada y queda en decision para el dueno",
               caso["etapa"] == "decision" and not caso["aprobada"]
               and not any(e["req_id"].startswith(f"caso-{cid}-") for e in envios(home)),
               f"{caso['etapa']} {envios(home)}")
            ok("y el resumen la cuenta como excepcion, no como error",
               r and r.get("excepciones") == 1 and r.get("errores") == 0, f"{p.stdout[:300]}")

            cid, v = propuesta_lista(home, "T3", chat=SOPORTE)
            p, r = tick(home)
            caso = js(home, "caso", "ver", cid)[0]
            ok("un chat en borrador (te pregunto antes) no sale solo: queda en decision",
               caso["etapa"] == "decision" and not caso["aprobada"]
               and not any(e["req_id"].startswith(f"caso-{cid}-") for e in envios(home)),
               f"{caso['etapa']} {envios(home)}")

            cid, v = propuesta_lista(home, "T4", tipo="trabajar", texto="Revisar el login")
            p, r = tick(home)
            caso = js(home, "caso", "ver", cid)[0]
            ok("un trabajo no lo toca el tick: el despacho es otra tarea",
               caso["etapa"] == "decision" and not caso["aprobada"], f"{caso['etapa']}")
        finally:
            sidecar.cerrar()

    # Dos ticks a la vez: el segundo no espera ni manda, y el envio sale una vez.
    with tempfile.TemporaryDirectory() as home:
        linea_lista(home)
        sidecar = SidecarFalso(home, demora=2.0)
        try:
            cid, v = propuesta_lista(home, "U1")
            env = dict(os.environ, HOME=str(home),
                       XDG_CONFIG_HOME=str(pathlib.Path(home) / ".config"),
                       APPDATA=str(pathlib.Path(home) / "AppData" / "Roaming"),
                       ORCA_CLI_COMMAND=os.environ.get("ORCA_CLI_COMMAND", SIN_ORCA))
            primero = subprocess.Popen([str(WA_SCOPE), "tick", "--json"], env=env,
                                       stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                       text=True)
            limite = time.time() + 30
            while time.time() < limite and not envios(home):
                time.sleep(0.05)
            p, r = tick(home)
            salida, _ = primero.communicate(timeout=120)
            ok("un tick encima de otro sale 0 diciendo que estaba ocupado",
               p.returncode == 0 and r and r.get("busy") is True, f"{p.stdout[:300]}")
            ok("y el mensaje sale una sola vez", sidecar.entregados == [f"caso-{cid}-{v[:12]}"],
               f"{sidecar.entregados}")
            ok("el primero termina y lo da por respondido",
               primero.returncode == 0 and js(home, "caso", "ver", cid)[0]["etapa"]
               == "respondido", f"{salida[:300]}")
        finally:
            sidecar.cerrar()

    # Jev frena: queda borrador para el dueno, el caso sigue en decision sin la firma de
    # la regla, y el tick siguiente no lo vuelve a intentar.
    with tempfile.TemporaryDirectory() as home:
        linea_lista(home)
        sidecar = SidecarFalso(home)
        antes_env = dict(os.environ)
        os.environ["WA_INBOX_JEV_ENDPOINT"] = "http://127.0.0.1:9/v1/systemone"
        try:
            pon_llave(home)
            cid, v = propuesta_lista(home, "J1")
            p, r = tick(home)
            caso = js(home, "caso", "ver", cid)[0]
            filas = [e for e in envios(home) if e["req_id"] == f"caso-{cid}-{v[:12]}"]
            ok("con Jev sin contestar no sale: queda el borrador con el id del caso",
               sidecar.entregados == [] and len(filas) == 1 and filas[0]["estado"] == "borrador",
               f"{filas} {p.stderr[-300:]}")
            ok("el caso sigue en decision, sin la firma de la regla, con el motivo",
               caso["etapa"] == "decision" and not caso["aprobada"]
               and "send-needs-approval" in caso["eventos"][-1]["detalle"],
               f"{caso['etapa']} {caso['eventos'][-1]}")
            ok("el resumen lo cuenta como frenado", r and r.get("frenados") == 1,
               f"{p.stdout[:300]}")
            antes = cuenta(home, "select count(*) from caso_evento")
            p, r = tick(home)
            ok("el tick siguiente no lo reintenta: es del dueno",
               cuenta(home, "select count(*) from caso_evento") == antes
               and r and r.get("esperando") == 1, f"{p.stdout[:300]}")
        finally:
            sidecar.cerrar()
            os.environ.clear()
            os.environ.update(antes_env)

    # Sin sidecar vivo no se aprueba ni se encola nada: se dice y se sale 0.
    with tempfile.TemporaryDirectory() as home:
        linea_lista(home)
        cid, v = propuesta_lista(home, "N1")
        con = sqlite3.connect(pathlib.Path(home) / ".wa-inbox" / "capture.db")
        con.execute("delete from store_meta where key='sidecar_beat'")
        con.commit()
        con.close()
        p, r = tick(home)
        caso = js(home, "caso", "ver", cid)[0]
        ok("sin la linea corriendo el tick sale 0 y lo dice",
           p.returncode == 0 and r and r.get("sin_transporte") is True, f"{p.stdout[:300]}")
        ok("y no aprueba ni encola nada", caso["etapa"] == "decision" and not caso["aprobada"]
           and envios(home) == [], f"{caso['etapa']} {envios(home)}")


# ── 17. `pending --needs-agent`: el precheck del agente (T7) ──────────────────────
# Sale 0 solo cuando un caso necesita lenguaje; si no, 1 rapido y callado.
print("\npending --needs-agent")


def necesita(home):
    return corre(home, "pending", "--needs-agent")


with tempfile.TemporaryDirectory() as home:
    p = necesita(home)
    ok("sin casos sale 1 y no imprime nada", p.returncode == 1 and not p.stdout.strip(),
       f"{p.returncode} {p.stdout[:200]} {p.stderr[-200:]}")
    cid = str(js(home, "caso", "crear", "--chat", CHAT, "--stanza", "G1",
                 "--actor", "automatizacion")[0]["case_id"])
    p = necesita(home)
    ok("un caso en recibido (nada lo clasifico) necesita al agente",
       p.returncode == 0 and int(cid) in json.loads(p.stdout)["cases"], f"{p.stdout}")
    js(home, "caso", "clasificar", cid, "--clase", "card", "--prioridad", "none",
       "--actor", "agente")
    ok("clasificado sin Jev y sin propuesta tambien: nadie mas redacta",
       necesita(home).returncode == 0)
    v = js(home, "caso", "propuesta", cid, "--tipo", "responder", "--respuesta", LIMPIA,
           "--actor", "agente")[0]["propuesta_version"]
    ok("con la propuesta en decision ya no", necesita(home).returncode == 1)
    js(home, "caso", "mover", cid, "clasificado", "--actor", "dueno")
    ok("reclasificado por el dueno vuelve a necesitar propuesta",
       necesita(home).returncode == 0)
    js(home, "caso", "mover", cid, "cerrado", "--motivo", "listo", "--actor", "dueno")
    ok("cerrado no", necesita(home).returncode == 1)

    def con_jev(stanza, agente, excepciones=None):
        c = str(js(home, "caso", "crear", "--chat", CHAT, "--stanza", stanza,
                   "--actor", "automatizacion")[0]["case_id"])
        js(home, "caso", "clasificar", c, "--clase", "card", "--prioridad", "none",
           "--actor", "jev")
        con = db_de(home)
        con.execute("update caso set jev=?, necesita_agente=?, excepciones=? where case_id=?",
                    ('{"attention_class": "x", "flags": [], "skip": false}', agente,
                     json.dumps(excepciones) if excepciones else None, int(c)))
        con.commit()
        con.close()
        return c

    gris = con_jev("G2", 0)
    ok("una clase que Jev juzgo sin skip y no esta en la lista cerrada despierta al agente",
       necesita(home).returncode == 0 and json.loads(necesita(home).stdout)["cases"] == [int(gris)],
       f"{necesita(home).stdout}")
    clave = con_jev("G3", 0, ["credential"])
    ok("una credencial no despierta al agente",
       int(clave) not in json.loads(necesita(home).stdout)["cases"])
    pide = con_jev("G4", 1)
    p = necesita(home)
    ok("Jev marca que necesita agente y no hay propuesta: 0, con ese caso",
       p.returncode == 0 and json.loads(p.stdout)["cases"] == [int(gris), int(pide)], f"{p.stdout}")


# ── El precheck del cron: callado cuando el tick se encarga ───────────────────────────
# Orca fuerza un espacio nuevo por corrida en las automatizaciones de un plugin: con el
# precheck en 0 crea `::workspace:<uuid>` y una terminal, aunque despues la corrida falle.
# Desde que el tick abre al agente de casos por terminal, el cron es el respaldo: su
# precheck (`--precheck`) sale 1 si el tick corrio hace poco y su ultimo lanzamiento no
# fallo por algo que el cron si arregla. El primer paso del agente sigue sin `--precheck`.
print("\npending --needs-agent --precheck: el cron no corre si el tick se encarga")


def precheck(home):
    return corre(home, "pending", "--needs-agent", "--precheck")


def ultima_corrida_agente(home, estado, motivo=None):
    con = db_de(home)
    con.execute("insert into agente_corrida (origen, estado, motivo, created_at, updated_at) "
                "values ('tick', ?, ?, datetime('now','localtime'), datetime('now','localtime'))",
                (estado, motivo))
    con.commit()
    con.close()


def tick_hace(home, segundos):
    con = db_de(home)
    n = con.execute("update settings set value=? where key='tick_at'",
                    (str(time.time() - segundos),)).rowcount
    con.commit()
    con.close()
    return n


with tempfile.TemporaryDirectory() as home:
    p = precheck(home)
    ok("sin casos sale 1 y no imprime nada", p.returncode == 1 and not p.stdout.strip(),
       f"{p.returncode} {p.stdout[:200]} {p.stderr[-200:]}")
    cid = str(js(home, "caso", "crear", "--chat", CHAT, "--stanza", "PC1",
                 "--actor", "automatizacion")[0]["case_id"])
    p = precheck(home)
    ok("con un caso y un tick que nunca corrio, el cron sigue: 0 con los casos",
       p.returncode == 0 and int(cid) in json.loads(p.stdout or "{}").get("cases", []),
       f"{p.returncode} {p.stdout[:200]} {p.stderr[-200:]}")
    tick(home)
    p = precheck(home)
    ok("un tick sin la CLI de Orca no puede abrir al agente: el cron sigue",
       p.returncode == 0, f"{p.returncode} {p.stdout[:200]} {p.stderr[-200:]}")
    ultima_corrida_agente(home, "activo")
    p = precheck(home)
    ok("con el tick al dia y su agente en vuelo, el precheck sale 1, callado",
       p.returncode == 1 and not p.stdout.strip(), f"{p.returncode} {p.stdout[:200]}")
    ok("y el primer paso del agente (sin --precheck) sigue viendo el caso",
       necesita(home).returncode == 0)
    ultima_corrida_agente(home, "fallido", "sin-cuenta")
    ok("una cuenta tomada no la arregla el cron (Orca lo lanza con la activa): 1",
       precheck(home).returncode == 1)
    ultima_corrida_agente(home, "terminado")
    ok("un agente que termino y el caso sigue: el tick lo relanza, el cron no corre",
       precheck(home).returncode == 1)
    for motivo in ("sin-cli", "sin-espacio", "sin-prompt"):
        ultima_corrida_agente(home, "fallido", motivo)
        ok(f"una falla del tick que el cron si arregla ({motivo}): 0",
           precheck(home).returncode == 0)
    ultima_corrida_agente(home, "activo")
    ok("el tick anota cuando corrio", tick_hace(home, 60) == 1)
    ok("hace un minuto sigue encargado", precheck(home).returncode == 1)
    tick_hace(home, 4 * 60)
    p = precheck(home)
    ok("un tick que no corre hace mas de 3 minutos no se encarga: el cron sigue",
       p.returncode == 0, f"{p.returncode} {p.stdout[:200]}")
    js(home, "caso", "mover", cid, "cerrado", "--motivo", "listo", "--actor", "dueno")
    ok("sin casos, 1 aunque el tick no corra", precheck(home).returncode == 1)


# ── T20: un caso clasificado sin propuesta siempre llega a alguien ────────────────────
# Visto en vivo: un saludo al asistente en un chat `responder`, que Jev juzgo sin marcas,
# se quedaba en clasificado para siempre. Ahora lo despierta al agente segun el modo del
# chat; una credencial no pasa por el agente y va a "Su decision"; `skip` sigue siendo skip.
print("\nT20: clasificado sin propuesta llega al agente o al dueno")


def caso_juzgado(home, stanza, jev_json, agente=0, excepciones=None):
    c = str(js(home, "caso", "crear", "--chat", CHAT, "--stanza", stanza,
               "--actor", "automatizacion")[0]["case_id"])
    js(home, "caso", "clasificar", c, "--clase", "card", "--prioridad", "none",
       "--actor", "jev")
    con = db_de(home)
    con.execute("update caso set jev=?, necesita_agente=?, excepciones=? where case_id=?",
                (json.dumps(jev_json), agente,
                 json.dumps(excepciones) if excepciones else None, int(c)))
    con.commit()
    con.close()
    return c


def para_el_agente(home):
    p = necesita(home)
    return json.loads(p.stdout)["cases"] if p.returncode == 0 else []


SALUDO = {"attention_class": "pleasantry", "flags": [], "skip": False}
for modo, despierta in (("responder", True), ("borrador", True), ("observar", False)):
    with tempfile.TemporaryDirectory() as home:
        js(home, "set", CHAT, "--provider", "plane", "--target", "SOP", "--mode", modo)
        saludo = caso_juzgado(home, "T20A", SALUDO)
        ok(f"un saludo que Jev juzgo sin marcas en un chat `{modo}` "
           f"{'despierta' if despierta else 'no despierta'} al agente",
           (int(saludo) in para_el_agente(home)) is despierta, f"{para_el_agente(home)}")

with tempfile.TemporaryDirectory() as home:
    js(home, "set", CHAT, "--provider", "plane", "--target", "SOP", "--mode", "responder")
    salta = caso_juzgado(home, "T20B", {"attention_class": "pleasantry", "flags": [], "skip": True})
    ok("con `skip` de Jev sigue sin despertar al agente", para_el_agente(home) == [],
       f"{para_el_agente(home)}")
    clave = caso_juzgado(home, "T20C", {"attention_class": "access_or_credential",
                                        "flags": ["asks_for_credential"], "skip": False},
                         agente=0, excepciones=["credential"])
    ok("una credencial no despierta al agente aunque el chat sea `responder`",
       int(clave) not in para_el_agente(home), f"{para_el_agente(home)}")
    # El mismo caso sin la marca de Jev pero con el piso fijo en `excepciones`: igual.
    p = corre(home, "tick", "--json")
    ok("el tick lo mueve a decision, con la excepcion y sin propuesta",
       p.returncode == 0 and tarjeta(home, clave) is not None
       and tarjeta(home, clave)["stage"] == "decision"
       and tarjeta(home, clave)["exceptions"] == ["credential"]
       and tarjeta(home, clave)["proposal"] is None, f"{p.stderr[-300:]} {tarjeta(home, clave)}")
    ok("y deja su evento de clasificado a decision", cuenta(
        home, "select count(*) from caso_evento where case_id=? and de='clasificado' "
        "and a='decision' and actor='automatizacion'", int(clave)) == 1)
    ok("sin que el agente lo vea", int(clave) not in para_el_agente(home))
    p = corre(home, "tick", "--json")
    ok("repetir el tick no vuelve a escribir", cuenta(
        home, "select count(*) from caso_evento where case_id=? and a='decision'",
        int(clave)) == 1)
    t = tablero(home).get("board", {})
    ok("la cuenta del tablero lo cuenta en decision",
       t.get("counts", {}).get("decision") == 1, f"{t.get('counts')}")
    ok("el que `skip` saco sigue en clasificado", tarjeta(home, salta)["stage"] == "clasificado")
    ok("y el saludo no es una excepcion: se queda para el agente",
       tarjeta(home, caso_juzgado(home, "T20D", SALUDO))["stage"] == "clasificado")
    ok("`pending --needs-agent` sale 0 con el saludo y 1 sin casos",
       necesita(home).returncode == 0)

with tempfile.TemporaryDirectory() as home:
    ok("sin casos `pending --needs-agent` sigue saliendo 1", necesita(home).returncode == 1)


# ── Un caso reabierto con una credencial llega al dueno, no al agente ─────────────────
# Visto en vivo: un caso respondido recibio otra pregunta, Jev marco credencial y
# compromiso, y se quedo en clasificado: la propuesta que ya salio lo frenaba, y el
