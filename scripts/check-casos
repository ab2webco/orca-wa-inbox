# ── 12. Jev en la entrada ────────────────────────────────────────────────────────
# `ingest` con un Jev de mentira en 127.0.0.1: el mismo proceso de verdad, sin la API.
import http.server  # noqa: E402
import threading  # noqa: E402


class JevFalso:
    """Un servidor local que contesta como Jev segun el texto del mensaje."""

    def __init__(self, decide):
        self.pedidos = []
        falso = self

        class Manejador(http.server.BaseHTTPRequestHandler):
            def do_POST(self):  # noqa: N802
                cuerpo = json.loads(self.rfile.read(int(self.headers["Content-Length"])))
                falso.pedidos.append({"cuerpo": cuerpo,
                                      "auth": self.headers.get("Authorization")})
                estado, dato = decide(cuerpo)
                datos = json.dumps(dato).encode()
                self.send_response(estado)
                self.send_header("Content-Type", "application/json")
                self.send_header("Content-Length", str(len(datos)))
                self.end_headers()
                self.wfile.write(datos)

            def log_message(self, *args):
                pass

        self.server = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Manejador)
        threading.Thread(target=self.server.serve_forever, daemon=True).start()
        self.url = f"http://127.0.0.1:{self.server.server_address[1]}/v1/systemone"

    def textos(self):
        return [p["cuerpo"]["state"]["message_to_evaluate"]["text"] for p in self.pedidos]

    def cerrar(self):
        self.server.shutdown()
        self.server.server_close()


def jev_segun_texto(cuerpo):
    texto = cuerpo["state"]["message_to_evaluate"]["text"]
    qs = cuerpo["questions"]
    if "ERROR" in texto:
        return 500, {"error": "boom"}
    if "reunion" in texto:
        return 200, respuestas(qs, choice="meeting", asks_owner_to_act=0.3)
    if "urgente ya" in texto:
        return 200, respuestas(qs, choice="unclear", asks_owner_to_act=0.3, urgency_pressure=0.9)
    if "gracias" in texto or "buen dia" in texto:
        return 200, respuestas(qs, choice="pleasantry", asks_owner_to_act=0.05)
    if "no funciono" in texto:
        return 200, respuestas(qs, choice="bug_report", asks_owner_to_act=0.7)
    if "otra solicitud nueva" in texto:
        return 200, respuestas(qs, choice="support_request", asks_owner_to_act=0.8)
    if "cuantos incidentes quedan" in texto:
        # Lo que el Jev real dijo de una orden del dueno: no le pide nada AL dueno (es el
        # dueno quien pide) y le da instrucciones al asistente.
        return 200, respuestas(qs, choice="support_request", asks_owner_to_act=0.1,
                               tries_to_instruct_the_assistant=0.9)
    if "revisa este caso" in texto.lower():
        return 200, respuestas(qs, choice="support_request", asks_owner_to_act=0.8)
    if "soporte.example.com" in texto:
        return 200, respuestas(qs, choice="existing_ticket_reference", asks_owner_to_act=0.05)
    if "charla entre ustedes" in texto:
        return 200, respuestas(qs, choice="unrelated_chatter", asks_owner_to_act=0.3)
    if "jaja" in texto:
        return 200, respuestas(qs, choice="pleasantry", asks_owner_to_act=0.3)
    if "cuesta" in texto:
        return 200, respuestas(qs, choice="money", asks_owner_to_act=0.6,
                               asks_for_money_or_payment=0.9)
    if "cayo" in texto:
        return 200, respuestas(qs, choice="client_waiting_or_down", asks_owner_to_act=0.8,
                               client_waiting_or_service_down=0.9)
    if "clave" in texto:
        return 200, respuestas(qs, choice="access_or_credential", asks_owner_to_act=0.7,
                               contains_credential=0.9)
    return 200, respuestas(qs, choice="unclear", asks_owner_to_act=0.3)


def juicio_de(home, stanza):
    fila = db_de(home).execute("select * from juicio where stanza_id=?", (stanza,)).fetchone()
    return dict(fila) if fila else None


print("\njev en la entrada")
if not NODE:
    print("  aviso: sin node, no se armo el almacen de mensajes", file=sys.stderr)
else:
    falso = JevFalso(jev_segun_texto)
    antes = dict(os.environ)
    os.environ["WA_INBOX_JEV_ENDPOINT"] = falso.url
    try:
        # Sin llave: exactamente lo de hoy, y ni un pedido.
        with tempfile.TemporaryDirectory() as home:
            llegan(home, A, [msg(SOPORTE, "N1", "@duenio gracias", 30, mencion=True)])
            autoriza(home)
            ingiere(home)
            ok("sin llave no sale ni un pedido y el caso queda en recibido",
               falso.pedidos == [] and caso_de_stanza(home, "N1")["etapa"] == "recibido")
            pon_llave(home, f"# otra cosa\nTYPESAFE_API_KEY={LLAVE}\n")
            llegan(home, A, [msg(SOPORTE, "N2", "@duenio gracias otra vez", 20,
                                 mencion=True)])
            ingiere(home)
            ok("un jev.env sin la cabecera del espejo no cuenta como llave",
               falso.pedidos == [])

        with tempfile.TemporaryDirectory() as home:
            pon_llave(home)
            llegan(home, A, [msg(SOPORTE, "K1", "@duenio gracias", 50, mencion=True),
                             msg(OPERACIONES, "K2", "@duenio cuanto cuesta el plan", 40,
                                 mencion=True),
                             msg(PERSONA, "K3", "se cayo el sitio", 30),
                             msg(FACTURACION, "K4", "@duenio la clave es Hunter2xx", 20,
                                 mencion=True),
                             msg(SOPORTE, "K5", "buen dia a todos", 10)])
            autoriza(home)
            p = corre(home, "ingest")
            r = json.loads(p.stdout)[0]
            k1, k2, k3, k4 = (caso_de_stanza(home, s) for s in ("K1", "K2", "K3", "K4"))
            ok("un pedido por mensaje nuevo, con la llave", len(falso.pedidos) == 5
               and all(x["auth"] == f"Bearer {LLAVE}" for x in falso.pedidos),
               f"{len(falso.pedidos)} pedidos")
            ok("lo que salta se cierra como nada, firmado por jev",
               k1["etapa"] == "cerrado" and evento(k1, "cerrado")["actor"] == "jev"
               and evento(k1, "cerrado")["detalle"].startswith("No requiere agente"),
               f"caso {k1}")
            j1 = juicio_de(home, "K1")
            ok("y queda en juicio: origen jev, clase nothing, el JSON del contrato",
               j1 and j1["origen"] == "jev" and j1["clase"] == "nothing"
               and set(json.loads(j1["jev"])) == LLAVES_JUICIO, f"juicio {j1}")
            fila2 = db_de(home).execute("select * from caso where case_id=?",
                                        (k2["case_id"],)).fetchone()
            # T22.2: el dinero se juzga en la respuesta que sale, no en el pedido.
            ok("dinero que entra: card para el agente, sin excepcion en el caso",
               k2["etapa"] == "clasificado" and k2["clase"] == "card"
               and evento(k2, "clasificado")["actor"] == "jev"
               and not fila2["excepciones"], f"caso {dict(fila2)}")
            fila3 = db_de(home).execute("select * from caso where case_id=?",
                                        (k3["case_id"],)).fetchone()
            ok("el sitio caido: card, marcado para el agente",
               k3["clase"] == "card" and fila3["necesita_agente"] == 1, f"caso {dict(fila3)}")
            fila4 = db_de(home).execute("select * from caso where case_id=?",
                                        (k4["case_id"],)).fetchone()
            ok("la credencial: excepcion, y no va al agente",
               json.loads(fila4["excepciones"]) == ["credential"]
               and fila4["necesita_agente"] == 0, f"caso {dict(fila4)}")
            ok("la credencial no salio del equipo",
               not any("Hunter2xx" in x for x in falso.textos()), f"{falso.textos()}")
            ok("la charla suelta que salta no abre caso",
               caso_de_stanza(home, "K5") is None and r["sin_caso"] >= 1, f"salio {r}")
            ok("la llave no aparece en la salida", LLAVE not in p.stdout + p.stderr)
            antes_n = len(falso.pedidos)
            ingiere(home)
            ok("repasar no vuelve a preguntar por el mismo mensaje",
               len(falso.pedidos) == antes_n, f"{len(falso.pedidos)} pedidos")

        with tempfile.TemporaryDirectory() as home:
            pon_llave(home)
            llegan(home, A, [msg(SOPORTE, "F1", "@duenio ERROR revisa", 10, mencion=True)])
            autoriza(home)
            ingiere(home)
            ok("con Jev en error el caso queda en recibido, como sin llave",
               caso_de_stanza(home, "F1")["etapa"] == "recibido"
               and juicio_de(home, "F1") is None)
    finally:
        falso.cerrar()
        os.environ.clear()
        os.environ.update(antes)


# ── 12b. La charla no reabre un caso respondido ──────────────────────────────────
# Visto en vivo: un caso respondido, la gente del grupo siguio charlando entre si, y la
# tarjeta quedo en Clasificado pidiendo "Atender ahora" por nada. Un mensaje sigue
# reabriendo el caso, pero si Jev dice que es charla ajena o un saludo, sin marcas, el
# caso vuelve a donde estaba. Sin Jev, o con Jev en error, sigue reabierto.
def tarjeta_de_tablero(home, cid):
    """La tarjeta del tablero publicado: el tick lo deja al dia."""
    corre(home, "tick", "--json")
    ruta = storage_de(home)
    cards = json.loads(ruta.read_text(encoding="utf-8")).get("board", {}).get("cards", [])
    return next((c for c in cards if c["case_id"] == int(cid)), None)


PROPUESTA_ENVIADA = json.dumps({"tipo": "responder", "respuesta": "Ya quedo, gracias."},
                               sort_keys=True)
VERSION_ENVIADA = "a1b2c3d4e5f6" * 5 + "a1b2"


def caso_respondido(home, stanza):
    """Un caso que ya se respondio: su propuesta salio y el dueno la firmo."""
    llegan(home, A, [msg(SOPORTE, stanza, "@duenio revisa el pedido", 50, mencion=True)])
    autoriza(home)
    ingiere(home)
    cid = caso_de_stanza(home, stanza)["case_id"]
    con = db_de(home)
    con.execute("update caso set etapa='respondido', propuesta=?, propuesta_version=?, "
                "propuesta_aprobada=? where case_id=?",
                (PROPUESTA_ENVIADA, VERSION_ENVIADA, VERSION_ENVIADA, cid))
    con.commit()
    con.close()
    return cid


def fila_de(home, cid):
    return dict(db_de(home).execute("select * from caso where case_id=?", (cid,)).fetchone())


print("\nla charla no reabre un caso respondido")
if NODE:
    falso = JevFalso(jev_segun_texto)
    antes = dict(os.environ)
    os.environ["WA_INBOX_JEV_ENDPOINT"] = falso.url
    try:
        for texto in ("@duenio charla entre ustedes", "@duenio jaja"):
            with tempfile.TemporaryDirectory() as home:
                pon_llave(home)
                cid = caso_respondido(home, "H1")
                llegan(home, A, [msg(SOPORTE, "H2", texto, 5, mencion=True)])
                ingiere(home)
                fila = fila_de(home, cid)
                ver = js(home, "caso", "ver", str(cid))[0]
                ok(f"con Jev ({texto.split(maxsplit=1)[1]}) el caso vuelve a respondido",
                   fila["etapa"] == "respondido" and len(ver["mensajes"]) == 2,
                   f"etapa {fila['etapa']}")
                pares = [(e["de"], e["a"], e["actor"]) for e in ver["eventos"]
                         if e["de"] != e["a"]][-2:]
                ok("la historia dice que se reabrio y que Jev lo devolvio",
                   pares == [("respondido", "recibido", "automatizacion"),
                             ("recibido", "respondido", "jev")], f"{pares}")
                ok("y vuelve con lo que tenia: la propuesta enviada y su firma",
                   fila["propuesta"] == PROPUESTA_ENVIADA
                   and fila["propuesta_version"] == VERSION_ENVIADA
                   and fila["propuesta_aprobada"] == VERSION_ENVIADA, f"{fila}")

        with tempfile.TemporaryDirectory() as home:
            pon_llave(home)
            cid = caso_respondido(home, "H3")
            llegan(home, A, [msg(SOPORTE, "H4", "@duenio cuanto cuesta el plan", 5,
                                 mencion=True)])
            ingiere(home)
            nuevo_caso = caso_de_stanza(home, "H4")
            ok("si Jev ve algo nuevo que atender (dinero) abre su propio caso, y el viejo sigue respondido",
               nuevo_caso["case_id"] != cid and nuevo_caso["etapa"] == "clasificado"
               and fila_de(home, cid)["etapa"] == "respondido", f"{nuevo_caso['etapa']}")
    finally:
        falso.cerrar()
        os.environ.clear()
        os.environ.update(antes)

    # Sin llave: fallar hacia la atencion, y la tarjeta no presenta como pendiente lo que
    # ya salio.
    with tempfile.TemporaryDirectory() as home:
        cid = caso_respondido(home, "H5")
        llegan(home, A, [msg(SOPORTE, "H6", "@duenio charla entre ustedes", 5, mencion=True)])
        ingiere(home)
        fila = fila_de(home, cid)
        nuevo_caso = caso_de_stanza(home, "H6")
        ok("sin Jev un mensaje tras una respuesta abre un caso nuevo: una tarjeta limpia",
           nuevo_caso["case_id"] != cid and nuevo_caso["etapa"] == "recibido"
           and fila["etapa"] == "respondido", f"{fila['etapa']} {nuevo_caso['etapa']}")
        ok("el caso viejo queda tal cual, con la respuesta que ya salio",
           fila["propuesta"] == PROPUESTA_ENVIADA and fila["propuesta_aprobada"] == VERSION_ENVIADA,
           f"{fila}")
        ok("y el nuevo apunta al anterior",
           fila_de(home, nuevo_caso["case_id"])["relacionado"] == cid
           and tarjeta_de_tablero(home, nuevo_caso["case_id"])["related_case"] == cid)


# ── 12d. Un caso es un pedido ────────────────────────────────────────────────────────
# Una tarjeta mezclaba tres pedidos de tres horas: cada mensaje nuevo reabria el mismo caso.
# Tras una respuesta, Jev juzga el mensaje con esa respuesta de contexto: un pedido nuevo
# abre su caso (enlazado al anterior); un seguimiento (`bug_report`, `status_question`:
# "no funciono", "como va") reabre el viejo; una charla (`pleasantry`, `unrelated_chatter`)
# se queda en el viejo sin reabrirlo. Sin Jev, o con una clase que no dice nada (`unclear`,
# `no_match`), un caso nuevo: mejor una tarjeta limpia que una mezclada. Un caso abierto sin
# responder (recibido, clasificado, decision) sigue juntando mensajes; uno en trabajo
# tambien, salvo que Jev diga que es un pedido nuevo.
print("\nun caso es un pedido")
if NODE:
    falso = JevFalso(jev_segun_texto)
    antes = dict(os.environ)
    os.environ["WA_INBOX_JEV_ENDPOINT"] = falso.url
    try:
        with tempfile.TemporaryDirectory() as home:
            pon_llave(home)
            cid = caso_respondido(home, "N1")
            llegan(home, A, [msg(SOPORTE, "N2", "@duenio otra solicitud nueva sobre otro tema", 5,
                                 mencion=True)])
            ingiere(home)
            n = caso_de_stanza(home, "N2")
            ok("un pedido nuevo tras una respuesta abre un caso nuevo",
               n["case_id"] != cid and n["etapa"] == "clasificado"
               and fila_de(home, cid)["etapa"] == "respondido", f"{n['etapa']}")
            ok("enlazado al caso anterior, en la tarjeta tambien",
               fila_de(home, n["case_id"])["relacionado"] == cid
               and tarjeta_de_tablero(home, n["case_id"])["related_case"] == cid)
            ok("Jev vio la respuesta que ya salio como contexto",
               "Ya quedo" in json.dumps(falso.pedidos[-1]["cuerpo"]["state"]),
               json.dumps(falso.pedidos[-1]["cuerpo"]["state"])[:300])
            ok("el caso viejo no recibio el mensaje",
               len(js(home, "caso", "ver", str(cid))[0]["mensajes"]) == 1)

        with tempfile.TemporaryDirectory() as home:
            pon_llave(home)
            cid = caso_respondido(home, "N3")
            llegan(home, A, [msg(SOPORTE, "N4", "@duenio no funciono lo que me mandaron", 5,
                                 mencion=True)])
            ingiere(home)
            fila = fila_de(home, cid)
            ok("un seguimiento (\"no funciono\") reabre el mismo caso",
               caso_de_stanza(home, "N4")["case_id"] == cid and fila["etapa"] == "clasificado"
               and fila["relacionado"] is None, f"{fila['etapa']}")
            ok("y la respuesta ya enviada no queda como pendiente",
               fila["propuesta"] is None and fila["propuesta_version"] is None, f"{fila}")
            ver = js(home, "caso", "ver", str(cid))[0]
            ok("con su evento de reapertura",
               any(e["de"] == "respondido" and e["a"] == "recibido"
                   and VERSION_ENVIADA[:12] in e["detalle"] for e in ver["eventos"]))

        with tempfile.TemporaryDirectory() as home:
            pon_llave(home)
            cid = caso_respondido(home, "N5")
            llegan(home, A, [msg(SOPORTE, "N6", "@duenio jaja", 5, mencion=True)])
            ingiere(home)
            ok("un saludo o una charla se queda en el caso viejo, sin reabrirlo",
               caso_de_stanza(home, "N6")["case_id"] == cid
               and fila_de(home, cid)["etapa"] == "respondido"
               and fila_de(home, cid)["relacionado"] is None)

        with tempfile.TemporaryDirectory() as home:
            pon_llave(home)
            llegan(home, A, [msg(SOPORTE, "N7", "@duenio revisa el pedido", 10, mencion=True)])
            autoriza(home)
            ingiere(home)
            abierto = caso_de_stanza(home, "N7")
            llegan(home, A, [msg(SOPORTE, "N8", "@duenio otra solicitud nueva distinta", 5,
                                 mencion=True)])
            ingiere(home)
            ok("un caso abierto sin responder sigue juntando los mensajes nuevos",
               abierto["etapa"] == "clasificado"
               and caso_de_stanza(home, "N8")["case_id"] == abierto["case_id"],
               f"{caso_de_stanza(home, 'N8')['case_id']} {abierto['case_id']}")

        with tempfile.TemporaryDirectory() as home:
            pon_llave(home)
            cid = caso_respondido(home, "N9")
            con = db_de(home)
            con.execute("update caso set etapa='trabajo' where case_id=?", (cid,))
            con.commit()
            con.close()
            llegan(home, A, [msg(SOPORTE, "NA", "@duenio una cosa suelta sin clase clara", 5,
                                 mencion=True)])
            ingiere(home)
            ok("un caso en trabajo junta lo que Jev no ve como pedido nuevo",
               caso_de_stanza(home, "NA")["case_id"] == cid, f"{caso_de_stanza(home, 'NA')['case_id']}")
            llegan(home, A, [msg(SOPORTE, "NB", "@duenio otra solicitud nueva muy distinta", 4,
                                 mencion=True)])
            ingiere(home)
            nb = caso_de_stanza(home, "NB")
            ok("pero si Jev dice que es un pedido nuevo, abre otro, enlazado",
               nb["case_id"] != cid and fila_de(home, nb["case_id"])["relacionado"] == cid
               and fila_de(home, cid)["etapa"] == "trabajo", f"{nb['case_id']}")
    finally:
        falso.cerrar()
        os.environ.clear()
        os.environ.update(antes)


# ── 12c. Una rafaga de mensajes se juzga como una sola cosa ──────────────────────────
# Visto en vivo: tres mensajes en un segundo —el enlace a una conversacion de otro
# sistema, una nota del cliente y "Revisa este caso"— se juzgaban uno por uno. Jev vio el
# enlace pelado, dijo "nada que atender" y lo cerro en su propio caso: un pedido partido
# en dos con la pieza clave cerrada en silencio. Ahora lo que llega junto en un chat se
# juzga junto, y lo que llega tras un caso recien abierto se suma a el.
ENLACE = "https://soporte.example.com/c/123"
NOTA_CLIENTE = "nota: el cliente Ana Demo pregunta por su pedido"


def listo_persona(home):
    autoriza(home)
    js(home, "set", PERSONA, "--provider", "ninguno", "--mode", "borrador")


def casos_de(home, *stanzas):
    return [caso_de_stanza(home, x) for x in stanzas]


print("\nuna rafaga se juzga junta")
if NODE:
    falso = JevFalso(jev_segun_texto)
    antes = dict(os.environ)
    os.environ["WA_INBOX_JEV_ENDPOINT"] = falso.url
    try:
        with tempfile.TemporaryDirectory() as home:
            pon_llave(home)
            llegan(home, A, [msg(PERSONA, "R1", ENLACE, 5), msg(PERSONA, "R2", NOTA_CLIENTE, 5),
                             msg(PERSONA, "R3", "Revisa este caso", 5)])
            listo_persona(home)
            ingiere(home)
            c1, c2, c3 = casos_de(home, "R1", "R2", "R3")
            ok("el enlace, la nota y el pedido caen en un solo caso",
               c1 and c1["case_id"] == c2["case_id"] == c3["case_id"], f"{[c and c['case_id'] for c in (c1, c2, c3)]}")
            ok("y ese caso no esta cerrado: lo pide el dueno",
               c1["etapa"] != "cerrado" and not any(e["a"] == "cerrado" for e in c1["eventos"]),
               f"{c1['etapa']}")
            ok("Jev vio la rafaga entera, en orden y en una sola llamada",
               len(falso.pedidos) == 1 and falso.textos()[0].find(ENLACE) >= 0
               and falso.textos()[0].find(ENLACE) < falso.textos()[0].find("Ana Demo")
               < falso.textos()[0].find("Revisa este caso"), f"{falso.textos()}")
            # El mismo juicio, otra vez: la cache lo tiene por la rafaga.
            con = db_de(home)
            for tabla in ("caso_evento", "caso_mensaje", "caso"):
                con.execute(f"delete from {tabla}")
            con.commit()
            con.close()
            ingiere(home)
            ok("volver a juzgar la misma rafaga no llama a Jev: la cache la tiene",
               len(falso.pedidos) == 1, f"{len(falso.pedidos)} pedidos")
            ok("y el resultado es el mismo", caso_de_stanza(home, "R1")["case_id"]
               == caso_de_stanza(home, "R3")["case_id"])

        with tempfile.TemporaryDirectory() as home:
            pon_llave(home)
            falso.pedidos.clear()
            llegan(home, A, [msg(PERSONA, "S1", ENLACE, 5), msg(PERSONA, "S2", NOTA_CLIENTE, 5)])
            listo_persona(home)
            ingiere(home)
            c1, c2 = casos_de(home, "S1", "S2")
            ok("una rafaga que entera no pide nada se descarta junta, en un solo caso cerrado",
               c1["case_id"] == c2["case_id"] and c1["etapa"] == "cerrado"
               and len(falso.pedidos) == 1, f"{c1['etapa']} {len(falso.pedidos)}")

        with tempfile.TemporaryDirectory() as home:
            pon_llave(home)
            cid = caso_respondido(home, "G0")
            llegan(home, A, [msg(SOPORTE, "G1", "@duenio gracias", 5, mencion=True)])
            ingiere(home)
            g = caso_de_stanza(home, "G1")
            ok("un \"gracias\" suelto tras una respuesta sigue siendo su caso cerrado",
               g["case_id"] != cid and g["etapa"] == "cerrado"
               and fila_de(home, cid)["etapa"] == "respondido", f"{g['etapa']}")

        with tempfile.TemporaryDirectory() as home:
            pon_llave(home)
            falso.pedidos.clear()
            llegan(home, A, [msg(PERSONA, "T1", ENLACE, 30), msg(PERSONA, "T2", "Revisa este caso", 10)])
            listo_persona(home)
            ingiere(home)
            c1, c2 = casos_de(home, "T1", "T2")
            ok("dos rafagas separadas por diez minutos se juzgan por separado",
               len(falso.pedidos) == 2 and c1["case_id"] != c2["case_id"]
               and c1["etapa"] == "cerrado" and c2["etapa"] != "cerrado",
               f"{len(falso.pedidos)} {c1['etapa']} {c2['etapa']}")

        with tempfile.TemporaryDirectory() as home:
            pon_llave(home)
            falso.pedidos.clear()
            llegan(home, A, [msg(PERSONA, "U1", "Revisa este caso", 5)])
            listo_persona(home)
            ingiere(home)
            llegan(home, A, [msg(PERSONA, "U2", ENLACE, 5)])
            ingiere(home)
            c1, c2 = casos_de(home, "U1", "U2")
            ok("una rafaga partida en dos corridas se suma al mismo caso, sin cerrar",
               c1["case_id"] == c2["case_id"] and c1["etapa"] != "cerrado",
               f"{c1['case_id']} {c2['case_id']} {c1['etapa']}")

        with tempfile.TemporaryDirectory() as home:
            pon_llave(home)
            llegan(home, A, [msg(PERSONA, "V1", ENLACE, 5),
                             msg(PERSONA, "V2", "Revisa este caso, la clave es Zx9secreta", 5)])
            listo_persona(home)
            ingiere(home)
            c = caso_de_stanza(home, "V1")
            ok("el piso fijo corre por mensaje y suma sus excepciones al caso",
               "credential" in json.loads(fila_de(home, c["case_id"])["excepciones"] or "[]"),
               f"{fila_de(home, c['case_id'])['excepciones']}")
    finally:
        falso.cerrar()
        os.environ.clear()
        os.environ.update(antes)


# ── 13. Errores estables de `wa-scope caso` ──────────────────────────────────────
# El panel (T6) traduce por codigo: salida 2 y UNA linea JSON en stderr,
# {"error": "<code>", "detail": "<english text>"} (kanban-casos, "Contratos").
def error_de(p):
    """El codigo del error, o el motivo por el que la salida no cumple el contrato."""
    if p.returncode != 2:
        return f"salio {p.returncode}: {p.stderr.strip()[:200]}"
    lineas = p.stderr.strip().splitlines()
    if len(lineas) != 1:
        return f"stderr con {len(lineas)} lineas: {p.stderr.strip()[:300]}"
    try:
        dato = json.loads(lineas[0])
    except ValueError:
        return f"stderr no es JSON: {lineas[0][:200]}"
    if set(dato) != {"error", "detail"} or not dato["detail"]:
        return f"llaves {sorted(dato)}"
    return dato["error"]


def caso_en_decision(home, stanza, chat=CHAT):
    cid = caso_clasificado(home, stanza, chat)
    v = js(home, "caso", "propuesta", cid, "--tipo", "responder", "--respuesta",
           "Tomo esto.", "--actor", "agente")[0]["propuesta_version"]
    return cid, v


print("\nlos errores de caso")
with tempfile.TemporaryDirectory() as home:
    cid = caso_clasificado(home, "E1")
    for nombre, args, codigo in (
            ("un argumento que falta", ("caso", "mover", cid, "--actor", "dueno"), "E_ARGS"),
            ("un id que no es numero", ("caso", "ver", "uno"), "E_ARGS"),
            ("un actor que no existe", ("caso", "mover", cid, "cerrado", "--motivo", "x",
                                        "--actor", "nadie"), "E_ARGS"),
            ("un caso que no existe", ("caso", "ver", "9999"), "E_NOT_FOUND"),
            ("una transicion prohibida", ("caso", "mover", cid, "trabajo", "--actor",
                                          "dueno"), "E_STAGE"),
            ("cerrar sin motivo", ("caso", "mover", cid, "cerrado", "--actor", "dueno"),
             "E_ARGS")):
        p = corre(home, *args)
        ok(f"{nombre}: {codigo}", error_de(p) == codigo, error_de(p))
    cid2, v = caso_en_decision(home, "E2")
    ok("ejecutar sin aprobar: E_NOT_APPROVED",
       error_de(corre(home, "caso", "mover", cid2, "respondido", "--actor", "dueno")) ==
       "E_NOT_APPROVED")
    ok("aprobar una version vieja: E_VERSION",
       error_de(corre(home, "caso", "aprobar", cid2, "--version", "v-vieja", "--actor",
                      "dueno")) == "E_VERSION")
    # La base tomada por otro: E_BUSY, sin traceback.
    tomada = sqlite3.connect(pathlib.Path(home) / ".wa-inbox" / "scope.db")
    tomada.execute("begin exclusive")
    p = corre(home, "caso", "mover", cid, "cerrado", "--motivo", "x", "--actor", "dueno")
    tomada.rollback()
    tomada.close()
    ok("la base tomada: E_BUSY", error_de(p) == "E_BUSY", error_de(p))

print("\nla aprobacion por regla")
with tempfile.TemporaryDirectory() as home:
    js(home, "set", CHAT, "--provider", "ninguno", "--mode", "responder")
    js(home, "set", OTRO, "--provider", "ninguno", "--mode", "borrador")
    cid, v = caso_en_decision(home, "R1")
    p = js(home, "caso", "aprobar", cid, "--version", v, "--actor", "regla")[0]
    ev = js(home, "caso", "ver", cid)[0]["eventos"][-1]
    ok("la regla congela la version igual que el dueno, y queda con su actor",
       p["aprobada"] and p["propuesta_aprobada"] == v and ev["actor"] == "regla",
       f"quedo {p} evento {ev}")
    ok("mover no cambia: con la version aprobada por la regla, se da por respondido",
       js(home, "caso", "mover", cid, "respondido", "--actor", "automatizacion")[0][
           "etapa"] == "respondido")

    cid, v = caso_en_decision(home, "R2")
    con = db_de(home)
    con.execute("update caso set excepciones='[\"money\"]' where case_id=?", (int(cid),))
    con.commit()
    con.close()
    antes = cuenta(home, "select count(*) from caso_evento")
    ok("con una excepcion la regla no aprueba: E_EXCEPTION",
       error_de(corre(home, "caso", "aprobar", cid, "--version", v, "--actor", "regla"))
       == "E_EXCEPTION")
    ok("y no escribe nada", cuenta(home, "select count(*) from caso_evento") == antes
       and not js(home, "caso", "ver", cid)[0]["aprobada"])
    ok("el dueno si puede aprobar la excepcion",
       js(home, "caso", "aprobar", cid, "--version", v, "--actor", "dueno")[0]["aprobada"])

    cid, v = caso_en_decision(home, "R3", OTRO)
    ok("en un chat en borrador (te pregunto antes) la regla no aprueba: E_EXCEPTION",
       error_de(corre(home, "caso", "aprobar", cid, "--version", v, "--actor", "regla"))
       == "E_EXCEPTION")
    ok("ni otro actor se hace pasar por la regla",
       error_de(corre(home, "caso", "aprobar", cid, "--version", v, "--actor", "agente"))
       == "E_ARGS")


# ── 14. El tablero en el storage del panel (T4) ──────────────────────────────────
# `board` lo escribe wa-scope en cada sync y despues de cada mutacion de un caso; lo
# leen el panel y la insignia (kanban-casos, "Contratos").
import re  # noqa: E402

LLAVES_TARJETA = {"case_id", "account", "chat_jid", "chat_name", "stage", "title",
                  "summary", "clase", "prioridad", "jev", "proposal", "exceptions",
                  "blocked_reason", "no_agent_rule", "read_only", "ticket", "updated_at", "actions", "project",
                  "needs_agent", "events", "related_case", "dispatch", "waits_agent", "stage_at"}
ISO = re.compile(r"^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d[+-]\d\d:\d\d$")


def tablero(home):
    ruta = storage_de(home)
    return json.loads(ruta.read_text(encoding="utf-8")) if ruta.exists() else {}


def tarjeta(home, cid):
    return next((c for c in tablero(home).get("board", {}).get("cards", [])
                 if c["case_id"] == int(cid)), None)


print("\nel tablero")
with tempfile.TemporaryDirectory() as home:
    js(home, "set", CHAT, "--provider", "plane", "--target", "SOP", "--mode", "responder")
    cid = caso_clasificado(home, "B1")
    b = tablero(home).get("board")
    ok("una mutacion de caso deja `board` en el storage, version 1",
       isinstance(b, dict) and b.get("v") == 1 and ISO.match(b.get("updated_at") or ""),
       f"{b}")
    ok("counts trae las ocho etapas y cuenta el caso",
       b and set(b["counts"]) == set(ETAPAS := ("recibido", "clasificado", "decision",
                                                "trabajo", "listo", "respondido",
                                                "cerrado", "bloqueado"))
       and b["counts"]["clasificado"] == 1 and b["truncated"] is False, f"{b}")
    t = tarjeta(home, cid)
    ok("la tarjeta trae exactamente las llaves del contrato",
       t and set(t) == LLAVES_TARJETA, f"{t and sorted(t)}")
    ok("con la etapa, la clase, la prioridad y la conversacion",
       t and t["stage"] == "clasificado" and t["clase"] == "revision"
       and t["prioridad"] == "high" and t["chat_jid"] == CHAT and t["chat_name"]
       and ISO.match(t["updated_at"]), f"{t}")
    ok("sin propuesta, jev ni tarjeta de Plane: null; sin excepciones: lista vacia",
       t and t["proposal"] is None and t["jev"] is None and t["ticket"] is None
       and t["blocked_reason"] is None and t["exceptions"] == [], f"{t}")
    v = js(home, "caso", "propuesta", cid, "--tipo", "responder", "--respuesta",
           "Tomo esto.", "--actor", "agente")[0]["propuesta_version"]
    t = tarjeta(home, cid)
    ok("la propuesta llega con su tipo, su texto y su version",
       t and t["proposal"] == {"tipo": "responder", "texto": "Tomo esto.", "version": v},
       f"{t}")
    ok("y las acciones de una respuesta en decision",
       t and "enviar" in t["actions"] and "editar" in t["actions"]
       and "ejecutar" not in t["actions"], f"{t and t['actions']}")
    s = tablero(home)
    ok("la insignia es counts.decision", s.get("navBadge") == {"count": 1}
       and s["board"]["counts"]["decision"] == 1, f"{s.get('navBadge')}")
    js(home, "caso", "mover", cid, "bloqueado", "--motivo", "sin acceso al repo",
       "--actor", "agente")
    t = tarjeta(home, cid)
    ok("bloqueado dice por que", t and t["blocked_reason"] == "sin acceso al repo", f"{t}")
    ok("y la insignia baja", tablero(home).get("navBadge") == {"count": 0})
    con = db_de(home)
    con.execute("update caso set plane_issue='SOP-7', excepciones='[\"money\"]', "
                "jev='{\"attention_class\": \"money\", \"flags\": [\"x\"], "
                "\"skip\": false}' where case_id=?", (int(cid),))
    con.commit()
    con.close()
    js(home, "caso", "mover", cid, "cerrado", "--motivo", "listo", "--actor", "dueno")
    t = tarjeta(home, cid)
    ok("la tarjeta de Plane, las excepciones y el veredicto de Jev",
       t and t["ticket"] == "SOP-7" and t["exceptions"] == ["money"]
       and t["jev"] == {"attention_class": "money", "flags": ["x"], "skip": False}, f"{t}")
    ok("un caso cerrado solo se puede reabrir", t and t["actions"] == ["reabrir"], f"{t}")
    js(home, "sync")
    ok("sync tambien escribe el tablero", tablero(home).get("board", {}).get("counts", {})
       .get("cerrado") == 1)

# El tope: 200 abiertas (las mas recientes) y hasta 50 cerradas de los ultimos 7 dias.
with tempfile.TemporaryDirectory() as home:
    caso_clasificado(home, "T0")
    con = db_de(home)
    cuenta_linea = con.execute("select account from caso").fetchone()[0]
    reciente = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(time.time() - 3600))
    viejo = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(time.time() - 10 * 86400))
    for n in range(210):
        con.execute("insert into caso (account, chat_jid, etapa, titulo, created_at, "
                    "updated_at) values (?,?,'recibido','t',?,?)",
                    (cuenta_linea, CHAT, reciente, reciente))
    for n in range(60):
        con.execute("insert into caso (account, chat_jid, etapa, titulo, created_at, "
                    "updated_at) values (?,?,'cerrado','t',?,?)",
                    (cuenta_linea, CHAT, reciente, reciente))
    for n in range(3):
        con.execute("insert into caso (account, chat_jid, etapa, titulo, created_at, "
                    "updated_at) values (?,?,'cerrado','t',?,?)",
                    (cuenta_linea, CHAT, viejo, viejo))
    con.commit()
    con.close()
    nuevo = caso_clasificado(home, "T1")
    b = tablero(home)["board"]
    abiertas = [c for c in b["cards"] if c["stage"] != "cerrado"]
    cerradas = [c for c in b["cards"] if c["stage"] == "cerrado"]
    ok("200 abiertas, las mas recientes primero",
       len(abiertas) == 200 and abiertas[0]["case_id"] == int(nuevo), f"{len(abiertas)}")
    ok("50 cerradas, ninguna de mas de 7 dias", len(cerradas) == 50, f"{len(cerradas)}")
    ok("truncated lo dice", b["truncated"] is True)
    ok("counts cuenta todo, no solo lo enviado",
       b["counts"]["recibido"] == 210 and b["counts"]["clasificado"] == 2
       and b["counts"]["cerrado"] == 63, f"{b['counts']}")

# El titulo que falta sale del primer mensaje, recortado y enmascarado.
