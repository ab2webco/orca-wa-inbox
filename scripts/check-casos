        finally:
            sidecar.cerrar()

    # Si su terminal ya no esta, la respuesta abre otro despacho con el hilo entero y lo que
    # el agente anterior reporto.
    with tempfile.TemporaryDirectory() as home, tempfile.TemporaryDirectory() as carpeta:
