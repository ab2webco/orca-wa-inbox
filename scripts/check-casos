           and cerradas(carpeta) == ["term_worker1"], f"{motivo_bloqueo(home, cid)}")

    # La linea del brief se pierde: `composer-ready` llega mientras Claude todavia arranca,
    # Orca ve el Enter sin turno y el agente queda con el composer vacio. El despacho mira
    # `terminal state` despues de escribir: sin turno, espera `tui-idle` y la escribe de
    # nuevo (dos veces por tick a lo mas); un tick siguiente sigue intentando, y con los
    # reenvios agotados va a Bloqueado. Con un turno empezado no vuelve a escribir nunca.
    print("\nT8: la linea del brief que el agente no recibio")
    NO_RECIBIO = "el agente del proyecto no recibió el trabajo"

    def esperas(carpeta, para):
        return [x for x in llamadas_orca(carpeta, "terminal wait") if bandera(x, "--for") == para]

    with tempfile.TemporaryDirectory() as home, tempfile.TemporaryDirectory() as carpeta:
        linea_lista(home)
        acepta_proyectos(home, "alfa-demo")
        orca_despacho(carpeta, arranca_en=2)
        cid = trabajo_firmado(home, "L1")
        p, r = tick_orca(home, carpeta)
        fila = (despachos(home, cid) or [{}])[-1]
        envios_l1 = lanzamientos(carpeta)
        ok("la primera linea se pierde: la escribe otra vez y el turno empieza",
           p.returncode == 0 and len(envios_l1) == 2
           and len({bandera(x, "--text") for x in envios_l1}) == 1
           and fila.get("estado") == "activo" and r.get("despachados") == 1
           and js(home, "caso", "ver", cid)[0]["etapa"] == "trabajo",
           f"{envios_l1} {fila} {r} {p.stderr[-400:]}")
        orden = [" ".join(x[:2]) + (f" {bandera(x, '--for')}" if x[:2] == ["terminal", "wait"]
                                    else "") for x in llamadas_orca(carpeta)
                 if " ".join(x[:2]) in ("terminal wait", "terminal send", "terminal state")]
        entre = orden[2:orden.index("terminal send", 2)] if orden.count("terminal send") > 1 \
            else []
        ok("mira el estado, espera tui-idle y recien ahi reenvia",
           orden[:2] == ["terminal wait composer-ready", "terminal send"]
           and "terminal state" in entre and "terminal wait tui-idle" in entre, f"{orden}")
        ok("la fila anota el reenvio y que el turno empezo",
           fila.get("reenvios") == 1 and fila.get("turno_at"), f"{fila}")
        estados_antes = len(llamadas_orca(carpeta, "terminal state"))
        tick_orca(home, carpeta)
        tick_orca(home, carpeta)
        ok("con el turno visto, los ticks siguientes no reenvian ni vuelven a mirar",
           len(lanzamientos(carpeta)) == 2
           and len(llamadas_orca(carpeta, "terminal state")) == estados_antes
           and despachos(home, cid)[-1]["estado"] == "activo", f"{lanzamientos(carpeta)}")

    with tempfile.TemporaryDirectory() as home, tempfile.TemporaryDirectory() as carpeta:
        linea_lista(home)
        acepta_proyectos(home, "alfa-demo")
        orca_despacho(carpeta)
        cid = trabajo_firmado(home, "L2")
        tick_orca(home, carpeta)
        tick_orca(home, carpeta)
        fila = (despachos(home, cid) or [{}])[-1]
        ok("con el turno empezado a la primera: una sola linea, sin tui-idle ni reenvios",
           len(lanzamientos(carpeta)) == 1 and not esperas(carpeta, "tui-idle")
           and fila.get("reenvios") == 0 and fila.get("turno_at")
           and fila.get("estado") == "activo", f"{fila} {lanzamientos(carpeta)}")

    with tempfile.TemporaryDirectory() as home, tempfile.TemporaryDirectory() as carpeta:
        linea_lista(home)
        acepta_proyectos(home, "alfa-demo")
        orca_despacho(carpeta, arranca_en=None, idle=False)
        cid = trabajo_firmado(home, "L3")
