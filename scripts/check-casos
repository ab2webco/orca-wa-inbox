# ── 15. La primera corrida de ingest (T15) ───────────────────────────────────────
# La primera vez solo entra lo de las ultimas `case_window_hours`; lo de antes queda
# visto: ni llena el tablero de historial ni gasta Jev en el.
print("\nla primera corrida de ingest")
if NODE:
    with tempfile.TemporaryDirectory() as home:
        llegan(home, A, [msg(SOPORTE, "P1", "@duenio esto es de antier", 30 * 60, mencion=True),
                         msg(PERSONA, "P2", "y esto de anoche", 13 * 60),
                         msg(SOPORTE, "P3", "@duenio esto es de hoy", 60, mencion=True)])
        autoriza(home)
        r = ingiere(home)
        ok("solo entra lo de la ventana", caso_de_stanza(home, "P3") is not None
           and caso_de_stanza(home, "P1") is None and caso_de_stanza(home, "P2") is None,
           f"salio {r}")
        ok("y el reporte cuenta lo que quedo visto de antes",
           r.get("anteriores") == 2 and r["nuevos"] == 1, f"salio {r}")
        r = ingiere(home)
        ok("lo de antes no entra en la segunda corrida",
           caso_de_stanza(home, "P1") is None and caso_de_stanza(home, "P2") is None
           and r["nuevos"] == 0, f"salio {r}")
        # Lo que llega despues con fecha de antes de la linea base (historial que el
        # telefono sincroniza tarde) tampoco.
        llegan(home, A, [msg(PERSONA, "P4", "historial tardio", 20 * 60),
                         msg(PERSONA, "P5", "esto llego ahora", 5)])
        r = ingiere(home)
        ok("lo que llega tarde con fecha de antes queda visto, lo nuevo entra",
           caso_de_stanza(home, "P4") is None and caso_de_stanza(home, "P5") is not None,
           f"salio {r}")

    with tempfile.TemporaryDirectory() as home:
        llegan(home, A, [msg(PERSONA, "W1", "y esto de anoche", 13 * 60)])
        autoriza(home)
        js(home, "config", "case_window_hours", "24")
        ingiere(home)
        ok("la ventana es la de case_window_hours", caso_de_stanza(home, "W1") is not None)

    falso = JevFalso(jev_segun_texto)
    antes = dict(os.environ)
    os.environ["WA_INBOX_JEV_ENDPOINT"] = falso.url
    try:
        with tempfile.TemporaryDirectory() as home:
            pon_llave(home)
            llegan(home, A, [msg(SOPORTE, "Q1", "@duenio cuanto cuesta", 30 * 60, mencion=True),
                             msg(SOPORTE, "Q2", "@duenio cuanto cuesta hoy", 30,
                                 mencion=True)])
            autoriza(home)
            ingiere(home)
            ok("con llave, Jev solo ve lo de la ventana", len(falso.pedidos) == 1,
               f"{len(falso.pedidos)} pedidos")
    finally:
        falso.cerrar()
        os.environ.clear()
        os.environ.update(antes)


# ── 16. El piso fijo de excepciones (T19) ────────────────────────────────────────
# Sin la llave de Jev nada marcaba dinero, credenciales ni compromisos, y la aprobacion
# por regla dejaba salir una respuesta con un precio sin el dueno. El piso es codigo
# determinista: siempre corre, y Jev solo puede sumar.
def carga_reglas():
    sys.dont_write_bytecode = True
    sys.path.insert(0, str(WA_SCOPE.parent))
    import wa_reglas  # noqa: E402
    return wa_reglas


print("\nel piso fijo: el modulo")
reglas = carga_reglas()
ok("usa los nombres de excepcion de Jev",
   set(reglas.EXCEPCIONES_PISO) <= set(carga_jev().ORDEN_EXCEPCIONES)
   and set(reglas.EXCEPCIONES_PISO) == {"money", "credential", "commitment"})
for texto, direccion, esperado in (
        # dinero (T22.2): un monto o un precio en lo que SALE. Lo que pide el cliente no
        # es una excepcion: lo que se le contesta con un precio si.
        ("el precio es $1.400", "salida", ["money"]),
        ("son 250.000 COP", "salida", ["money"]),
        ("queda un saldo de 1,250.50", "salida", ["money"]),
        ("el plan cuesta 50 al mes", "salida", ["money"]),
        ("le hacemos un descuento del 10%", "salida", ["money"]),
        ("son 300 mil pesos", "salida", ["money"]),
        ("the fee is 30 USD", "salida", ["money"]),
        ("€ 40 per month", "salida", ["money"]),
        ("custa R$ 99", "salida", ["money"]),
        ("o orçamento fica em 1.200", "salida", ["money"]),
        ("le paso la cotización con el equipo", "salida", []),
        ("le envio la factura por correo", "salida", []),
        ("revisamos el pago y le aviso", "salida", []),
        ("we'll check the invoice", "salida", []),
        ("cuanto vale el plan?", "entrada", []),
        ("¿Cuánto cuesta la instalación?", "entrada", []),
        ("ya hice la transferencia de 1.400", "entrada", []),
        ("send me the invoice please", "entrada", []),
        ("el ticket 4512 sigue abierto", "salida", []),
        # credencial: un valor con forma de secreto, o alguien que pide una clave, un
        # token o un codigo. "acceso" solo, una URL o un enlace no lo son.
        ("la contraseña es Hunter2xx", "entrada", ["credential"]),
        ("me pasas usuario y clave?", "entrada", ["credential"]),
        ("cual es el password del wifi", "entrada", ["credential"]),
        ("qual é a senha?", "entrada", ["credential"]),
        ("el código de verificación es 482913", "entrada", ["credential"]),
        ("ahi va el token ghp_abcdefghijklmnop1234", "salida", ["credential"]),
        ("mi PIN es 4455", "entrada", ["credential"]),
        ("entra a https://x.example.com/?access_token=abc123def", "entrada",
         ["credential"]),
        ("me mandas tu clave del panel?", "entrada", ["credential"]),
        ("¿Ya tienes listo el Artifact? ¿Me mandas la URL?", "entrada", []),
        ("¿Ya tienes listo el Artifact? ¿Me mandas la URL?", "salida", []),
        ("te comparto el enlace: https://demo.example.com/informe", "salida", []),
        ("ya tienes acceso al tablero", "salida", []),
        ("necesito acceso al repositorio", "entrada", []),
        ("es clave que lo revisemos con calma", "salida", []),
        # compromiso (T22.2): una fecha u hora concreta prometida en lo que sale. La
        # palabra "fecha", "te confirmo" o "para el" solos no lo son, y una pregunta no
        # promete nada.
        ("Queda listo el viernes", "salida", ["commitment"]),
        ("Mañana te confirmo", "salida", ["commitment"]),
        ("lo revisamos hoy", "salida", ["commitment"]),
        ("pasado mañana lo tienes", "salida", ["commitment"]),
        ("el lunes lo vemos", "salida", ["commitment"]),
        ("a más tardar el 15/10", "salida", ["commitment"]),
        ("en 2 horas te lo envío", "salida", ["commitment"]),
        ("a las 3 pm te llamo", "salida", ["commitment"]),
        ("tomorrow it will be ready", "salida", ["commitment"]),
        ("we'll fix it by Friday", "salida", ["commitment"]),
        ("fica pronto amanhã", "salida", ["commitment"]),
        ("hoje eu te envio", "salida", ["commitment"]),
        ("le confirmo que sale", "salida", []),
        ("te confirmo apenas lo vea el equipo", "salida", []),
        ("¿Para qué fecha lo necesitas?", "salida", []),
        ("¿Qué fecha te queda mejor para la revisión?", "salida", []),
        ("¿Te sirve el viernes a las 10?", "salida", []),
        ("¿Te sirve el viernes? Lo dejamos listo el lunes.", "salida", ["commitment"]),
        ("lo dejamos para el equipo de soporte", "salida", []),
        ("anoté la fecha de entrega que nos diste", "salida", []),
        # varias a la vez, en el orden del contrato
        ("Mañana te paso la factura de $200 y la clave: Abc12345", "salida",
         ["money", "credential", "commitment"]),
        # lo limpio
        ("hola, ya lo revisamos", "salida", []),
        # avisar no es prometer: sin fecha ni entrega, una respuesta de soporte sigue sola
        ("ya lo revisamos y te aviso", "salida", []),
        ("en cuanto sepa algo les avisamos", "salida", []),
        ("we'll keep you posted", "salida", []),
        ("assim que souber te aviso", "salida", []),
        ("Tomo esto.", "salida", []),
        ("gracias!", "entrada", []),
        ("el sitio carga lento", "entrada", []),
        ("revisa la pagina de inicio", "entrada", []),
        ("Thanks, we are looking into it", "salida", []),
        ("Obrigado, estamos olhando", "salida", []),
        ("", "salida", []),
        (None, "entrada", []),
        # lo de entrada nunca es compromiso, aunque nombre una fecha
        ("lo necesito para mañana el viernes", "entrada", []),
        ("can you have it by Friday?", "entrada", [])):
    salio = reglas.excepciones(texto, direccion)
    ok(f"{direccion}: {texto!r} -> {esperado}", salio == esperado, f"salio {salio}")


def _da_error(f):
    try:
        f()
    except ValueError:
        return True
    return False


ok("una direccion desconocida levanta ValueError",
   _da_error(lambda: reglas.excepciones("x", "otra")))

# El control destructivo: un valor con forma de secreto. Es lo unico que ningun nivel de
# un chat ni el dueno apagan en lo que sale (T22.1).
for texto, esperado in (("la clave: Abc12345", True),
                        ("ahi va el token ghp_abcdefghijklmnop1234", True),
                        ("el código de verificación es 482913", True),
                        ("te mando la clave por otro medio", False),
                        ("¿Me mandas la URL?", False),
                        ("", False), (None, False)):
    ok(f"secreto: {texto!r} -> {esperado}", reglas.secreto(texto) is esperado,
       f"salio {reglas.secreto(texto)}")


def fila_caso(home, cid):
    return dict(db_de(home).execute("select * from caso where case_id=?",
                                    (int(cid),)).fetchone())


def excepciones_de(home, cid):
    valor = fila_caso(home, cid)["excepciones"]
    return json.loads(valor) if valor else []


