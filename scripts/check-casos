       fila_caso(home, cid)["propuesta"] is None
       and fila_caso(home, cid)["propuesta_version"] is None, f"{fila_caso(home, cid)}")
    js(home, "caso", "clasificar", cid, "--clase", "alert", "--prioridad", "none",
       "--actor", "jev")
