            autoriza(home)
            ingiere(home)
            c = caso_de_stanza(home, "U1")
            ok("Jev dijo que no hay excepcion y se pregunto",
               len(falso.pedidos) == 1, f"{len(falso.pedidos)} pedidos")
            ok("pero la del piso queda: Jev solo suma",
