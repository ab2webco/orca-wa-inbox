        ok("los que sobran no se abren ni se marcan: esperan a la proxima",
           caso_de_stanza(home, "T7") is None and caso_de_stanza(home, "T1") is not None)
        ingiere_con(home, env)
        ok("la proxima corrida toma los que faltaron y no repite ninguno",
           sorted(llamadas(registro)) == sorted(f"t{i}.ogg" for i in range(1, 8)),
           f"{llamadas(registro)}")

