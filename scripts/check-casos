            ok("sin terminal: un despacho nuevo, uno solo",
               len(arranques) == 2 and not respuestas_a_terminal(carpeta)
               and len(lanzamientos(carpeta)) == 2
               and ruta_brief(carpeta, 0) != ruta_brief(carpeta, 1)
               and [f["estado"] for f in despachos(home, cid)] == ["continuado", "activo"],
               f"{despachos(home, cid)} {p.stderr[-300:]}")
            ok("con el hilo entero y lo que reporto el anterior",
               PEDIDO in spec and "Del 30 de septiembre" in spec
               and "¿Cuál reporte es el que falla?" in spec
               and "Falta la fecha del reporte" in spec and TRABAJO in spec, spec[:2000])
            p, r = tick_orca(home, carpeta)
            ok("y el tick siguiente no lanza otro",
               len(llamadas_orca(carpeta, "terminal create")) == 2)
        finally:
            sidecar.cerrar()

    # Una credencial en la respuesta del cliente nunca va al agente del proyecto.
    with tempfile.TemporaryDirectory() as home, tempfile.TemporaryDirectory() as carpeta:
        linea_lista(home)
        acepta_proyectos(home, "alfa-demo")
        orca_despacho(carpeta)
        sidecar = SidecarFalso(home)
        try:
            cid = trabajo_firmado(home, "D17")
            tick_orca(home, carpeta)
            js(home, "caso", "resultado", cid, "--estado", "necesita", "--respuesta",
               "¿Con qué usuario entras?", "--resumen", "Falta el usuario", "--actor",
               "trabajador")
            tick_orca(home, carpeta)
            llegan(home, A, [msg(PERSONA, "D17b", "la contraseña es Hunter2xx", 0)])
            tick_orca(home, carpeta)
            ok("una credencial en la respuesta no llega a la terminal del agente",
               not respuestas_a_terminal(carpeta)
               and not any("Hunter2xx" in " ".join(x) for x in llamadas_orca(carpeta))
               and js(home, "caso", "ver", cid)[0]["etapa"] != "trabajo",
               f"{js(home, 'caso', 'ver', cid)[0]['etapa']}")
        finally:
            sidecar.cerrar()


    # Jev retiene la respuesta del resultado: queda el borrador para el dueno, sin firma.
    with tempfile.TemporaryDirectory() as home, tempfile.TemporaryDirectory() as carpeta:
        linea_lista(home)
        acepta_proyectos(home, "alfa-demo")
        orca_despacho(carpeta)
        sidecar = SidecarFalso(home)
        antes_env = dict(os.environ)
        os.environ["WA_INBOX_JEV_ENDPOINT"] = "http://127.0.0.1:9/v1/systemone"
        try:
            pon_llave(home)
            cid = trabajo_firmado(home, "D18")
            tick_orca(home, carpeta)
            hecho = js(home, "caso", "resultado", cid, "--respuesta", "Ya quedó, ¿puedes revisarlo?",
                       "--resumen", "Hecho", "--actor", "trabajador")[0]
            ver = js(home, "caso", "ver", cid)[0]
            req = f"caso-{cid}-{hecho['propuesta_version'][:12]}"
            ok("con Jev sin contestar, el resultado queda retenido: borrador y listo, sin firma",
               ver["etapa"] == "listo" and not ver["aprobada"] and req not in sidecar.entregados
               and [e["estado"] for e in envios(home) if e["req_id"] == req] == ["borrador"]
               and (hecho.get("envio") or {}).get("estado") == "retenido",
               f"{ver['etapa']} {envios(home)} {hecho.get('envio')}")
            p, r = tick_orca(home, carpeta)
            ok("y el tick no lo reintenta: espera al dueno",
               req not in sidecar.entregados and r.get("esperando") == 1, f"{r}")
        finally:
            sidecar.cerrar()
            os.environ.clear()
            os.environ.update(antes_env)

    # Una credencial en la respuesta del resultado tampoco sale.
    with tempfile.TemporaryDirectory() as home, tempfile.TemporaryDirectory() as carpeta:
        linea_lista(home)
        acepta_proyectos(home, "alfa-demo")
        orca_despacho(carpeta)
        sidecar = SidecarFalso(home)
        try:
            cid = trabajo_firmado(home, "D19")
            tick_orca(home, carpeta)
