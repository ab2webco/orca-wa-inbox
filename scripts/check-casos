    # Decision del dueno (2026-10-05): un agente `blocked` avisa igual que uno que espera, por
    # el mismo interruptor, con su propio texto. Esperar y bloquearse en el mismo panel dentro
    # de la ventana es UN aviso, en cualquier orden.
    with tempfile.TemporaryDirectory() as home:
        r = js(home, "orca-aviso", "--state=blocked", "--pane=tab-1:p1",
               f"--at={int(time.time() * 1000)}")
        ok("blocked: la linea de comandos lo acepta, y apagado no encola nada",
           r and r[0].get("reason") == "off" and cuenta(home, "select count(*) from aviso") == 0,
           f"{r}")
    with tempfile.TemporaryDirectory() as home:
        ws, con, enviados, _ = prepara_orca(home, waiting="on")
        at = int(time.time() * 1000)
        r = orca_aviso(ws, con, "tab-1:p1", at, state="blocked")
        t = enviados[0]["texto"] if enviados else ""
        ok("blocked: un agente bloqueado produce un aviso, y sale",
           r.get("queued") is True and len(enviados) == 1, f"{r} {enviados}")
        ok("blocked: el texto dice que esta bloqueado, no que espera",
