       tablero(home).get("board", {}).get("agent_waiting") == 1)


# ── Lo que era la bandeja, en el tablero: atender ya y el proyecto a mano ──────────
# La pestana "Bandeja" se fue. "Tomar" es ahora "Atender ahora" sobre un caso en
# recibido o clasificado: lo marca para el agente, y `pending --needs-agent` lo cuenta.
# El proyecto del caso se elige a mano del catalogo aceptado y deja su evento.
def acepta_proyectos(home, *ids):
    ruta = storage_de(home)
    ruta.parent.mkdir(parents=True, exist_ok=True)
    datos = json.loads(ruta.read_text(encoding="utf-8")) if ruta.exists() else {}
    datos["projects"] = [{"id": i, "name": i.replace("-", " ").title(),
                          "path": f"/srv/ejemplo/{i}", "note": ""} for i in ids]
    ruta.write_text(json.dumps(datos), encoding="utf-8")


print("\natender ahora y el proyecto a mano")
with tempfile.TemporaryDirectory() as home:
    cid = str(js(home, "caso", "crear", "--chat", CHAT, "--stanza", "AT1",
                 "--actor", "automatizacion")[0]["case_id"])
    js(home, "caso", "clasificar", cid, "--clase", "card", "--prioridad", "none",
       "--actor", "jev")
    con = db_de(home)
    con.execute("update caso set jev=?, necesita_agente=0 where case_id=?",
                ('{"attention_class": "pleasantry", "flags": [], "skip": true}', int(cid)))
    con.commit()
    con.close()
    ok("antes: Jev dijo skip, el agente no lo ve", necesita(home).returncode == 1)
    r = js(home, "caso", "atender", cid, "--actor", "dueno")[0]
    ok("atender lo marca para el agente", r["necesita_agente"] == 1, f"{r}")
    p = necesita(home)
    ok("y `pending --needs-agent` lo cuenta en su proxima corrida",
       p.returncode == 0 and int(cid) in json.loads(p.stdout)["cases"], p.stdout)
    ok("deja su evento, firmado por el dueno",
       cuenta(home, "select count(*) from caso_evento where case_id=? and actor='dueno' "
              "and de=a", int(cid)) == 1)
    ok("sin actor no se puede", corre(home, "caso", "atender", cid).returncode != 0)
    t = tarjeta(home, cid)
    ok("la tarjeta dice que espera al agente y ofrece atender e ignorar",
       t and t["needs_agent"] is True and "atender" in t["actions"] and "ignorar" in t["actions"],
       f"{t and t['actions']}")
    ok("y trae su historia, sin el detalle de maquina",
       t and len(t["events"]) >= 3
       and all({"de", "a", "actor", "at"} <= set(e) <= {"de", "a", "actor", "at", "que", "args"}
               and "detalle" not in e for e in t["events"])
       and t["events"][-1]["actor"] == "dueno", f"{t and t['events']}")
    ok("cada evento dice que paso con un codigo, no con el texto (T22)",
       t and t["events"][-1].get("que") == "attend", f"{t and t['events']}")
    js(home, "caso", "propuesta", cid, "--tipo", "responder", "--respuesta", "Hola.",
       "--actor", "agente")
    p = corre(home, "caso", "atender", cid, "--actor", "dueno", "--json")
    ok("con propuesta (decision) ya no se atiende: E_STAGE",
       p.returncode != 0 and "E_STAGE" in p.stderr, p.stderr)

    acepta_proyectos(home, "alfa-demo", "beta-demo")
    r = js(home, "caso", "proyecto", cid, "--proyecto", "beta-demo", "--actor", "dueno")[0]
    ok("el proyecto se pone a mano del catalogo", (r["ruta"] or {}).get("workspace") == "beta-demo",
       f"{r['ruta']}")
    ok("y deja su evento", cuenta(home, "select count(*) from caso_evento where case_id=? "
                                  "and detalle='proyecto beta-demo'", int(cid)) == 1)
    t = tarjeta(home, cid)
    ok("la tarjeta lo trae con su nombre", t and t["project"] == {"id": "beta-demo",
                                                                  "name": "Beta Demo"},
       f"{t and t['project']}")
    p = corre(home, "caso", "proyecto", cid, "--proyecto", "otro-demo", "--actor", "dueno",
              "--json")
    ok("uno fuera del catalogo es E_ARGS y no toca nada",
       p.returncode != 0 and "E_ARGS" in p.stderr and
       tarjeta(home, cid)["project"]["id"] == "beta-demo", p.stderr)
    r = js(home, "caso", "proyecto", cid, "--proyecto", "", "--actor", "dueno")[0]
    ok("con '' queda sin proyecto", (r["ruta"] or {}).get("workspace") is None and
       tarjeta(home, cid)["project"] is None, f"{r['ruta']}")
    js(home, "caso", "mover", cid, "cerrado", "--motivo", "listo", "--actor", "dueno")
    p = corre(home, "caso", "proyecto", cid, "--proyecto", "alfa-demo", "--actor", "dueno",
              "--json")
    ok("un caso cerrado no cambia de proyecto: E_STAGE",
       p.returncode != 0 and "E_STAGE" in p.stderr, p.stderr)

# ── El tick limpia los espacios que dejan las corridas del plugin ─────────────────────
# Orca crea un espacio por corrida de un plugin (`new_per_run`), con una terminal de shell
# adentro, y nunca lo cierra. El tick, a lo mas cada 5 minutos (al minuto si quedan), mira
# `worktree list` y quita todo hijo `::workspace:` de la carpeta del plugin pasada la
# gracia, sea de la automatizacion de ahora o de una que Orca borro y recreo: cierra sus
# terminales, `worktree rm`, y vuelve a listar. Visto en vivo: `rm` dijo `removed: true` y
# el espacio seguia ahi. Nunca la raiz, otro plugin, una corrida en vuelo, ni el espacio
# del agente de casos o de un despacho en vuelo. Todo con una CLI de mentira.
print("\nel tick limpia los espacios del plugin")
CARPETA_PLUGIN = "/srv/demo/plugin-workspaces/ab2web.orca-wa-inbox"
CARPETA_OTRO = "/srv/demo/plugin-workspaces/otro.plugin"
RAIZ_WS = f"repo-demo::{CARPETA_PLUGIN}"
AUTOS_PLUGIN = [
    {"id": "auto-otra", "pluginOrigin": {"pluginKey": "otro.plugin", "automationId": "triage"},
     "runContext": {"kind": "workspace-run", "repoId": "repo-demo", "path": CARPETA_OTRO}},
    {"id": "auto-tick", "pluginOrigin": {"pluginKey": "ab2web.orca-wa-inbox",
                                         "automationId": "tick"},
     "runContext": {"kind": "workspace-run", "repoId": "repo-demo", "path": CARPETA_PLUGIN}},
    {"id": "auto-triage", "pluginOrigin": {"pluginKey": "ab2web.orca-wa-inbox",
                                           "automationId": "triage"},
     "runContext": {"kind": "workspace-run", "repoId": "repo-demo", "path": CARPETA_PLUGIN}}]


def ws(sufijo):
    return f"{RAIZ_WS}::workspace:{sufijo}"


def ms_hace(segundos):
    return int((time.time() - segundos) * 1000)


def wt(sufijo, hace_s=600, carpeta=CARPETA_PLUGIN, raiz=False):
    """Un espacio como lo lista `worktree list`: la raiz de la carpeta o un hijo."""
    ident = f"repo-demo::{carpeta}" + ("" if raiz else f"::workspace:{sufijo}")
    return {"id": ident, "repoId": "repo-demo", "path": carpeta, "isArchived": False,
            "displayName": "WA Inbox (plugin)", "isMainWorktree": False,
            "sortOrder": ms_hace(hace_s), "lastActivityAt": ms_hace(hace_s)}


def term(handle, espacio, hace_s=600):
    return {"handle": handle, "worktreeId": espacio, "liveness": "running",
            "lastOutputAt": ms_hace(hace_s)}


def orca_falso(carpeta, corridas=(), automatizaciones=None, worktrees=None, terminales=(),
               pegados=(), trunca=False):
    """Una `orca` de mentira con estado: `worktree rm` quita el espacio de la lista (salvo
    los `pegados`, que contestan `removed: true` y siguen ahi, como en vivo) y `terminal
    close` quita la terminal. Anota cada llamada en calls.log."""
    carpeta = pathlib.Path(carpeta)
    (carpeta / "estado.json").write_text(json.dumps({
        "automations": AUTOS_PLUGIN if automatizaciones is None else automatizaciones,
        "runs": list(corridas),
        "worktrees": [wt("", raiz=True)] if worktrees is None else list(worktrees),
        "terminals": list(terminales), "pegados": list(pegados), "trunca": trunca}),
        encoding="utf-8")
    exe = carpeta / "orca"
    exe.write_text("""#!/usr/bin/env python3
import json, os, sys
d = os.path.dirname(os.path.abspath(__file__))
a = sys.argv[1:]
open(os.path.join(d, "calls.log"), "a").write(" ".join(a) + "\\n")
ruta = os.path.join(d, "estado.json")
e = json.load(open(ruta))
def valor(flag):
    return a[a.index(flag) + 1] if flag in a else None
def sale(x, code=0):
    json.dump(e, open(ruta, "w"))
    print(json.dumps(x)); sys.exit(code)
clave = " ".join(a[:2])
if clave == "automations list":
    sale({"ok": True, "result": {"automations": e["automations"]}})
if clave == "automations runs":
    sale({"ok": True, "result": {"runs": e["runs"]}})
if clave == "worktree list":
    sale({"ok": True, "result": {"worktrees": e["worktrees"], "totalCount": len(e["worktrees"]),
                                 "truncated": e["trunca"]}})
if clave == "terminal list":
    sale({"ok": True, "result": {"terminals": e["terminals"], "truncated": False}})
if clave == "terminal close":
    e["terminals"] = [t for t in e["terminals"] if t["handle"] != valor("--terminal")]
    sale({"ok": True, "result": {"closed": True}})
if clave == "worktree rm":
    sel = (valor("--worktree") or "")[3:]
    if sel not in e["pegados"]:
        e["worktrees"] = [w for w in e["worktrees"] if w["id"] != sel]
    sale({"ok": True, "result": {"removed": True}})
sale({"ok": False, "error": {"code": "unknown"}}, 1)
""", encoding="utf-8")
    exe.chmod(0o755)
    return exe


def cambia_falso(carpeta, **cambios):
    ruta = pathlib.Path(carpeta) / "estado.json"
    e = json.loads(ruta.read_text(encoding="utf-8"))
    e.update(cambios)
    ruta.write_text(json.dumps(e), encoding="utf-8")


def llamadas(carpeta):
    ruta = pathlib.Path(carpeta) / "calls.log"
    return ruta.read_text(encoding="utf-8").splitlines() if ruta.exists() else []


def quitados(carpeta):
    return [x.split("--worktree id:")[1].split()[0] for x in llamadas(carpeta)
            if x.startswith("worktree rm")]


def quedan(carpeta):
    return [w["id"] for w in json.loads(
        (pathlib.Path(carpeta) / "estado.json").read_text(encoding="utf-8"))["worktrees"]]


def corrida(sufijo, estado, hace_s, raiz=False):
    ms = int((time.time() - hace_s) * 1000)
    return {"id": f"run-{sufijo}", "automationId": "auto-triage", "status": estado,
            "workspaceId": RAIZ_WS if raiz else (None if sufijo == "nulo" else ws(sufijo)),
            "createdAt": ms, "dispatchedAt": ms, "startedAt": ms}


def tick_con(home, carpeta):
    p = corre(home, "tick", extra={"ORCA_CLI_COMMAND": str(pathlib.Path(carpeta) / "orca")})
    return p, (json.loads(p.stdout.strip().splitlines()[-1]) if p.stdout.strip() else {})


def olvida_limpieza(home):
    con = db_de(home)
    con.execute("delete from settings where key='limpieza_at'")
    con.commit()
    con.close()


def adelanta_limpieza(home, segundos):
    con = db_de(home)
    con.execute("update settings set value=cast(value as real) - ? where key='limpieza_at'",
                (segundos,))
    con.commit()
    con.close()


with tempfile.TemporaryDirectory() as home, tempfile.TemporaryDirectory() as carpeta:
    orca_falso(carpeta, corridas=[
        corrida("aaa", "completed", 600), corrida("raiz", "completed", 600, raiz=True),
        corrida("bbb", "dispatched", 600), corrida("pend", "pending", 600),
        corrida("nulo", "completed", 600), corrida("ccc", "completed", 30)],
        worktrees=[wt("", raiz=True), wt("aaa"), wt("bbb"), wt("pend"), wt("ccc", 30),
                   # De una automatizacion que Orca borro y recreo: ninguna corrida los nombra.
                   wt("huerfano-1"), wt("huerfano-2", 3 * 3600), wt("reciente", 30),
                   wt("x1", carpeta=CARPETA_OTRO), wt("activo"), wt("con-shell")],
        terminales=[term("term_activo", ws("activo"), 10),
                    term("term_shell", ws("con-shell"), 900),
                    term("term_raiz", RAIZ_WS, 900)])
    p, r = tick_con(home, carpeta)
    ok("el tick sale 0", p.returncode == 0, p.stderr[-300:])
    ok("quita las corridas terminadas y los hijos de la carpeta que ninguna corrida nombra",
       sorted(quitados(carpeta)) == sorted([ws("aaa"), ws("huerfano-1"), ws("huerfano-2"),
                                            ws("con-shell")]), f"{quitados(carpeta)}")
    ok("nunca la raiz, otro plugin, una corrida en vuelo, ni algo de hace menos de 2 minutos",
       not any(x in quitados(carpeta) for x in (
           RAIZ_WS, wt("x1", carpeta=CARPETA_OTRO)["id"], ws("bbb"), ws("pend"), ws("ccc"),
           ws("reciente"))), f"{quitados(carpeta)}")
    ok("ni un espacio con una terminal que escribio hace poco",
       ws("activo") not in quitados(carpeta)
       and not any("term_activo" in x for x in llamadas(carpeta)), f"{llamadas(carpeta)}")
    orden = [x for x in llamadas(carpeta) if "term_shell" in x or ws("con-shell") in x]
    ok("cierra la terminal del espacio antes de quitarlo",
       len(orden) == 2 and orden[0].startswith("terminal close --terminal term_shell")
       and orden[1].startswith("worktree rm"), f"{orden}")
    ok("la terminal de la raiz no se toca", not any("term_raiz" in x for x in llamadas(carpeta)))
    ok("vuelve a listar despues de quitar: verifica",
       [x.split()[:2] for x in llamadas(carpeta)].count(["worktree", "list"]) == 2
       and llamadas(carpeta)[-1].startswith("worktree list"), f"{llamadas(carpeta)}")
    ok("busca la carpeta en las automatizaciones de ESTE plugin, y las corridas de la suya",
       any(x.startswith("automations runs") and "auto-triage" in x for x in llamadas(carpeta))
       and not any("auto-otra" in x for x in llamadas(carpeta)), f"{llamadas(carpeta)}")
    ok("la linea del tick cuenta lo quitado y no dice nada del espacio",
       r.get("limpiados") == 4 and r.get("limpieza_error") == 0
       and r.get("limpieza_atascados") == 0
       and "huerfano" not in p.stdout and "plugin-workspaces" not in p.stdout, p.stdout[-300:])
    antes = len(llamadas(carpeta))
    p, r = tick_con(home, carpeta)
    ok("un segundo tick enseguida no llama a la CLI", len(llamadas(carpeta)) == antes
       and r.get("limpiados") == 0, f"{len(llamadas(carpeta))} vs {antes}")
    olvida_limpieza(home)
    p, r = tick_con(home, carpeta)
    ok("pasado el plazo vuelve a mirar, y lo que ya no esta no se quita dos veces",
       len(quitados(carpeta)) == 4 and r.get("limpiados") == 0, f"{quitados(carpeta)} {r}")
    # La corrida en vuelo termina, y lo reciente pasa la gracia.
    cambia_falso(carpeta, runs=[corrida("bbb", "completed", 600)],
                 worktrees=[wt("", raiz=True), wt("bbb"), wt("reciente", 600)])
    olvida_limpieza(home)
    p, r = tick_con(home, carpeta)
    ok("lo que termino despues (y paso la gracia) se quita entonces",
       sorted(quitados(carpeta)[4:]) == sorted([ws("bbb"), ws("reciente")])
       and r.get("limpiados") == 2, f"{quitados(carpeta)} {r}")

with tempfile.TemporaryDirectory() as home, tempfile.TemporaryDirectory() as carpeta:
    # Visto en vivo: `rm` contesta `removed: true` y el espacio sigue en la lista.
    orca_falso(carpeta, worktrees=[wt("", raiz=True), wt("pegado"), wt("suelto")],
               pegados=[ws("pegado")])
    p, r = tick_con(home, carpeta)
    ok("un rm que dice ok pero el espacio sigue listado no cuenta como quitado",
       r.get("limpiados") == 1 and r.get("limpieza_error") == 1
       and r.get("limpieza_atascados") == 0 and ws("pegado") in quedan(carpeta), f"{r}")
    olvida_limpieza(home)
    p, r = tick_con(home, carpeta)
    ok("y se reintenta en la vuelta siguiente", quitados(carpeta).count(ws("pegado")) == 2
       and r.get("limpieza_atascados") == 0, f"{quitados(carpeta)} {r}")
    olvida_limpieza(home)
    p, r = tick_con(home, carpeta)
    ok("al tercer intento fallido lo dice en la linea del tick",
       quitados(carpeta).count(ws("pegado")) == 3 and r.get("limpieza_atascados") == 1,
       f"{quitados(carpeta)} {r}")
    atascados = (tablero(home).get("board") or {}).get("workspaces_stuck")
    ok("y el tablero cuenta los espacios que no se pudieron quitar", atascados == 1,
       f"{atascados}")
    olvida_limpieza(home)
    p, r = tick_con(home, carpeta)
    ok("no se rinde: sigue intentando", quitados(carpeta).count(ws("pegado")) == 4
       and r.get("limpieza_atascados") == 1, f"{quitados(carpeta)} {r}")
    cambia_falso(carpeta, pegados=[])
    olvida_limpieza(home)
    p, r = tick_con(home, carpeta)
    ok("cuando por fin se va, cuenta como quitado y deja de decirlo",
       r.get("limpiados") == 1 and r.get("limpieza_atascados") == 0
       and ws("pegado") not in quedan(carpeta)
       and (tablero(home).get("board") or {}).get("workspaces_stuck") == 0, f"{r}")

with tempfile.TemporaryDirectory() as home, tempfile.TemporaryDirectory() as carpeta:
    orca_falso(carpeta, worktrees=[wt("", raiz=True)] + [wt(f"m{i:02d}", 600 + i)
                                                         for i in range(14)])
    p, r = tick_con(home, carpeta)
    ok("no quita mas de 10 por vuelta", len(quitados(carpeta)) == 10
       and r.get("limpiados") == 10, f"{len(quitados(carpeta))} {r}")
    antes = len(llamadas(carpeta))
    tick_con(home, carpeta)
    ok("en el mismo minuto no vuelve", len(llamadas(carpeta)) == antes)
    adelanta_limpieza(home, 61)
    p, r = tick_con(home, carpeta)
    ok("con pendientes vuelve al minuto, no a los 5, y no repite",
       len(quitados(carpeta)) == 14 and len(set(quitados(carpeta))) == 14
       and r.get("limpiados") == 4, f"{quitados(carpeta)} {r}")
    antes = len(llamadas(carpeta))
    adelanta_limpieza(home, 61)
    tick_con(home, carpeta)
    ok("sin pendientes espera los 5 minutos", len(llamadas(carpeta)) == antes,
       f"{llamadas(carpeta)[antes:]}")

with tempfile.TemporaryDirectory() as home, tempfile.TemporaryDirectory() as carpeta:
    # El agente de casos vivo y un despacho en vuelo: su espacio no se toca nunca, aunque
    # sea un hijo de la carpeta y lleve rato quieto.
    orca_falso(carpeta, worktrees=[wt("", raiz=True), wt("agente"), wt("despacho"),
                                   wt("suelto")],
               terminales=[term("term_agente", ws("agente"), 900),
                           term("term_despacho", ws("despacho"), 900)])
    corre(home, "list")
    con = db_de(home)
    momento = time.strftime("%Y-%m-%d %H:%M:%S")
    con.execute("insert into agente_corrida (origen, estado, workspace_selector, terminal, "
                "turno_at, created_at, updated_at) values ('tick', 'activo', ?, 'term_agente', "
                "?, ?, ?)", (f"id:{RAIZ_WS}", momento, momento, momento))
    con.execute("insert into caso_despacho (case_id, evento_id, workspace_selector, terminal, "
                "estado, created_at, updated_at) values (9999, 1, ?, 'term_otro', 'activo', ?, ?)",
                (f"id:{ws('despacho')}", momento, momento))
    con.commit()
    con.close()
    p, r = tick_con(home, carpeta)
    ok("el espacio de la terminal del agente de casos y el de un despacho no se tocan",
       quitados(carpeta) == [ws("suelto")]
       and not any("term_agente" in x or "term_despacho" in x for x in llamadas(carpeta)
                   if not x.startswith("terminal list")), f"{llamadas(carpeta)}")

with tempfile.TemporaryDirectory() as home:
    p = corre(home, "tick")
    r = json.loads(p.stdout.strip().splitlines()[-1])
    ok("sin la CLI de Orca el tick sale 0 y lo cuenta",
       p.returncode == 0 and r.get("limpiados") == 0 and r.get("limpieza_error") == 1,
       f"{p.returncode} {p.stdout[-200:]} {p.stderr[-200:]}")

with tempfile.TemporaryDirectory() as home, tempfile.TemporaryDirectory() as carpeta:
    orca_falso(carpeta, worktrees=[wt("", raiz=True), wt("zzz")], automatizaciones=[
        AUTOS_PLUGIN[0], {"id": "auto-triage", "pluginOrigin": {
            "pluginKey": "ab2web.orca-wa-inbox", "automationId": "triage"}}])
    p, r = tick_con(home, carpeta)
    ok("sin la carpeta del plugin (ninguna automatizacion la dice) no quita nada y sale 0",
       p.returncode == 0 and quitados(carpeta) == [] and r.get("limpiados") == 0,
       f"{quitados(carpeta)} {r}")

with tempfile.TemporaryDirectory() as home, tempfile.TemporaryDirectory() as carpeta:
    orca_falso(carpeta, worktrees=[wt("", raiz=True), wt("zzz")], trunca=True)
    p, r = tick_con(home, carpeta)
    ok("con la lista de espacios incompleta no quita nada y lo cuenta",
       p.returncode == 0 and quitados(carpeta) == [] and r.get("limpieza_error") == 1,
       f"{quitados(carpeta)} {r}")

with tempfile.TemporaryDirectory() as home, tempfile.TemporaryDirectory() as carpeta:
    exe = orca_falso(carpeta, worktrees=[wt("", raiz=True), wt("yyy")])
    exe.write_text("#!/bin/sh\nexit 3\n", encoding="utf-8")
    p, r = tick_con(home, carpeta)
    ok("una CLI que falla deja el tick en 0 y cuenta el error",
       p.returncode == 0 and r.get("limpiados") == 0 and r.get("limpieza_error") >= 1,
       f"{p.returncode} {r}")


# ── "Autorizar": el dueno dice "esto lo puedes ver" ──────────────────────────────────
# Visto en vivo: un caso con credencial y compromiso (un falso positivo: "acceso" era acceso
# a un proyecto) llegaba a decision sin texto. El dueno lo devolvia a clasificado, el agente
# volvia a verlo con las mismas excepciones y volvia a escalarlo. Autorizar le quita las
# excepciones DE ENTRADA al caso (y deja dicho cuales), lo marca para el agente y lo suelta;
# lo que el agente redacte sigue pasando por el piso de salida.
print("\nautorizar: el dueno suelta las excepciones de entrada")


def tablero_de(home, cid):
    corre(home, "tick", "--json")
    return tarjeta(home, cid)


def caso_escalado(home, stanza, excepciones):
    """Un caso en decision con una propuesta `escalar` sin texto y estas excepciones."""
    cid = str(js(home, "caso", "crear", "--chat", CHAT, "--stanza", stanza,
                 "--actor", "automatizacion")[0]["case_id"])
    js(home, "caso", "clasificar", cid, "--clase", "card", "--prioridad", "none",
       "--actor", "jev")
    js(home, "caso", "propuesta", cid, "--tipo", "escalar", "--actor", "agente")
    con = db_de(home)
    con.execute("update caso set excepciones=?, necesita_agente=1 where case_id=?",
                (json.dumps(excepciones), int(cid)))
    con.commit()
    con.close()
    return cid


with tempfile.TemporaryDirectory() as home:
    js(home, "set", CHAT, "--provider", "plane", "--target", "SOP", "--mode", "responder")
    cid = caso_escalado(home, "AU1", ["credential", "commitment"])
    ok("la tarjeta ofrece Autorizar solo con excepciones",
       "autorizar" in tablero_de(home, cid)["actions"]
       and "autorizar" not in tablero_de(home, caso_en_decision(home, "AU0")[0])["actions"],
       f"{tablero_de(home, cid)['actions']}")
    p = corre(home, "caso", "autorizar", cid, "--actor", "agente")
    ok("solo lo autoriza el dueno: E_ARGS", error_de(p) == "E_ARGS", error_de(p))
    r = js(home, "caso", "autorizar", cid, "--actor", "dueno")[0]
    ok("el caso vuelve a clasificado, sin excepciones y marcado para el agente",
       r["etapa"] == "clasificado" and not json.loads(fila_de(home, int(cid))["excepciones"] or "[]")
       and r["necesita_agente"] == 1 and r["propuesta"] is None, f"{r}")
    ver = js(home, "caso", "ver", cid)[0]
    ev = [e for e in ver["eventos"] if e["actor"] == "dueno"][-1]
    ok("el evento dice cuales dispenso",
       ev["de"] == "decision" and ev["a"] == "clasificado" and "credential" in ev["detalle"]
       and "commitment" in ev["detalle"], f"{ev}")
    ok("el agente lo ve, y el tick no lo devuelve al dueno",
       int(cid) in para_el_agente(home), f"{para_el_agente(home)}")
    corre(home, "tick", "--json")
    ok("tras el tick sigue en clasificado", tablero_de(home, cid)["stage"] == "clasificado")
    # Sin excepciones, o fuera de decision, no hay nada que autorizar.
    p = corre(home, "caso", "autorizar", cid, "--actor", "dueno")
    ok("lo que ya no esta en decision no se autoriza: E_STAGE", error_de(p) == "E_STAGE",
       error_de(p))

    # Lo que el agente redacta tras autorizar sigue pasando por el piso de salida.
    v = js(home, "caso", "propuesta", cid, "--tipo", "responder", "--respuesta",
           "Lo entregamos manana a las 10.", "--actor", "agente")[0]["propuesta_version"]
    # T22.3: la excepcion de la respuesta se ve en la tarjeta y no se pega al caso.
    ok("una respuesta con compromiso vuelve a traer su excepcion y espera al dueno",
       "commitment" in tablero_de(home, cid)["exceptions"],
       f"{tablero_de(home, cid)['exceptions']}")
    ok("y la regla no la firma por su cuenta",
       error_de(corre(home, "caso", "aprobar", cid, "--version", v, "--actor", "regla"))
       == "E_EXCEPTION")

