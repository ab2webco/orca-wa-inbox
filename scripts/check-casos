        ("lo necesito para mañana el viernes", "entrada", []),
        ("can you have it by Friday?", "entrada", [])):
    salio = reglas.excepciones(texto, direccion)
    ok(f"{direccion}: {texto!r} -> {esperado}", salio == esperado, f"salio {salio}")


def _da_error(f):
    try:
        f()
    except ValueError:
        return True
    return False


ok("una direccion desconocida levanta ValueError",
   _da_error(lambda: reglas.excepciones("x", "otra")))

# El control destructivo: un valor con forma de secreto. Es lo unico que ningun nivel de
# un chat ni el dueno apagan en lo que sale (T22.1).
for texto, esperado in (("la clave: Abc12345", True),
                        ("ahi va el token ghp_abcdefghijklmnop1234", True),
                        ("el código de verificación es 482913", True),
                        ("te mando la clave por otro medio", False),
                        ("¿Me mandas la URL?", False),
                        ("", False), (None, False)):
    ok(f"secreto: {texto!r} -> {esperado}", reglas.secreto(texto) is esperado,
       f"salio {reglas.secreto(texto)}")


def fila_caso(home, cid):
    return dict(db_de(home).execute("select * from caso where case_id=?",
                                    (int(cid),)).fetchone())


def excepciones_de(home, cid):
    valor = fila_caso(home, cid)["excepciones"]
    return json.loads(valor) if valor else []


print("\nel piso fijo: entrada, propuesta y aprobacion por regla, sin Jev")
