        ws.tick_orca(con, {})
        ws.envia_avisos(con)
        t = enviados[0]["texto"] if enviados else ""
        ok("O4: un turno que termino hace mas que la espera avisa, uno solo",
           len(enviados) == 1 and "termin" in t and "alfa-demo" in t and "codex" in t
           and enviados[0]["req"].startswith("aviso-o-termino-"), f"{enviados}")
        ok("O4: ni el que termino hace menos de la espera, ni un done sin trabajo, ni el que "
           "volvio a trabajar, ni uno viejo", len(enviados) == 1)
        pon_paneles(home, {"pB": dict(base, state="done", at=ahora_ms - 10000 - 35000,
                                      finished=True),
                           "pA": dict(base, state="done", at=ahora_ms - 60000, finished=True)})
        ws.tick_orca(con, {})
        ws.envia_avisos(con)
        ok("O4: pasada la espera sale el otro, y el primero no se repite", len(enviados) == 2,
           f"{enviados}")
        pon_orca(home, finished="off")
        pon_paneles(home, {"pF": dict(base, state="done", at=ahora_ms - 60000, finished=True)})
        ws.tick_orca(con, {})
        ws.envia_avisos(con)
        ok("O4: con el aviso apagado no sale", len(enviados) == 2)
        con.close()

    # O5: las automatizaciones que fallaron, con la marca de agua.
    with tempfile.TemporaryDirectory() as home:
        ws, con, enviados, falsa = prepara_orca(home, automationFailed="on")
        ahora_ms = int(time.time() * 1000)
        falsa.runs = [{"id": "run-viejo", "title": "Reporte diario #3", "status": "dispatch_failed",
                       "error": "viejo", "createdAt": ahora_ms - 3600000}]
        ws.tick_orca(con, {})
        ws.envia_avisos(con)
        marca = con.execute("select value from settings where key='orca_runs_desde'").fetchone()
        ok("O5: la primera vuelta solo pone la marca: nada de fallas viejas",
           enviados == [] and marca is not None, f"{enviados} {marca}")
        falsa.runs += [
            {"id": "run-1", "title": "Reporte diario #4", "status": "dispatch_failed",
             "error": "Workspace not found at /Users/ejemplo/proyecto/x; retry later",
             "createdAt": ahora_ms + 1000},
            {"id": "run-2", "title": "Limpieza #9", "status": "completed",
             "createdAt": ahora_ms + 2000},
            {"id": "run-3", "title": "Copia nocturna #2", "status": "command_failed",
             "commandResult": {"exitCode": 2, "timedOut": False, "stdout": "SALIDA-DE-TERMINAL",
                               "stderr": "password: Abc12345", "command": "rsync /srv/x"},
             "createdAt": ahora_ms + 3000},
            {"id": "run-4", "title": "Indexado #1", "status": "completed",
             "commandResult": {"exitCode": None, "timedOut": True, "stdout": "", "stderr": ""},
             "createdAt": ahora_ms + 4000},
            {"id": "run-5", "title": "Revisión #7", "status": "skipped_precheck",
             "createdAt": ahora_ms + 5000}]
        ws.tick_orca(con, {})
        ws.envia_avisos(con)
        textos = [e["texto"] for e in enviados]
        ok("O5: una falla de despacho, un comando que salio mal y uno que se paso del tiempo, "
           "uno cada uno", len(enviados) == 3 and all(e["req"].startswith("aviso-o-fallo-")
                                                      for e in enviados), f"{textos}")
        ok("O5: con el titulo y el error recortado, sin la ruta",
           any("Reporte diario #4" in t and "Workspace not found" in t and "/Users" not in t
               for t in textos), f"{textos}")
        ok("O5: un comando que fallo dice su codigo y nunca lo que salio en la terminal",
           any("Copia nocturna #2" in t and "2" in t for t in textos)
           and not any("SALIDA" in t or "Abc12345" in t or "rsync" in t for t in textos),
           f"{textos}")
        ok("O5: ni lo que se completo ni lo que se salto", not any(
            "Limpieza" in t or "Revisión" in t for t in textos), f"{textos}")
        ws.tick_orca(con, {})
        ws.envia_avisos(con)
        ok("O5: otra vuelta no repite", len(enviados) == 3)
        pon_orca(home, automationFailed="off")
        ws.tick_orca(con, {})
        ok("O5: apagado, la marca se borra: al volver a encenderlo no llegan las de antes",
           con.execute("select 1 from settings where key='orca_runs_desde'").fetchone() is None)
        con.close()

    # Con todo apagado (de fabrica) nada cambia: ni avisos ni llamadas a Orca.
    with tempfile.TemporaryDirectory() as home:
        ws, con, enviados, falsa = prepara_orca(home)
        ahora_ms = int(time.time() * 1000)
        pon_paneles(home, {"pA": {"state": "done", "at": ahora_ms - 60000, "finished": True,
                                  "worktreeId": WT_ALFA}})
        falsa.runs = [{"id": "r", "title": "X", "status": "dispatch_failed", "error": "e",
                       "createdAt": ahora_ms}]
        ws.tick_orca(con, {})
        ws.tick_orca(con, {})
        ws.envia_avisos(con)
        ok("todo apagado: ningun aviso, ninguna llamada a Orca, ninguna fila",
           enviados == [] and falsa.llamadas == []
           and con.execute("select count(*) from aviso").fetchone()[0] == 0,
           f"{enviados} {falsa.llamadas}")
        ok("el tick llama a los avisos de Orca antes de mandar los avisos",
           "tick_orca_si_toca(con" in inspect.getsource(ws.cmd_tick)
           and inspect.getsource(ws.cmd_tick).index("tick_orca_si_toca(con")
           < inspect.getsource(ws.cmd_tick).index("tick_avisos(con"))
        con.close()
finally:
    os.environ.clear()
    os.environ.update(env_orca)


# ── L3. Varias lineas a la vez (odd/tasks/varias-lineas-y-segundo-cerebro.md) ────────────
# Dos lineas vinculadas a la vez, la misma conversacion en las dos y un mensaje en cada una.
# Sin `WA_INBOX_LINEA`, la entrada y el tick corren una vez por linea, cada una en su proceso
# y con su candado; nada cruza: ni el permiso, ni el caso, ni la aprobacion, ni el envio,
# ni el tablero que lee el panel.
SUMA_LINEA_JS = """
import { abrirAlmacen, rutaAlmacen } from %r;
const a = abrirAlmacen(rutaAlmacen({ HOME: process.env.HOME }));
const d = JSON.parse(process.env.DATOS);
if (d.retirar) a.retirarLinea(d.cuenta); else a.sumarLinea(d.cuenta);
a.cerrar();
""" % (RAIZ / "sidecar" / "src" / "almacen.js").as_uri()


def suma_linea(home, cuenta, retirar=False):
    """Lo que hace el sidecar de una linea que no es la principal (o desvincularla)."""
    env = dict(os.environ, HOME=str(home), DATOS=json.dumps({"cuenta": cuenta,
                                                             "retirar": retirar}))
    subprocess.run([NODE, "--input-type=module", "-e", SUMA_LINEA_JS], env=env, check=True,
                   capture_output=True, timeout=120)


def jsl(home, linea, *args):
    """`js` en una linea nombrada, como la corre el proceso de esa linea."""
    p = corre(home, *args, extra={"WA_INBOX_LINEA": linea})
    if p.returncode != 0:
        raise AssertionError(f"wa-scope {' '.join(args)} en {linea} salio {p.returncode}: "
                             f"{p.stderr.strip() or p.stdout.strip()}")
    return json.loads(p.stdout or "[]")


class SidecarDeLinea(SidecarFalso):
    """El sidecar de UNA linea: late y entrega solo lo encolado para su numero, como
    `atenderSalida` con `cuenta`."""

    def __init__(self, home, linea):
        self.linea = linea
        super().__init__(home)

    def _vuelta(self):
        con = sqlite3.connect(self.ruta, timeout=10)
        while not self.parar.is_set():
            ahora = int(time.time())
            con.execute("insert into store_meta (key, value) values ('sidecar_beat', ?) "
                        "on conflict(key) do update set value=excluded.value", (str(ahora),))
            con.commit()
            for (req,) in con.execute("select req_id from envio where estado='pendiente' "
                                      "and account=?", (self.linea,)).fetchall():
                cur = con.execute("update envio set estado='enviado', stanza_id=?, "
                                  "settled_at=? where req_id=? and estado='pendiente'",
                                  (f"STANZA-{req}", ahora, req))
                con.commit()
                if cur.rowcount == 1:
                    self.entregados.append(req)
            time.sleep(0.05)
        con.close()


def modos(filas):
    return {f["chat_jid"]: f["mode"] for f in filas}


