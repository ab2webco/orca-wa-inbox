    # O6: las horas de silencio y el resumen al terminar.
    with tempfile.TemporaryDirectory() as home:
        ws, con, enviados, _ = prepara_orca(home, waiting="on", quietStart="22:00",
                                            quietEnd="07:00")
        for m, esperado in ((23 * 60, True), (3 * 60, True), (6 * 60 + 59, True),
