#!/usr/bin/env python3
"""Las cinco copias del resolvedor siguen siendo la misma, y salen de un solo texto.

El resolvedor —el que decide DE CUAL instalacion salen wa-scope, wa-read y wa-send— vive
inlineado en cinco lugares: los dos `precheck` de `orca-plugin.json`, los dos de
`automations/` y el bloque de cada prompt. No es pereza: un precheck es una cadena de
shell dentro de un JSON y un prompt es texto que lee un modelo; ninguno de los dos puede
importar un archivo. Lo que no se puede evitar se comprueba.

Existe porque la duplicacion ya cobro: una correccion aplicada a cuatro copias se ve
perfecta en el diff y falla en la quinta, y la quinta es la que corre en la maquina del
usuario. Peor todavia: las copias ya habian divergido solas —los prompts ordenaban de una
forma y los precheck de otra— y nadie lo vio, porque nada las comparaba.

La copia editable es `scripts/resolver.py`, y ademas corre sola: `python3
scripts/resolver.py` imprime el bin que elegiria en esta maquina. De ahi se derivan las
dos formas publicadas:

  - prompts: el texto tal cual, con comentarios. El agente los lee y le sirven.
  - precheck: el mismo texto sin comentarios ni lineas en blanco. La cadena de shell del
    JSON ya es incomoda de por si, y ahi los comentarios no los lee nadie.
"""
import json
import pathlib
import re
import sys

RAIZ = pathlib.Path(__file__).resolve().parent.parent
CANONICO = RAIZ / "scripts" / "resolver.py"

# El precheck mete el resolvedor entero dentro de un `python3 -c "..."` en una linea de
# shell. Cualquiera de estos cuatro caracteres lo partiria ahi, y el sintoma no seria un
# error claro sino un WA vacio en una corrida automatica que nadie mira.
PROHIBIDOS = ('"', "$", "`", "\\")

# Lo que cada automation corre DESPUES de resolver. Es lo unico que las distingue: si
# alguna vez dos prechecks se diferencian en algo mas, es que el resolvedor divergio.
COLAS = {
    "triage": '"$WA/wa-scope" pending',
    "take": '"$WA/wa-scope" pending --only-taken',
}
ARCHIVO_POR_AUTOMATION = {
    "triage": "whatsapp-triage.json",
    "take": "whatsapp-tomar-lo-marcado.json",
}

HEREDOC = re.compile(r"WA=\$\(python3 - <<'PY'\n([\s\S]*?)\nPY\n\)")


def sin_comentarios(texto: str) -> str:
    """El resolvedor como lo lleva el precheck: solo codigo."""
    return "\n".join(l for l in texto.splitlines()
                     if l.strip() and not l.lstrip().startswith("#"))


def precheck_esperado(compacto: str, cola: str) -> str:
    return f'WA=$(python3 -c "{compacto}") && [ -x "$WA/wa-scope" ] || exit 1; {cola}'


def main() -> int:
    fallos = []
    comprobaciones = 0

    canonico = CANONICO.read_text(encoding="utf-8").rstrip("\n")

    # ── 1. El canonico es Python de verdad. Un error de sintaxis aca se publica a las
    # cinco copias de un golpe y solo aparece en la primera corrida automatica.
    comprobaciones += 1
    try:
        compile(canonico, str(CANONICO), "exec")
    except SyntaxError as error:
        fallos.append(f"scripts/resolver.py no compila: linea {error.lineno}: {error.msg}")
        # Sin canonico valido, comparar las copias contra el no dice nada util.
        print("El resolvedor no se puede publicar:", file=sys.stderr)
        for f in fallos:
            print(f"  {f}", file=sys.stderr)
        return 1

    # ── 2. Los cuatro caracteres que no sobreviven al viaje por el precheck.
    comprobaciones += 1
    presentes = [c for c in PROHIBIDOS if c in canonico]
    if presentes:
        fallos.append(f"scripts/resolver.py usa {presentes}, que parten el "
                      f"`python3 -c` del precheck")

    # ── 3. La identidad anterior no vuelve por la puerta de atras. En los comentarios
    # si se nombra —ahi es la explicacion de por que no se resuelve— pero en el codigo
    # significaria volver a resolver hacia la build 3.0.1, que manda WhatsApp
    # conduciendo la app de escritorio por un camino que este plugin borro.
    compacto = sin_comentarios(canonico)
    comprobaciones += 1
    if "ab2web.wa-inbox" in compacto:
        fallos.append("scripts/resolver.py vuelve a buscar ab2web.wa-inbox: esa no es "
                      "una version vieja, es otro producto")

    # ── 4. Los dos precheck del manifiesto, que es lo que corre en la instalacion.
    manifiesto = json.loads((RAIZ / "orca-plugin.json").read_text(encoding="utf-8"))
    automations = manifiesto["contributes"]["automations"]
    comprobaciones += 1
    if {a["id"] for a in automations} != set(COLAS):
        fallos.append(f"orca-plugin.json ya no declara las automations {sorted(COLAS)}: "
                      f"este chequeo estaria mirando nada")
        automations = []
    for auto in automations:
        comprobaciones += 1
        esperado = precheck_esperado(compacto, COLAS[auto["id"]])
        if auto["precheck"] != esperado:
            fallos.append(f"orca-plugin.json ({auto['id']}): el precheck no es el "
                          f"resolvedor de scripts/resolver.py")

        # ── 5. La copia versionada en automations/, que es de donde se crean.
        f = RAIZ / "automations" / ARCHIVO_POR_AUTOMATION[auto["id"]]
        comprobaciones += 1
        try:
            copia = json.loads(f.read_text(encoding="utf-8"))["precheck"]
        except (OSError, ValueError, KeyError) as error:
            fallos.append(f"automations/{f.name}: no se pudo leer el precheck ({error})")
            continue
        if copia != esperado:
            fallos.append(f"automations/{f.name}: el precheck no es el resolvedor de "
                          f"scripts/resolver.py")

    # ── 6. Los dos prompts, que llevan el texto completo con sus comentarios.
    prompts = sorted((RAIZ / "prompts").glob("*.md"))
    comprobaciones += 1
    if not prompts:
        fallos.append("prompts/  no hay ningun prompt que revisar")
    for ruta in prompts:
        cuerpo = ruta.read_text(encoding="utf-8")
        bloques = HEREDOC.findall(cuerpo)
        comprobaciones += 1
        if len(bloques) != 1:
            fallos.append(f"{ruta.relative_to(RAIZ)}: {len(bloques)} bloques que "
                          f"resuelven el bin, tiene que haber exactamente uno")
            continue
        if bloques[0] != canonico:
            fallos.append(f"{ruta.relative_to(RAIZ)}: el bloque que resuelve el bin no "
                          f"es scripts/resolver.py")

    if fallos:
        print("Las copias del resolvedor divergieron:", file=sys.stderr)
        for f in dict.fromkeys(fallos):
            print(f"  {f}", file=sys.stderr)
        print("\nEditar scripts/resolver.py y volver a publicarlo en las cinco copias. "
              "Una copia con su propio criterio es como el agente termino mandando un "
              "WhatsApp con las herramientas de otra instalacion.", file=sys.stderr)
        return 1
    print(f"{comprobaciones} comprobaciones: las 5 copias del resolvedor salen de "
          f"scripts/resolver.py")
    return 0


if __name__ == "__main__":
    sys.exit(main())
