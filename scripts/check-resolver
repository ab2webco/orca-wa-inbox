#!/usr/bin/env python3
"""Las herramientas del plugin salen de UNA forma, `.wa-bin` con respaldo en el puntero
estable `bin-path`, y todo lo que la lee dice lo mismo.

El resolvedor de cinco copias (dos en `orca-plugin.json`, dos en `automations/` y el
bloque del prompt) se fue: ver `scripts/resolver_formas.py`. Lo que se comprueba ahora es
que quedo UNA forma corta en esos mismos cinco lugares, que el worker de verdad siembra
el archivo, y que ninguno tiene un camino por `PATH`: un `wa-scope` pelado puede ser una
copia vieja que lee otra base, que es como el agente del dueno llego a mandar un WhatsApp
con herramientas de otra instalacion.
"""
import json
import pathlib
import re
import sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
from resolver_formas import COLAS, RAIZ, bloque_prompt, comando

# orca-oss/src/shared/plugins/plugin-automation-contribution.ts:43 y :57: el techo del
# `command` y del `precheck`. Pasarse invalida el manifiesto entero, no solo la automation.
TECHO = 1024
ARCHIVO_POR_AUTOMATION = {"triage": "whatsapp-triage.json", "tick": "whatsapp-tick.json"}
BLOQUE = re.compile(r"```sh\n(WA=[\s\S]*?)\n```")


def campo(auto: dict) -> str:
    return "command" if "command" in auto else "precheck"


def main() -> int:
    fallos = []
    n = 0

    manifiesto = json.loads((RAIZ / "orca-plugin.json").read_text(encoding="utf-8"))
    automations = manifiesto["contributes"]["automations"]
    n += 1
    if {a["id"] for a in automations} != set(COLAS):
        fallos.append(f"orca-plugin.json ya no declara las automations {sorted(COLAS)}")
        automations = []
    for auto in automations:
        esperado = comando(COLAS[auto["id"]])
        n += 4
        if auto.get(campo(auto)) != esperado:
            fallos.append(f"orca-plugin.json ({auto['id']}): el {campo(auto)} no es la forma "
                          f"de scripts/resolver_formas.py")
        if len(esperado) > TECHO:
            fallos.append(f"el {campo(auto)} de {auto['id']} mide {len(esperado)} y Orca "
                          f"acepta {TECHO}")
        if auto.get("workspace") != "plugin-owned":
            fallos.append(f"{auto['id']}: ya no corre en la carpeta del plugin, y `.wa-bin` "
                          f"vive ahi (`workspace: plugin-owned`)")
        f = RAIZ / "automations" / ARCHIVO_POR_AUTOMATION[auto["id"]]
        try:
            copia = json.loads(f.read_text(encoding="utf-8"))[campo(auto)]
        except (OSError, ValueError, KeyError) as error:
            fallos.append(f"automations/{f.name}: no se pudo leer ({error})")
            continue
        if copia != esperado:
            fallos.append(f"automations/{f.name}: no es la forma de scripts/resolver_formas.py")

    for ruta in sorted((RAIZ / "prompts").glob("*.md")):
        cuerpo = ruta.read_text(encoding="utf-8")
        bloques = BLOQUE.findall(cuerpo)
        n += 3
        if len(bloques) != 1 or bloques[0] != bloque_prompt():
            fallos.append(f"{ruta.relative_to(RAIZ)}: tiene que haber exactamente un bloque "
                          f"que resuelve el bin y ser el de scripts/resolver_formas.py")
        if "python3 -" in cuerpo or "devPluginPaths" in cuerpo:
            fallos.append(f"{ruta.relative_to(RAIZ)}: volvio el resolvedor inlineado")
        if "Never fall back to a bare `wa-scope` from PATH" not in cuerpo:
            fallos.append(f"{ruta.relative_to(RAIZ)}: ya no prohibe el `wa-scope` pelado de PATH")

    # Y el worker de verdad escribe los dos archivos que todo esto lee.
    n += 3
    arnes = (RAIZ / "harness.mjs").read_text(encoding="utf-8")
    if "ARCHIVO_BIN = '.wa-bin'" not in arnes or "sembrarBin(" not in arnes:
        fallos.append("harness.mjs ya no siembra `.wa-bin`: nadie escribiria la ruta que "
                      "las automations leen")
    if "ARCHIVO_BIN_ESTABLE = 'bin-path'" not in arnes or "sembrarBinEstable(" not in arnes:
        fallos.append("harness.mjs ya no deja `bin-path`: el respaldo de las automations "
                      "leeria un archivo que nadie escribe")
    if "ab2web.wa-inbox" in (RAIZ / "orca-plugin.json").read_text(encoding="utf-8"):
        fallos.append("orca-plugin.json nombra ab2web.wa-inbox: esa no es una version vieja, "
                      "es otro producto")

    if fallos:
        print("Las herramientas ya no salen de una sola fuente:", file=sys.stderr)
        for f in dict.fromkeys(fallos):
            print(f"  {f}", file=sys.stderr)
        return 1
    print(f"{n} comprobaciones: las herramientas salen de `.wa-bin` o de `bin-path`, con una "
          f"sola forma en el manifiesto, `automations/` y el prompt")
    return 0


if __name__ == "__main__":
    sys.exit(main())
