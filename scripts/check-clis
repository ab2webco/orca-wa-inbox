#!/usr/bin/env python3
"""Los cuatro CLI arrancan de verdad, y los ajustes validan lo que guardan.

Existe porque `npm run check` dejo pasar un NameError en wa-transcribe: probaba
los paneles y las pruebas jsdom, y ninguna de las dos ejecuta un CLI. Compilar no
alcanza — un import que falta solo aparece al recorrer esa rama — asi que aca se
corre cada herramienta.
"""
import importlib.machinery
import importlib.util
import json
import pathlib
import sqlite3
import subprocess
import sys
import tempfile
import time

RAIZ = pathlib.Path(__file__).resolve().parent.parent
BIN = RAIZ / "bin"

# Solo lecturas: nada que escriba, mande un mensaje ni toque WhatsApp.
# El tercer campo dice si el caso corre con HOME propio. `wa-scope` abre su base al
# arrancar y la migra si hace falta, asi que correrlo con el HOME de verdad hace que
# un chequeo — algo que se corre a cada rato y sin pensarlo — le toque el registro real
# al usuario. Lo de `wa-read` si va contra el equipo de verdad: solo lee, y es lo unico
# que recorre la base de WhatsApp y comprueba que se pueda abrir.
CASOS = [
    ("wa-read", ["doctor", "--json"], False),
    ("wa-scope", ["config", "--json"], True),
    # Con un nombre en vez de un JID, wa-scope tiene que preguntarle a wa-read.
    # Ese camino llamaba a ~/tools/wa-read — una ruta fuera del plugin — y reventaba
    # sin que ningun chequeo lo viera, porque los otros casos no lo recorren.
    ("wa-scope", ["voice", "un-nombre-que-no-existe", "--json"], True),
    # El listado de cierres pendientes toca la migracion y la linea de corte: si esa
    # rama revienta, el agente deja de avisar cierres y nada mas lo delata.
    ("wa-scope", ["closing", "--json"], True),
    # El registro de lineas toca la migracion a (cuenta, jid): si esa rama revienta,
    # el alcance entero deja de leerse.
    ("wa-scope", ["accounts", "--json"], True),
    # El rastro de la corrida sobre una base recien creada: es la rama que contesta
    # "nunca corrio", y es justo la que nadie ejecuta a mano.
    ("wa-scope", ["run", "--json"], True),
    ("wa-transcribe", ["--check", "--json"], False),
    ("wa-send", ["--help"], False),
]


# El esquema whatsapp:// solo direcciona telefonos. Que un JID de grupo NO salga por
# ahi no es un detalle: WhatsApp lo lee como numero, no lo encuentra y levanta una hoja
# modal que tapa la ventana entera y deja clavada la corrida siguiente. Esta tabla es
# la que sostiene ese "falla cerrado", asi que se recorre entera.
# Los JID de aqui son inventados a proposito: el 555 esta reservado para ejemplos y los
# demas son ceros. Un chequeo no puede llevar el telefono ni los grupos de quien lo
# escribio — el plugin se instala en maquinas ajenas y esto viaja con el.
TELEFONOS = [
    ("15550000000@s.whatsapp.net", "15550000000"),   # directo: unico caso que sirve
    ("100000000000000000@g.us", None),               # grupo moderno
    ("15550000000-1000000000@g.us", None),           # grupo viejo, con guion
    ("100000000000000@lid", None),                   # identidad enlazada
    ("15550000001@status", None),                    # estados, no es un chat
    ("no-es-un-numero@s.whatsapp.net", None),
    ("15550000000", None),                           # sin dominio no se puede afirmar
    (None, None),
]

# Arboles reales de la app, capturados con `orca computer get-app-state`. WhatsApp usa
# la MISMA hoja modal para avisar un error y para mostrar que esta navegando; lo unico
# que las separa es el boton. Tomar la de progreso por un error abortaba toda apertura
# por URL, y tomar la de error por progreso deja la app clavada. Por eso se comprueban
# las dos.
HOJA_PROGRESO = """App=net.whatsapp.WhatsApp (pid 88122)
Window: "\u200eWhatsApp", App: \u200eWhatsApp.

0 ventana est\u00e1ndar \u200eWhatsApp
\t1 container, Secondary Actions: cancel
\t6 hoja aviso
\t\t7 texto, Value: \u200eIniciando chat
\t\t8 texto
\t\t9 bot\u00f3n \u200eCancelar
"""

HOJA_ERROR = """App=net.whatsapp.WhatsApp (pid 88122)
Window: "\u200eWhatsApp", App: \u200eWhatsApp.

0 ventana est\u00e1ndar \u200eWhatsApp
\t1 container, Secondary Actions: cancel
\t6 hoja aviso
\t\t7 texto, Value: \u200eEl n\u00famero de tel\u00e9fono +100000000000000000 no existe en WhatsApp.
\t\t8 texto
\t\t9 bot\u00f3n \u200eOK
"""

ARBOL_NORMAL = """App=net.whatsapp.WhatsApp (pid 88122)
Window: "\u200eWhatsApp", App: \u200eWhatsApp.

0 ventana est\u00e1ndar \u200eWhatsApp
\t28 container Lista de chats, Secondary Actions: cancel, scroll down, scroll up
\t\t48 texto (selected) \u200eGrupo de ejemplo, Secondary Actions: cancel
\t61 container Mensajes en el chat con Grupo de ejemplo, Secondary Actions: cancel
\t76 campo de texto Escribir mensaje
"""


def modulo_wa_send():
    """wa-send no tiene extension .py, asi que se carga por ruta. Se importa en vez de
    reimplementar la tabla: lo que se comprueba tiene que ser el codigo que corre."""
    ruta = str(BIN / "wa-send")
    # Importar deja un __pycache__ al lado del CLI. El repo no tiene por que cargar con
    # eso solo porque un chequeo lo leyo.
    sys.dont_write_bytecode = True
    spec = importlib.util.spec_from_loader(
        "wa_send", importlib.machinery.SourceFileLoader("wa_send", ruta))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def revisa_wa_send(fallos: list) -> int:
    """Recorre la eleccion de via y la lectura de hojas modales. Devuelve cuantas corrio.

    Nada de esto abre WhatsApp: son las decisiones que se toman antes de tocarlo, que es
    justo donde un error manda el mensaje a la conversacion equivocada.
    """
    hechas = 0
    try:
        wa = modulo_wa_send()
    except Exception as error:            # noqa: BLE001 - el motivo va en el reporte
        fallos.append(f"wa-send: no se pudo importar — {error}")
        return hechas

    for jid, esperado in TELEFONOS:
        hechas += 1
        quedo = wa.phone_of(jid)
        if quedo != esperado:
            fallos.append(f"wa-send phone_of({jid!r}) dio {quedo!r} y tenia que dar "
                          f"{esperado!r}")

    # La hoja de error se reconoce Y se puede cerrar: hace falta el indice del boton.
    hechas += 1
    node, texto, ok = wa.alert(HOJA_ERROR)
    if node is None or ok is None or "no existe en WhatsApp" not in (texto or ""):
        fallos.append(f"wa-send alert() no leyo la hoja de error: {(node, texto, ok)!r}")

    # La de progreso se ve, pero sin boton de aceptar: hay que seguir esperando, no abortar.
    hechas += 1
    node, texto, ok = wa.alert(HOJA_PROGRESO)
    if node is None or ok is not None:
        fallos.append(f"wa-send alert() confundio la hoja de progreso: {(node, texto, ok)!r}")

    # Y un arbol sano no puede parecer una hoja modal, o no se abre ningun chat nunca.
    hechas += 1
    if wa.alert(ARBOL_NORMAL)[0] is not None:
        fallos.append("wa-send alert() vio un aviso en un arbol normal")

    # El nombre del chat sale del mismo arbol en las dos vias: es lo que compara el guard.
    hechas += 1
    if wa.current_chat(ARBOL_NORMAL) != "Grupo de ejemplo":
        fallos.append(f"wa-send current_chat() dio {wa.current_chat(ARBOL_NORMAL)!r}")

    # Una via que no existe se rechaza en la linea de comandos, no adentro.
    hechas += 1
    p = subprocess.run([str(BIN / "wa-send"), "--open", "telepatia", "x", "y"],
                       capture_output=True, text=True, timeout=120)
    if p.returncode == 0:
        fallos.append("wa-send acepto un --open que no existe")

    # `--open url` contra algo que no es un chat directo tiene que morir ANTES de tocar
    # WhatsApp. Corre con HOME propio a proposito: asi la busqueda del JID no llega nunca
    # al contenedor protegido de WhatsApp, que es una carpeta que macOS pregunta antes de
    # abrir. Un chequeo que corre a cada rato no puede ser lo que dispare ese permiso.
    hechas += 1
    with tempfile.TemporaryDirectory() as tmp:
        p = subprocess.run(
            [str(BIN / "wa-send"), "--open", "url", "grupo-que-no-existe", "texto", "--raw"],
            capture_output=True, text=True, env=entorno(pathlib.Path(tmp)), timeout=120)
        if p.returncode == 0 or "whatsapp://" not in (p.stderr + p.stdout):
            fallos.append(f"wa-send --open url no fallo cerrado: rc={p.returncode} "
                          f"{(p.stderr or p.stdout).strip()[:120]}")
        if "Traceback (most recent call last)" in p.stderr:
            fallos.append("wa-send --open url reventó con un traceback")
    return hechas


# Ajustes: lo que se acepta y lo que se rechaza. Cada caso es
# (args, se_guarda, que_tiene_que_quedar).
# Un ajuste invalido no falla al escribirse: falla despues, en la corrida del agente y
# lejos de donde se tipeo — o peor, transcribe en el idioma equivocado sin decir nada.
# La validacion solo se ve recorriendola, asi que se recorre.
AJUSTES = [
    (["config", "inbox_days", "30"], True, "30"),
    (["config", "inbox_days", "abc"], False, "30"),
    (["config", "inbox_days", "todos"], False, "30"),
    (["config", "transcribe", "off"], True, "off"),
    (["config", "transcribe", "basura"], False, "off"),
    (["config", "transcribe_lang", "pt"], True, "pt"),
    (["config", "transcribe_lang", "klingon"], False, "pt"),
    (["config", "transcribe_quality", "minima"], True, "minima"),
    (["config", "transcribe_quality", "media"], False, "minima"),
    # owner_name es texto libre: cualquier nombre es un nombre.
    (["config", "owner_name", "Nombre De Ejemplo"], True, "Nombre De Ejemplo"),
    # De donde lee. Un valor que no sea on/off tiene que morir al guardarse: guardado
    # se descubre en la corrida del agente, que es donde ya no se puede preguntar.
    (["config", "read_local", "off"], True, "off"),
    (["config", "read_local", "quizas"], False, "off"),
    (["config", "read_web", "on"], True, "on"),
    (["config", "read_web", "automatico"], False, "on"),
]

# La eleccion de fuente, recorrida de verdad. Cada caso es
# (ajustes, codigo_esperado, motivo_en_la_primera_linea).
# Existe porque lo que decide de donde se lee no se ve compilando: solo se ve
# corriendolo, que es exactamente como se colo aqui un NameError en su momento.
FUENTES = [
    # Con las dos apagadas no hay de donde leer, y eso NO es una bandeja vacia: una
    # bandeja vacia se lee como "no hay nada que atender".
    ({"read_local": "off", "read_web": "off"}, 4, "no-source"),
    # Web elegida en un equipo que igual tendria base: se respeta la eleccion y se
    # falla con el motivo estable, no se cae de vuelta a la local en silencio.
    ({"read_local": "off", "read_web": "on"}, 4, "web-not-implemented"),
    # Y lo de siempre: sin base que leer se sale con 1 y el texto de requisitos.
    ({"read_local": "on", "read_web": "off"}, 1, "local-unavailable"),
]


def revisa_fuentes(fallos: list) -> int:
    """Recorre la eleccion de fuente y el doctor en un equipo SIN base local.

    El HOME temporal no tiene contenedor de WhatsApp, asi que es la misma situacion
    que una maquina Linux: ninguna base que leer. Ahi el doctor tiene que seguir
    diciendo la verdad — que hay una segunda via y que falta construirla — en vez de
    parecer un callejon sin salida.
    """
    hechas = 0
    with tempfile.TemporaryDirectory() as tmp:
        home = pathlib.Path(tmp)
        env = entorno(home)

        for ajustes, codigo, motivo in FUENTES:
            for clave, valor_ in ajustes.items():
                subprocess.run([str(BIN / "wa-scope"), "config", clave, valor_],
                               capture_output=True, text=True, env=env, timeout=120)
            p = subprocess.run([str(BIN / "wa-read"), "inbox", "--json"],
                               capture_output=True, text=True, env=env, timeout=180)
            hechas += 3
            if p.returncode != codigo:
                fallos.append(f"wa-read inbox con {ajustes}: salio {p.returncode} y "
                              f"tenia que salir {codigo}")
            primera = (p.stderr or "").strip().splitlines()[:1]
            if primera != [f"wa-read: {motivo}"]:
                fallos.append(f"wa-read inbox con {ajustes}: la primera linea de stderr "
                              f"es {primera!r} y tenia que ser 'wa-read: {motivo}'")
            # stdout vacio no es cosmetica: quien parsea lee `stdout or '[]'`, y un
            # objeto de error ahi lo hace reventar en vez de quedarse sin filas.
            if p.stdout.strip():
                fallos.append(f"wa-read inbox con {ajustes}: escribio en stdout al fallar")
            if "Traceback (most recent call last)" in p.stderr:
                fallos.append(f"wa-read inbox con {ajustes}: reventó con un traceback")

        # El doctor de un equipo sin base: tiene que nombrar la segunda via, decir que
        # falta construirla, y NO bloquear por ella.
        subprocess.run([str(BIN / "wa-scope"), "config", "read_web", "off"],
                       capture_output=True, text=True, env=env, timeout=120)
        p = subprocess.run([str(BIN / "wa-read"), "doctor", "--json"],
                           capture_output=True, text=True, env=env, timeout=120)
        filas = json.loads(p.stdout or "[]")
        web = next((f for f in filas if f.get("code") == "web"), None)
        hechas += 4
        if not web:
            fallos.append("wa-read doctor no dice nada de la via web")
        else:
            if web.get("requerido", True):
                fallos.append("wa-read doctor marca la via web como requisito: una "
                              "funcion que falta no es una rotura")
            if web.get("detailCode") != "web-not-implemented":
                fallos.append(f"la via web llego sin su codigo estable: "
                              f"{web.get('detailCode')!r}")
            # El detalle tiene que ser accionable: que cuesta y como se enciende.
            detalle = (web.get("detalle") or "").lower()
            if not ("linked-device" in detalle and "read_web" in detalle):
                fallos.append("el detalle de la via web no dice ni lo que cuesta ni "
                              f"como se enciende: {web.get('detalle')!r}")

        # Y el texto de requisitos, que es lo que ve quien no tiene base, no puede
        # seguir diciendo que no hay camino.
        p = subprocess.run([str(BIN / "wa-read"), "doctor"], capture_output=True,
                           text=True, env=env, timeout=120)
        hechas += 2
        if "WhatsApp Web" not in p.stdout:
            fallos.append("el doctor sin base no nombra la via web")
        if "not supported" in p.stdout:
            fallos.append("el doctor sigue diciendo 'not supported' donde si hay via")
    return hechas


def revisa_migracion_cuentas(fallos: list) -> int:
    """Una base vieja, con chat_jid como unica llave, no puede perder ni una fila.

    El registro de alcance ES la lista blanca: perderlo no se arregla reinstalando,
    hay que volver a autorizar cada conversacion a mano.
    """
    hechas = 0
    with tempfile.TemporaryDirectory() as tmp:
        home = pathlib.Path(tmp)
        env = entorno(home)
        db = home / ".wa-inbox" / "scope.db"
        db.parent.mkdir(parents=True, exist_ok=True)
        con = sqlite3.connect(db)
        # El esquema v1 tal cual era: sin provider/target, con plane_project.
        con.executescript("""
            create table chat_scope (
              chat_jid text primary key, chat_name text not null, plane_project text,
              mode text not null default 'off', initial_state text,
              hours text, timezone text, notes text, updated_at text);
            insert into chat_scope values
              ('100@g.us','Grupo Viejo','CCBQA','responder','Backlog','L-V',
               'America/Bogota','una nota','2025-01-01 10:00'),
              ('200@s.whatsapp.net','Directo Viejo','OPS','observar',null,'L-V',
               'America/Bogota',null,'2025-01-02 10:00');""")
        con.commit()
        con.close()

        p = subprocess.run([str(BIN / "wa-scope"), "list", "--json"],
                           capture_output=True, text=True, env=env, timeout=120)
        filas = {f["chat_jid"]: f for f in json.loads(p.stdout or "[]")}
        hechas += 5
        if len(filas) != 2:
            fallos.append(f"la migracion a (cuenta, jid) perdio filas: quedaron "
                          f"{sorted(filas)}")
        grupo = filas.get("100@g.us", {})
        if grupo.get("account") != "local":
            fallos.append(f"lo que ya estaba no quedo en la cuenta local: "
                          f"{grupo.get('account')!r}")
        if grupo.get("target") != "CCBQA" or grupo.get("mode") != "responder":
            fallos.append(f"la migracion perdio el mapeo de la fila: {grupo!r}")
        if grupo.get("notes") != "una nota":
            fallos.append(f"la migracion copio las columnas corridas: {grupo!r}")

        # Y la llave nueva es (cuenta, jid): sin eso dos lineas con el mismo directo
        # se colapsan en una y el agente contesta desde el numero equivocado.
        con = sqlite3.connect(db)
        llave = [r[1] for r in con.execute("pragma table_info(chat_scope)") if r[5]]
        con.close()
        if llave != ["account", "chat_jid"]:
            fallos.append(f"la llave de chat_scope quedo en {llave!r}")

        # La linea local tiene que existir en el registro de cuentas y contar lo que
        # tiene autorizado: un cero ahi dice mejor que un parrafo que conectar no
        # autoriza nada.
        p = subprocess.run([str(BIN / "wa-scope"), "accounts", "--json"],
                           capture_output=True, text=True, env=env, timeout=120)
        cuentas = json.loads(p.stdout or "[]")
        hechas += 2
        local = next((c for c in cuentas if c.get("id") == "local"), None)
        if not local or local.get("kind") != "local":
            fallos.append(f"wa-scope accounts no lista la linea local: {cuentas!r}")
        elif local.get("authorized_chats") != 2:
            fallos.append(f"wa-scope accounts conto {local.get('authorized_chats')} "
                          "conversaciones autorizadas y eran 2")
    return hechas


def revisa_rastro_corrida(fallos: list) -> int:
    """Los cinco finales de una corrida, recorridos de verdad.

    Existe por lo mismo que el resto de este archivo: una rama que ningun chequeo
    ejecuta es una rama que se rompe en la maquina del usuario. Y aca el precio es
    peor que un traceback — si el rastro miente, el panel afirma que el agente hizo
    algo que no hizo, que es exactamente lo que este trabajo vino a arreglar.
    """
    hechas = 0
    with tempfile.TemporaryDirectory() as tmp:
        home = pathlib.Path(tmp)
        env = entorno(home)

        def scope(*args):
            return subprocess.run([str(BIN / "wa-scope"), *args], capture_output=True,
                                  text=True, env=env, timeout=180)

        def estado():
            p = scope("run", "--json")
            filas = json.loads(p.stdout or "[]")
            return filas[0] if filas else {}

        hechas += 1
        if estado().get("state") != "never":
            fallos.append(f"sin corridas, wa-scope run dice {estado().get('state')!r} "
                          "en vez de never")

        scope("set", "100@g.us", "--target", "SOP", "--mode", "responder")
        scope("lock", "--note", "triage")
        hechas += 1
        if estado().get("state") != "running":
            fallos.append(f"con el lock puesto, wa-scope run dice "
                          f"{estado().get('state')!r} en vez de running")

        scope("unlock")
        cerrada = estado()
        hechas += 2
        if cerrada.get("state") != "ok":
            fallos.append(f"al soltar el lock quedo en {cerrada.get('state')!r} "
                          "en vez de ok")
        if cerrada.get("looked") != 1:
            fallos.append(f"la corrida dice que miro {cerrada.get('looked')!r} "
                          "conversaciones autorizadas y era 1")

        motivo = "This Claude account is in use by an assigned worktree"
        scope("lock")
        scope("unlock", "--failed", motivo)
        fallida = estado()
        hechas += 2
        if fallida.get("state") != "failed":
            fallos.append(f"unlock --failed dejo el estado en "
                          f"{fallida.get('state')!r} en vez de failed")
        if fallida.get("reason") != motivo:
            fallos.append(f"el motivo del fallo llego como {fallida.get('reason')!r}")

        # La corrida que se murio: el lock vence y nadie llama a unlock. No se guarda
        # como estado, se deduce — asi que si la deduccion se rompe nada mas lo delata.
        scope("lock", "--ttl", "0")
        hechas += 1
        if estado().get("state") != "interrupted":
            fallos.append(f"una corrida que no volvio quedo en "
                          f"{estado().get('state')!r} en vez de interrupted")

        # Y lo que separa "no hay trabajo" de "no hay permiso". Apagar por terminal
        # tiene que APAGAR: la copia del panel le ganaba al CLI y `mode off` volvia a
        # salir como `responder`, con lo que este estado era inalcanzable desde ahi.
        scope("unlock")
        scope("mode", "100@g.us", "off")
        hechas += 1
        modos = [f["mode"] for f in json.loads(scope("list", "--json").stdout or "[]")]
        if modos != ["off"]:
            fallos.append(f"despues de `mode off` el registro quedo en {modos!r}")
        apagada = estado()
        hechas += 2
        if apagada.get("mapped") != 1:
            fallos.append(f"con una conversacion registrada, mapped llego "
                          f"{apagada.get('mapped')!r}")
        if apagada.get("authorized") != 0:
            fallos.append(f"con todo en off, authorized llego "
                          f"{apagada.get('authorized')!r} en vez de 0")
    return hechas


# Un wa-read que no lee nada y deja constancia de que lo llamaron. Es la prueba, y no
# una promesa, de que el precheck ya no abre la base de WhatsApp: si aparece una linea
# en la marca, alguien fue a buscarla.
STUB_WA_READ = '''#!/usr/bin/env python3
import os, sys
with open(os.environ["WA_MARCA"], "a") as fh:
    fh.write(" ".join(sys.argv[1:]) + "\\n")
print("[]")
'''


def revisa_precheck(fallos: list) -> int:
    """El precheck de las dos automations: barato, sin tocar WhatsApp, y sus tres
    salidas siguen significando lo mismo.

    Corre cada uno o dos minutos en dos automations a la vez. Cuando empezaba
    sincronizando, cada corrida copiaba 260 MB del contenedor de WhatsApp en tres
    procesos distintos y macOS preguntaba por el acceso en cada uno. Que no vuelva a
    pasar no se comprueba leyendo el codigo: se comprueba poniendo un wa-read falso y
    mirando si alguien lo llamo.

    Los tres codigos de salida son contrato con las automations —0 hay trabajo, 1 nada
    que hacer, 2 bloqueado— y el 2 tiene que seguir siendo ruidoso: un store viejo es
    una instalacion que no sincroniza, no una bandeja vacia.
    """
    hechas = 0
    with tempfile.TemporaryDirectory() as tmp:
        raiz = pathlib.Path(tmp)
        home = raiz / "home"
        home.mkdir()
        marca = raiz / "llamadas.txt"

        # bin/ propio: el mismo wa-scope, con un wa-read que no lee.
        binf = raiz / "bin"
        binf.mkdir()
        (binf / "wa-scope").write_text((BIN / "wa-scope").read_text())
        (binf / "wa-scope").chmod(0o755)
        (binf / "wa-read").write_text(STUB_WA_READ)
        (binf / "wa-read").chmod(0o755)

        env = dict(entorno(home), WA_MARCA=str(marca))

        def scope(*args):
            return subprocess.run([str(binf / "wa-scope"), *args], capture_output=True,
                                  text=True, env=env, timeout=180)

        # Un sync deja el store donde wa-scope lo pone de verdad; preguntarselo a el
        # evita tener una segunda copia de esa ruta, que cambia por sistema operativo.
        salida = json.loads(scope("sync", "--json").stdout or "[]")
        destinos = (salida[0] if salida else {}).get("destinos") or []
        if not destinos:
            fallos.append("wa-scope sync no dijo donde deja el store del panel")
            return hechas
        store = pathlib.Path(destinos[0])

        def sembrar(pendientes=0, salud_ok=True, minutos=0, decisiones=None):
            ahora = time.time() - minutos * 60
            sello = time.strftime("%Y-%m-%d %H:%M", time.localtime(ahora))
            datos = {
                "scope": {"100@g.us": {"chatName": "Soporte", "mode": "responder",
                                       "provider": "plane", "target": "SOP"}},
                "decisions": decisiones or {},
                "health": ({"ok": True, "optional": []} if salud_ok else
                           {"ok": False, "problem": "chat database present",
                            "detail": "missing", "problemCode": "database"}),
                "activity": {"syncedAt": sello, "recent": [], "running": False,
                             "mapped": 1, "authorized": 1,
                             "pending": [{"stanzaId": f"S{i}", "chatJid": "100@g.us",
                                          "chat": "Soporte", "text": "hola"}
                                         for i in range(pendientes)]},
            }
            store.write_text(json.dumps(datos))
            marca.write_text("")

        def precheck(*args):
            p = scope("pending", *args)
            llamadas = [l for l in marca.read_text().splitlines() if l.strip()]
            if llamadas:
                fallos.append(f"`wa-scope pending {' '.join(args)}` abrio WhatsApp: "
                              f"llamo a wa-read {llamadas}")
            return p

        # 0 = hay trabajo.
        sembrar(pendientes=2)
        p = precheck()
        hechas += 2
        if p.returncode != 0:
            fallos.append(f"con 2 pendientes el precheck salio {p.returncode} y no 0")

        # 1 = no hay nada que hacer. Es el caso normal y el unico que puede ser callado.
        sembrar(pendientes=0)
        p = precheck()
        hechas += 2
        if p.returncode != 1:
            fallos.append(f"sin pendientes el precheck salio {p.returncode} y no 1")

        # 2 = bloqueado porque el sistema no puede leer.
        sembrar(pendientes=2, salud_ok=False)
        p = precheck()
        hechas += 3
        if p.returncode != 2:
            fallos.append(f"con el sistema roto el precheck salio {p.returncode} y no 2")
        cuerpo = json.loads(p.stdout or "{}")
        if not cuerpo.get("bloqueado"):
            fallos.append("el precheck bloqueado no dice por que: un salteo callado "
                          "esconde una instalacion rota")

        # 2 tambien cuando nadie sincroniza: contestar "no hay nada" sobre un store de
        # hace una hora seria afirmar algo que no se sabe.
        sembrar(pendientes=2, minutos=120)
        p = precheck()
        hechas += 2
        if p.returncode != 2:
            fallos.append(f"con el store viejo el precheck salio {p.returncode} y no 2")
        if json.loads(p.stdout or "{}").get("codigo") != "sync-stale":
            fallos.append("el store viejo no llego con su codigo estable")

        # El limite sale del ajuste, no de una constante: subirlo tiene que alcanzar
        # para que el mismo store deje de estar viejo.
        scope("config", "sync_minutes", "60")
        p = precheck()
        hechas += 1
        # 0 y no 2: el mismo store deja de estar viejo y sus 2 pendientes vuelven
        # a ser trabajo.
        if p.returncode != 0:
            fallos.append(f"con sync_minutes en 60 el mismo store salio "
                          f"{p.returncode}; el limite no sigue al ajuste")
        scope("config", "sync_minutes", "5")

        # Sin store no hay nada que responder, y eso tampoco es "no hay trabajo".
        store.unlink()
        marca.write_text("")
        p = precheck()
        hechas += 2
        if p.returncode != 2:
            fallos.append(f"sin store el precheck salio {p.returncode} y no 2")
        if json.loads(p.stdout or "{}").get("codigo") != "never-synced":
            fallos.append("un plugin que nunca sincronizo no se distingue de uno roto")

        # --only-taken es la otra automation: cuenta lo que el humano marco a mano.
        sembrar(pendientes=5)
        p = precheck("--only-taken")
        hechas += 2
        if p.returncode != 1:
            fallos.append(f"sin marcas a mano, --only-taken salio {p.returncode} y no 1")
        sembrar(pendientes=0, decisiones={"S0": {"decision": "take"}})
        p = precheck("--only-taken")
        hechas += 1
        if p.returncode != 0:
            fallos.append(f"con una marca Tomar, --only-taken salio {p.returncode} y no 0")
    return hechas


def entorno(home: pathlib.Path) -> dict:
    """HOME propio: la base vive en ~/.wa-inbox/scope.db y no hay variable para moverla,
    asi que mover el HOME es lo que mantiene la base real del usuario fuera de esto."""
    import os
    return dict(os.environ, HOME=str(home),
                XDG_CONFIG_HOME=str(home / ".config"),
                APPDATA=str(home / "AppData" / "Roaming"))


def valor(env: dict, clave: str):
    p = subprocess.run([str(BIN / "wa-scope"), "config", clave, "--json"],
                       capture_output=True, text=True, env=env, timeout=120)
    filas = json.loads(p.stdout or "[]")
    return filas[0]["value"] if filas else None


def revisa_ajustes(fallos: list) -> int:
    """Devuelve cuantas comprobaciones corrio."""
    hechas = 0
    with tempfile.TemporaryDirectory() as tmp:
        home = pathlib.Path(tmp)
        env = entorno(home)
        for args, acepta, esperado in AJUSTES:
            clave = args[1]
            p = subprocess.run([str(BIN / "wa-scope"), *args], capture_output=True,
                               text=True, env=env, timeout=120)
            hechas += 2
            if acepta and p.returncode != 0:
                fallos.append(f"wa-scope {' '.join(args)}: rechazo un valor valido — "
                              f"{(p.stderr or p.stdout).strip()[:120]}")
            if not acepta and p.returncode == 0:
                fallos.append(f"wa-scope {' '.join(args)}: acepto un valor invalido")
            quedo = valor(env, clave)
            if quedo != esperado:
                fallos.append(f"{clave} quedo en {quedo!r} y tenia que quedar en {esperado!r}")

        # La llave sale del manifiesto, no escrita a mano: cuando el plugin se
        # renombro, la copia fija aqui hizo fallar el chequeo culpando al codigo.
        man = json.loads((RAIZ / "orca-plugin.json").read_text(encoding="utf-8"))
        llave = f"{man['publisher']}.{man['id']}"
        store = (home / "Library" / "Application Support" / "orca" / "plugins-data" /
                 llave / "storage.json")
        store.parent.mkdir(parents=True, exist_ok=True)

        # `sync` tiene que devolverle al panel TODOS los ajustes, no solo el tono: uno
        # que viva nada mas en la base deja el control vacio y el panel miente sobre lo
        # que rige. Se borra el store primero para que lo que quede venga de sync y no
        # del espejo que ya hace cada escritura.
        store.unlink(missing_ok=True)
        subprocess.run([str(BIN / "wa-scope"), "sync", "--json"], capture_output=True,
                       text=True, env=env, timeout=180)
        espejo = json.loads(store.read_text(encoding="utf-8")) if store.exists() else {}
        hechas += 5
        for flat, esperado in (("inboxDays", "30"), ("transcribe", "off"),
                               ("transcribeLang", "pt"), ("transcribeQuality", "minima"),
                               ("ownerName", "Nombre De Ejemplo")):
            if espejo.get(flat) != esperado:
                fallos.append(f"sync no le devolvio {flat} al panel: quedo "
                              f"{espejo.get(flat)!r} en vez de {esperado!r}")

        # El panel escribe en el store del host sin pasar por el CLI, asi que un valor
        # sucio de ahi es lo unico que la validacion de escritura no puede atajar.
        store.write_text(json.dumps({"inboxDays": "nunca", "transcribe": "magia",
                                     "transcribeLang": "klingon"}), encoding="utf-8")
        hechas += 3
        for clave, esperado in (("inbox_days", "30"), ("transcribe", "off"),
                                ("transcribe_lang", "pt")):
            quedo = valor(env, clave)
            if quedo != esperado:
                fallos.append(f"basura del panel en {clave}: llego {quedo!r} en vez de "
                              f"{esperado!r}, el valor del CLI")

        # Y lo valido del panel SI tiene que ganarle al CLI, como el tono.
        store.write_text(json.dumps({"inboxDays": "0", "transcribe": "local"}),
                         encoding="utf-8")
        hechas += 2
        for clave, esperado in (("inbox_days", "0"), ("transcribe", "local")):
            quedo = valor(env, clave)
            if quedo != esperado:
                fallos.append(f"el panel no le gano al CLI en {clave}: quedo {quedo!r}")
    return hechas


def main() -> int:
    fallos = []
    aislado = tempfile.TemporaryDirectory()
    env_aislado = entorno(pathlib.Path(aislado.name))
    for nombre, args, propio in CASOS:
        ruta = BIN / nombre
        if not ruta.exists():
            fallos.append(f"{nombre}: no existe")
            continue
        try:
            p = subprocess.run([str(ruta), *args], capture_output=True, text=True,
                               env=env_aislado if propio else None, timeout=120)
        except (OSError, subprocess.SubprocessError) as error:
            fallos.append(f"{nombre}: no arranco — {error}")
            continue
        # Un doctor puede terminar en != 0 porque al equipo le falta algo; eso no
        # es un error del codigo. Lo que nunca es aceptable es un traceback.
        if "Traceback (most recent call last)" in p.stderr:
            ultima = [l for l in p.stderr.strip().splitlines() if l.strip()][-1]
            fallos.append(f"{nombre} {' '.join(args)}: {ultima.strip()}")

    comprobaciones = (revisa_ajustes(fallos) + revisa_wa_send(fallos)
                      + revisa_fuentes(fallos) + revisa_migracion_cuentas(fallos)
                      + revisa_rastro_corrida(fallos) + revisa_precheck(fallos))
    aislado.cleanup()

    if fallos:
        print("CLI que se rompen al correr:", file=sys.stderr)
        for f in fallos:
            print(f"  {f}", file=sys.stderr)
        return 1
    print(f"{len(CASOS)} CLI arrancan, {comprobaciones} comprobaciones de ajustes")
    return 0


if __name__ == "__main__":
    sys.exit(main())
