    # La meta del primer contacto de los informes (odd/tasks/informes-tablero.md, I4): en
    # minutos, entre 1 y un dia. Cero haria fallar todo caso; mas de un dia no es una meta.
    (["config", "sla_first_reply_minutes", "30"], True, "30"),
    (["config", "sla_first_reply_minutes", "0"], False, "30"),
    (["config", "sla_first_reply_minutes", "1441"], False, "30"),
    (["config", "sla_first_reply_minutes", "media hora"], False, "30"),
