# Con que arranca la meta del primer contacto: 15 minutos, y se cambia en Ajustes.
DEFAULTS_INFORMES = {"sla_first_reply_minutes": "15"}

# Con que arranca el primer mensaje en una instalacion nueva: el acuse fijo de siempre.
# Los modos del agente son Beta y nadie entra a ellos sin elegirlos.
DEFAULTS_PRIMER = {"first_reply_mode": "ack", "ack_fallback_minutes": "5",
                   "update_every_minutes": "10", "updates_max": "3"}

# Con que arranca cada ajuste de la via web en una instalacion nueva. Van aca y no en un
# comentario porque son el trato entero del almacen — cuanto texto ajeno se guarda y por
# cuanto tiempo — y un default que cambia sin querer no se ve en ninguna salida.
SHIM_LINUX = "import platform\nplatform.system = lambda: 'Linux'\n"


def revisa_sin_bytecode(fallos: list) -> int:
    """Correr los CLI no puede dejar archivos nuevos dentro del plugin.

    El directorio del plugin instalado esta direccionado por hash; un `__pycache__` que
    aparece DESPUES de instalar es exactamente lo que dejaba el plugin en "No valido".
    Aparecio en cuanto wa-scope y wa-read pasaron a importar un modulo hermano, asi que
    la guarda va aca y no en un comentario.
    """
    cache = BIN / "__pycache__"
    shutil.rmtree(cache, ignore_errors=True)
    with tempfile.TemporaryDirectory() as tmp:
        env = entorno(pathlib.Path(tmp))
        subprocess.run([str(BIN / "wa-scope"), "config", "--json"],
                       capture_output=True, text=True, env=env, timeout=120)
        subprocess.run([str(BIN / "wa-read"), "doctor", "--json"],
                       capture_output=True, text=True, env=env, timeout=180)
    if cache.exists():
        fallos.append(f"correr los CLI dejo {cache} dentro del plugin: en la instalacion "
                      "direccionada por hash eso lo invalida")
        shutil.rmtree(cache, ignore_errors=True)
    return 1


def revisa_firma_del_panel(fallos: list) -> int:
    """El nombre puesto DESDE EL PANEL tambien firma.

    Es el caso que bloqueo a un agente de verdad: `wa-scope agent` devolvia `Jarvis` y
    `wa-send` salia con "no agent name is configured", porque leia el sqlite directo y
    el panel guarda en el almacen del plugin. Por eso el nombre se escribe SOLO ahi.

    Sin una linea enlazada no se puede comprobar el mensaje firmado que sale, pero si la
    puerta que lo bloqueaba: con el nombre solo en el almacen, wa-send tiene que PASAR
    la firma y llegar hasta la negativa siguiente, que es la del permiso —esa
    conversacion no esta en el registro—. Que se quede en "no agent name is configured"
    es exactamente el defecto viejo, y eso si se ve.
    """
    hechas = 0
    with tempfile.TemporaryDirectory() as tmp:
        home = pathlib.Path(tmp)
        env = entorno(home)
        man = json.loads((RAIZ / "orca-plugin.json").read_text(encoding="utf-8"))
        store = (home / "Library" / "Application Support" / "orca" / "plugins-data" /
                 f"{man['publisher']}.{man['id']}" / "storage.json")
        store.parent.mkdir(parents=True, exist_ok=True)
        store.write_text(json.dumps({"agentName": "Jarvis"}), encoding="utf-8")
        # La base tiene que existir y NO tener el nombre, o el caso no mide lo que dice.
        subprocess.run([str(BIN / "wa-scope"), "config", "--json"],
                       capture_output=True, text=True, env=env, timeout=120)

        con = sqlite3.connect(home / ".wa-inbox" / "scope.db")
        quedo = con.execute("select value from settings where key='agent_name'").fetchone()
        con.close()
        hechas += 1
        if quedo and (quedo[0] or "").strip():
            fallos.append("el caso no mide lo que dice: el nombre tambien esta en la base")

        hechas += 2
        p = subprocess.run([str(BIN / "wa-send"), "Un Grupo", "hola", "--send"],
                           capture_output=True, text=True, timeout=180, env=env)
        if "no agent name is configured" in (p.stderr or ""):
            fallos.append("wa-send no ve el nombre del agente puesto desde el panel")
        primera = (p.stderr or "").strip().splitlines()[:1]
        if primera != [f"wa-send: {DENEGADO}"]:
            fallos.append(f"con la firma resuelta, wa-send tenia que llegar a la negativa "
                          f"por permiso y dijo {primera!r}")
    return hechas


def revisa_migracion_cuentas(fallos: list) -> int:
    """Una base vieja, con chat_jid como unica llave, no puede perder ni una fila.

    El registro de alcance ES la lista blanca: perderlo no se arregla reinstalando,
    hay que volver a autorizar cada conversacion a mano.
    """
    hechas = 0
    with tempfile.TemporaryDirectory() as tmp:
        home = pathlib.Path(tmp)
        env = entorno(home)
        db = home / ".wa-inbox" / "scope.db"
        db.parent.mkdir(parents=True, exist_ok=True)
        con = sqlite3.connect(db)
        # El esquema v1 tal cual era: sin provider/target, con plane_project.
        con.executescript("""
            create table chat_scope (
              chat_jid text primary key, chat_name text not null, plane_project text,
              mode text not null default 'off', initial_state text,
              hours text, timezone text, notes text, updated_at text);
            insert into chat_scope values
              ('100@g.us','Grupo Viejo','CCBQA','responder','Backlog','L-V',
               'America/Bogota','una nota','2025-01-01 10:00'),
              ('200@s.whatsapp.net','Directo Viejo','OPS','observar',null,'L-V',
               'America/Bogota',null,'2025-01-02 10:00');""")
        con.commit()
        con.close()

        p = subprocess.run([str(BIN / "wa-scope"), "list", "--json"],
                           capture_output=True, text=True, env=env, timeout=120)
        filas = {f["chat_jid"]: f for f in json.loads(p.stdout or "[]")}
        hechas += 5
        if len(filas) != 2:
            fallos.append(f"la migracion a (cuenta, jid) perdio filas: quedaron "
                          f"{sorted(filas)}")
        grupo = filas.get("100@g.us", {})
        if grupo.get("account") != "local":
            fallos.append(f"lo que ya estaba no quedo en la cuenta local: "
                          f"{grupo.get('account')!r}")
        if grupo.get("target") != "CCBQA" or grupo.get("mode") != "responder":
            fallos.append(f"la migracion perdio el mapeo de la fila: {grupo!r}")
        if grupo.get("notes") != "una nota":
            fallos.append(f"la migracion copio las columnas corridas: {grupo!r}")

        # Y la llave nueva es (cuenta, jid): sin eso dos lineas con el mismo directo
        # se colapsan en una y el agente contesta desde el numero equivocado.
        con = sqlite3.connect(db)
        llave = [r[1] for r in con.execute("pragma table_info(chat_scope)") if r[5]]
        con.close()
        if llave != ["account", "chat_jid"]:
            fallos.append(f"la llave de chat_scope quedo en {llave!r}")

        # La linea local tiene que existir en el registro de cuentas y contar lo que
        # tiene autorizado: un cero ahi dice mejor que un parrafo que conectar no
        # autoriza nada.
        p = subprocess.run([str(BIN / "wa-scope"), "accounts", "--json"],
                           capture_output=True, text=True, env=env, timeout=120)
        cuentas = json.loads(p.stdout or "[]")
        hechas += 2
        local = next((c for c in cuentas if c.get("id") == "local"), None)
        if not local or local.get("kind") != "local":
            fallos.append(f"wa-scope accounts no lista la linea local: {cuentas!r}")
        elif local.get("authorized_chats") != 2:
            fallos.append(f"wa-scope accounts conto {local.get('authorized_chats')} "
                          "conversaciones autorizadas y eran 2")

        # Una linea web recien conectada nace APAGADA —todavia no hay identidad— y el
        # listado la tiene que seguir mostrando igual. Es el defecto reportado: la fila
        # aparecia "esperando el escaneo" y desaparecia, porque quien la pintaba la leia
        # de una fuente que solo devuelve las habilitadas. `pending` es lo que separa
        # una recien conectada de una caida: las dos vienen apagadas y sin fecha.
        subprocess.run([str(BIN / "wa-scope"), "accounts", "--connect", "perfil-qr",
                        "--label", "NoVa", "--json"],
                       capture_output=True, text=True, env=env, timeout=120)
        p = subprocess.run([str(BIN / "wa-scope"), "accounts", "--json"],
                           capture_output=True, text=True, env=env, timeout=120)
        cuentas = json.loads(p.stdout or "[]")
        hechas += 3
        web = next((c for c in cuentas if c.get("kind") == "web"), None)
        if not web:
            fallos.append(f"una linea web a medio enlazar no se lista: {cuentas!r}")
        else:
            if web.get("enabled") is not False:
                fallos.append(f"la linea pendiente se lista habilitada: {web!r}")
            if web.get("pending") is not True:
                fallos.append(f"la linea pendiente no se distingue de una caida: {web!r}")
    return hechas


def revisa_proyectos(fallos: list) -> int:
    """Los ajustes por chat apuntan a un PROYECTO (kanban-casos, T13).

    Lo que se prueba es lo que no se ve en el codigo: que una base de antes de este
    cambio gane la columna sin perder una fila ni una columna vieja, que una conversacion
    sin proyecto siga funcionando (el dueno ya no elige servicio de tareas), que la
    resolucion del destino vea el proyecto, y que lo que escribe el panel no se pierda
    en el siguiente sync — las reglas del panel se perdian ahi.
    """
    hechas = 0
    with tempfile.TemporaryDirectory() as tmp:
        home = pathlib.Path(tmp)
        env = entorno(home)

        def scope(*args):
            return subprocess.run([str(BIN / "wa-scope"), *args, "--json"],
                                  capture_output=True, text=True, env=env, timeout=180)

        def filas(*args):
            p = scope(*args)
            return json.loads(p.stdout or "[]") if p.returncode == 0 else p

        man = json.loads((RAIZ / "orca-plugin.json").read_text(encoding="utf-8"))
        base = ((home / "Library" / "Application Support" / "orca") if sys.platform == "darwin"
                else (home / ".config" / "orca"))
        store = base / "plugins-data" / f"{man['publisher']}.{man['id']}" / "storage.json"
        store.parent.mkdir(parents=True, exist_ok=True)

        def storage():
            return json.loads(store.read_text(encoding="utf-8")) if store.exists() else {}

        def guarda(**claves):
            datos = storage()
            datos.update(claves)
            store.write_text(json.dumps(datos), encoding="utf-8")

        GRUPO, DIRECTO = "100@g.us", "200@s.whatsapp.net"
        PROYECTOS = [
            {"id": "alfa-demo", "name": "Alfa Demo", "path": "/srv/ejemplo/alfa-demo",
             "note": "Tienda en linea"},
            {"id": "beta-demo", "name": "Beta Demo", "path": "/srv/ejemplo/beta-demo",
             "note": ""}]

        # ── La migracion: una base de antes, con una conversacion y una regla.
        scope("set", GRUPO, "--provider", "plane", "--target", "SOP", "--mode", "responder")
        scope("route", "--match", "acme", "--provider", "plane", "--target", "ACM")
        db = home / ".wa-inbox" / "scope.db"
        con = sqlite3.connect(db)
        # Se deja la base como la dejaba la version anterior: sin la columna nueva.
        for tabla in ("chat_scope", "route"):
            if "workspace" in {r[1] for r in con.execute(f"pragma table_info({tabla})")}:
                con.execute(f"alter table {tabla} drop column workspace")
        con.commit()
        con.close()
        scope("list")
        con = sqlite3.connect(db)
        cs = {r[1] for r in con.execute("pragma table_info(chat_scope)")}
        rt = {r[1] for r in con.execute("pragma table_info(route)")}
        fila = con.execute("select provider, target, mode, workspace from chat_scope "
                           "where chat_jid=?", (GRUPO,)).fetchone()
        regla = con.execute("select provider, target, workspace from route "
                            "where pattern='acme'").fetchone()
        con.close()
        hechas += 4
        if "workspace" not in cs or "workspace" not in rt:
            fallos.append(f"la migracion no agrego la columna workspace: chat_scope={'workspace' in cs} "
                          f"route={'workspace' in rt}")
        if fila != ("plane", "SOP", "responder", None):
            fallos.append(f"la migracion toco lo que ya estaba en chat_scope: {fila!r}")
        if regla != ("plane", "ACM", None):
            fallos.append(f"la migracion toco la regla vieja: {regla!r}")
        if not {"provider", "target", "initial_state"} <= cs:
            fallos.append(f"las columnas viejas de chat_scope no se conservan: {sorted(cs)}")

        # ── El catalogo: lo guarda el worker en storage y el CLI lo espeja a la base.
        guarda(projects=PROYECTOS)
        listado = filas("projects")
        hechas += 3
        if [p.get("id") for p in listado] != ["alfa-demo", "beta-demo"] \
                or listado[0].get("path") != "/srv/ejemplo/alfa-demo" \
                or listado[0].get("note") != "Tienda en linea":
            fallos.append(f"wa-scope projects no lista lo que acepto el dueno: {listado!r}")
        con = sqlite3.connect(db)
        espejo = [r[0] for r in con.execute("select id from project order by id")]
        con.close()
        if espejo != ["alfa-demo", "beta-demo"]:
            fallos.append(f"el catalogo no se espejo a scope.db: {espejo!r}")
        # Sin el storage -Orca cerrado, otra maquina- el CLI sigue viendo lo ultimo.
        store.unlink()
        if [p.get("id") for p in filas("projects")] != ["alfa-demo", "beta-demo"]:
            fallos.append("sin storage el CLI perdio el catalogo espejado")
        guarda(projects=PROYECTOS)

        # ── set --workspace.
        p = scope("set", GRUPO, "--workspace", "no-existe")
        hechas += 1
        if p.returncode == 0 or "no-existe" not in (p.stderr + p.stdout):
            fallos.append(f"set --workspace con un proyecto que no existe no se rechaza: "
                          f"rc={p.returncode} {p.stderr.strip()[:120]}")
        p = scope("set", GRUPO, "--workspace", "alfa-demo", "--mode", "borrador")
        hechas += 2
        if p.returncode != 0:
            fallos.append(f"set --workspace con un proyecto del catalogo falla: {p.stderr.strip()[:200]}")
        lista = filas("list")
        grupo = next((r for r in lista if r["chat_jid"] == GRUPO), {}) if isinstance(lista, list) else {}
        if grupo.get("workspace") != "alfa-demo" or grupo.get("target") != "SOP":
            fallos.append(f"list no trae el proyecto o perdio el destino viejo: {grupo!r}")
        if (storage().get("scope") or {}).get(GRUPO, {}).get("workspace") != "alfa-demo":
            fallos.append("el proyecto no viaja al storage que lee el panel")

        # Una conversacion SIN proyecto sigue andando: no hay servicio de tareas que elegir.
        p = scope("set", DIRECTO, "--mode", "borrador")
        hechas += 3
        if p.returncode != 0:
            fallos.append(f"una conversacion sin proyecto ni destino no se puede activar: "
                          f"{p.stderr.strip()[:200]}")
        directo = next((r for r in filas("list") if r["chat_jid"] == DIRECTO), {})
        if directo.get("workspace") is not None or directo.get("mode") != "borrador":
            fallos.append(f"la conversacion sin proyecto quedo mal: {directo!r}")
        voz = filas("voice", GRUPO)
        if not isinstance(voz, list) or voz[0].get("workspace") != "alfa-demo":
            fallos.append(f"voice no dice el proyecto de la conversacion: {voz!r}")

        # ── where: el proyecto manda, y el contenido puede cambiarlo.
        ruta = lambda texto, chat: (filas("where", texto, "--chat", chat) or [{}])[0]
        d = ruta("hola", GRUPO)
        hechas += 1
        if d.get("workspace") != "alfa-demo" or d.get("workspace_path") != "/srv/ejemplo/alfa-demo":
            fallos.append(f"where no resuelve al proyecto de la conversacion: {d!r}")
        scope("route", "--match", "beta", "--workspace", "beta-demo")
        d = ruta("pasa algo con BETA", GRUPO)
        hechas += 2
        if d.get("workspace") != "beta-demo" or d.get("matched") != "beta":
            fallos.append(f"una regla de texto no manda el caso a su proyecto: {d!r}")
        if d.get("target") != "SOP":
            fallos.append(f"una regla solo de proyecto pisa el destino viejo del chat: {d!r}")
        d = ruta("hola", DIRECTO)
        hechas += 1
        if d.get("workspace") is not None:
            fallos.append(f"un chat sin proyecto resuelve a uno: {d!r}")
        p = scope("route", "--match", "sola")
        hechas += 1
        if p.returncode == 0:
            fallos.append("una regla sin proyecto ni destino se acepta")
        reglas = filas("route")
        beta = next((r for r in reglas if r["pattern"] == "beta"), {}) if isinstance(reglas, list) else {}
        hechas += 1
        if beta.get("workspace") != "beta-demo":
            fallos.append(f"route no lista el proyecto de la regla: {reglas!r}")

        # Un proyecto que el dueno quito del catalogo deja de resolver, pero no se borra
        # de la conversacion: puede volver.
        guarda(projects=[PROYECTOS[1]])
        d = ruta("hola", GRUPO)
        hechas += 2
        if d.get("workspace") is not None:
            fallos.append(f"un proyecto que ya no esta en el catalogo sigue resolviendo: {d!r}")
        if "alfa-demo" not in (d.get("why") or "") and "alfa-demo" not in json.dumps(d):
            fallos.append(f"where no dice que el proyecto de la conversacion ya no esta: {d!r}")
        guarda(projects=PROYECTOS)

        # ── Lo que escribe el panel manda, y no se pierde en el sync.
        datos = storage()
        datos["scope"][GRUPO]["workspace"] = None
        datos["routes"] = [{"pattern": "gama", "workspace": "beta-demo"}]
        store.write_text(json.dumps(datos), encoding="utf-8")
        d = ruta("hola", GRUPO)
        hechas += 1
        if d.get("workspace") is not None:
            fallos.append(f"quitar el proyecto en el panel no lo quita: {d!r}")
        d = ruta("algo de gama", GRUPO)
        hechas += 1
        if d.get("workspace") != "beta-demo":
            fallos.append(f"una regla del panel con proyecto no se aplica: {d!r}")
        scope("sync")
        despues = storage()
        hechas += 3
        if not any(r.get("pattern") == "gama" and r.get("workspace") == "beta-demo"
                   for r in despues.get("routes") or []):
            fallos.append(f"el sync borro la regla que el panel acababa de guardar: "
                          f"{despues.get('routes')!r}")
        if not any(r.get("pattern") == "beta" and r.get("workspace") == "beta-demo"
                   for r in despues.get("routes") or []):
            fallos.append(f"el sync no trae al panel la regla del CLI con su proyecto: "
                          f"{despues.get('routes')!r}")
        con = sqlite3.connect(db)
        ws_db = con.execute("select workspace from chat_scope where chat_jid=?",
                            (GRUPO,)).fetchone()
        con.close()
        if ws_db != (None,):
            fallos.append(f"el proyecto que el panel quito sigue en la base: {ws_db!r}")
    return hechas


def revisa_varios_proyectos(fallos: list) -> int:
    """Una conversacion con VARIOS proyectos (proyectos-por-chat, M1 y M2).

    La lista vive en `chat_scope.workspaces` y en `scope[jid].workspaces` del panel; la
    columna y la clave `workspace` de siempre quedan derivadas (el unico id cuando la lista
    tiene uno, si no null), y asi cada lector de un solo proyecto sigue igual. Lo que se
    prueba es lo que no se ve en el codigo: una base y un panel de antes dan la lista de
    un proyecto, un panel que vacia la lista la vacia, un id que el dueno quito del
    catalogo se conserva y se dice, y lo que escribe el codigo anterior no queda pisado
    por una lista vieja."""
    hechas = 0
    with tempfile.TemporaryDirectory() as tmp:
        home = pathlib.Path(tmp)
        env = entorno(home)

        def scope(*args):
            return subprocess.run([str(BIN / "wa-scope"), *args, "--json"],
                                  capture_output=True, text=True, env=env, timeout=180)

        def filas(*args):
            p = scope(*args)
            return json.loads(p.stdout or "[]") if p.returncode == 0 else []

        man = json.loads((RAIZ / "orca-plugin.json").read_text(encoding="utf-8"))
        base = ((home / "Library" / "Application Support" / "orca") if sys.platform == "darwin"
                else (home / ".config" / "orca"))
        store = base / "plugins-data" / f"{man['publisher']}.{man['id']}" / "storage.json"
        store.parent.mkdir(parents=True, exist_ok=True)

        def storage():
            return json.loads(store.read_text(encoding="utf-8")) if store.exists() else {}

        def guarda(**claves):
            datos = storage()
            datos.update(claves)
            store.write_text(json.dumps(datos), encoding="utf-8")

        def entrada(jid, **campos):
            datos = storage()
            datos.setdefault("scope", {})[jid] = dict(
                {"chatName": "Grupo Demo", "provider": "ninguno", "target": None,
                 "mode": "borrador"}, **campos)
            store.write_text(json.dumps(datos), encoding="utf-8")

        def fila(jid):
            return next((r for r in filas("list") if r.get("chat_jid") == jid), {})

        def columnas(jid):
            con = sqlite3.connect(db)
            try:
                r = con.execute("select workspace, workspaces from chat_scope where chat_jid=?",
                                (jid,)).fetchone()
            except sqlite3.OperationalError:
                return None
            finally:
                con.close()
            return (r[0], json.loads(r[1]) if r and r[1] else None) if r else None

        GRUPO, DIRECTO, OTRO = "300@g.us", "400@s.whatsapp.net", "500@g.us"
        PROYECTOS = [
            {"id": "alfa-demo", "name": "Alfa Demo", "path": "/srv/ejemplo/alfa-demo",
             "note": "Tienda en linea"},
            {"id": "beta-demo", "name": "Beta Demo", "path": "/srv/ejemplo/beta-demo",
             "note": "Sitio de reservas"},
            {"id": "gama-demo", "name": "Gama Demo", "path": "/srv/ejemplo/gama-demo",
             "note": ""}]
        guarda(projects=PROYECTOS)
        db = home / ".wa-inbox" / "scope.db"

        # ── Una base de antes: con `workspace` y sin la columna nueva.
        scope("set", GRUPO, "--provider", "ninguno", "--mode", "responder",
              "--workspace", "alfa-demo")
        scope("set", DIRECTO, "--provider", "ninguno", "--mode", "borrador")
        con = sqlite3.connect(db)
        if "workspaces" in {r[1] for r in con.execute("pragma table_info(chat_scope)")}:
            con.execute("alter table chat_scope drop column workspaces")
        con.commit()
        con.close()
        datos = storage()
        datos.pop("scope", None)
        store.write_text(json.dumps(datos), encoding="utf-8")
        scope("list")
        hechas += 3
        con = sqlite3.connect(db)
        cs = {r[1] for r in con.execute("pragma table_info(chat_scope)")}
        con.close()
        if "workspaces" not in cs:
            fallos.append("la migracion no agrego chat_scope.workspaces")
        if columnas(GRUPO) != ("alfa-demo", ["alfa-demo"]) or columnas(DIRECTO) != (None, []):
            fallos.append(f"la migracion no lleno la lista con el proyecto de antes: "
                          f"{columnas(GRUPO)!r} {columnas(DIRECTO)!r}")
        g = fila(GRUPO)
        if g.get("workspaces") != ["alfa-demo"] or g.get("workspace") != "alfa-demo":
            fallos.append(f"list no da la lista de un proyecto de una base de antes: {g!r}")

        # ── Un panel de antes: la entrada solo trae `workspace`.
        entrada(OTRO, workspace="beta-demo")
        hechas += 2
        o = fila(OTRO)
        if o.get("workspaces") != ["beta-demo"] or o.get("workspace") != "beta-demo":
            fallos.append(f"una entrada de un panel de antes no da [su proyecto]: {o!r}")
        scope("sync")
        if columnas(OTRO) != ("beta-demo", ["beta-demo"]) \
                or (storage().get("scope") or {}).get(OTRO, {}).get("workspaces") != ["beta-demo"]:
            fallos.append(f"el sync no guardo ni empujo la lista de un panel de antes: "
                          f"{columnas(OTRO)!r} {(storage().get('scope') or {}).get(OTRO)!r}")

        # ── set --workspaces: la lista, en orden, validada contra el catalogo.
        p = scope("set", GRUPO, "--workspaces", "beta-demo,no-existe")
        hechas += 2
        if p.returncode == 0 or "no-existe" not in (p.stderr + p.stdout):
            fallos.append(f"set --workspaces con un id fuera del catalogo no se rechaza: "
                          f"rc={p.returncode} {p.stderr.strip()[:160]}")
        if columnas(GRUPO) != ("alfa-demo", ["alfa-demo"]):
            fallos.append(f"un set rechazado igual toco la lista: {columnas(GRUPO)!r}")
        p = scope("set", GRUPO, "--workspaces", "beta-demo, alfa-demo")
        hechas += 5
        if p.returncode != 0:
            fallos.append(f"set --workspaces con dos proyectos falla: {p.stderr.strip()[:200]}")
        g = fila(GRUPO)
        if g.get("workspaces") != ["beta-demo", "alfa-demo"] or g.get("workspace") is not None:
            fallos.append(f"una lista de dos no da workspace=null y su orden: {g!r}")
        if columnas(GRUPO) != (None, ["beta-demo", "alfa-demo"]):
            fallos.append(f"la base no guarda la lista ni deriva workspace: {columnas(GRUPO)!r}")
        e = (storage().get("scope") or {}).get(GRUPO, {})
        if e.get("workspaces") != ["beta-demo", "alfa-demo"] or e.get("workspace") is not None:
            fallos.append(f"el panel no recibe la lista y el workspace derivado: {e!r}")
        p = scope("check", GRUPO, "--for", "observar")
        voz = filas("voice", GRUPO)
        chequeo = json.loads(p.stdout or "{}") if p.stdout.strip().startswith("{") else {}
        if chequeo.get("workspaces") != ["beta-demo", "alfa-demo"] or not voz \
                or voz[0].get("workspaces") != ["beta-demo", "alfa-demo"]:
            fallos.append(f"check y voice no devuelven la lista: {chequeo!r} {voz!r}")

        # --workspace sigue valiendo: una lista de un proyecto.
        scope("set", DIRECTO, "--workspace", "gama-demo")
        hechas += 1
        if columnas(DIRECTO) != ("gama-demo", ["gama-demo"]) \
                or fila(DIRECTO).get("workspaces") != ["gama-demo"]:
            fallos.append(f"set --workspace no deja una lista de uno: {columnas(DIRECTO)!r}")
        scope("set", DIRECTO, "--workspaces", "")
        hechas += 1
        if columnas(DIRECTO) != (None, []) or fila(DIRECTO).get("workspaces") != []:
            fallos.append(f"set --workspaces '' no vacia la lista: {columnas(DIRECTO)!r}")

        # ── El panel vacia la lista: `workspaces: []` manda.
        datos = storage()
        datos["scope"][GRUPO]["workspaces"] = []
        datos["scope"][GRUPO]["workspace"] = None
        store.write_text(json.dumps(datos), encoding="utf-8")
        hechas += 2
        if fila(GRUPO).get("workspaces") != []:
            fallos.append(f"workspaces: [] en el panel no vacia la lista: {fila(GRUPO)!r}")
        scope("sync")
        if columnas(GRUPO) != (None, []):
            fallos.append(f"el sync no vacio la lista en la base: {columnas(GRUPO)!r}")
        # Un panel nuevo que no escribe `workspace`: la lista sola manda.
        datos = storage()
        datos["scope"][GRUPO].pop("workspace", None)
        datos["scope"][GRUPO]["workspaces"] = ["alfa-demo", "gama-demo"]
        store.write_text(json.dumps(datos), encoding="utf-8")
        hechas += 1
        if fila(GRUPO).get("workspaces") != ["alfa-demo", "gama-demo"]:
            fallos.append(f"la lista del panel sin workspace no manda: {fila(GRUPO)!r}")
        # Un id que no tiene forma de id no pasa (id_proyecto).
        datos["scope"][GRUPO]["workspaces"] = ["alfa-demo", "../otro", 7, "alfa-demo"]
        store.write_text(json.dumps(datos), encoding="utf-8")
        hechas += 1
        if fila(GRUPO).get("workspaces") != ["alfa-demo"]:
            fallos.append(f"un id sin forma de id o repetido entra a la lista: {fila(GRUPO)!r}")

        # ── Un panel de antes que edito `workspace` con una lista vieja al lado: lo que
        # acaba de tocar el dueno es `workspace`, y la lista vieja no lo pisa.
        datos["scope"][GRUPO]["workspaces"] = ["alfa-demo"]
        datos["scope"][GRUPO]["workspace"] = "beta-demo"
        store.write_text(json.dumps(datos), encoding="utf-8")
        hechas += 1
        if fila(GRUPO).get("workspaces") != ["beta-demo"]:
            fallos.append(f"una lista vieja pisa el proyecto que edito un panel de antes: "
                          f"{fila(GRUPO)!r}")
        # Y lo mismo en la base: el codigo anterior escribe solo `workspace`.
        datos = storage()
        datos.pop("scope", None)
        store.write_text(json.dumps(datos), encoding="utf-8")
        scope("set", DIRECTO, "--workspaces", "alfa-demo,beta-demo")
        datos = storage()
        datos.pop("scope", None)
        store.write_text(json.dumps(datos), encoding="utf-8")
        con = sqlite3.connect(db)
        con.execute("update chat_scope set workspace='gama-demo' where chat_jid=?", (DIRECTO,))
        con.commit()
        con.close()
        hechas += 1
        if fila(DIRECTO).get("workspaces") != ["gama-demo"]:
            fallos.append(f"el proyecto que escribio el codigo anterior no se ve: "
                          f"{fila(DIRECTO)!r}")

        # ── Un id que el dueno quito del catalogo: se conserva en la lista y se dice.
        scope("set", DIRECTO, "--workspaces", "alfa-demo,beta-demo")
        guarda(projects=PROYECTOS[1:])
        scope("sync")
        hechas += 2
        if columnas(DIRECTO) != (None, ["alfa-demo", "beta-demo"]) \
                or fila(DIRECTO).get("workspaces") != ["alfa-demo", "beta-demo"]:
            fallos.append(f"un proyecto quitado del catalogo se borro de la lista: "
                          f"{columnas(DIRECTO)!r}")
        d = (filas("where", "hola", "--chat", DIRECTO) or [{}])[0]
        hechas += 1
        if d.get("missing") != ["alfa-demo"]:
            fallos.append(f"where no dice que un proyecto de la lista ya no esta: {d!r}")
        guarda(projects=PROYECTOS)

        # ── where (M2): la regla gana sobre la lista; sin regla, con dos proyectos no
        # elige nadie mas que el agente, y los candidatos van en orden.
        scope("set", DIRECTO, "--workspaces", "beta-demo,alfa-demo")
        scope("route", "--match", "reservas", "--workspace", "gama-demo")
        d = (filas("where", "una duda de reservas", "--chat", DIRECTO) or [{}])[0]
        hechas += 3
        if d.get("workspace") != "gama-demo" or d.get("matched") != "reservas" \
                or d.get("by") != "rule":
            fallos.append(f"la regla no gana sobre la lista del chat: {d!r}")
        d = (filas("where", "hola", "--chat", DIRECTO) or [{}])[0]
        if d.get("workspace") is not None or d.get("by") is not None \
                or d.get("workspace_why") != "the chat has 2 projects: the agent chooses by content":
            fallos.append(f"dos proyectos sin regla no dan null con su motivo: {d!r}")
        if [c.get("id") for c in d.get("candidates") or []] != ["beta-demo", "alfa-demo"] \
                or (d.get("candidates") or [{}])[0].get("note") != "Sitio de reservas" \
                or (d.get("candidates") or [{}])[0].get("name") != "Beta Demo":
            fallos.append(f"where no lista los candidatos del chat en orden: {d!r}")
        scope("set", DIRECTO, "--workspaces", "beta-demo")
        d = (filas("where", "hola", "--chat", DIRECTO) or [{}])[0]
        hechas += 1
        if d.get("workspace") != "beta-demo" or d.get("workspace_why") != "the chat's project" \
                or d.get("by") != "chat" or [c["id"] for c in d.get("candidates") or []] \
                != ["beta-demo"]:
            fallos.append(f"un chat de un proyecto no resuelve como siempre: {d!r}")
        # Con dos ids y uno quitado del catalogo queda un solo aceptado: ese es el del chat.
        scope("set", DIRECTO, "--workspaces", "alfa-demo,beta-demo")
        guarda(projects=PROYECTOS[1:])
        d = (filas("where", "hola", "--chat", DIRECTO) or [{}])[0]
        hechas += 1
        if d.get("workspace") != "beta-demo" or d.get("missing") != ["alfa-demo"]:
            fallos.append(f"con un solo proyecto aceptado en la lista no cae en ese: {d!r}")
        guarda(projects=PROYECTOS)
        # Un chat sin proyectos: sin candidatos, y nada que elegir.
        scope("set", DIRECTO, "--workspaces", "")
        d = (filas("where", "hola", "--chat", DIRECTO) or [{}])[0]
        hechas += 1
        if d.get("workspace") is not None or d.get("candidates") != [] or d.get("missing") != []:
            fallos.append(f"un chat sin proyectos no da candidatos vacios: {d!r}")

        # ── A quien se le pregunta "A o B?" (M5): `projectQuestion` por chat, auto de
        # fabrica, y `projectQuestionHours` global, 24 de fabrica.
        con = sqlite3.connect(db)
        cs = {r[1] for r in con.execute("pragma table_info(chat_scope)")}
        con.close()
        hechas += 1
        if "pregunta_proyecto" not in cs:
            fallos.append("la migracion no agrego chat_scope.pregunta_proyecto")
        voz = filas("voice", GRUPO)
        hechas += 1
        if not voz or voz[0].get("project_question") != "auto":
            fallos.append(f"voice no dice auto de fabrica: {voz!r}")
        p = scope("set", GRUPO, "--project-question", "nadie")
        hechas += 1
        if p.returncode == 0:
            fallos.append("set --project-question con un valor que no existe se acepta")
        p = scope("set", GRUPO, "--project-question", "writer")
        voz = filas("voice", GRUPO)
        hechas += 3
        if p.returncode != 0 or not voz or voz[0].get("project_question") != "writer":
            fallos.append(f"set --project-question writer no queda: {p.stderr.strip()[:160]} {voz!r}")
        if fila(GRUPO).get("pregunta_proyecto") != "writer":
            fallos.append(f"list no trae pregunta_proyecto: {fila(GRUPO)!r}")
        if (storage().get("scope") or {}).get(GRUPO, {}).get("projectQuestion") != "writer":
            fallos.append(f"el panel no recibe projectQuestion: {(storage().get('scope') or {}).get(GRUPO)!r}")
        datos = storage()
        datos["scope"][GRUPO]["projectQuestion"] = "owner"
        store.write_text(json.dumps(datos), encoding="utf-8")
        voz = filas("voice", GRUPO)
        hechas += 1
        if not voz or voz[0].get("project_question") != "owner":
            fallos.append(f"projectQuestion del panel no manda: {voz!r}")
        scope("sync")
        con = sqlite3.connect(db)
        guardado = con.execute("select pregunta_proyecto from chat_scope where chat_jid=?",
                               (GRUPO,)).fetchone()
        con.close()
        hechas += 1
        if guardado != ("owner",):
            fallos.append(f"el sync no guardo projectQuestion del panel: {guardado!r}")
        datos = storage()
        datos["scope"][GRUPO]["projectQuestion"] = "basura"
        store.write_text(json.dumps(datos), encoding="utf-8")
        voz = filas("voice", GRUPO)
        hechas += 1
        if not voz or voz[0].get("project_question") != "auto":
            fallos.append(f"un projectQuestion que no existe no vuelve a auto: {voz!r}")

        hechas += 4
        if valor(env, "project_question_hours") != "24":
            fallos.append(f"project_question_hours no es 24 de fabrica: "
                          f"{valor(env, 'project_question_hours')!r}")
        p = scope("config", "project_question_hours", "0")
        if p.returncode == 0 or valor(env, "project_question_hours") != "24":
            fallos.append("project_question_hours acepta cero")
        scope("config", "project_question_hours", "6")
        scope("sync")
        if storage().get("projectQuestionHours") != "6":
            fallos.append(f"el panel no recibe projectQuestionHours: "
                          f"{storage().get('projectQuestionHours')!r}")
        guarda(projectQuestionHours="3")
        if valor(env, "project_question_hours") != "3":
            fallos.append(f"projectQuestionHours del panel no manda: "
                          f"{valor(env, 'project_question_hours')!r}")
    return hechas


def revisa_rol_del_juicio(fallos: list) -> int:
    """El veredicto de Jev guarda el rol con que se juzgo (roles-por-numero, M10): una base
    con la tabla `juicio` de antes gana la columna `rol` sin perder sus veredictos, que
    quedan con `rol` null (juzgados con el binario dueno / participante de entonces)."""
    hechas = 0
    with tempfile.TemporaryDirectory() as tmp:
        home = pathlib.Path(tmp)
        env = entorno(home)
        db = home / ".wa-inbox" / "scope.db"
        db.parent.mkdir(parents=True, exist_ok=True)
        con = sqlite3.connect(db)
        con.executescript("""
            create table juicio (
              account text not null default 'local', chat_jid text not null,
              stanza_id text not null, clase text not null,
              origen text not null default 'agente', at text not null, jev text,
              primary key (account, chat_jid, stanza_id));
            insert into juicio (account, chat_jid, stanza_id, clase, origen, at, jev)
              values ('local', '100@g.us', 'J1', 'card', 'jev', '2026-10-01 09:00',
                      '{"flags": []}');""")
        con.commit()
        con.close()
        p = subprocess.run([str(BIN / "wa-scope"), "list", "--json"],
                           capture_output=True, text=True, env=env, timeout=120)
        hechas += 1
        if p.returncode != 0:
            fallos.append("wa-scope list se rompio migrando una tabla juicio sin rol: "
                          f"{(p.stderr or '').strip()[:200]}")
        con = sqlite3.connect(db)
        con.row_factory = sqlite3.Row
        hechas += 2
        if "rol" not in {r["name"] for r in con.execute("pragma table_info(juicio)")}:
            fallos.append("la migracion no le agrego la columna rol a juicio")
        else:
            fila = con.execute("select clase, jev, rol from juicio where stanza_id='J1'"
                               ).fetchone()
            if not fila or fila["clase"] != "card" or fila["jev"] != '{"flags": []}' \
                    or fila["rol"] is not None:
                fallos.append("agregar juicio.rol perdio o cambio un veredicto de antes: "
                              f"{dict(fila) if fila else None}")
        con.close()
    return hechas


def revisa_juicio(fallos: list) -> int:
    """La tabla `juicio` se agrega sola sobre una base vieja, y el veredicto se guarda
    una vez por llave (odd/tasks/juicio-cacheado.md, T1/T2).

    Sin esto el agente reclasifica los mismos 40 mensajes en cada corrida: medido en
    5.280 clasificaciones por dia contra 40 reales, ver el documento de la tarea.
    """
    hechas = 0
    with tempfile.TemporaryDirectory() as tmp:
        home = pathlib.Path(tmp)
        env = entorno(home)
        db = home / ".wa-inbox" / "scope.db"
        db.parent.mkdir(parents=True, exist_ok=True)

        # Una base YA existente, de antes de esta tarea: sin la tabla juicio. Agregarla
        # no puede perder ni pisar lo que ya estaba autorizado.
        con = sqlite3.connect(db)
        con.executescript("""
            create table chat_scope (
              account text not null default 'local', chat_jid text not null,
              chat_name text not null, provider text default 'plane', target text,
              mode text not null default 'off', initial_state text,
              hours text, tone text, instructions text, timezone text, notes text,
              updated_at text, primary key (account, chat_jid));
            insert into chat_scope (account, chat_jid, chat_name, mode)
              values ('local', '100@g.us', 'Grupo Viejo', 'observar');""")
        con.commit()
        con.close()

        p = subprocess.run([str(BIN / "wa-scope"), "list", "--json"],
                           capture_output=True, text=True, env=env, timeout=120)
        hechas += 1
        if p.returncode != 0:
            fallos.append("wa-scope list se rompio migrando una base sin la tabla "
                          f"juicio: {(p.stderr or '').strip()[:200]}")

        con = sqlite3.connect(db)
        con.row_factory = sqlite3.Row
        hechas += 2
        if not con.execute("pragma table_info(juicio)").fetchall():
            fallos.append("agregar la tabla juicio a una base existente no la creo")
        vieja = con.execute("select mode from chat_scope where chat_jid=?",
                            ("100@g.us",)).fetchone()
        if not vieja or vieja["mode"] != "observar":
            fallos.append("crear la tabla juicio perdio o piso lo que ya estaba en "
                          "chat_scope")
        con.close()

        # T2: el veredicto se guarda con el CLI y queda leible en la tabla.
        p = subprocess.run(
            [str(BIN / "wa-scope"), "juicio", "--account", "local", "--chat", "100@g.us",
             "--stanza", "S1", "--clase", "card", "--origen", "agente", "--json"],
            capture_output=True, text=True, env=env, timeout=120)
        hechas += 2
        if p.returncode != 0:
            fallos.append("wa-scope juicio rechazo un veredicto valido: "
                          f"{(p.stderr or p.stdout).strip()[:200]}")
        else:
            filas = json.loads(p.stdout or "[]")
            if not filas or filas[0].get("clase") != "card":
                fallos.append(f"wa-scope juicio no devolvio el veredicto guardado: "
                              f"{p.stdout!r}")

        con = sqlite3.connect(db)
        con.row_factory = sqlite3.Row
        guardado = con.execute(
            "select clase, origen from juicio where account=? and chat_jid=? "
            "and stanza_id=?", ("local", "100@g.us", "S1")).fetchone()
        con.close()
        hechas += 1
        if not guardado or guardado["clase"] != "card" or guardado["origen"] != "agente":
            fallos.append("el veredicto no quedo guardado en la tabla juicio: "
                          f"{dict(guardado) if guardado else None}")

        # La misma llave (account, chat_jid, stanza_id) actualiza, no duplica.
        subprocess.run(
            [str(BIN / "wa-scope"), "juicio", "--account", "local", "--chat", "100@g.us",
             "--stanza", "S1", "--clase", "nothing"],
            capture_output=True, text=True, env=env, timeout=120)
        con = sqlite3.connect(db)
        repetidas = con.execute(
            "select clase from juicio where account=? and chat_jid=? and stanza_id=?",
            ("local", "100@g.us", "S1")).fetchall()
        con.close()
        hechas += 2
        if len(repetidas) != 1:
            fallos.append(f"la misma llave dejo {len(repetidas)} filas en vez de "
                          "actualizar la unica que existe")
        elif repetidas[0][0] != "nothing":
            fallos.append(f"reescribir el veredicto no lo actualizo: quedo "
                          f"{repetidas[0][0]!r}")

        # Un valor fuera del vocabulario cerrado de STEP 7 se rechaza, no se guarda.
        p = subprocess.run(
            [str(BIN / "wa-scope"), "juicio", "--account", "local", "--chat", "100@g.us",
             "--stanza", "S2", "--clase", "basura"],
            capture_output=True, text=True, env=env, timeout=120)
        hechas += 2
        if p.returncode == 0:
            fallos.append("wa-scope juicio acepto una clase fuera del vocabulario "
                          "cerrado")
        con = sqlite3.connect(db)
        huerfano = con.execute("select 1 from juicio where stanza_id=?",
                               ("S2",)).fetchone()
        con.close()
        if huerfano:
            fallos.append("una clase invalida igual quedo guardada en la tabla")

        # El mismo vocabulario cerrado tiene que valer en wa_store: si discrepa, lo que
        # wa-scope acepta y lo que `inbox` reconoce como veredicto no son la misma cosa.
        wa_scope = cargar_modulo("wa_scope_juicio", BIN / "wa-scope")
        wa_store = cargar_modulo("wa_store_juicio", BIN / "wa_store.py")
        hechas += 1
        propio = getattr(wa_scope, "CLASES_JUICIO", None)
        ajeno = getattr(wa_store, "CLASES_JUICIO", None)
        if propio is None or ajeno is None or tuple(propio) != tuple(ajeno):
            fallos.append(f"CLASES_JUICIO discrepa: wa-scope tiene {propio!r} y "
                          f"wa_store tiene {ajeno!r}")
    return hechas


def revisa_insignia_nav(fallos: list) -> int:
    """La insignia del nav es `board.counts.decision`, y nada mas (kanban-casos, T10).

    Orca la lee de una clave reservada del storage del propio plugin -`navBadge`,
    plugin-nav-badge.ts- y nunca la escribe. Su contrato: un entero POSITIVO pinta
    insignia y cualquier otra cosa -cero, un texto, la clave ausente- no pinta
    ninguna, para que no quede un "0" colgado en la barra.

    Antes contaba las filas `alert` de la actividad y se quedaba pegada: un aviso ya
    atendido seguia sumando. Ahora sale del MISMO `board` que pinta la columna "Tu
    decision", escrito en la misma escritura: dos fuentes para el mismo numero es como
    el panel termino diciendo "nada pendiente" con dos tarjetas en pantalla. Sin un
    `board` valido no hay insignia.

    Se prueba corriendo el CLI de verdad y no leyendo la funcion, por lo mismo que el
    resto de este archivo.
    """
    hechas = 0
    with tempfile.TemporaryDirectory() as tmp:
        home = pathlib.Path(tmp)
        env = entorno(home)

        def scope(*args):
            return subprocess.run([str(BIN / "wa-scope"), *args], capture_output=True,
                                  text=True, env=env, timeout=180)

        man = json.loads((RAIZ / "orca-plugin.json").read_text(encoding="utf-8"))
        store = (home / "Library" / "Application Support" / "orca" / "plugins-data" /
                 f"{man['publisher']}.{man['id']}" / "storage.json")
        if sys.platform != "darwin":
            store = (home / ".config" / "orca" / "plugins-data" /
                     f"{man['publisher']}.{man['id']}" / "storage.json")

        def storage():
            return json.loads(store.read_text(encoding="utf-8")) if store.exists() else {}

        def insignia():
            return storage().get("navBadge")

        def en_decision(stanza):
            caso = json.loads(scope("caso", "crear", "--chat", "100@g.us", "--stanza",
                                    stanza, "--actor", "agente", "--json").stdout)[0]
            cid = str(caso["case_id"])
            scope("caso", "clasificar", cid, "--clase", "card", "--prioridad", "none",
                  "--actor", "agente")
            scope("caso", "propuesta", cid, "--tipo", "responder", "--respuesta", "Tomo esto.",
                  "--actor", "agente")
            return cid

        scope("set", "100@g.us", "--target", "SOP", "--mode", "responder")
        scope("sync")
        hechas += 1
        if insignia() != {"count": 0}:
            fallos.append(f"sin un solo caso en decision la insignia dice {insignia()!r}, "
                          "y con cero Orca no pinta nada — tiene que ser 0")

        # Un aviso de la bitacora ya no es una decision pendiente: no suma.
        scope("record", "--chat", "100@g.us", "--name", "G", "--stanza", "A1",
              "--action", "alert", "--detail", "Piden descuento | el precio no es mio")
        scope("sync")
        hechas += 1
        if insignia() != {"count": 0}:
            fallos.append(f"una fila alert de la bitacora movio la insignia a {insignia()!r}: "
                          "solo cuentan los casos en decision")

        uno = en_decision("D1")
        hechas += 1
        if insignia() != {"count": 1}:
            fallos.append(f"con UN caso en decision la insignia dice {insignia()!r} "
                          "en vez de 1, despues de la mutacion y sin esperar al sync")
        en_decision("D2")
        scope("sync")
        hechas += 1
        s = storage()
        if insignia() != {"count": 2} or (s.get("board") or {}).get(
                "counts", {}).get("decision") != 2:
            fallos.append(f"con dos casos en decision la insignia dice {insignia()!r} y "
                          f"el tablero {(s.get('board') or {}).get('counts')!r}")

        # Lo que se resuelve deja de contar: la insignia ya no se queda pegada.
        scope("caso", "mover", uno, "cerrado", "--motivo", "resuelto", "--actor", "dueno")
        hechas += 1
        if insignia() != {"count": 1}:
            fallos.append(f"cerrar un caso en decision dejo la insignia en {insignia()!r}")

        # Sin un `board` valido no se escribe insignia.
        wa = cargar_modulo("wa_scope_insignia", BIN / "wa-scope")
        antes = dict(os.environ)
        os.environ.update(env)
        try:
            for nombre, tablero in (("un board sin counts", {"v": 1}),
                                    ("un board de otra version", {"v": 2, "counts": {
                                        "decision": 3}}),
                                    ("un counts.decision que no es entero", {
                                        "v": 1, "counts": {"decision": "3"}})):
                wa.plugin_store_write(None, extra={"board": tablero})
                hechas += 1
                if "navBadge" in storage():
                    fallos.append(f"con {nombre} quedo la insignia {insignia()!r}")
        finally:
            os.environ.clear()
            os.environ.update(antes)

    return hechas


VIEJA = "pn:573001112233"
NUEVA = "pn:573000000012"


def almacen_con_lineas(home: pathlib.Path, activa: str) -> None:
    """Un capture.db con DOS numeros, armado por el escritor de verdad (el sidecar) y no
    a mano: el esquema es suyo. La vieja tiene el grupo 100, la nueva el 200."""
    js = (
        "import { abrirAlmacen, rutaAlmacen } from %r;"
        "const a = abrirAlmacen(rutaAlmacen({ HOME: process.env.HOME }));"
        "a.registrarLinea({ cuenta: %r, pn: '573001112233:7@s.whatsapp.net', nombre: 'Vieja' });"
        "a.anotarChat({ cuenta: %r, chatJid: '100@g.us', nombre: 'Grupo Viejo', esGrupo: 1 });"
        "a.registrarLinea({ cuenta: %r, lid: '100000000000002:1@lid', "
        "pn: '573000000012:7@s.whatsapp.net', nombre: 'Nueva' });"
        "a.anotarChat({ cuenta: %r, chatJid: '200@g.us', nombre: 'Grupo Nuevo', esGrupo: 1 });"
        # El chat de la linea consigo misma (T10), que se anota con su jid como nombre.
        "a.anotarChat({ cuenta: %r, chatJid: '100000000000002@lid', "
        "nombre: '100000000000002@lid', esGrupo: 0 });"
        "a.activarLinea(%r); a.latir(); a.cerrar();"
        % ((RAIZ / "sidecar" / "src" / "almacen.js").as_uri(), VIEJA, VIEJA, NUEVA, NUEVA,
           NUEVA, activa))
    subprocess.run([shutil.which("node") or "node", "--input-type=module", "-e", js],
                   env=entorno(home), check=True, capture_output=True, timeout=120)


def activar(home: pathlib.Path, cuenta: str) -> None:
    """Lo que hace el sidecar al abrir con otro numero: cambiar la linea activa."""
    con = sqlite3.connect(home / ".wa-inbox" / "capture.db")
    con.execute("update store_meta set value=? where key='linea_activa'", (cuenta,))
    con.commit()
    con.close()


def revisa_linea_por_numero(fallos: list) -> int:
    """Cada numero, su linea (T9). Visto en vivo el 2026-10-01: tras vincular OTRO
    numero, la linea nueva heredo las conversaciones, las autorizaciones en `responder`,
    los avisos, el rastro de la corrida y la insignia del numero viejo, porque todo
    colgaba de la cuenta fija `local`. Es una fuga de permisos entre lineas.

    Se recorre con el CLI de verdad sobre un HOME temporal: nunca contra ~/.wa-inbox."""
    hechas = 0
    if not shutil.which("node"):
        print("  aviso: sin node, no se armo el almacen de dos lineas", file=sys.stderr)
        return hechas
    with tempfile.TemporaryDirectory() as tmp:
        home = pathlib.Path(tmp)
        env = entorno(home)
        almacen_con_lineas(home, VIEJA)

        def scope(*args):
            return subprocess.run([str(BIN / "wa-scope"), *args], capture_output=True,
                                  text=True, env=env, timeout=180)

        man = json.loads((RAIZ / "orca-plugin.json").read_text(encoding="utf-8"))
        store = (home / "Library" / "Application Support" / "orca" / "plugins-data" /
                 f"{man['publisher']}.{man['id']}" / "storage.json")
        if sys.platform != "darwin":
            store = (home / ".config" / "orca" / "plugins-data" /
                     f"{man['publisher']}.{man['id']}" / "storage.json")

        def storage():
            return json.loads(store.read_text(encoding="utf-8")) if store.exists() else {}

        # Con el numero viejo vinculado: autoriza, avisa, deja un caso esperando al
        # dueno y corre.
        scope("set", "100@g.us", "--target", "SOP", "--mode", "responder")
        scope("record", "--chat", "100@g.us", "--name", "Grupo Viejo", "--stanza", "A1",
              "--action", "alert", "--detail", "Piden descuento | el precio no es mio")
        caso = json.loads(scope("caso", "crear", "--chat", "100@g.us", "--stanza", "A1",
                                "--actor", "agente", "--json").stdout or "[{}]")[0]
        scope("caso", "clasificar", str(caso.get("case_id")), "--clase", "card",
              "--prioridad", "none", "--actor", "agente")
        scope("caso", "propuesta", str(caso.get("case_id")), "--tipo", "responder",
              "--respuesta", "Tomo esto.", "--actor", "agente")
        scope("lock", "--note", "triage")
        scope("unlock")
        # Lo que dejo la version de antes: una autorizacion `local` en la base y otra
        # sin cuenta en el storage del panel. Las dos son de la linea vieja.
        con = sqlite3.connect(home / ".wa-inbox" / "scope.db")
        con.execute("insert into chat_scope (account, chat_jid, chat_name, mode) "
                    "values ('local', '300@g.us', 'Legado', 'responder')")
        con.commit()
        con.close()
        datos = storage()
        datos.setdefault("scope", {})["400@g.us"] = {"chatName": "Legado Panel",
                                                     "mode": "responder"}
        store.write_text(json.dumps(datos), encoding="utf-8")

        # Se vincula OTRO numero.
        activar(home, NUEVA)
        hechas += 1
        lista = json.loads(scope("list", "--json").stdout or "[]")
        if lista:
            fallos.append(f"con el numero nuevo vinculado, `wa-scope list` hereda "
                          f"{[f.get('chat_jid') for f in lista]}: el numero nuevo empieza "
                          "sin autorizaciones")
        corrida = json.loads(scope("run", "--json").stdout or "[{}]")[0]
        hechas += 1
        if corrida.get("state") != "never" or corrida.get("mapped") or corrida.get("authorized"):
            fallos.append(f"con el numero nuevo, `wa-scope run` muestra la corrida del "
                          f"viejo: {corrida!r}")
        scope("sync")
        s = storage()
        act = s.get("activity") or {}
        hechas += 6
        if s.get("scope"):
            fallos.append(f"el storage del panel sigue con las autorizaciones del numero "
                          f"viejo: {sorted(s['scope'])}")
        if act.get("recent"):
            fallos.append(f"'lo ultimo que hizo' del numero nuevo trae lo del viejo: "
                          f"{act['recent']!r}")
        if (s.get("navBadge") or {}).get("count") != 0:
            fallos.append(f"la insignia del numero nuevo cuenta los casos del viejo: "
                          f"{s.get('navBadge')!r}")
        if act.get("authorized") or act.get("mapped"):
            fallos.append(f"la cobertura del numero nuevo cuenta las del viejo: "
                          f"{act.get('authorized')} de {act.get('mapped')}")
        if act.get("account") != NUEVA:
            fallos.append(f"la actividad no dice de que linea es: account={act.get('account')!r}")
        if sorted(c.get("jid") for c in s.get("chats") or []) != [
                "100000000000002@lid", "200@g.us"]:
            fallos.append(f"el selector del numero nuevo ofrece "
                          f"{[c.get('jid') for c in s.get('chats') or []]}")
        # T10: el chat propio llega al panel marcado y con el nombre de la linea, no con
        # su jid pelado.
        propio = next((c for c in s.get("chats") or []
                       if c.get("jid") == "100000000000002@lid"), {})
        hechas += 1
        if propio.get("own") is not True or propio.get("name") != "Nueva":
            fallos.append(f"el chat propio de la linea llega al panel como {propio!r}")

        # Lo que se escribe con el numero nuevo vinculado es del numero nuevo, en TODAS
        # las tablas: el `default 'local'` de las columnas nuevas es solo para las filas
        # de antes, y una fila nueva que cayera ahi seria la fuga otra vez.
        def locales():
            c = sqlite3.connect(home / ".wa-inbox" / "scope.db")
            n = {t: c.execute(f"select count(*) from {t} where account='local'").fetchone()[0]
                 for t in ("chat_scope", "agent_action", "work", "digest", "juicio")}
            c.close()
            return n
        antes = locales()
        scope("set", "200@g.us", "--target", "NEW", "--mode", "observar")
        scope("record", "--chat", "200@g.us", "--name", "Grupo Nuevo", "--stanza", "N1",
              "--action", "issue", "--detail", "")
        scope("check", "999@g.us", "--for", "responder")
        scope("work", "--stanza", "N1", "--chat", "200@g.us", "--name", "Grupo Nuevo",
              "--next", "seguir")
        scope("juicio", "--chat", "200@g.us", "--stanza", "N1", "--clase", "card")
        scope("rotate", "--keep", "0")
        scope("lock")
        scope("unlock")
        hechas += 2
        if locales() != antes:
            fallos.append(f"con el numero nuevo vinculado se escribieron filas `local`: "
                          f"{antes!r} -> {locales()!r}")
        c = sqlite3.connect(home / ".wa-inbox" / "scope.db")
        nuevas = {t: c.execute(f"select count(*) from {t} where account=?", (NUEVA,)).fetchone()[0]
                  for t in ("chat_scope", "work", "digest", "juicio")}
        rastro_nuevo = c.execute("select count(*) from run_trace where name=?",
                                 (f"triage@{NUEVA}",)).fetchone()[0]
        c.close()
        if not all(nuevas.values()) or not rastro_nuevo:
            fallos.append(f"lo escrito con el numero nuevo no quedo con su cuenta: {nuevas!r}, "
                          f"rastro={rastro_nuevo}")

        # Vuelve el numero viejo: todo reaparece, nada se borro.
        activar(home, VIEJA)
        lista = {f.get("chat_jid"): f.get("mode")
                 for f in json.loads(scope("list", "--json").stdout or "[]")}
        hechas += 1
        if lista.get("100@g.us") != "responder":
            fallos.append(f"al volver el numero viejo su autorizacion no reaparece: {lista!r}")
        corrida = json.loads(scope("run", "--json").stdout or "[{}]")[0]
        hechas += 1
        if corrida.get("state") != "ok":
            fallos.append(f"al volver el numero viejo su corrida no reaparece: {corrida!r}")
        scope("sync")
        s = storage()
        hechas += 1
        if (s.get("navBadge") or {}).get("count") != 1:
            fallos.append(f"al volver el numero viejo su caso en decision no reaparece "
                          f"en la insignia: "
                          f"{s.get('navBadge')!r}")
        # Lo de antes sin cuenta sigue guardado como `local`: no se lo apropia nadie
        # hasta que la migracion lo atribuya.
        con = sqlite3.connect(home / ".wa-inbox" / "scope.db")
        legado = {r[0] for r in con.execute(
            "select chat_jid from chat_scope where account='local'")}
        con.close()
        hechas += 1
        if legado != {"300@g.us", "400@g.us"}:
            fallos.append(f"las autorizaciones de antes no quedaron guardadas como "
                          f"`local`: {sorted(legado)}")
    return hechas


def revisa_telefono_de_lid(fallos: list) -> int:
    """WhatsApp guarda los directos con un id interno (`<digitos>@lid`) y ya no muestra el
    numero. El sidecar anota el telefono de cada LID (`lid_telefono`); `wa-read chats` lo
    publica como `phone` y `wa-scope sync` lo lleva al panel, que lo muestra y lo busca.
    Un directo por telefono lo trae en su propio jid; un grupo, o un LID sin par, null.

    Y un almacen que todavia no tiene la tabla (el sidecar de antes sigue corriendo) se
    sigue leyendo: el telefono es un dato de mas, no una condicion para listar."""
    hechas = 0
    if not shutil.which("node"):
        print("  aviso: sin node, no se armo el almacen con telefonos", file=sys.stderr)
        return hechas
    lid, tel = "111122223333@lid", "573007776655@s.whatsapp.net"
    sin_par, directo, grupo = "111122224444@lid", "573000000002@s.whatsapp.net", "300@g.us"
    with tempfile.TemporaryDirectory() as tmp:
        home = pathlib.Path(tmp)
        env = entorno(home)
        js = (
            "import { abrirAlmacen, rutaAlmacen } from %r;"
            "const a = abrirAlmacen(rutaAlmacen({ HOME: process.env.HOME }));"
            "a.registrarLinea({ cuenta: %r, pn: '573000000012:7@s.whatsapp.net', nombre: 'L' });"
            "for (const [j, n, g] of [[%r, 'Persona', 0], [%r, '', 0], [%r, 'Otra', 0],"
            " [%r, 'Grupo', 1]]) a.anotarChat({ cuenta: %r, chatJid: j, nombre: n, esGrupo: g });"
            "a.anotarTelefono({ cuenta: %r, lid: %r, pn: %r });"
            "a.activarLinea(%r); a.latir(); a.cerrar();"
            % ((RAIZ / "sidecar" / "src" / "almacen.js").as_uri(), NUEVA, lid, sin_par,
               directo, grupo, NUEVA, NUEVA, lid, tel, NUEVA))
        subprocess.run([shutil.which("node") or "node", "--input-type=module", "-e", js],
                       env=env, check=True, capture_output=True, timeout=120)

        def leer():
            p = subprocess.run([str(BIN / "wa-read"), "chats", "--json"], capture_output=True,
                               text=True, env=env, timeout=120)
            try:
                return {c.get("jid"): c for c in json.loads(p.stdout or "[]")}, p.stderr
            except ValueError:
                return {}, p.stderr

        chats, err = leer()
        esperado = {lid: "+573007776655", sin_par: None, directo: "+573000000002", grupo: None}
        hechas += 1
        visto = {j: (chats.get(j) or {}).get("phone", "falta") for j in esperado}
        if visto != esperado:
            fallos.append(f"`wa-read chats --json` publica los telefonos {visto!r}, se "
                          f"esperaba {esperado!r} {err.strip()[-200:]}")

        man = json.loads((RAIZ / "orca-plugin.json").read_text(encoding="utf-8"))
        base = (home / ".config" if sys.platform != "darwin"
                else home / "Library" / "Application Support")
        store = base / "orca" / "plugins-data" / f"{man['publisher']}.{man['id']}" / "storage.json"
        subprocess.run([str(BIN / "wa-scope"), "sync"], capture_output=True, text=True,
                       env=env, timeout=180)
        datos = json.loads(store.read_text(encoding="utf-8")) if store.exists() else {}
        hechas += 1
        al_panel = {c.get("jid"): c.get("phone", "falta") for c in datos.get("chats") or []}
        if al_panel.get(lid) != "+573007776655" or al_panel.get(grupo) is not None:
            fallos.append(f"`wa-scope sync` no lleva el telefono al panel: {al_panel!r}")

        con = sqlite3.connect(home / ".wa-inbox" / "capture.db")
        con.execute("drop table lid_telefono")
        con.commit()
        con.close()
        chats, err = leer()
        hechas += 1
        if (chats.get(directo) or {}).get("phone") != "+573000000002" or \
                (chats.get(lid) or {}).get("phone") is not None:
            fallos.append(f"sin la tabla de telefonos, `wa-read chats` contesta "
                          f"{list(chats.values())!r} {err.strip()[-200:]}")
    return hechas


def revisa_miembros(fallos: list) -> int:
    """`wa-read members --chat <jid> --json` (roles-por-numero, M8): quien esta en un grupo,
    para que el dueno le de un rol desde el panel. El contrato que lee el panel es
    `[{id, name, phone, wa_admin}]`: el id sin dispositivo, el nombre del ultimo mensaje o
    de la libreta, el telefono por el propio jid o por el par LID-telefono (si no, null), y
    lo que dice WhatsApp de admin. La linea misma no sale. Sin `--chat` no hay respuesta."""
    hechas = 0
    if not shutil.which("node"):
        print("  aviso: sin node, no se armo el almacen con miembros", file=sys.stderr)
        return hechas
    grupo, lid, tel, directo = ("120363000000000077@g.us", "111122223333@lid",
                                "573007776655@s.whatsapp.net", "573000000002@s.whatsapp.net")
    propio = "100000000000002@lid"
    with tempfile.TemporaryDirectory() as tmp:
        home = pathlib.Path(tmp)
        env = entorno(home)
        js = (
            "import { abrirAlmacen, rutaAlmacen } from %r;"
            "import { ingerirMiembros } from %r;"
            "const a = abrirAlmacen(rutaAlmacen({ HOME: process.env.HOME }));"
            "a.registrarLinea({ cuenta: %r, lid: %r, pn: '573000000012:7@s.whatsapp.net', "
            "nombre: 'L' });"
            "a.anotarChat({ cuenta: %r, chatJid: %r, nombre: 'Grupo Demo', esGrupo: 1 });"
            "a.anotarChat({ cuenta: %r, chatJid: %r, nombre: 'Persona Dos', esGrupo: 0 });"
            "const yo = new Set([%r, '573000000012@s.whatsapp.net']);"
            "ingerirMiembros({ almacen: a, cuenta: %r, esPropio: (j) => yo.has(j), grupos: ["
            "{ id: %r, participants: [{ id: %r, jid: %r, lid: %r, admin: 'superadmin' },"
            " { id: %r, admin: null }, { id: %r, admin: 'admin' }] }] });"
            "a.activarLinea(%r); a.latir(); a.cerrar();"
            % ((RAIZ / "sidecar" / "src" / "almacen.js").as_uri(),
               (RAIZ / "sidecar" / "src" / "ingesta.js").as_uri(), NUEVA, propio + ":1",
               NUEVA, grupo, NUEVA, directo, propio, NUEVA, grupo, "111122223333:3@lid", tel, lid,
               directo, propio, NUEVA))
        subprocess.run([shutil.which("node") or "node", "--input-type=module", "-e", js],
                       env=env, check=True, capture_output=True, timeout=120)

        p = subprocess.run([str(BIN / "wa-read"), "members", "--chat", grupo, "--json"],
                           capture_output=True, text=True, env=env, timeout=120)
        try:
            filas = json.loads(p.stdout or "null")
        except ValueError:
            filas = None
        esperado = [{"id": directo, "name": "Persona Dos", "phone": "+573000000002",
                     "wa_admin": False},
                    {"id": lid, "name": "", "phone": "+573007776655", "wa_admin": True}]
        hechas += 1
        if p.returncode != 0 or filas != esperado:
            fallos.append(f"`wa-read members --chat` contesta {filas!r} (salio "
                          f"{p.returncode}), se esperaba {esperado!r} {p.stderr.strip()[-200:]}")
        p = subprocess.run([str(BIN / "wa-read"), "members", "--json"], capture_output=True,
                           text=True, env=env, timeout=120)
        hechas += 1
        if p.returncode == 0 or p.stdout.strip():
            fallos.append(f"`wa-read members` sin --chat contesta {p.stdout!r} (salio "
                          f"{p.returncode}): tiene que negarse")
    return hechas


def revisa_roles(fallos: list) -> int:
    """Los roles por numero (roles-por-numero, M9). El dueno marca a una persona Operador o
    Super admin de UNA conversacion; Cliente es lo de siempre y no se guarda.

    - `chat_scope.miembros` es un JSON `{id: operator|admin}`; una base de antes recibe la
      columna y sigue igual (nadie tiene rol).
    - El panel guarda `scope[jid].members: [{id, name, role}]`, que se fusiona, se persiste
      y se empuja como `approval`; una entrada de un panel anterior no trae la clave y vale
      la base. `role: client` y un id sin forma de id no se guardan.
    - `wa-scope set --member <id>=operator|admin|client` (client lo quita), y el id tiene
      que tener forma de id de persona.
    - `wa-scope sync` empuja `groupMembers: {jid: [{id, name, phone}]}` de los grupos del
      alcance, al lado de `senders`.
    - `wa_store.rol_de`: un dueno global es admin en todos lados; si no, el rol guardado en
      ESA conversacion; un LID y un telefono son la misma persona solo por un par de
      `lid_telefono`, nunca por los digitos."""
    hechas = 0
    GRUPO, OTRO, DIRECTO = "300@g.us", "500@g.us", "573000000002@s.whatsapp.net"
    OPER, JEFA, NADIE = "111122223333@lid", "111122224444@lid", "111122225555@lid"
    OPER_TEL = "573007776655@s.whatsapp.net"
    with tempfile.TemporaryDirectory() as tmp:
        home = pathlib.Path(tmp)
        env = entorno(home)

        def scope(*args):
            return subprocess.run([str(BIN / "wa-scope"), *args, "--json"],
                                  capture_output=True, text=True, env=env, timeout=180)

        man = json.loads((RAIZ / "orca-plugin.json").read_text(encoding="utf-8"))
        base = ((home / "Library" / "Application Support" / "orca") if sys.platform == "darwin"
                else (home / ".config" / "orca"))
        store = base / "plugins-data" / f"{man['publisher']}.{man['id']}" / "storage.json"
        store.parent.mkdir(parents=True, exist_ok=True)

        def storage():
            return json.loads(store.read_text(encoding="utf-8")) if store.exists() else {}

        def escribe(datos):
            store.write_text(json.dumps(datos), encoding="utf-8")

        db = home / ".wa-inbox" / "scope.db"

        def columna(jid):
            con = sqlite3.connect(db)
            try:
                r = con.execute("select miembros from chat_scope where chat_jid=?",
                                (jid,)).fetchone()
            except sqlite3.OperationalError:
                return "sin columna"
            finally:
                con.close()
            return json.loads(r[0]) if r and r[0] else {}

        def miembros_de(jid):
            p = scope("list")
            filas = json.loads(p.stdout or "[]") if p.returncode == 0 else []
            return next((r.get("miembros") for r in filas if r.get("chat_jid") == jid),
                        "sin fila")

        # ── Una base de antes: sin la columna.
        scope("set", GRUPO, "--provider", "ninguno", "--mode", "borrador")
        scope("set", DIRECTO, "--provider", "ninguno", "--mode", "borrador")
        con = sqlite3.connect(db)
        if "miembros" in {r[1] for r in con.execute("pragma table_info(chat_scope)")}:
            con.execute("alter table chat_scope drop column miembros")
        con.commit()
        con.close()
        escribe({k: v for k, v in storage().items() if k != "scope"})
        hechas += 1
        if miembros_de(GRUPO) != {} or columna(GRUPO) != {}:
            fallos.append(f"una base de antes no queda sin roles: list {miembros_de(GRUPO)!r}, "
                          f"columna {columna(GRUPO)!r}")

        # ── set --member: operator, admin; client lo quita; un id o un rol que no existe no.
        scope("set", GRUPO, "--member", f"{OPER.split('@')[0]}:4@lid=operator",
              "--member", f"{JEFA}=admin")
        hechas += 1
        if columna(GRUPO) != {OPER: "operator", JEFA: "admin"}:
            fallos.append(f"`set --member` no guardo los roles sin dispositivo: "
                          f"{columna(GRUPO)!r}")
        scope("set", GRUPO, "--member", f"{JEFA}=client")
        hechas += 1
        if columna(GRUPO) != {OPER: "operator"}:
            fallos.append(f"`--member <id>=client` no quito el rol: {columna(GRUPO)!r}")
        for malo in (f"{OTRO}=operator", "alguien=operator", f"{NADIE}=jefe", NADIE):
            p = scope("set", GRUPO, "--member", malo)
            hechas += 1
            if p.returncode == 0 or columna(GRUPO) != {OPER: "operator"}:
                fallos.append(f"`--member {malo}` se acepto: salio {p.returncode}, quedo "
                              f"{columna(GRUPO)!r}")
        hechas += 1
        if miembros_de(OTRO) not in ("sin fila", {}) or columna(DIRECTO) != {}:
            fallos.append("un rol de un chat aparecio en otro")

        # ── El panel: members [{id, name, role}] manda, se persiste y vuelve con nombre.
        datos = storage()
        datos.setdefault("scope", {})[GRUPO] = {
            "chatName": "Grupo Demo", "provider": "ninguno", "target": None,
            "mode": "borrador", "members": [
                {"id": OPER, "name": "Persona Operadora", "role": "operator"},
                {"id": JEFA, "name": "Persona Jefa", "role": "admin"},
                {"id": NADIE, "name": "Persona Cliente", "role": "client"},
                {"id": "basura", "name": "X", "role": "admin"},
                {"id": OTRO, "name": "Grupo", "role": "operator"},
                {"id": OPER_TEL, "name": "Rol Raro", "role": "jefe"}]}
        escribe(datos)
        hechas += 1
        if miembros_de(GRUPO) != {OPER: "operator", JEFA: "admin"}:
            fallos.append(f"`members` del panel no manda: {miembros_de(GRUPO)!r}")
        scope("sync")
        hechas += 1
        if columna(GRUPO) != {OPER: "operator", JEFA: "admin"}:
            fallos.append(f"el sync no guardo `members` del panel: {columna(GRUPO)!r}")
        empujados = ((storage().get("scope") or {}).get(GRUPO) or {}).get("members")
        hechas += 1
        if empujados != [{"id": OPER, "name": "Persona Operadora", "role": "operator"},
                         {"id": JEFA, "name": "Persona Jefa", "role": "admin"}]:
            fallos.append(f"el panel no recibe `members` con su nombre: {empujados!r}")
        directo = ((storage().get("scope") or {}).get(DIRECTO) or {}).get("members")
        hechas += 1
        if directo != []:
            fallos.append(f"un chat sin roles no recibe `members: []`: {directo!r}")

        # Una entrada de un panel anterior (sin `members`) no borra lo de la base.
        datos = storage()
        datos["scope"][GRUPO].pop("members", None)
        escribe(datos)
        scope("sync")
        hechas += 1
        if columna(GRUPO) != {OPER: "operator", JEFA: "admin"} or \
                miembros_de(GRUPO) != {OPER: "operator", JEFA: "admin"}:
            fallos.append(f"un panel anterior borro los roles: {columna(GRUPO)!r}")
        # `set --member` corrige tambien la entrada del panel, que si no lo pisaria.
        scope("set", GRUPO, "--member", f"{JEFA}=client")
        hechas += 1
        if miembros_de(GRUPO) != {OPER: "operator"} or columna(GRUPO) != {OPER: "operator"}:
            fallos.append(f"`set --member` no gano sobre la entrada del panel: "
                          f"{miembros_de(GRUPO)!r} {columna(GRUPO)!r}")
        # Y el panel que vacia la lista la vacia.
        datos = storage()
        datos["scope"][GRUPO]["members"] = []
        escribe(datos)
        scope("sync")
        hechas += 1
        if columna(GRUPO) != {}:
            fallos.append(f"`members: []` del panel no vacio los roles: {columna(GRUPO)!r}")
        # El panel quita un rol y, antes del proximo sync, alguien corre `set --member` con
        # otra persona: el rol quitado no vuelve. `set` parte de lo fusionado (lo del panel
        # manda, como en `merged_scope`), no de la columna que el sync todavia no corrigio.
        scope("set", GRUPO, "--member", f"{OPER}=operator")
        scope("sync")
        datos = storage()
        datos["scope"][GRUPO]["members"] = []
        escribe(datos)
        p = scope("set", GRUPO, "--member", f"{JEFA}=operator")
        empujados = [m.get("id") for m in (((storage().get("scope") or {}).get(GRUPO) or {})
                                           .get("members") or [])]
        hechas += 1
        if p.returncode != 0 or columna(GRUPO) != {JEFA: "operator"} or \
                miembros_de(GRUPO) != {JEFA: "operator"} or empujados != [JEFA]:
            fallos.append(f"`set --member` devolvio un rol que el panel quito: salio "
                          f"{p.returncode}, columna {columna(GRUPO)!r}, list "
                          f"{miembros_de(GRUPO)!r}, panel {empujados!r}")
        scope("set", GRUPO, "--member", f"{JEFA}=client")

        # ── groupMembers: los miembros de los grupos del alcance, al lado de senders.
        if shutil.which("node"):
            js = (
                "import { abrirAlmacen, rutaAlmacen } from %r;"
                "const a = abrirAlmacen(rutaAlmacen({ HOME: process.env.HOME }));"
                "a.registrarLinea({ cuenta: %r, pn: '573000000012:7@s.whatsapp.net', "
                "nombre: 'L' });"
                "a.anotarChat({ cuenta: %r, chatJid: %r, nombre: 'Grupo Demo', esGrupo: 1 });"
                "a.anotarChat({ cuenta: %r, chatJid: %r, nombre: 'Fuera', esGrupo: 1 });"
                "a.reemplazarMiembros({ cuenta: %r, chatJid: %r, miembros: ["
                "{ jid: %r, admin: 1 }, { jid: %r, admin: 0 }] });"
                "a.reemplazarMiembros({ cuenta: %r, chatJid: %r, miembros: [{ jid: %r }] });"
                "a.anotarTelefono({ cuenta: %r, lid: %r, pn: %r });"
                "a.activarLinea(%r); a.latir(); a.cerrar();"
                % ((RAIZ / "sidecar" / "src" / "almacen.js").as_uri(), NUEVA, NUEVA, GRUPO,
                   NUEVA, OTRO, NUEVA, GRUPO, OPER, NADIE, NUEVA, OTRO, JEFA, NUEVA, OPER,
                   OPER_TEL, NUEVA))
            subprocess.run([shutil.which("node") or "node", "--input-type=module", "-e", js],
                           env=env, check=True, capture_output=True, timeout=120)
            # El alcance de la linea vinculada: los chats de antes eran de `local`.
            datos = storage()
            for e in (datos.get("scope") or {}).values():
                e["account"] = NUEVA
            escribe(datos)
            con = sqlite3.connect(db)
            con.execute("update chat_scope set account=?", (NUEVA,))
            con.commit()
            con.close()
            scope("sync")
            grupos = storage().get("groupMembers")
            hechas += 1
            if grupos != {GRUPO: [{"id": OPER, "name": "", "phone": "+573007776655"},
                                  {"id": NADIE, "name": "", "phone": None}]}:
                fallos.append(f"`sync` no empuja groupMembers de los grupos del alcance: "
                              f"{grupos!r}")

    # ── rol_de, la regla, con un almacen de verdad para los pares LID-telefono.
    wa_store = cargar_modulo("wa_store_roles", BIN / "wa_store.py")
    con = sqlite3.connect(":memory:")
    con.row_factory = sqlite3.Row
    con.execute("create table lid_telefono (account text, lid text, pn text, updated_at "
                "integer)")
    DUENO_LID, DUENO_TEL = "100000000000001@lid", "573000000001@s.whatsapp.net"
    con.executemany("insert into lid_telefono values (?,?,?,0)", [
        (NUEVA, DUENO_LID, DUENO_TEL), (NUEVA, OPER, OPER_TEL)])
    roles = {GRUPO: {OPER: "operator", JEFA: "admin"}, OTRO: {}}
    casos = [
        ("un dueno global es admin en un chat sin roles",
         (con, NUEVA, OTRO, DUENO_LID, [DUENO_LID], roles), "admin"),
        ("y en uno donde lo marcaron operador",
         (con, NUEVA, GRUPO, DUENO_LID, [DUENO_LID], {GRUPO: {DUENO_LID: "operator"}}), "admin"),
        ("y con el dispositivo en el id", (con, NUEVA, GRUPO, "100000000000001:9@lid",
                                           [DUENO_LID], roles), "admin"),
        ("el operador de un grupo es operador ahi", (con, NUEVA, GRUPO, OPER, [], roles),
         "operator"),
        ("y cliente en otro chat", (con, NUEVA, OTRO, OPER, [], roles), "client"),
        ("y cliente en un chat que no tiene entrada", (con, NUEVA, "600@g.us", OPER, [], roles),
         "client"),
        ("un admin de un grupo es admin ahi", (con, NUEVA, GRUPO, JEFA, [], roles), "admin"),
        ("quien no esta es cliente", (con, NUEVA, GRUPO, NADIE, [], roles), "client"),
        # El dueno global es su id EXACTO, como `es_dueno`, `chat_del_dueno` y
        # `caso_del_dueno` (v4.16.0): el par no lo vuelve dueno por el otro id. Cambiado en la
        # verificacion: decia "admin", y eso partia al dueno en dos (roles-por-numero).
        ("el dueno guardado por telefono escribe con su LID: sin roles, como en v4.16.0",
         (con, NUEVA, OTRO, DUENO_LID, [DUENO_TEL], roles), "client"),
        ("ni en su directo por LID", (con, NUEVA, DUENO_LID, None, [DUENO_TEL], {}), "client"),
        ("el par si une a quien el dueno le dio un rol en ESE chat",
         (con, NUEVA, GRUPO, DUENO_LID, [DUENO_TEL], {GRUPO: {DUENO_TEL: "operator"}}),
         "operator"),
        ("el operador guardado por LID escribe con su telefono: el par lo une",
         (con, NUEVA, GRUPO, OPER_TEL, [], roles), "operator"),
        ("sin el par no se une: el LID de otra persona con el mismo numero no es el dueno",
         (con, NUEVA, OTRO, "573000000001@lid", [DUENO_TEL], roles), "client"),
        ("ni el par de otra linea", (con, VIEJA, GRUPO, OPER_TEL, [], roles), "client"),
        ("sin almacen no hay pares", (None, NUEVA, GRUPO, OPER_TEL, [], roles), "client"),
        ("en un directo sin remitente, el que escribe es la conversacion",
         (con, NUEVA, DIRECTO, None, [], {DIRECTO: {DIRECTO: "operator"}}), "operator"),
        ("en un grupo sin remitente, nadie: cliente",
         (con, NUEVA, GRUPO, None, [], roles), "client"),
        ("un rol que no existe guardado a mano no da nada",
         (con, NUEVA, GRUPO, NADIE, [], {GRUPO: {NADIE: "jefe"}}), "client"),
        ("sin roles guardados (una base de antes) solo el dueno es admin",
         (con, NUEVA, GRUPO, OPER, [DUENO_LID], {}), "client"),
    ]
    rol_de = getattr(wa_store, "rol_de", None)
    for nombre, args, esperado in casos:
        hechas += 1
        try:
            visto = rol_de(*args) if rol_de else "no existe wa_store.rol_de"
        except Exception as error:  # noqa: BLE001 - lo que se reporta es el fallo
            visto = f"revento: {error}"
        if visto != esperado:
            fallos.append(f"rol_de: {nombre}: {visto!r}, se esperaba {esperado!r}")
    con.close()
    return hechas


def revisa_reclave_local(fallos: list) -> int:
    """T9f: lo que colgaba de `local` en scope.db pasa al numero de su linea, al MISMO
    numero que anoto el sidecar en capture.db. Explicito: ningun comando de todos los
    dias lo hace solo, porque en una maquina con la fila `local` pisada por otro numero
    le daria al nuevo lo del viejo."""
    hechas = 0
    if not shutil.which("node"):
        print("  aviso: sin node, no se armo el almacen de la re-clave", file=sys.stderr)
        return hechas
    with tempfile.TemporaryDirectory() as tmp:
        home = pathlib.Path(tmp)
        env = entorno(home)

        def scope(*args):
            return subprocess.run([str(BIN / "wa-scope"), *args], capture_output=True,
                                  text=True, env=env, timeout=180)

        # Una maquina de antes de T9: todo en `local`, en las dos bases y en el panel.
        scope("set", "100@g.us", "--target", "SOP", "--mode", "responder")
        scope("record", "--chat", "100@g.us", "--name", "G", "--stanza", "A1",
              "--action", "alert", "--detail", "aviso | de antes")
        scope("work", "--stanza", "W1", "--chat", "100@g.us", "--name", "G", "--next", "x")
        scope("juicio", "--chat", "100@g.us", "--stanza", "A1", "--clase", "alert")
        scope("lock")
        scope("unlock")
        man = json.loads((RAIZ / "orca-plugin.json").read_text(encoding="utf-8"))
        store = (home / ("Library/Application Support" if sys.platform == "darwin"
                         else ".config") / "orca" / "plugins-data" /
                 f"{man['publisher']}.{man['id']}" / "storage.json")
        datos = json.loads(store.read_text(encoding="utf-8")) if store.exists() else {}
        datos.setdefault("scope", {})["400@g.us"] = {"chatName": "Del panel",
                                                     "mode": "observar"}
        datos["decisions"] = {"A1": {"decision": "take", "at": "2026-09-24T08:00:00Z"}}
        store.parent.mkdir(parents=True, exist_ok=True)
        store.write_text(json.dumps(datos), encoding="utf-8")

        # El sidecar re-clava capture.db (su esquema) y vincula ese mismo numero.
        js = ("import { abrirAlmacen, rutaAlmacen } from %r;"
              "const a = abrirAlmacen(rutaAlmacen({ HOME: process.env.HOME }));"
              "a.registrarLinea({ cuenta: 'local', pn: '573001112233:7@s.whatsapp.net' });"
              "a.anotarChat({ cuenta: 'local', chatJid: '100@g.us', nombre: 'G', esGrupo: 1 });"
              "a.reclavarLocal(); a.activarLinea(%r); a.latir(); a.cerrar();"
              % ((RAIZ / "sidecar" / "src" / "almacen.js").as_uri(), VIEJA))
        subprocess.run([shutil.which("node"), "--input-type=module", "-e", js], env=env,
                       check=True, capture_output=True, timeout=120)

        # Ya conectada al arranque (T9f): con el numero que anoto el sidecar, cualquier
        # comando de wa-scope la aplica sola. No hace falta el comando explicito.
        scope("sync")
        con = sqlite3.connect(home / ".wa-inbox" / "scope.db")
        quedan = {t: con.execute(f"select count(*) from {t} where account='local'").fetchone()[0]
                  for t in ("chat_scope", "agent_action", "work", "juicio")}
        rastro_viejo = con.execute(
            "select count(*) from run_trace where name='triage'").fetchone()[0]
        con.close()
        hechas += 2
        if any(quedan.values()):
            fallos.append(f"con el numero anotado por el sidecar, wa-scope no re-clavo solo: "
                          f"quedan filas `local` {quedan!r}")
        if rastro_viejo:
            fallos.append("el rastro de la corrida de antes no paso al numero")

        lista = {f.get("chat_jid"): f.get("mode")
                 for f in json.loads(scope("list", "--json").stdout or "[]")}
        corrida = json.loads(scope("run", "--json").stdout or "[{}]")[0]
        hechas += 2
        if lista.get("100@g.us") != "responder" or lista.get("400@g.us") != "observar":
            fallos.append(f"con el numero re-clavado vinculado, sus autorizaciones no "
                          f"aparecen: {lista!r}")
        if corrida.get("state") != "ok":
            fallos.append(f"con el numero re-clavado, su corrida no aparece: {corrida!r}")
        datos = json.loads(store.read_text(encoding="utf-8"))
        hechas += 1
        if (datos.get("decisions", {}).get("A1") or {}).get("account") != VIEJA:
            fallos.append(f"la decision de antes no quedo con su numero: "
                          f"{datos.get('decisions')!r}")
        segunda = (json.loads(scope("reclave", "--json").stdout or "[]") or [{}])[0]
        hechas += 1
        if segunda.get("movidas"):
            fallos.append(f"correr la re-clave dos veces volvio a mover algo: {segunda!r}")

        # La decision del dueno, cuando la evidencia no alcanzo: `--numero` la deja
        # anotada para que el sidecar la lea al arrancar. Un numero que no es un numero
        # se rechaza en vez de anotarse.
        p = scope("reclave", "--numero", "+57 300 000 0011", "--json")
        anotada = valor(env, "reclave_local_a")
        hechas += 2
        if anotada != "pn:573000000011":
            fallos.append(f"`wa-scope reclave --numero` no dejo la decision anotada: {anotada!r} "
                          f"{(p.stderr or '').strip()[:200]}")
        malo = scope("reclave", "--numero", "hola")
        if malo.returncode == 0 or valor(env, "reclave_local_a") != "pn:573000000011":
            fallos.append("`wa-scope reclave --numero` acepto algo que no es un numero")
    return hechas


def revisa_rastro_corrida(fallos: list) -> int:
    """Los cinco finales de una corrida, recorridos de verdad.

    Existe por lo mismo que el resto de este archivo: una rama que ningun chequeo
    ejecuta es una rama que se rompe en la maquina del usuario. Y aca el precio es
    peor que un traceback — si el rastro miente, el panel afirma que el agente hizo
    algo que no hizo, que es exactamente lo que este trabajo vino a arreglar.
    """
    hechas = 0
    with tempfile.TemporaryDirectory() as tmp:
        home = pathlib.Path(tmp)
        env = entorno(home)

        def scope(*args):
            return subprocess.run([str(BIN / "wa-scope"), *args], capture_output=True,
                                  text=True, env=env, timeout=180)

        def estado():
            p = scope("run", "--json")
            filas = json.loads(p.stdout or "[]")
            return filas[0] if filas else {}

        hechas += 1
        if estado().get("state") != "never":
            fallos.append(f"sin corridas, wa-scope run dice {estado().get('state')!r} "
                          "en vez de never")

        scope("set", "100@g.us", "--target", "SOP", "--mode", "responder")
        scope("lock", "--note", "triage")
        hechas += 1
        if estado().get("state") != "running":
            fallos.append(f"con el lock puesto, wa-scope run dice "
                          f"{estado().get('state')!r} en vez de running")

        scope("unlock")
        cerrada = estado()
        hechas += 2
        if cerrada.get("state") != "ok":
            fallos.append(f"al soltar el lock quedo en {cerrada.get('state')!r} "
                          "en vez de ok")
        if cerrada.get("looked") != 1:
            fallos.append(f"la corrida dice que miro {cerrada.get('looked')!r} "
                          "conversaciones autorizadas y era 1")

        motivo = "This Claude account is in use by an assigned worktree"
        scope("lock")
        scope("unlock", "--failed", motivo)
        fallida = estado()
        hechas += 2
        if fallida.get("state") != "failed":
            fallos.append(f"unlock --failed dejo el estado en "
                          f"{fallida.get('state')!r} en vez de failed")
        if fallida.get("reason") != motivo:
            fallos.append(f"el motivo del fallo llego como {fallida.get('reason')!r}")

        # La corrida que se murio: el lock vence y nadie llama a unlock. No se guarda
        # como estado, se deduce — asi que si la deduccion se rompe nada mas lo delata.
        scope("lock", "--ttl", "0")
        hechas += 1
        if estado().get("state") != "interrupted":
            fallos.append(f"una corrida que no volvio quedo en "
                          f"{estado().get('state')!r} en vez de interrupted")

        # Y lo que separa "no hay trabajo" de "no hay permiso". Apagar por terminal
        # tiene que APAGAR: la copia del panel le ganaba al CLI y `mode off` volvia a
        # salir como `responder`, con lo que este estado era inalcanzable desde ahi.
        scope("unlock")
        scope("mode", "100@g.us", "off")
        hechas += 1
        modos = [f["mode"] for f in json.loads(scope("list", "--json").stdout or "[]")]
        if modos != ["off"]:
            fallos.append(f"despues de `mode off` el registro quedo en {modos!r}")
        apagada = estado()
        hechas += 2
        if apagada.get("mapped") != 1:
            fallos.append(f"con una conversacion registrada, mapped llego "
                          f"{apagada.get('mapped')!r}")
        if apagada.get("authorized") != 0:
            fallos.append(f"con todo en off, authorized llego "
                          f"{apagada.get('authorized')!r} en vez de 0")
    return hechas


# Un wa-read que no lee nada y deja constancia de que lo llamaron. Es la prueba, y no
# una promesa, de que el precheck ya no abre la base de WhatsApp: si aparece una linea
# en la marca, alguien fue a buscarla.
STUB_WA_READ = '''#!/usr/bin/env python3
import os, sys
with open(os.environ["WA_MARCA"], "a") as fh:
    fh.write(" ".join(sys.argv[1:]) + "\\n")
print("[]")
'''


def revisa_precheck(fallos: list) -> int:
    """El precheck de las dos automations: barato, sin tocar WhatsApp, y sus tres
    salidas siguen significando lo mismo.

    Corre cada uno o dos minutos en dos automations a la vez. Cuando empezaba
    sincronizando, cada corrida copiaba 260 MB del contenedor de WhatsApp en tres
    procesos distintos y macOS preguntaba por el acceso en cada uno. Que no vuelva a
    pasar no se comprueba leyendo el codigo: se comprueba poniendo un wa-read falso y
    mirando si alguien lo llamo.

    Los tres codigos de salida son contrato con las automations —0 hay trabajo, 1 nada
    que hacer, 2 bloqueado— y el 2 tiene que seguir siendo ruidoso: un store viejo es
    una instalacion que no sincroniza, no una bandeja vacia.
    """
    hechas = 0
    with tempfile.TemporaryDirectory() as tmp:
        raiz = pathlib.Path(tmp)
        home = raiz / "home"
        home.mkdir()
        marca = raiz / "llamadas.txt"

        # bin/ propio: el mismo wa-scope, con un wa-read que no lee.
        binf = raiz / "bin"
        binf.mkdir()
        (binf / "wa-scope").write_text((BIN / "wa-scope").read_text())
        (binf / "wa-scope").chmod(0o755)
        # Los ajustes efectivos viven en un modulo al lado: wa-scope y wa-read tienen
        # que contestar lo MISMO sobre un mismo ajuste, y tenerlo dos veces era el defecto.
        (binf / "wa_settings.py").write_text((BIN / "wa_settings.py").read_text())
        # Y la linea activa sale de capture.db por wa_store, en solo lectura (T9).
        (binf / "wa_store.py").write_text((BIN / "wa_store.py").read_text())
        # Y el cliente de Jev, que wa-scope importa al arrancar (T3).
        (binf / "wa_jev.py").write_text((BIN / "wa_jev.py").read_text())
        # Y el piso fijo de excepciones, que wa-scope tambien importa al arrancar (T19).
        (binf / "wa_reglas.py").write_text((BIN / "wa_reglas.py").read_text())
        (binf / "wa-read").write_text(STUB_WA_READ)
        (binf / "wa-read").chmod(0o755)

        env = dict(entorno(home), WA_MARCA=str(marca))

        def scope(*args):
            return subprocess.run([str(binf / "wa-scope"), *args], capture_output=True,
                                  text=True, env=env, timeout=180)

        # Un sync deja el store donde wa-scope lo pone de verdad; preguntarselo a el
        # evita tener una segunda copia de esa ruta, que cambia por sistema operativo.
        salida = json.loads(scope("sync", "--json").stdout or "[]")
        destinos = (salida[0] if salida else {}).get("destinos") or []
        if not destinos:
            fallos.append("wa-scope sync no dijo donde deja el store del panel")
            return hechas
        store = pathlib.Path(destinos[0])

        def sembrar(pendientes=0, salud_ok=True, minutos=0, decisiones=None):
            ahora = time.time() - minutos * 60
            sello = time.strftime("%Y-%m-%d %H:%M", time.localtime(ahora))
            datos = {
                "scope": {"100@g.us": {"chatName": "Soporte", "mode": "responder",
                                       "provider": "plane", "target": "SOP"}},
                "decisions": decisiones or {},
                "health": ({"ok": True, "optional": []} if salud_ok else
                           {"ok": False, "problem": "chat database present",
                            "detail": "missing", "problemCode": "database"}),
                "activity": {"syncedAt": sello, "recent": [], "running": False,
                             "mapped": 1, "authorized": 1,
                             "pending": [{"stanzaId": f"S{i}", "chatJid": "100@g.us",
                                          "chat": "Soporte", "text": "hola"}
                                         for i in range(pendientes)]},
            }
            store.write_text(json.dumps(datos))
            marca.write_text("")

        def precheck(*args):
            p = scope("pending", *args)
            llamadas = [l for l in marca.read_text().splitlines() if l.strip()]
            if llamadas:
                fallos.append(f"`wa-scope pending {' '.join(args)}` abrio WhatsApp: "
                              f"llamo a wa-read {llamadas}")
            return p

        # 0 = hay trabajo.
        sembrar(pendientes=2)
        p = precheck()
        hechas += 2
        if p.returncode != 0:
            fallos.append(f"con 2 pendientes el precheck salio {p.returncode} y no 0")

        # 1 = no hay nada que hacer. Es el caso normal y el unico que puede ser callado.
        sembrar(pendientes=0)
        p = precheck()
        hechas += 2
        if p.returncode != 1:
            fallos.append(f"sin pendientes el precheck salio {p.returncode} y no 1")

        # 2 = bloqueado porque el sistema no puede leer.
        sembrar(pendientes=2, salud_ok=False)
        p = precheck()
        hechas += 3
        if p.returncode != 2:
            fallos.append(f"con el sistema roto el precheck salio {p.returncode} y no 2")
        cuerpo = json.loads(p.stdout or "{}")
        if not cuerpo.get("bloqueado"):
            fallos.append("el precheck bloqueado no dice por que: un salteo callado "
                          "esconde una instalacion rota")

        # 2 tambien cuando nadie sincroniza: contestar "no hay nada" sobre un store de
        # hace una hora seria afirmar algo que no se sabe.
        sembrar(pendientes=2, minutos=120)
        p = precheck()
        hechas += 2
        if p.returncode != 2:
            fallos.append(f"con el store viejo el precheck salio {p.returncode} y no 2")
        if json.loads(p.stdout or "{}").get("codigo") != "sync-stale":
            fallos.append("el store viejo no llego con su codigo estable")

        # El limite sale del ajuste, no de una constante: subirlo tiene que alcanzar
        # para que el mismo store deje de estar viejo.
        scope("config", "sync_minutes", "60")
        p = precheck()
        hechas += 1
        # 0 y no 2: el mismo store deja de estar viejo y sus 2 pendientes vuelven
        # a ser trabajo.
        if p.returncode != 0:
            fallos.append(f"con sync_minutes en 60 el mismo store salio "
                          f"{p.returncode}; el limite no sigue al ajuste")
        scope("config", "sync_minutes", "5")

        # Sin store no hay nada que responder, y eso tampoco es "no hay trabajo".
        store.unlink()
        marca.write_text("")
        p = precheck()
        hechas += 2
        if p.returncode != 2:
            fallos.append(f"sin store el precheck salio {p.returncode} y no 2")
        if json.loads(p.stdout or "{}").get("codigo") != "never-synced":
            fallos.append("un plugin que nunca sincronizo no se distingue de uno roto")

        # --only-taken es la otra automation: cuenta lo que el humano marco a mano.
        sembrar(pendientes=5)
        p = precheck("--only-taken")
        hechas += 2
        if p.returncode != 1:
            fallos.append(f"sin marcas a mano, --only-taken salio {p.returncode} y no 1")
        sembrar(pendientes=0, decisiones={"S0": {"decision": "take"}})
        p = precheck("--only-taken")
        hechas += 1
        if p.returncode != 0:
            fallos.append(f"con una marca Tomar, --only-taken salio {p.returncode} y no 0")
    return hechas


# Un Orca de mentira: contesta las DOS llamadas que la via web hace de verdad
# (`tab list` y `eval`) y nada mas. La frontera es un subproceso y ORCA_CLI_COMMAND es
# la perilla con la que se cambia en produccion, asi que esto recorre el parseo real de
# la CLI en vez de saltearlo. Lo que NO se puede recorrer aca es la sonda, que es JS y
# corre dentro de la pagina: eso solo se comprueba contra una sesion viva.
def entorno(home: pathlib.Path) -> dict:
    """HOME propio: la base vive en ~/.wa-inbox/scope.db y no hay variable para moverla,
    asi que mover el HOME es lo que mantiene la base real del usuario fuera de esto."""
    return dict(os.environ, HOME=str(home),
                XDG_CONFIG_HOME=str(home / ".config"),
                APPDATA=str(home / "AppData" / "Roaming"))


def valor(env: dict, clave: str):
    p = subprocess.run([str(BIN / "wa-scope"), "config", clave, "--json"],
                       capture_output=True, text=True, env=env, timeout=120)
    filas = json.loads(p.stdout or "[]")
    return filas[0]["value"] if filas else None


def revisa_ajustes(fallos: list) -> int:
    """Devuelve cuantas comprobaciones corrio."""
    hechas = 0
    with tempfile.TemporaryDirectory() as tmp:
        home = pathlib.Path(tmp)
        env = entorno(home)
        # Los arranques, ANTES de tocar nada: despues del bucle ya no son defaults.
        for clave, esperado in sorted({**DEFAULTS_RETENCION, **DEFAULTS_PRIMER,
                                       **DEFAULTS_INFORMES}.items()):
            hechas += 1
            quedo = valor(env, clave)
            if quedo != esperado:
                fallos.append(f"una instalacion nueva arranca con {clave} en {quedo!r} "
                              f"y tenia que arrancar en {esperado!r}")
        for args, acepta, esperado in AJUSTES:
            clave = args[1]
            p = subprocess.run([str(BIN / "wa-scope"), *args], capture_output=True,
                               text=True, env=env, timeout=120)
            hechas += 2
            if acepta and p.returncode != 0:
                fallos.append(f"wa-scope {' '.join(args)}: rechazo un valor valido — "
                              f"{(p.stderr or p.stdout).strip()[:120]}")
            if not acepta and p.returncode == 0:
                fallos.append(f"wa-scope {' '.join(args)}: acepto un valor invalido")
            quedo = valor(env, clave)
            if quedo != esperado:
                fallos.append(f"{clave} quedo en {quedo!r} y tenia que quedar en {esperado!r}")

        # La llave sale del manifiesto, no escrita a mano: cuando el plugin se
        # renombro, la copia fija aqui hizo fallar el chequeo culpando al codigo.
        man = json.loads((RAIZ / "orca-plugin.json").read_text(encoding="utf-8"))
        llave = f"{man['publisher']}.{man['id']}"
        store = (home / "Library" / "Application Support" / "orca" / "plugins-data" /
                 llave / "storage.json")
        store.parent.mkdir(parents=True, exist_ok=True)

        # `sync` tiene que devolverle al panel TODOS los ajustes, no solo el tono: uno
        # que viva nada mas en la base deja el control vacio y el panel miente sobre lo
        # que rige. Se borra el store primero para que lo que quede venga de sync y no
        # del espejo que ya hace cada escritura.
        store.unlink(missing_ok=True)
        subprocess.run([str(BIN / "wa-scope"), "sync", "--json"], capture_output=True,
                       text=True, env=env, timeout=180)
        espejo = json.loads(store.read_text(encoding="utf-8")) if store.exists() else {}
        hechas += 6
        for flat, esperado in (("inboxDays", "30"), ("transcribe", "off"),
                               ("transcribeLang", "pt"), ("transcribeQuality", "minima"),
                               ("ownerName", "Nombre De Ejemplo"), ("slaMinutes", "30")):
            if espejo.get(flat) != esperado:
                fallos.append(f"sync no le devolvio {flat} al panel: quedo "
                              f"{espejo.get(flat)!r} en vez de {esperado!r}")
        # El primer mensaje viaja en UNA clave del panel, con sus cuatro valores: cada
        # clave mas es una lectura mas contra el cupo de mensajes del host.
        hechas += 1
        primer = {"mode": "model_with_ack_fallback", "fallbackMinutes": "15",
                  "everyMinutes": "30", "max": "5"}
        if espejo.get("firstReply") != primer:
            fallos.append(f"sync no le devolvio firstReply al panel: quedo "
                          f"{espejo.get('firstReply')!r} en vez de {primer!r}")

        # El panel escribe en el store del host sin pasar por el CLI, asi que un valor
        # sucio de ahi es lo unico que la validacion de escritura no puede atajar.
        store.write_text(json.dumps({"inboxDays": "nunca", "transcribe": "magia",
                                     "transcribeLang": "klingon", "slaMinutes": "0",
                                     "firstReply": {"mode": "magia", "fallbackMinutes": "99",
                                                    "everyMinutes": "-1", "max": "mil"}}),
                         encoding="utf-8")
        hechas += 8
        for clave, esperado in (("inbox_days", "30"), ("transcribe", "off"),
                                ("transcribe_lang", "pt"), ("sla_first_reply_minutes", "30"),
                                ("first_reply_mode", "model_with_ack_fallback"),
                                ("ack_fallback_minutes", "15"),
                                ("update_every_minutes", "30"), ("updates_max", "5")):
            quedo = valor(env, clave)
            if quedo != esperado:
                fallos.append(f"basura del panel en {clave}: llego {quedo!r} en vez de "
                              f"{esperado!r}, el valor del CLI")

        # Y lo valido del panel SI tiene que ganarle al CLI, como el tono.
        store.write_text(json.dumps({"inboxDays": "0", "transcribe": "local",
                                     "slaMinutes": "45",
                                     "firstReply": {"mode": "model", "fallbackMinutes": 7,
                                                    "everyMinutes": "12", "max": "2"}}),
                         encoding="utf-8")
        hechas += 7
        for clave, esperado in (("inbox_days", "0"), ("transcribe", "local"),
                                ("sla_first_reply_minutes", "45"),
                                ("first_reply_mode", "model"), ("ack_fallback_minutes", "7"),
                                ("update_every_minutes", "12"), ("updates_max", "2")):
            quedo = valor(env, clave)
            if quedo != esperado:
                fallos.append(f"el panel no le gano al CLI en {clave}: quedo {quedo!r}")
    return hechas


def cargar_modulo(nombre, ruta):
    """Un archivo de bin/, importado y no copiado: lo que se comprueba tiene que ser el
    codigo que corre. `wa-scope` no termina en `.py`, asi que se carga con el loader de
    fuente en vez de por nombre."""
    sys.dont_write_bytecode = True
    sys.path.insert(0, str(BIN))
    cargador = importlib.machinery.SourceFileLoader(nombre, str(ruta))
    spec = importlib.util.spec_from_loader(nombre, cargador)
    mod = importlib.util.module_from_spec(spec)
    cargador.exec_module(mod)
    return mod


def wa_settings():
    """El modulo compartido de los CLI, importado y no copiado: lo que se comprueba
    tiene que ser el codigo que corre."""
    return cargar_modulo("wa_settings_check", BIN / "wa_settings.py")


def revisa_casa_del_runtime(fallos: list) -> int:
    """Como se elige el Orca vivo, sobre las formas que puede tener una maquina.

    El defecto que lo trajo es de Linux: la app publicada guarda su userData en
    `~/.config/orca-ide` y la CLI de Orca busca su runtime en `~/.config/orca`, asi que
    con las dos carpetas presentes —una vieja, otra viva— la CLI leia la muerta y
    contestaba "Could not connect to the Orca Lab runtime transport from this shell".
    Ninguno de los dos que escribimos esto tiene una maquina Linux, asi que la unica
    prueba posible es esta: las formas, no la maquina de nadie. La medicion del usuario
    —vieja en `orca`, viva en `orca-ide`, sin variable— es UNA fila de la tabla.

    Se prueba con sockets de verdad, no con mocks: lo que decide es si el transporte
    CONTESTA, y un archivo de hoy puede apuntar a un socket muerto."""
    import socket as sock

    hechas = 0

    def escenario(tmp, carpetas):
        """Arma un userData por cada (nombre, vivo, antiguedad_s) y devuelve el env."""
        base = pathlib.Path(tmp) / ".config"
        base.mkdir(parents=True, exist_ok=True)
        abiertos = []
        for nombre, vivo, antiguedad in carpetas:
            d = base / nombre
            d.mkdir(parents=True, exist_ok=True)
            # El socket va en el tmp y no en la carpeta: una ruta de socket unix no
            # puede pasar de ~104 bytes y la de un TemporaryDirectory ya es larga.
            endpoint = str(pathlib.Path(tmp) / f"s-{nombre}.sock")
            if vivo:
                s = sock.socket(sock.AF_UNIX, sock.SOCK_STREAM)
                s.bind(endpoint)
                s.listen(1)
                abiertos.append(s)
            meta = {"runtimeId": nombre, "pid": 1, "authToken": None, "startedAt": 0,
                    "transports": [{"kind": "unix", "endpoint": endpoint}]}
            (d / "orca-runtime.json").write_text(json.dumps(meta), encoding="utf-8")
            if antiguedad:
                cuando = time.time() - antiguedad
                os.utime(d / "orca-runtime.json", (cuando, cuando))
        return {"HOME": tmp, "XDG_CONFIG_HOME": str(base), "PATH": os.environ["PATH"]}, abiertos

    def resuelve(env):
        return wa_settings().orca_runtime_home(env, "linux")

    casos = [
        # (nombre del caso, carpetas, cual tiene que ganar)
        ("una sola carpeta, viva", [("orca", True, 0)], "orca"),
        ("una sola carpeta, muerta", [("orca", False, 0)], None),
        ("vieja en orca y viva en orca-ide (lo medido en su maquina)",
         [("orca", False, 60 * 24 * 3600), ("orca-ide", True, 0)], "orca-ide"),
        ("viva en orca y vieja en orca-ide (el espejo del caso de arriba)",
         [("orca", True, 60 * 24 * 3600), ("orca-ide", False, 0)], "orca"),
        ("dos vivas: desempata la mas nueva",
         [("orca", True, 3600), ("orca-ide", True, 0)], "orca-ide"),
        ("un nombre que nadie conoce, pero contesta",
         [("orca-lab-nightly", True, 0)], "orca-lab-nightly"),
        ("ninguna carpeta", [], None),
    ]
    for nombre, carpetas, gana in casos:
        with tempfile.TemporaryDirectory() as tmp:
            env, abiertos = escenario(tmp, carpetas)
            casa = resuelve(env)
            hechas += 1
            esperado = str(pathlib.Path(env["XDG_CONFIG_HOME"]) / gana) if gana else None
            if casa["path"] != esperado:
                fallos.append(f"casa del runtime — {nombre}: eligio {casa['path']!r} y "
                              f"tenia que elegir {esperado!r}")
            for s in abiertos:
                s.close()

    # Lo que el usuario puede hacer cuando no hay ninguna viva: saber donde se busco.
    with tempfile.TemporaryDirectory() as tmp:
        env, abiertos = escenario(tmp, [("orca", False, 0), ("orca-ide", False, 0)])
        casa = resuelve(env)
        hechas += 1
        if len(casa["tried"]) != 2:
            fallos.append(f"casa del runtime: sin ninguna viva tiene que decir las dos "
                          f"que miro, y dijo {casa['tried']}")
        for s in abiertos:
            s.close()

    # La variable explicita manda y no se sale a probar nada: si el que empaqueta la
    # fija, adivinar por encima es desobedecerlo.
    with tempfile.TemporaryDirectory() as tmp:
        env, abiertos = escenario(tmp, [("orca-ide", True, 0)])
        env["ORCA_USER_DATA_PATH"] = "/ruta/que/el/empaquetador/fijo"
        casa = resuelve(env)
        hechas += 2
        if casa["path"] != "/ruta/que/el/empaquetador/fijo" or casa["source"] != "env":
            fallos.append(f"casa del runtime: ORCA_USER_DATA_PATH tiene que mandar, y "
                          f"quedo {casa['path']!r} ({casa['source']})")
        # Y el env del hijo la lleva SIEMPRE: el worker corre con una lista blanca que
        # no la incluye, asi que heredarla no es una opcion.
        hijo = wa_settings().orca_env(env, "linux")
        if hijo.get("ORCA_USER_DATA_PATH") != "/ruta/que/el/empaquetador/fijo":
            fallos.append("el env del hijo no lleva ORCA_USER_DATA_PATH")
        for s in abiertos:
            s.close()

    # Sin ninguna viva NO se inventa una carpeta: apuntar a la muerta es el defecto.
    with tempfile.TemporaryDirectory() as tmp:
        env, abiertos = escenario(tmp, [("orca", False, 0)])
        hechas += 1
        if "ORCA_USER_DATA_PATH" in wa_settings().orca_env(env, "linux"):
            fallos.append("sin runtime vivo el env del hijo no puede fijar una carpeta")
        for s in abiertos:
            s.close()

    # El archivo de un Orca viejo trae `transport` en singular. Dejar de entenderlo
    # seria mandar a ese usuario a la carpeta equivocada.
    with tempfile.TemporaryDirectory() as tmp:
        base = pathlib.Path(tmp) / ".config" / "orca"
        base.mkdir(parents=True)
        endpoint = str(pathlib.Path(tmp) / "viejo.sock")
        s = sock.socket(sock.AF_UNIX, sock.SOCK_STREAM)
        s.bind(endpoint)
        s.listen(1)
        (base / "orca-runtime.json").write_text(
            json.dumps({"transport": {"kind": "unix", "endpoint": endpoint}}),
            encoding="utf-8")
        env = {"HOME": tmp, "XDG_CONFIG_HOME": str(base.parent),
               "PATH": os.environ["PATH"]}
        hechas += 1
        if wa_settings().orca_runtime_home(env, "linux")["path"] != str(base):
            fallos.append("casa del runtime: no entendio el `transport` singular de un "
                          "Orca viejo")
        s.close()

    # El binario: una maquina puede tener uno, el otro, o ninguno en el PATH.
    with tempfile.TemporaryDirectory() as tmp:
        d = pathlib.Path(tmp) / "bin"
        d.mkdir()
        env = {"PATH": str(d), "HOME": tmp}
        hechas += 3
        if wa_settings().orca_cli_path(env, "linux") is not None:
            fallos.append("el binario: sin nada en el PATH tiene que contestar None, "
                          "no un nombre que no existe")
        (d / "orca").write_text("#!/bin/sh\n")
        (d / "orca").chmod(0o755)
        if wa_settings().orca_cli_path(env, "linux") is not None:
            fallos.append("el binario: en Linux `orca` es el lector de pantalla de "
                          "GNOME y no se puede tomar por la CLI de Orca")
        if wa_settings().orca_cli_path(env, "darwin") != str(d / "orca"):
            fallos.append("el binario: fuera de Linux `orca` SI es la CLI")
        (d / "orca-ide").write_text("#!/bin/sh\n")
        (d / "orca-ide").chmod(0o755)
        hechas += 2
        if wa_settings().orca_cli_path(env, "linux") != str(d / "orca-ide"):
            fallos.append("el binario: en Linux la CLI es `orca-ide`")
        env["ORCA_CLI_COMMAND"] = str(d / "orca")
        if wa_settings().orca_cli_path(env, "linux") != str(d / "orca"):
            fallos.append("el binario: ORCA_CLI_COMMAND tiene que mandar sobre todo")

    return hechas


# Los comandos que necesitan mensajes. SIN una linea enlazada los seis se niegan con el
# MISMO motivo estable, y eso es lo que se recorre: el fallo que importa no es que
# fallen, es que uno solo de ellos conteste una lista vacia. Una bandeja vacia se lee como
# "no hay nada que atender", que es justo lo contrario de "no puedo leer nada".
#
# El otro lado —con el almacen lleno los seis contestan, y una lista vacia quiere decir
# que de verdad no hubo nada— se recorre en test/almacen.test.mjs, que ingiere mensajes
# fabricados con el codigo del sidecar y despues le pregunta a este mismo ejecutable.
SIN_TRANSPORTE_COMANDOS = [["inbox"], ["chats"], ["whoami"], ["state"],
                           ["chat", "algo"], ["media", "algo"],
                           ["wait", "algo", "--timeout", "0"]]
SIN_TRANSPORTE = "no-transport"
# Lo que contesta `wa-send` cuando no hay sidecar vivo del otro lado. Es un motivo
# PROPIO y no el rechazo de WhatsApp: la accion del dueno es distinta —abrir Orca, no
# revisar la conversacion— y el panel traduce por codigo (§11-E1/E2).
SIN_TRANSPORTE_ENVIO = "send-no-transport"
# Y lo que contesta cuando la escalera de permisos dijo que no. Denegar por defecto: la
# conversacion que nadie registro no existe para el agente.
DENEGADO = "send-denied"


def revisa_rutas_del_almacen(fallos: list) -> int:
    """La ruta del almacen la resuelven DOS implementaciones. No pueden discrepar.

    El sidecar la escribe desde JavaScript (`rutaInbox()` en sidecar/src/almacen.js) y
    `wa-read` la lee desde Python (`inbox_dir()` en bin/wa_store.py). Discrepar sobre
    esta ruta no da un error: da un almacen que se llena y otro que se lee vacio, o sea
    una bandeja siempre tranquila sobre una cuenta que no para de escribir. Por eso las
    dos se corren contra el MISMO entorno y se comparan.

    Los topes de retencion van igual: viven en `DEFAULT_CONFIG` de wa-scope —que es
    quien los guarda— y en `DEFAULTS` de wa_store —que es quien los aplica cuando no hay
    registro que leer—. Un arranque distinto en cada lado es texto ajeno conservado por
    mas tiempo del que el panel dice.
    """
    hechas = 0
    nodo = shutil.which("node")
    with tempfile.TemporaryDirectory() as tmp:
        home = pathlib.Path(tmp)
        env = entorno(home)

        py = subprocess.run(
            [sys.executable, "-c",
             "import sys; sys.dont_write_bytecode = True; sys.path.insert(0, %r); "
             "import wa_store; print(wa_store.inbox_dir())" % str(BIN)],
            capture_output=True, text=True, env=env, timeout=120)
        ruta_py = (py.stdout or "").strip()
        hechas += 1
        if not ruta_py:
            fallos.append("wa_store.inbox_dir() no contesto una ruta: "
                          f"{(py.stderr or '').strip()[:200]!r}")
        elif ruta_py != str(home / ".wa-inbox"):
            fallos.append(f"wa_store.inbox_dir() dio {ruta_py!r} con HOME propio y tenia "
                          f"que dar {str(home / '.wa-inbox')!r}")

        # Sin node no se puede comparar con el lado que ESCRIBE. Se dice, y no se
        # inventa un verde: un chequeo que no corrio no es un chequeo que paso.
        if not nodo:
            print("  aviso: sin node, no se comparo la ruta del almacen con el sidecar",
                  file=sys.stderr)
            return hechas
        js = subprocess.run(
            [nodo, "--input-type=module", "-e",
             "import { rutaInbox, rutaAlmacen } from %r;"
             "process.stdout.write(rutaInbox(process.env) + '\\n' + rutaAlmacen(process.env))"
             % (RAIZ / "sidecar" / "src" / "almacen.js").as_uri()],
            capture_output=True, text=True, env=env, timeout=120)
        partes = (js.stdout or "").strip().splitlines()
        hechas += 2
        if len(partes) != 2:
            fallos.append("sidecar/src/almacen.js no contesto la ruta del almacen: "
                          f"{(js.stderr or '').strip()[:200]!r}")
        else:
            if partes[0] != ruta_py:
                fallos.append(f"el sidecar escribe en {partes[0]!r} y wa-read lee "
                              f"{ruta_py!r}: el almacen se llenaria de un lado y se "
                              "leeria vacio del otro")
            esperado = str(home / ".wa-inbox" / "capture.db")
            if partes[1] != esperado:
                fallos.append(f"el almacen quedo en {partes[1]!r} y tenia que quedar en "
                              f"{esperado!r}, al lado del registro de alcance")

    # El latido del sidecar, que tambien esta escrito de los dos lados. `wa-send` lo usa
    # para distinguir "no hay sidecar" de "no contesto a tiempo", que son dos acciones
    # distintas del dueno; si los dos numeros se separan, la CLI le diria que arranque
    # algo que ya esta corriendo. Se comparan, como las rutas.
    if nodo:
        wa_send = cargar_modulo("wa_send_mod", BIN / "wa-send")
        js = subprocess.run(
            [nodo, "--input-type=module", "-e",
             "import { LATIDO_VENCE_MS } from %r; process.stdout.write(String(LATIDO_VENCE_MS))"
             % (RAIZ / "sidecar" / "src" / "envio.js").as_uri()],
            capture_output=True, text=True, timeout=120)
        hechas += 1
        try:
            del_sidecar = int((js.stdout or "").strip()) / 1000
        except ValueError:
            del_sidecar = None
            fallos.append("sidecar/src/envio.js no contesto LATIDO_VENCE_MS: "
                          f"{(js.stderr or '').strip()[:200]!r}")
        if del_sidecar is not None and del_sidecar != wa_send.LATIDO_VENCE_S:
            fallos.append(f"el latido vence a los {del_sidecar}s para el sidecar y a los "
                          f"{wa_send.LATIDO_VENCE_S}s para wa-send: la CLI daria por "
                          "muerto a un sidecar vivo, o al reves")

    # Y los dos arranques de retencion, que son el trato entero sobre texto ajeno.
    wa_scope = cargar_modulo("wa_scope_mod", BIN / "wa-scope")
    wa_store = cargar_modulo("wa_store_mod", BIN / "wa_store.py")
    for clave in ("capture_max", "capture_days", "inbox_days"):
        hechas += 1
        a = wa_scope.DEFAULT_CONFIG.get(clave)
        b = wa_store.DEFAULTS.get(clave)
        if a != b:
            fallos.append(f"{clave} arranca en {a!r} para wa-scope y en {b!r} para "
                          "wa_store: el tope que el panel muestra no seria el que se "
                          "aplica")
    return hechas


def revisa_sin_transporte(fallos: list) -> int:
    """Sin una linea enlazada, leer y escribir se NIEGAN con motivo, no contestan vacio.

    Este HOME de mentira no tiene almacen de mensajes, que es exactamente la maquina de
    quien todavia no escaneo el QR. Ese hueco tiene que tener nombre: el panel traduce
    por codigo, y un codigo estable es la diferencia entre "no hay trabajo" y "esto no
    puede leer".
    """
    hechas = 0
    with tempfile.TemporaryDirectory() as tmp:
        home = pathlib.Path(tmp)
        env = dict(entorno(home), ORCA_CLI_COMMAND=str(home / "no-existe-este-orca"))

        for comando in SIN_TRANSPORTE_COMANDOS:
            p = subprocess.run([str(BIN / "wa-read"), *comando, "--json"],
                               capture_output=True, text=True, env=env, timeout=180)
            hechas += 4
            if p.returncode != 4:
                fallos.append(f"wa-read {comando[0]}: salio {p.returncode} y tenia que "
                              f"salir 4 (no hay de donde leer)")
            primera = (p.stderr or "").strip().splitlines()[:1]
            if primera != [f"wa-read: {SIN_TRANSPORTE}"]:
                fallos.append(f"wa-read {comando[0]}: la primera linea de stderr es "
                              f"{primera!r} y tenia que ser 'wa-read: {SIN_TRANSPORTE}'")
            # stdout vacio no es cosmetica: quien parsea lee `stdout or '[]'`, y una
            # lista vacia ahi es exactamente la bandeja tranquila que no hay.
            if p.stdout.strip():
                fallos.append(f"wa-read {comando[0]}: escribio en stdout al negarse")
            if "Traceback (most recent call last)" in p.stderr:
                fallos.append(f"wa-read {comando[0]}: reventó con un traceback")

        # El doctor SI contesta: es el unico que puede decir por que no hay transporte.
        p = subprocess.run([str(BIN / "wa-read"), "doctor", "--json"],
                           capture_output=True, text=True, env=env, timeout=120)
        filas = json.loads(p.stdout or "[]")
        hechas += 4
        if p.returncode != 1:
            fallos.append(f"wa-read doctor salio {p.returncode} y tenia que salir 1: sin "
                          "transporte falta un requisito")
        fila = next((f for f in filas if f.get("code") == SIN_TRANSPORTE), None)
        if not fila:
            fallos.append(f"wa-read doctor no trae el renglon {SIN_TRANSPORTE!r}: sin el, "
                          "el panel no tiene codigo que traducir")
        else:
            if not fila.get("requerido", True):
                fallos.append("el renglon del transporte no bloquea: un plugin que no "
                              "puede leer no es un plugin al que le falta algo opcional")
            if fila.get("ok"):
                fallos.append("el renglon del transporte llego en ok")
        # Y ningun renglon puede seguir mandando a encender lo que ya no existe.
        for f in filas:
            texto = f"{f.get('check', '')} {f.get('detalle', '')}".lower()
            for muerto in ("whatsapp web", "read_web", "read_local", "desktop app"):
                if muerto in texto:
                    fallos.append(f"wa-read doctor sigue nombrando {muerto!r} en "
                                  f"{f.get('code')!r}: manda a una accion que ya no existe")
        hechas += 1

        # Escribir tampoco puede fallar en oscuro. El nombre del agente va primero: la
        # firma es obligatoria y se comprueba antes que nada.
        subprocess.run([str(BIN / "wa-scope"), "agent", "Agente De Ejemplo"],
                       capture_output=True, text=True, env=env, timeout=120)

        # Denegar por defecto: la conversacion que nadie registro no existe para el
        # agente, y eso se dice ANTES que el estado del transporte. Lo contrario —un
        # fallo generico de transporte— taparia que el permiso nunca estuvo.
        p = subprocess.run([str(BIN / "wa-send"), "Un Grupo", "hola", "--send"],
                           capture_output=True, text=True, env=env, timeout=120)
        hechas += 3
        if p.returncode != 3:
            fallos.append(f"wa-send sobre una conversacion sin registrar salio "
                          f"{p.returncode} y tenia que salir 3 (denegado)")
        primera = (p.stderr or "").strip().splitlines()[:1]
        if primera != [f"wa-send: {DENEGADO}"]:
            fallos.append(f"wa-send sin permiso: la primera linea de stderr es "
                          f"{primera!r} y tenia que ser 'wa-send: {DENEGADO}'")
        if "Traceback (most recent call last)" in p.stderr:
            fallos.append("wa-send reventó con un traceback al negarse")

        # Y con el permiso puesto, la negativa que queda es la del TRANSPORTE: este HOME
        # de mentira no tiene almacen de mensajes, que es la maquina de quien todavia no
        # escaneo el QR. Que sean dos codigos distintos es el punto entero: uno lo
        # arregla el dueno en el panel y el otro abriendo Orca.
        con = sqlite3.connect(home / ".wa-inbox" / "scope.db")
        con.execute("insert or replace into chat_scope (account, chat_jid, chat_name, "
                    "mode) values (?,?,?,?)",
                    ("local", "100000000000000001@g.us", "Un Grupo", "responder"))
        con.commit()
        con.close()
        p = subprocess.run([str(BIN / "wa-send"), "Un Grupo", "hola", "--send"],
                           capture_output=True, text=True, env=env, timeout=120)
        hechas += 4
        if p.returncode == 0:
            fallos.append("wa-send contesto ok sin transporte con que mandar nada")
        if p.returncode != 4:
            fallos.append(f"wa-send sin linea salio {p.returncode} y tenia que salir 4, "
                          f"la misma que `wa-read` sin transporte")
        primera = (p.stderr or "").strip().splitlines()[:1]
        if primera != [f"wa-send: {SIN_TRANSPORTE_ENVIO}"]:
            fallos.append(f"wa-send: la primera linea de stderr es {primera!r} y tenia "
                          f"que ser 'wa-send: {SIN_TRANSPORTE_ENVIO}'")
        if "Traceback (most recent call last)" in p.stderr:
            fallos.append("wa-send reventó con un traceback al negarse")

        # Y la ambiguedad se sigue rechazando ANTES, que es la invariante de mas valor
        # del camino de escritura: la MISMA conversacion puede estar en dos lineas
        # propias, y escribirle a la equivocada no se deshace. Mandarla a la negativa
        # generica por transporte seria taparla.
        # Las dos en `responder` a proposito: lo que se mide es que la ambiguedad se
        # rechace ANTES que nada, y con el permiso mas alto puesto no queda duda de que
        # lo que la rechaza es la ambiguedad y no la escalera.
        con = sqlite3.connect(home / ".wa-inbox" / "scope.db")
        for cuenta in ("linea-uno", "linea-dos"):
            con.execute("insert or replace into chat_scope (account, chat_jid, chat_name, "
                        "mode) values (?,?,?,?)",
                        (cuenta, "100000000000000000@g.us", "Grupo En Dos Lineas",
                         "responder"))
        con.commit()
        con.close()
        p = subprocess.run([str(BIN / "wa-send"), "Grupo En Dos Lineas", "hola"],
                           capture_output=True, text=True, env=env, timeout=120)
        hechas += 2
        primera = (p.stderr or "").strip().splitlines()[:1]
        if primera != ["wa-send: send-ambiguous-line"]:
            fallos.append(f"una conversacion en dos lineas ya no se rechaza: dijo "
                          f"{primera!r}")
        # Y con la linea dicha, la ambiguedad desaparece y se llega a la negativa real.
        p = subprocess.run([str(BIN / "wa-send"), "Grupo En Dos Lineas", "hola",
                            "--line", "linea-uno"],
                           capture_output=True, text=True, env=env, timeout=120)
        primera = (p.stderr or "").strip().splitlines()[:1]
        if primera != [f"wa-send: {SIN_TRANSPORTE_ENVIO}"]:
            fallos.append(f"con --line resuelto, wa-send tenia que llegar a la negativa "
                          f"por transporte y dijo {primera!r}")
        # Una linea que no es de esa conversacion tampoco se resuelve en silencio.
        p = subprocess.run([str(BIN / "wa-send"), "Grupo En Dos Lineas", "hola",
                            "--line", "linea-tres"],
                           capture_output=True, text=True, env=env, timeout=120)
        hechas += 1
        primera = (p.stderr or "").strip().splitlines()[:1]
        if primera != ["wa-send: send-wrong-line"]:
            fallos.append(f"una linea ajena a la conversacion no se rechaza: {primera!r}")

        # Y lo que NO cambia: sin nombre de agente se niega antes, por la firma.
        env_sin_firma = dict(entorno(pathlib.Path(tmp) / "otra"),
                             ORCA_CLI_COMMAND=str(home / "no-existe-este-orca"))
        (pathlib.Path(tmp) / "otra").mkdir(parents=True, exist_ok=True)
        p = subprocess.run([str(BIN / "wa-send"), "Un Grupo", "hola"],
                           capture_output=True, text=True, env=env_sin_firma, timeout=120)
        hechas += 1
        if "no agent name is configured" not in (p.stderr or ""):
            fallos.append("sin nombre de agente, wa-send ya no se niega por la firma: "
                          f"dijo {(p.stderr or '').strip()[:120]!r}")
    return hechas

def revisa_espera(fallos: list) -> int:
    """`wa-read wait` (cli-huecos, C4): bloquea hasta que llega un mensaje nuevo de OTRO
    en una conversacion autorizada, o hasta el plazo. Lee el almacen, nunca el socket.

    Los mensajes los escribe el escritor de verdad (el sidecar) MIENTRAS `wait` espera:
    es la unica forma de ver que despierta por lo que llega y no por lo que ya estaba.
    HOME temporal: nunca contra ~/.wa-inbox."""
    hechas = 0
    nodo = shutil.which("node")
    if not nodo:
        print("  aviso: sin node, no se armo el almacen para `wa-read wait`", file=sys.stderr)
        return hechas
    almacen_js = (RAIZ / "sidecar" / "src" / "almacen.js").as_uri()
    t0 = int(time.time()) - 600
    with tempfile.TemporaryDirectory() as tmp:
        home = pathlib.Path(tmp)
        env = entorno(home)

        def escribe(cuerpo):
            js = ("import { abrirAlmacen, rutaAlmacen } from %r;"
                  "const a = abrirAlmacen(rutaAlmacen({ HOME: process.env.HOME }));"
                  "%s; a.cerrar();" % (almacen_js, cuerpo))
            subprocess.run([nodo, "--input-type=module", "-e", js], env=env, check=True,
                           capture_output=True, timeout=120)

        def mensaje(chat, stanza, ts, mio=0):
            return ("a.guardarMensaje({ cuenta: %r, chatJid: %r, stanzaId: %r, ts: %d, "
                    "fromMe: %d, senderJid: %r, senderName: 'Laura', body: 'hola %s', "
                    "mediaTipo: null, mediaBytes: null, mencionaMe: 0, citaMe: 0 })"
                    % (NUEVA, chat, stanza, ts, mio,
                       "573000000012@s.whatsapp.net" if mio else "573009998877@s.whatsapp.net",
                       stanza))

        escribe(
            "a.registrarLinea({ cuenta: %r, pn: '573000000012:7@s.whatsapp.net', "
            "nombre: 'Nueva' });"
            "a.anotarChat({ cuenta: %r, chatJid: '200@g.us', nombre: 'Grupo Espera', esGrupo: 1 });"
            "a.anotarChat({ cuenta: %r, chatJid: '201@g.us', nombre: 'Grupo Cerrado', esGrupo: 1 });"
            "a.anotarChat({ cuenta: %r, chatJid: '202@g.us', nombre: 'Grupo Doble', esGrupo: 1 });"
            "a.anotarChat({ cuenta: %r, chatJid: '203@g.us', nombre: 'Grupo Doble', esGrupo: 1 });"
            "%s; a.activarLinea(%r); a.latir()"
            % (NUEVA, NUEVA, NUEVA, NUEVA, NUEVA, mensaje("200@g.us", "E1", t0), NUEVA))
        subprocess.run([str(BIN / "wa-scope"), "set", "200@g.us", "--mode", "observar"],
                       env=env, capture_output=True, timeout=120)

        def espera(*args):
            inicio = time.time()
            p = subprocess.run([str(BIN / "wa-read"), "wait", *args, "--poll", "0.2",
                                "--json"], capture_output=True, text=True, env=env,
                               timeout=120)
            return p, time.time() - inicio

        def primera(p):
            return (p.stderr.strip().splitlines() or [""])[0]

        hechas += 1
        p, _ = espera("Grupo Cerrado", "--timeout", "1")
        if p.returncode != 3 or primera(p) != "wa-read: chat-not-authorized" or p.stdout.strip():
            fallos.append(f"wa-read wait sobre un chat no autorizado salio {p.returncode} "
                          f"({primera(p)!r}) y tenia que negarse con 3 y "
                          "'wa-read: chat-not-authorized', sin stdout")

        hechas += 1
        p, _ = espera("Grupo Doble", "--timeout", "1")
        if p.returncode != 2:
            fallos.append(f"wa-read wait sobre un nombre de dos chats salio {p.returncode} "
                          "y tenia que salir 2 (ambiguo), como `wa-read chat`")

        hechas += 1
        p, tardo = espera("Grupo Espera", "--timeout", "1")
        if p.returncode != 5 or primera(p) != "wa-read: wait-timeout" or p.stdout.strip():
            fallos.append(f"wa-read wait sin nada nuevo salio {p.returncode} ({primera(p)!r}) "
                          "y tenia que salir 5 con 'wa-read: wait-timeout', sin stdout: lo "
                          "que ya estaba en el chat no es un mensaje nuevo")
        elif not 0.9 <= tardo < 15:
            fallos.append(f"wa-read wait --timeout 1 tardo {tardo:.1f}s")

        # Lo que llega MIENTRAS espera: primero un mensaje propio (no despierta) y despues
        # uno de la otra persona, que es el que se devuelve.
        hechas += 1
        proc = subprocess.Popen([str(BIN / "wa-read"), "wait", "Grupo Espera",
                                 "--timeout", "30", "--poll", "0.2", "--json"],
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
                                env=env)
        time.sleep(1.0)
        escribe(mensaje("200@g.us", "E2", t0 + 60, mio=1))
        time.sleep(1.0)
        vivo_tras_el_propio = proc.poll() is None
        escribe(mensaje("200@g.us", "E3", t0 + 120))
        try:
            salida, error = proc.communicate(timeout=30)
        except subprocess.TimeoutExpired:
            proc.kill()
            salida, error = proc.communicate()
        try:
            filas = json.loads(salida or "null")
        except ValueError:
            filas = None
        if not vivo_tras_el_propio:
            fallos.append("wa-read wait desperto con un mensaje propio: espera a la otra "
                          "persona")
        if proc.returncode != 0 or not isinstance(filas, list) or \
                [f.get("stanza_id") for f in filas] != ["E3"]:
            fallos.append(f"wa-read wait con un mensaje que llega salio {proc.returncode} "
                          f"con {salida.strip()[:200]!r} {error.strip()[:200]!r}; tenia que "
                          "salir 0 con SOLO el mensaje nuevo de la otra persona (E3)")

        hechas += 1
        p, tardo = espera("Grupo Espera", "--after", "E1", "--timeout", "5")
        filas = json.loads(p.stdout or "null") if p.returncode == 0 else None
        if not isinstance(filas, list) or [f.get("stanza_id") for f in filas] != ["E3"] \
                or tardo > 4:
            fallos.append(f"wa-read wait --after E1 salio {p.returncode} con "
                          f"{p.stdout.strip()[:200]!r}: tenia que contestar ya con lo que "
                          "llego despues de E1 (E3), sin esperar")

        hechas += 1
        p, _ = espera("Grupo Espera", "--after", str(t0 + 90), "--timeout", "5")
        filas = json.loads(p.stdout or "null") if p.returncode == 0 else None
        if not isinstance(filas, list) or [f.get("stanza_id") for f in filas] != ["E3"]:
            fallos.append(f"wa-read wait --after <epoch> salio {p.returncode} con "
                          f"{p.stdout.strip()[:200]!r}: tenia que contestar con E3")

        hechas += 1
        p, _ = espera("Grupo Espera", "--after", "NO-EXISTE", "--timeout", "1")
        if p.returncode in (0, 5) or "NO-EXISTE" not in p.stderr:
            fallos.append(f"wa-read wait --after con un mensaje que no es de ese chat salio "
                          f"{p.returncode} ({p.stderr.strip()[:200]!r}): tenia que negarse "
                          "nombrandolo, no esperar")

        hechas += 1
        ayuda = subprocess.run([str(BIN / "wa-read"), "wait", "--help"], capture_output=True,
                               text=True, env=env, timeout=60).stdout
        if not all(x in ayuda for x in ("--after", "--timeout", "--poll", "exit", "5",
                                        "chat-not-authorized", "wait-timeout")):
            fallos.append("wa-read wait --help no documenta --after, --timeout, --poll y "
                          "los codigos de salida (5 timeout, chat-not-authorized)")
    return hechas


def main() -> int:
    fallos = []
    aislado = tempfile.TemporaryDirectory()
    env_aislado = entorno(pathlib.Path(aislado.name))
    for nombre, args, propio, extra in CASOS:
        ruta = BIN / nombre
        if not ruta.exists():
            fallos.append(f"{nombre}: no existe")
            continue
        try:
            p = subprocess.run([str(ruta), *args], capture_output=True, text=True,
                               env=dict(env_aislado if propio else os.environ, **extra),
                               timeout=120)
        except (OSError, subprocess.SubprocessError) as error:
            fallos.append(f"{nombre}: no arranco — {error}")
            continue
        # Un doctor puede terminar en != 0 porque al equipo le falta algo; eso no
        # es un error del codigo. Lo que nunca es aceptable es un traceback.
        if "Traceback (most recent call last)" in p.stderr:
            ultima = [l for l in p.stderr.strip().splitlines() if l.strip()][-1]
            fallos.append(f"{nombre} {' '.join(args)}: {ultima.strip()}")

    comprobaciones = (revisa_ajustes(fallos) + revisa_sin_transporte(fallos)
                      + revisa_rutas_del_almacen(fallos)
                      + revisa_migracion_cuentas(fallos)
                      + revisa_rastro_corrida(fallos) + revisa_precheck(fallos)
                      + revisa_insignia_nav(fallos)
                      + revisa_sin_bytecode(fallos)
                      + revisa_firma_del_panel(fallos)
                      + revisa_casa_del_runtime(fallos)
                      + revisa_juicio(fallos)
                      + revisa_rol_del_juicio(fallos)
                      + revisa_linea_por_numero(fallos)
                      + revisa_reclave_local(fallos)
                      + revisa_telefono_de_lid(fallos)
                      + revisa_miembros(fallos)
                      + revisa_roles(fallos)
                      + revisa_proyectos(fallos)
                      + revisa_varios_proyectos(fallos)
                      + revisa_espera(fallos))
    aislado.cleanup()

    if fallos:
        print("CLI que se rompen al correr:", file=sys.stderr)
        for f in fallos:
            print(f"  {f}", file=sys.stderr)
        return 1
    print(f"{len(CASOS)} CLI arrancan, {comprobaciones} comprobaciones de ajustes")
    return 0


if __name__ == "__main__":
    sys.exit(main())
