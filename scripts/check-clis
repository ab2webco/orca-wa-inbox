#!/usr/bin/env python3
"""Los cuatro CLI arrancan de verdad, y los ajustes validan lo que guardan.

Existe porque `npm run check` dejo pasar un NameError en wa-transcribe: probaba
los paneles y las pruebas jsdom, y ninguna de las dos ejecuta un CLI. Compilar no
alcanza — un import que falta solo aparece al recorrer esa rama — asi que aca se
corre cada herramienta.
"""
import importlib.machinery
import importlib.util
import inspect
import json
import os
import pathlib
import re
import shutil
import sqlite3
import subprocess
import sys
import tempfile
import time

RAIZ = pathlib.Path(__file__).resolve().parent.parent
BIN = RAIZ / "bin"

# El HOME real del usuario tiene su registro (~/.wa-inbox/scope.db). Un chequeo que se
# corre a cada rato no puede tocarlo, asi que casi todo corre con HOME propio. Lo que
# antes hacia falta enjaular —el doctor abria la sesion de WhatsApp Web del usuario y
# le conducia el navegador— ya no existe: sin transportes, el doctor no abre nada.
CASOS = [
    # Con HOME propio, como todo lo demas: `wa-read doctor` llama a `wa-transcribe --check`, que
    # le pregunta a `wa-scope config`, y eso abre (y migra) ~/.wa-inbox/scope.db. Con el HOME
    # real, este chequeo le agrego columnas a la base viva del dueno.
    ("wa-read", ["doctor", "--json"], True, {}),
    ("wa-scope", ["config", "--json"], True, {}),
    # Con un nombre en vez de un JID, wa-scope tiene que preguntarle a wa-read.
    # Ese camino llamaba a ~/tools/wa-read — una ruta fuera del plugin — y reventaba
    # sin que ningun chequeo lo viera, porque los otros casos no lo recorren.
    ("wa-scope", ["voice", "un-nombre-que-no-existe", "--json"], True, {}),
    # El listado de cierres pendientes toca la migracion y la linea de corte: si esa
    # rama revienta, el agente deja de avisar cierres y nada mas lo delata.
    ("wa-scope", ["closing", "--json"], True, {}),
    # El registro de lineas toca la migracion a (cuenta, jid): si esa rama revienta,
    # el alcance entero deja de leerse.
    ("wa-scope", ["accounts", "--json"], True, {}),
    # El rastro de la corrida sobre una base recien creada: es la rama que contesta
    # "nunca corrio", y es justo la que nadie ejecuta a mano.
    ("wa-scope", ["run", "--json"], True, {}),
    ("wa-transcribe", ["--check", "--json"], True, {}),
    ("wa-send", ["--help"], False, {}),
]


# Con que arranca cada tope de retencion en una instalacion nueva. Van aca y no en un
# comentario porque son el trato entero del almacen de cuerpos — cuanto texto ajeno se
# guarda y por cuanto tiempo — y un default que cambia sin querer no se ve en ninguna
# salida.
DEFAULTS_RETENCION = {"capture_max": "20000", "capture_days": "90"}

# Ajustes: lo que se acepta y lo que se rechaza. Cada caso es
# (args, se_guarda, que_tiene_que_quedar).
# Un ajuste invalido no falla al escribirse: falla despues, en la corrida del agente y
# lejos de donde se tipeo — o peor, transcribe en el idioma equivocado sin decir nada.
# La validacion solo se ve recorriendola, asi que se recorre.
AJUSTES = [
    (["config", "inbox_days", "30"], True, "30"),
    (["config", "inbox_days", "abc"], False, "30"),
    (["config", "inbox_days", "todos"], False, "30"),
    (["config", "transcribe", "off"], True, "off"),
    (["config", "transcribe", "basura"], False, "off"),
    # `api` se ofrecia en el panel y nunca existio: tiene que morir al guardarse, no
    # tres audios despues.
    (["config", "transcribe", "api"], False, "off"),
    (["config", "transcribe_lang", "pt"], True, "pt"),
    (["config", "transcribe_lang", "klingon"], False, "pt"),
    (["config", "transcribe_quality", "minima"], True, "minima"),
    (["config", "transcribe_quality", "media"], False, "minima"),
    # owner_name es texto libre: cualquier nombre es un nombre.
    (["config", "owner_name", "Nombre De Ejemplo"], True, "Nombre De Ejemplo"),
    # Los dos topes del almacen de cuerpos, que son retencion de texto ajeno: bajarlos
    # tiene que poder hacerse sin tocar el codigo, y un valor invalido no puede quedar.
    (["config", "capture_max", "500"], True, "500"),
    (["config", "capture_max", "muchos"], False, "500"),
    (["config", "capture_days", "7"], True, "7"),
    (["config", "capture_days", "siempre"], False, "7"),
    # La ventana de la regla de agrupacion de casos. Cero o negativa no agruparia nunca
    # y abriria una tarjeta por mensaje: se rechaza al guardarse.
    (["config", "case_window_hours", "24"], True, "24"),
    (["config", "case_window_hours", "0"], False, "24"),
    (["config", "case_window_hours", "-3"], False, "24"),
    (["config", "case_window_hours", "medio dia"], False, "24"),
    # El primer mensaje (Beta): quien lo escribe y el ritmo de los avances. Un modo que no
