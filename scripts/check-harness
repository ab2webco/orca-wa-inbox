#!/usr/bin/env python3
"""Ninguna regla dura se perdio al mudarse al arnes.

Parte de la doctrina que vivia en los prompts vive ahora en `harness/`, que el worker
siembra en la carpeta de trabajo del plugin. Mudar texto es exactamente la operacion en
la que una regla se cae sin que nadie lo note: el diff se lee entero, se aprueba, y seis
semanas despues el agente manda una clave por WhatsApp.

Asi que no se lee el diff: se comprueba que cada regla dura siga ALCANZABLE por el
agente, y por los dos caminos que tiene dentro de su carpeta: el AGENTS.md, que Orca le
mete al contexto solo, y la skill whatsapp-soporte, que dice como se atiende un caso.
Desde caso-en-archivo (T3) el agente de casos corre siempre en la carpeta del plugin (el
tick lo abre ahi, con UNA linea que apunta a su caso y a la skill), y el prompt de triage
es solo un puntero al arnes: las reglas ya no viven en el prompt.

Ademas se comprueba que lo que el prompt manda leer exista de verdad: un `cat` a un
archivo que nadie siembra es una instruccion que el agente obedece sin obtener nada.
"""
import os
import pathlib
import re
import subprocess
import tempfile
import sys

RAIZ = pathlib.Path(__file__).resolve().parent.parent
ARNES = RAIZ / "harness"
PROMPTS = RAIZ / "prompts"

# Las cinco reglas duras, tal como las dicen los textos. El patron es la frase, no una
# palabra suelta: "credential" aparece en la tabla de clasificacion sin ser la regla.
REGLAS = [
    ("la credencial no pasa por el agente",
     r"credential never passes through the agent"),
    ("el agente nunca envia por WhatsApp",
     r"you never send anything on whatsapp"),
    ("en la duda no se propone nada",
     r"when in doubt,? you propose nothing"),
    ("nunca se promete fecha ni precio",
     r"never promise a date"),
    ("el idioma y el registro salen del tono configurado",
     r"language and (the )?register come from"),
]

# Los archivos que el plugin GENERA en la carpeta del orquestador y que no salen de
# `harness/`: PROJECTS.md es la lista de proyectos que el dueno acepto en los ajustes,
# asi que su contenido no puede vivir en el repo. Son el unico caso en que el arnes
# siembra mas archivos que los que hay en `harness/`, y eso es deliberado: lo que se
# comprueba abajo es que sigan siendo UNA excepcion con nombre, no un hueco en la regla.
GENERADOS = {"PROJECTS.md": "ARCHIVO_PROYECTOS = 'PROJECTS.md'"}

# Donde tiene que estar cada regla. El AGENTS.md es lo que Orca le mete al contexto al
# agente sin que nadie lo pida; la skill whatsapp-soporte es la que sigue con su caso.
OBLIGATORIOS = ["harness/AGENTS.md", "harness/skills/whatsapp-soporte/SKILL.md"]
SKILL_SOPORTE = "harness/skills/whatsapp-soporte/SKILL.md"
# El prompt de triage es un puntero: corto, sin los pasos, y apuntando a la skill.
PUNTERO_MAX_LINEAS = 30


def plano(texto: str) -> str:
    """Un solo espacio entre palabras: las frases del prompt van partidas en dos
    lineas y buscarlas literalmente solo encontraria la mitad."""
    return re.sub(r"\s+", " ", texto)


def ayuda_de_las_herramientas() -> str:
    """El `--help` de verdad de cada herramienta y de cada subcomando, todo junto: las
    banderas de una skill se comprueban contra esto y no contra una lista a mano."""
    textos = []

    def corre(*args: str) -> str:
        p = subprocess.run([str(RAIZ / "bin" / args[0]), *args[1:], "--help"],
                           capture_output=True, text=True, timeout=60,
                           env=dict(os.environ, HOME="/nonexistent"))
        return p.stdout

    for herramienta in ("wa-scope", "wa-read", "wa-send", "wa-transcribe"):
        base = corre(herramienta)
        textos.append(base)
        for grupo in re.findall(r"\{([a-z,-]+)\}", base):
            for sub in grupo.split(","):
                texto = corre(herramienta, sub)
                textos.append(texto)
                if herramienta == "wa-scope" and sub == "caso":
                    for g2 in re.findall(r"\{([a-z,-]+)\}", texto):
                        textos.extend(corre(herramienta, sub, s2) for s2 in g2.split(","))
    return "\n".join(textos)


def main() -> int:
    fallos = []
    comprobaciones = 0

    cuerpos = {}
    for rel in OBLIGATORIOS:
        ruta = RAIZ / rel
        if not ruta.exists():
            fallos.append(f"{rel}  no existe")
            cuerpos[rel] = ""
            continue
        cuerpos[rel] = plano(ruta.read_text(encoding="utf-8"))

    for nombre, patron in REGLAS:
        for rel in OBLIGATORIOS:
            comprobaciones += 1
            if not re.search(patron, cuerpos[rel], re.I):
                fallos.append(f"{rel}  ya no dice que {nombre}")

    # La tabla de clasificacion salio de 266 menciones reales. Si se muda otra vez y se
    # pierde el numero, se pierde lo unico que hace creible "la mitad no es trabajo".
    tabla = ARNES / "CLASSIFICATION.md"
    comprobaciones += 3
    if not tabla.exists():
        fallos.append("harness/CLASSIFICATION.md  no existe")
    else:
        cuerpo = tabla.read_text(encoding="utf-8")
        if "266" not in cuerpo:
            fallos.append("harness/CLASSIFICATION.md  perdio de donde salio la tabla "
                          "(las 266 menciones reales)")
        filas = [l for l in cuerpo.splitlines() if l.startswith("| **")]
        if len(filas) < 13:
            fallos.append(f"harness/CLASSIFICATION.md  la tabla quedo en {len(filas)} "
                          f"filas y tenia 13")

    # Los ejemplos son lo que mas corrige a un modelo chico: uno bien y uno mal.
    ejemplos = ARNES / "EXAMPLES.md"
    comprobaciones += 1
    if not ejemplos.exists() or "## One handled well" not in ejemplos.read_text(encoding="utf-8"):
        fallos.append("harness/EXAMPLES.md  ya no trae el mensaje atendido bien")

    # Lo que el prompt manda leer tiene que existir en el arnes, o el `cat` no trae nada.
    # Lo generado cuenta como sembrado, pero solo si el plugin de verdad lo declara, el
    # AGENTS.md lo nombra, y NO esta tambien en `harness/` (se sembraria dos veces, y la
    # copia del repo ganaria sobre la generada).
    sembrados = {p.name for p in ARNES.glob("*.md")}
    siembra = (RAIZ / "harness.mjs").read_text(encoding="utf-8")
    for archivo, declaracion in GENERADOS.items():
        comprobaciones += 3
        if declaracion not in siembra:
            fallos.append(f"harness.mjs  ya no declara el archivo generado {archivo}")
        if archivo not in cuerpos["harness/AGENTS.md"]:
            fallos.append(f"harness/AGENTS.md  no nombra {archivo}, que el plugin genera")
        if archivo in sembrados:
            fallos.append(f"harness/{archivo}  existe en el repo y tambien se genera")
        sembrados.add(archivo)
    for rel in ("prompts/triage.md",):
        cuerpo = (RAIZ / rel).read_text(encoding="utf-8")
        nombrados = set(re.findall(r"\b([A-Z][A-Z]+\.md)\b", cuerpo))
        comprobaciones += 1
        if not nombrados:
            fallos.append(f"{rel}  ya no manda leer el arnes")
        for archivo in sorted(nombrados - sembrados):
            fallos.append(f"{rel}  manda leer {archivo}, que el plugin no siembra")

    # Dos reglas del agente que no pueden perderse sin que nadie lo note: solo se actua
    # sobre lo posterior a la ultima respuesta enviada, y el encargo de un trabajo lleva
    # los mensajes textuales y no inventa quien es nadie. Viven en la skill. Y donde le
    # llega la correccion del dueno (T14): si no lo sabe, la propone igual que antes.
    soporte = cuerpos[SKILL_SOPORTE]
    for frase in ("`respondido`", "Act only on the messages after the last reply sent",
                  "VERBATIM", "open questions", "casos/caso-<id>.md",
                  "The owner's corrections"):
        comprobaciones += 1
        if frase.lower() not in soporte.lower():
            fallos.append(f"{SKILL_SOPORTE}  ya no dice: {frase}")

    # Y el prompt de triage es un puntero: corto, sin los pasos de antes, y mandando a la
    # skill. Unas reglas en el prompt y otras en el arnes terminan diciendo dos cosas.
    crudo = (RAIZ / "prompts" / "triage.md").read_text(encoding="utf-8")
    comprobaciones += 3
    if len(crudo.splitlines()) > PUNTERO_MAX_LINEAS:
        fallos.append(f"prompts/triage.md  tiene {len(crudo.splitlines())} lineas: es un "
                      f"puntero al arnes, a lo mas {PUNTERO_MAX_LINEAS}")
    if "whatsapp-soporte" not in crudo:
        fallos.append("prompts/triage.md  no manda a la skill whatsapp-soporte")
    if re.search(r"^## STEP", crudo, re.M):
        fallos.append("prompts/triage.md  todavia trae los pasos: viven en la skill")

    # El modelo de casos reemplazo a Tomar/Ignorar: ni el arnes ni el prompt pueden mandar
    # al dueno a botones, banderas o locks que ya no existen. Fue justo lo que el agente
    # obedecio en vivo ("usa Tomar o Ignorar").
    viejo = re.compile(r"Take or Ignore|only-taken|take lock|wa-scope decisions"
                       r"|\.?ninguno.? conversation (never )?opens? (no )?cards?", re.I)
    for rel in [*(f"harness/{p.name}" for p in ARNES.glob("*.md")),
                *(str(p.relative_to(RAIZ)) for p in ARNES.glob("skills/*/SKILL.md")),
                "prompts/triage.md"]:
        comprobaciones += 1
        hallado = viejo.search(plano((RAIZ / rel).read_text(encoding="utf-8")))
        if hallado:
            fallos.append(f"{rel}  describe el flujo viejo: {hallado.group(0)!r}")

    # Las skills del agente: `harness/skills/<nombre>/SKILL.md` se siembran en
    # `.claude/skills/<nombre>/SKILL.md`. Claude Code solo las carga con un frontmatter
    # valido (name igual a la carpeta, description que diga cuando usarla), y una skill que
    # inventa una bandera le ensena al agente un comando que no existe.
    skills = sorted((ARNES / "skills").glob("*/SKILL.md"))
    comprobaciones += 1
    if {p.parent.name for p in skills} != {"whatsapp-soporte", "whatsapp-cli"}:
        fallos.append("harness/skills  tienen que estar whatsapp-soporte y whatsapp-cli")
    ayuda = ayuda_de_las_herramientas()
    for ruta in skills:
        rel = ruta.relative_to(RAIZ)
        cuerpo = ruta.read_text(encoding="utf-8")
        marco = re.match(r"---\n(.*?)\n---\n", cuerpo, re.S)
        comprobaciones += 4
        campos = dict(re.findall(r"^(\w+): (.+)$", marco.group(1), re.M)) if marco else {}
        if not marco or campos.get("name") != ruta.parent.name:
            fallos.append(f"{rel}  el frontmatter no empieza el archivo o su `name` no es "
                          f"{ruta.parent.name}")
        if len(campos.get("description", "")) < 40 or "use" not in campos.get("description", "").lower():
            fallos.append(f"{rel}  la `description` no dice cuando usar la skill")
        if "you edited is yours" not in cuerpo[:1500]:
            fallos.append(f"{rel}  no dice en el propio archivo que pasa con una edicion a mano")
        inventadas = sorted({f for f in re.findall(r"(?<![\w-])--[a-z][a-z-]+", cuerpo)
                             if f not in ayuda})
        if inventadas:
            fallos.append(f"{rel}  usa banderas que ninguna herramienta tiene: {inventadas}")
        if "wa-send" in cuerpo and "never run" not in cuerpo.lower():
            fallos.append(f"{rel}  nombra wa-send sin decir que el agente no lo usa")
    # Y el CLAUDE.md del espacio de trabajo apunta a AGENTS.md y a las dos skills.
    comprobaciones += 1
    claude = (ARNES / "CLAUDE.md").read_text(encoding="utf-8") if (ARNES / "CLAUDE.md").exists() else ""
    if not all(x in claude for x in ("AGENTS.md", "whatsapp-soporte", "whatsapp-cli")):
        fallos.append("harness/CLAUDE.md  tiene que apuntar a AGENTS.md y a las dos skills")
    # El worker siembra las skills y `.wa-bin` con la misma huella que el resto.
    comprobaciones += 1
    if "plantillasDelArnes" not in siembra or "sembrarBin(" not in siembra:
        fallos.append("harness.mjs  ya no siembra las skills o `.wa-bin`")

    # El puntero estable al bin (cli-huecos, C5) vive en la carpeta de estado de las
    # herramientas. La escribe harness.mjs y la leen las CLIs y quien siga la skill: las
    # dos tablas se corren contra el MISMO HOME y se comparan, como las del almacen.
    comprobaciones += 1
    if "ARCHIVO_BIN_ESTABLE = 'bin-path'" not in siembra or "sembrarBinEstable(" not in siembra:
        fallos.append("harness.mjs  ya no deja `bin-path` en la carpeta de estado")
    else:
        with tempfile.TemporaryDirectory() as casa:
            env = dict(os.environ, HOME=casa, APPDATA=os.path.join(casa, "AppData"))
            js = subprocess.run(
                ["node", "--input-type=module", "-e",
                 "import { dirEstado } from %r; process.stdout.write(dirEstado())"
                 % (RAIZ / "harness.mjs").as_uri()],
                capture_output=True, text=True, env=env, timeout=60)
            py = subprocess.run(
                [sys.executable, "-c", "import sys; sys.dont_write_bytecode = True; "
                 "sys.path.insert(0, %r); import wa_store; print(wa_store.inbox_dir())"
                 % str(RAIZ / "bin")],
                capture_output=True, text=True, env=env, timeout=60)
            if not js.stdout or js.stdout.strip() != py.stdout.strip():
                fallos.append(f"harness.mjs  deja `bin-path` en {js.stdout.strip()!r} y las "
                              f"CLIs leen su estado de {py.stdout.strip()!r}")
    # Y lo nuevo del CLI esta dicho donde el agente lo lee (cli-huecos, C6). El primer
    # mensaje del agente (Beta) solo en los modos del agente, y en `ack` la regla de siempre;
    # y el `necesita` del agente del proyecto: una pregunta concreta, y esperar en la
    # terminal sin sondear (primer-mensaje-beta, P4).
    for rel, frases in (("harness/COMMANDS.md", ("bin-path", "wa-read wait", "caso avance",
                                                 "first_reply_mode")),
                        ("harness/skills/whatsapp-cli/SKILL.md", ("bin-path", "wa-read\" wait",
                                                                  "caso avance")),
                        (SKILL_SOPORTE, ("caso avance", "first_reply_mode",
                                         "Never write either one yourself", "Never filler",
                                         "Never repeat", "one concrete question",
                                         "wait idle in the same terminal", "Do not poll")),
                        ("prompts/triage.md", ("caso avance", "first_reply_mode"))):
        comprobaciones += 1
        texto = plano((RAIZ / rel).read_text(encoding="utf-8")) if (RAIZ / rel).exists() else ""
        faltan = [f for f in frases if f not in texto]
        if faltan:
            fallos.append(f"{rel}  no dice {', '.join(faltan)}")

    # Y cada archivo del arnes tiene que decir en el propio archivo que pasa con una
    # edicion a mano: saberlo no puede exigir leer el codigo del plugin.
    for ruta in sorted(ARNES.glob("*.md")):
        comprobaciones += 1
        cabecera = ruta.read_text(encoding="utf-8")[:1200]
        if "you edited is yours" not in cabecera:
            fallos.append(f"harness/{ruta.name}  no dice en el propio archivo que pasa "
                          f"con una edicion a mano en la proxima actualizacion")

    if fallos:
        print("Se perdio una regla al mudar la doctrina al arnes:", file=sys.stderr)
        for f in dict.fromkeys(fallos):
            print(f"  {f}", file=sys.stderr)
        return 1
    print(f"{comprobaciones} comprobaciones: las {len(REGLAS)} reglas duras siguen "
          f"alcanzables por el AGENTS.md y por la skill; el prompt es un puntero; "
          f"{len(GENERADOS)} archivo generado declarado")
    return 0


if __name__ == "__main__":
    sys.exit(main())
