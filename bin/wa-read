#!/usr/bin/env python3
"""wa-read — read-only access to WhatsApp for agents.

The plugin links one WhatsApp line with a QR code, and a sidecar keeps that line open
and writes what it receives into a message store. This tool is the query layer over
that store — it never writes to it, and it never talks to WhatsApp.

  inbox [--days N] [--limit N]  what arrived in the conversations you authorized
  chats [--query TXT] [-n N]    list chats (groups and 1:1) with unread counts, and
                                the phone of a 1:1 (`phone`, +E.164) when known
  senders [-n N]                who wrote in the authorized chats: ids and names, no text
  members --chat <jid|id|name>  who is in a chat, to give each one a role: [{id, name,
                                phone, wa_admin}], no text
  whoami                        your LID and how many groups
  chat <id|name> [-n N]         latest messages of a chat
  media <id|name> [-n N]        latest images/videos/audio, with the path on disk
  wait --chat <jid> [--after X] [--timeout S]
                                block until someone else writes in that chat: how
                                you ask the owner something and wait for his reply
  state                         how much the store changed, without reading it
  doctor                        check the requirements

Every read command takes `--line ACCOUNT` to answer for one linked line only. The same
1:1 conversation seen from two of your own lines is the same JID, so the key is
(account, jid) and never the JID alone.

Exit codes are domain answers, not failure levels: 1 = a requirement is missing,
2 = that chat reference is ambiguous, 3 = that chat is not authorized (`wait`), 4 =
there is nothing to read from, 5 = `wait` ended with no new message. Reason on the
first line of stderr, stdout empty or parseable. Refusing is the point: an empty list
reads as "there is nothing to attend to", which is the opposite of "I cannot read
anything".

Global: --json  JSON output instead of a table.
"""
import argparse, json, os, subprocess, sys, time

# Sin esto Python deja un __pycache__ DENTRO de bin/, y el directorio del plugin
# instalado esta direccionado por hash: un archivo que aparece despues de la
# instalacion es justo lo que deja el plugin en "No valido".
sys.dont_write_bytecode = True

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import wa_store  # noqa: E402
from wa_store import SinFuente  # noqa: E402

# Salir con 1 ya significa "te falta un requisito" y con 2 "esa referencia es ambigua".
# Que no haya de donde leer es otra cosa, y quien automatiza necesita distinguirla sin
# leer prosa: por eso tiene su propio codigo y un motivo estable en la salida.
EXIT_SOURCE = 4
# Estos motivos son contrato: el panel los traduce por codigo. Cambiar el texto no rompe
# nada; renombrar el codigo desincroniza el panel en silencio.
SIN_TRANSPORTE = wa_store.SIN_TRANSPORTE
SIN_TRANSPORTE_DETALLE = wa_store.SIN_TRANSPORTE_DETALLE
# `wait`: una conversacion que el dueno no autorizo no se espera (nada de ella llega al
# almacen, asi que esperarla es esperar hasta el plazo sin decir por que), y el plazo
# vencido sin nada nuevo es una respuesta, no un fallo.
EXIT_NO_AUTORIZADO = 3
EXIT_SIN_NOVEDAD = 5
NO_AUTORIZADO = "chat-not-authorized"
SIN_NOVEDAD = "wait-timeout"
# Cuanto espera `wait` y cada cuanto mira el almacen si no se le dice. Son banderas, no
# constantes escondidas: quien llama sabe cuanto puede esperar.
ESPERA_S = 300.0
SONDEO_S = 2.0
SONDEO_MIN_S = 0.05

AYUDA_WAIT = f"""Block until someone else writes in an authorized chat, then print what arrived.

  wa-read wait --chat <jid> [--after <stanza_id|epoch>] [--timeout S] --json

Only messages from the other side count: what this line sends never wakes it. It reads
the message store every --poll seconds; it never talks to WhatsApp. The chat (--chat, or
as the first argument) follows the same rules as `chat` (a JID, the id from `chats`, or
part of its name; `--line` for one line), and it must be authorized for the agent (any
mode but `off`).

--after takes the stanza_id of a message of that chat (what arrived after it, which may
already be there), including the one `wa-send` just returned even before its echo is in
the store, or a time in epoch seconds. Without it, only what arrives from now on.

ASK THE OWNER AND WAIT FOR THE REPLY. A send to the owner's own chat is never held, so:

  wa-send "<owner chat jid>" "<question>" --send --json     -> {{"stanza_id": "<S>", ...}}
  wa-read wait --chat "<owner chat jid>" --after <S> --timeout 600 --json

In the line's chat with itself, what the owner types on his phone counts as his reply
even though WhatsApp marks it as sent by the line; what the line itself sent does not.

Exit codes: 0 = new messages, printed oldest first (each with its stanza_id, for the next
--after); 1 = no chat or no --after message matches; 2 = the chat reference is ambiguous;
3 = `{NO_AUTORIZADO}`, the chat is not authorized; 4 = `no-transport`, there is nothing
to read from; 5 = `{SIN_NOVEDAD}`, --timeout ended with no new message. The reason is on
the first line of stderr and stdout is empty when it does not exit 0."""


def morir_sin_fuente(reason, detail, code=EXIT_SOURCE):
    """Sale con el motivo en la PRIMERA linea de stderr y sin escribir nada en stdout.

    Las dos cosas son contrato. La primera linea la lee el worker (lineaUtil) y termina
    en el panel; stdout vacio es lo que hace que quien parsea JSON lea una lista vacia
    en vez de reventar con un objeto que no esperaba."""
    sys.stderr.write(f"wa-read: {reason}\n{detail}\n")
    sys.exit(code)


def _transcribe_check():
    """Opcional: sin esto todo funciona, solo que los audios quedan sin leer.

    Devuelve (ok, detalle, codigo). El detalle lo lee quien corre el CLI y va en
    ingles como todo lo demas; el codigo es lo que el panel traduce al idioma del
    usuario, porque una frase guardada en el storage se congela en su idioma."""
    exe = os.path.join(os.path.dirname(os.path.abspath(__file__)), "wa-transcribe")
    if not os.path.exists(exe):
        return False, "bin/wa-transcribe is missing", "transcribe-missing-tool"
    try:
        p = subprocess.run([exe, "--check", "--json"], capture_output=True,
                           text=True, timeout=30)
        info = json.loads(p.stdout or "{}")
    except (OSError, ValueError, subprocess.SubprocessError):
        return False, "could not check", "transcribe-unknown"
    if info.get("puede"):
        # Ojo: con Orca listo `motores` viene vacio, asi que indexarlo revienta el doctor.
        if info.get("orca"):
            return True, f"Orca with model {info.get('modelo_orca')}", "transcribe-orca"
        return True, f"{info['motores'][0]} with model {info['modelo']}", "transcribe-engine"
    if info.get("orca_sin_comando"):
        return (False,
                "optional — this Orca does not ship audio transcription yet; update it, "
                "or install a local engine with brew install whisper-cpp",
                "transcribe-orca-outdated")
    if not info.get("motores"):
        return (False,
                "optional — no engine: download the model in Settings > Voice, or "
                "install a local one with brew install whisper-cpp",
                "transcribe-no-engine")
    return False, f"optional — the model {info.get('modelo')} is missing", "transcribe-no-model"


REQUISITOS = """The plugin cannot read messages yet.

  No WhatsApp line is linked. Open the plugin settings and scan the QR code with the
  phone whose conversations the agent should read. Once the line is linked, the
  sidecar starts filling the message store and every command here answers.

  Everything else does work: the registry, the mapping, the panels and the
  automations, which stay blocked on purpose while there is nothing to read. Blocking
  is the honest answer: an empty inbox would read as a quiet week.
"""


# Cuanto se sigue avisando de algo que paso una vez (una subida de esquema, una
# re-clave). Pasado esto ya no le pide nada a nadie y solo ensucia el panel.
AVISO_UNICO_S = 7 * 86400


def reciente(epoch):
    """Si un aviso de una sola vez todavia vale la pena mostrarlo."""
    try:
        return time.time() - int(epoch) <= AVISO_UNICO_S
    except (TypeError, ValueError):
        return False


def estado_de_lineas(con, cuentas):
    """El transporte de cada linea para el doctor: su ultimo latido, si su socket esta
    abierto y si esta muda (`sidecar_mudo`). Una linea muda lleva `transport-silent`,
    el mismo codigo que el renglon cuando no lee ninguna."""
    salida = []
    for cuenta in cuentas:
        mudo = wa_store.sidecar_mudo(con, cuenta)
        salida.append({"account": cuenta, "ok": not mudo,
                       "code": wa_store.LINEA_MUDA if mudo else SIN_TRANSPORTE,
                       "latido": wa_store.ultimo_latido(con, cuenta),
                       "conectado": wa_store.linea_conectada(con, cuenta)})
    return salida


def cmd_doctor(a):
    """Para que el usuario sepa que le falta antes de que nada dependa de esto.

    El codigo es la llave estable: el nombre y el detalle estan en ingles para quien
    corre el CLI, y el panel traduce por codigo al idioma del usuario. Renombrar un
    codigo desincroniza el panel en silencio; el texto se puede reescribir sin riesgo."""
    # Bloquea, y tiene que bloquear cuando no hay linea. Un plugin que no puede leer no
    # es un plugin al que le falta algo opcional: con esto en verde, `wa-scope pending`
    # dejaria correr al agente sobre una bandeja que siempre esta vacia, y eso se lee
    # como que no hubo trabajo.
    try:
        con = wa_store.abrir()
    except SinFuente as exc:
        filas = [{"check": "a message transport", "ok": False, "detalle": exc.detail,
                  "requerido": True, "code": exc.reason, "via": None}]
    else:
        # La linea vinculada AHORA: las de otros numeros siguen guardadas, pero no son
        # las que este equipo esta leyendo.
        lineas = wa_store.whoami(con, wa_store.linea_activa(con))
        cuantas = len(lineas)
        etiquetas = ", ".join(x.get("account") or "?" for x in lineas)
        via = lineas[0].get("account") if lineas else None
        # `sidecar_mudo` y no `sidecar_vivo`: el doctor da un margen que cubre un reinicio
        # del sidecar (T16c), y `wa-send` conserva su plazo corto. Cada linea con SU
        # latido (linea-viva V8): con el global, una linea muda se escondia detras de la
        # otra. El renglon sigue en verde mientras alguna lea —una linea caida no frena a
        # la otra—, y `lineas` dice cual esta muda.
        por_linea = estado_de_lineas(con, wa_store.lineas_activas(con) or
                                     [x.get("account") for x in lineas if x.get("account")])
        mudas = [x for x in por_linea if not x["ok"]]
        if (len(mudas) < len(por_linea)) if por_linea else not wa_store.sidecar_mudo(con):
            detalle = (f"{cuantas} linked line"
                       f"{'' if cuantas == 1 else 's'} ({etiquetas})")
            if mudas:
                detalle += "; no sign of life from " + ", ".join(
                    f"{x['account']} (since {wa_store.ts(x['latido'])})" if x["latido"]
                    else f"{x['account']} (never)" for x in mudas)
            filas = [{"check": "a message transport", "ok": True, "detalle": detalle,
                      "requerido": True, "code": SIN_TRANSPORTE, "via": via,
                      "lineas": por_linea}]
        else:
            # Una fila en `linea` dice que alguna vez hubo una linea, no que alguien la
            # este leyendo. Medido en la maquina del dueno: el sidecar muerto desde el
            # dia anterior y este renglon en verde, porque la fila seguia ahi.
            latido = wa_store.ultimo_latido(con, via)
            desde = (f"since {wa_store.ts(latido)}" if latido
                     else "at all since it was linked")
            filas = [{"check": "a message transport", "ok": False,
                      "detalle": (f"the linked line has given no sign of life {desde}: "
                                  "nothing is reading WhatsApp right now. Restart the "
                                  "connection from the plugin settings."),
                      "requerido": True, "code": wa_store.LINEA_MUDA, "via": via,
                      "lineas": por_linea}]
        # El desalojo va al doctor porque es lo unico del almacen que el usuario puede
        # cambiar: subir `capture_max` o `capture_days` desde el panel. Un tope que
        # muerde en silencio deja filas sin cuerpo sin que nadie sepa por que (§11-F2).
        desalojo = wa_store.ultimo_desalojo(con)
        if desalojo and (desalojo["caducados"] or desalojo["desalojados"]):
            total = desalojo["caducados"] + desalojo["desalojados"]
            # `ok: False` a proposito, y no es un fallo: `checkSystem` arma la lista
            # de opcionales del panel con `requerido === false && !ok` (main.mjs), asi
            # que un renglon en verde no llega NUNCA a la pantalla. Un desalojo que
            # solo se ve corriendo el CLI a mano no esta visible, esta escondido detras
            # de una terminal — y "visible" es justo lo que pide §11-F2. No bloquea
            # porque `requerido` es False: el doctor sigue saliendo 0.
            filas.append({
                "check": "message retention", "ok": False,
                "detalle": (f"optional — {total} message bodies were evicted on "
                            f"{wa_store.ts(desalojo['at'])} ({desalojo['caducados']} "
                            f"expired, {desalojo['desalojados']} over the cap). Raise "
                            f"capture_max or capture_days to keep more."),
                "requerido": False, "code": "retention",
                "detailCode": "retention-evicted", "via": None})
        con.close()
    # La migracion del almacen va FUERA del try/except de arriba a proposito: se
    # reporta igual cuando `abrir()` se nego. En una maquina que venia de la via de
    # WhatsApp Web, la subida se lleva las lineas de esa via —ya no existe quien las
    # escriba— y el almacen queda sin linea enlazada hasta que el sidecar conecte. Ese
    # es justo el momento en que el usuario necesita leer que paso con lo viejo; si
    # este renglon colgara del almacen abierto, no se veria nunca.
    migracion = wa_store.ultima_migracion()
    # Una semana, no para siempre (T10): visto en vivo, el aviso seguia en el panel
    # semanas despues de una subida que ya no le pedia nada a nadie.
    if migracion and not reciente(migracion["at"]):
        migracion = None
    if migracion and not migracion["cuerpos"] and migracion["lineas"]:
        # Sin cuerpos no se borro ningun mensaje: solo se retiraron las lineas de la via
        # que ya no existe. Decir "se borro" asustaba por algo que no paso.
        filas.append({
            "check": "message store upgrade", "ok": False,
            "detalle": (f"optional — the message store was upgraded from version "
                        f"{migracion['desde']} to {migracion['hasta']} on "
                        f"{wa_store.ts(migracion['at'])} without losing any message. "
                        f"The {migracion['lineas']} lines of the removed WhatsApp Web "
                        f"route were retired, and the linked line fills the store."),
            "requerido": False, "code": "store-migrated",
            "detailCode": "store-migrated-clean", "via": None})
    elif migracion and migracion["cuerpos"]:
        # `ok: False` a proposito, por lo mismo que el renglon de retencion de aca
        # arriba: `checkSystem` arma la lista de opcionales del panel con
        # `requerido === false && !ok` (main.mjs), asi que un renglon en verde no llega
        # NUNCA a la pantalla. Y no bloquea, porque no hay nada roto que arreglar: el
        # almacen quedo al dia. Lo que hay es algo que se fue y hay que decirlo.
        filas.append({
            "check": "message store upgrade", "ok": False,
            "detalle": (f"optional — the message store was upgraded from version "
                        f"{migracion['desde']} to {migracion['hasta']} on "
                        f"{wa_store.ts(migracion['at'])}. The removed WhatsApp Web "
                        f"route left {migracion['cuerpos']} cached message bodies and "
                        f"{migracion['lineas']} of its own lines behind, in a schema "
                        f"this version cannot read: they were dropped. Nothing else "
                        f"was touched, and the linked line fills the store again."),
            "requerido": False, "code": "store-migrated",
            "detailCode": "store-migrated-dropped", "via": None})
    # La re-clave de `local` al numero de su linea (T9), por lo mismo que la migracion
    # de arriba: `ok: False` para que llegue al panel, y no bloquea, porque no hay nada
    # roto. Se dice adonde fueron las conversaciones de antes.
    # Lo de antes de T9 que no se pudo atribuir con certeza (T9f, falla cerrada): no se
    # movio nada y hace falta que el dueno diga de que numero es. No caduca: es una
    # decision pendiente, no un aviso de algo que ya paso.
    pendiente = wa_store.reclave_pendiente()
    if pendiente:
        wa_scope = os.path.join(os.path.dirname(os.path.abspath(__file__)), "wa-scope")
        filas.append({
            "check": "data from a previous number", "ok": False,
            "detalle": (f"optional — {pendiente.get('chats', 0)} conversations and "
                        f"{pendiente.get('mensajes', 0)} messages were stored before each "
                        f"number had its own line, and they cannot be matched for sure to "
                        f"the number linked now, so they stay hidden. Nothing was "
                        f"deleted. If they came from another number of yours, run: "
                        f"{wa_scope} reclave --numero <that number, digits only>; it "
                        f"is applied within a minute."),
            "requerido": False, "code": "store-rekey-pending",
            "detailCode": "store-rekey-decide", "via": None})
    # Con la misma semana de vida que el de la migracion: es el mismo tipo de aviso.
    for r in [x for x in wa_store.reclaves()[-1:] if reciente(x["at"])]:
        numero = str(r["hacia"]).replace("pn:", "+", 1)
        filas.append({
            "check": "line re-keyed", "ok": False,
            "detalle": (f"optional — on {wa_store.ts(r['at'])} the {r['chats']} "
                        f"conversations and {r['mensajes']} messages that were stored "
                        f"before each number became its own line were assigned to "
                        f"{numero}, the number they came from. Nothing was deleted."),
            "requerido": False, "code": "store-rekeyed",
            "detailCode": "store-rekeyed-line", "via": None})
    # Lo opcional no bloquea: sin transcripcion todo funciona, solo que los audios
    # quedan sin leer. Marcarlo como rotura pintaria de rojo un equipo sano.
    ok, detalle, dcode = _transcribe_check()
    filas.append({"check": "audio transcription", "ok": ok, "detalle": detalle,
                  "requerido": False, "code": "transcribe", "detailCode": dcode,
                  "via": None})
    return filas


def cmd_inbox(con, a):
    # La ventana de lectura es de la linea que se lee (ajustes-por-linea).
    ajustes = wa_store.ajustes(a.line)
    dias = a.days if a.days else wa_store.entero(ajustes, "inbox_days")
    # 500 y no un numero mas chico: es el tope que el arnes ya documenta
    # (harness, "al menos los 500 mas nuevos"), y bajarlo en silencio haria que el
    # agente diera por vista una ventana que no vio entera.
    return wa_store.inbox(con, dias, a.limit or 500, a.window, a.only, a.line)


def cmd_chats(con, a):
    return wa_store.chats(con, a.n, a.query, a.unread, a.line)


def cmd_senders(con, a):
    return wa_store.remitentes(con, a.line, a.n)


def cmd_members(con, a):
    fila = wa_store.resolver_chat(con, a.chat, a.line)
    return wa_store.miembros(con, fila["account"], fila["chat_jid"], bool(fila["is_group"]))


def cmd_chat(con, a):
    return wa_store.chat(con, wa_store.resolver_chat(con, a.chat, a.line), a.n, a.days)


def cmd_media(con, a):
    return wa_store.media(con, wa_store.resolver_chat(con, a.chat, a.line), a.n)


def autorizada(fila):
    """Si el dueno autorizo esta conversacion: la pregunta va a `wa-scope list`, que cruza
    la base y lo que se toco en el panel, igual que el sidecar antes de guardar un
    mensaje. Copiar ese cruce aca seria tener dos verdades. Si no se puede saber, no."""
    exe = os.path.join(os.path.dirname(os.path.abspath(__file__)), "wa-scope")
    try:
        p = subprocess.run([exe, "list", "--json"], capture_output=True, text=True,
                           timeout=60)
        filas = json.loads(p.stdout or "[]") if p.returncode == 0 else []
    except (OSError, ValueError, subprocess.SubprocessError):
        filas = []
    return any(isinstance(r, dict) and r.get("chat_jid") == fila["chat_jid"]
               and (r.get("account") or "local") == fila["account"]
               and (r.get("mode") or "off") != "off" for r in filas)


def cmd_wait(con, a):
    fila = wa_store.resolver_chat(con, a.chat_ref, a.line)
    if not autorizada(fila):
        morir_sin_fuente(NO_AUTORIZADO,
                         f"{wa_store.nombre_de(fila)!r} is not authorized for the agent "
                         "(its mode is off): nothing from it reaches the store. Authorize "
                         "it in the plugin settings.", EXIT_NO_AUTORIZADO)
    base = wa_store.desde_donde(con, fila, a.after)
    sondeo = max(SONDEO_MIN_S, a.poll)
    limite = time.monotonic() + max(0.0, a.timeout)
    while True:
        filas = wa_store.nuevos(con, fila, base)
        if filas:
            return filas
        if time.monotonic() >= limite:
            morir_sin_fuente(SIN_NOVEDAD,
                             f"no new message in {wa_store.nombre_de(fila)!r} within "
                             f"{a.timeout:g}s.", EXIT_SIN_NOVEDAD)
        time.sleep(min(sondeo, max(0.0, limite - time.monotonic())))


def cmd_whoami(con, a):
    return wa_store.whoami(con, a.line)


def cmd_state(con, a):
    return wa_store.state(con, a.line)


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--json", action="store_true")
    sub = ap.add_subparsers(dest="cmd", required=True)

    def add(name, fn=None, **kw):
        sp = sub.add_parser(name, **kw)
        sp.add_argument("--json", dest="json_sub", action="store_true")
        # La MISMA conversacion puede existir en dos lineas propias. Sin poder decir
        # cual, pedirla es ambiguo, y resolver la ambiguedad en silencio es contestar
        # sobre la conversacion ajena (§11-A1/D4).
        sp.add_argument("--line", default=None,
                        help="answer for one linked line only (its account id)")
        if fn:
            sp.set_defaults(fn=fn)
        return sp

    s = add("inbox", cmd_inbox, help="what arrived in the conversations you authorized")
    s.add_argument("--days", type=int, default=None)
    s.add_argument("--limit", type=int, default=None)
    s.add_argument("--window", type=int, default=5)
    s.add_argument("--only", choices=["todos", "grupos", "directos"], default="todos")

    s = add("chats", cmd_chats, help="list chats")
    s.add_argument("--query"); s.add_argument("--unread", action="store_true")
    s.add_argument("-n", type=int, default=30)

    s = add("senders", cmd_senders,
            help="who wrote in the authorized chats (ids and names, no text): the panel "
                 "offers them to pick the owner's numbers")
    s.add_argument("-n", type=int, default=400)

    s = add("members", cmd_members,
            help="who is in a chat (ids, names, phones; no text): the panel offers them to "
                 "give each person a role")
    s.add_argument("--chat", required=True,
                   help="the chat: its JID, the id from `chats`, or part of its name")

    s = add("chat", cmd_chat, help="messages of a chat")
    s.add_argument("chat"); s.add_argument("-n", type=int, default=40)
    s.add_argument("--days", type=int)

    s = add("media", cmd_media, help="attachments of a chat, with the path on disk")
    s.add_argument("chat"); s.add_argument("-n", type=int, default=15)

    s = add("wait", cmd_wait, help="block until someone else writes in an authorized chat",
            description=AYUDA_WAIT, formatter_class=argparse.RawDescriptionHelpFormatter)
    # La conversacion va con `--chat <jid>` (T18) o como primer argumento, como en
    # `chat`: una de las dos, y una sola vez.
    s.add_argument("chat", nargs="?", default=None, help=argparse.SUPPRESS)
    s.add_argument("--chat", dest="chat_opt", default=None, metavar="JID|ID|NAME",
                   help="the chat to wait on: its JID, the id from `chats`, or part of its "
                        "name (it can also go as the first argument)")
    s_wait = s
    s.add_argument("--after", default=None, metavar="STANZA|EPOCH",
                   help="start after this message of the chat, or after this time")
    s.add_argument("--timeout", type=float, default=ESPERA_S, metavar="S",
                   help=f"how long to wait, in seconds (default {ESPERA_S:g}; 0 looks once)")
    s.add_argument("--poll", type=float, default=SONDEO_S, metavar="S",
                   help=f"how often to read the store, in seconds (default {SONDEO_S:g})")

    add("whoami", cmd_whoami)
    add("doctor", help="check the requirements")
    add("state", cmd_state, help="how much the store changed, without reading it")

    a = ap.parse_args()
    if getattr(a, "json_sub", False):   # permite --json antes o despues del subcomando
        a.json = True
    if a.cmd == "wait":
        # Antes de abrir nada: un pedido mal formado es un error de argumentos (2), no
        # "no hay de donde leer".
        if bool(a.chat) == bool(a.chat_opt):
            s_wait.error("name the chat once: --chat <jid> (or as the first argument)")
        a.chat_ref = a.chat or a.chat_opt

    if a.cmd == "doctor":               # tiene que correr aunque falte todo lo demas
        rows = cmd_doctor(a)
        if a.json:
            print(json.dumps(rows, ensure_ascii=False, indent=2))
        else:
            for r in rows:
                print(f"{'ok ' if r['ok'] else 'MISSING'}  {r['check']}: {r['detalle']}")
            if [r for r in rows if not r["ok"] and r.get("requerido", True)]:
                print("\n" + REQUISITOS)
        # Lo requerido lo dice el propio chequeo, no la palabra "optional" en su nombre.
        # Clasificar por texto ya habia roto esto antes, en el panel y aca.
        obligatorios = [r for r in rows if r.get("requerido", True)]
        sys.exit(0 if all(r["ok"] for r in obligatorios) else 1)

    try:
        con = wa_store.abrir()
    except SinFuente as exc:
        morir_sin_fuente(exc.reason, exc.detail, exc.code)
    try:
        # Sin `--line`, la linea que esta vinculada AHORA. Leer todas mezclaba las
        # conversaciones del numero viejo con las del nuevo (visto en vivo, 2026-10-01).
        # Otra linea se puede pedir a proposito, nombrandola.
        # Con varias lineas, la corrida de una linea la nombra (`WA_INBOX_LINEA`) y sus
        # lecturas son de esa linea.
        if not a.line:
            try:
                a.line = wa_store.linea_pedida() or wa_store.linea_activa(con)
            except wa_store.LineaInvalida as exc:
                sys.exit(f"wa-read: {exc}")
        rows = a.fn(con, a)
    finally:
        con.close()

    if a.json:
        print(json.dumps(rows, ensure_ascii=False, indent=2))
    elif not rows:
        print("(no results)")
    else:
        for r in rows:
            print(" | ".join(str(v) for v in r.values() if v not in (None, "")))


if __name__ == "__main__":
    main()
