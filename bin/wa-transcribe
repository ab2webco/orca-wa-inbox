#!/usr/bin/env python3
"""wa-transcribe — turns a voice note into text, depending on nothing from Orca.

  wa-transcribe <file.opus>          transcribes
  wa-transcribe --check              says whether this machine can transcribe

Everything lives in the plugin: this tool ships with it, and the engine is looked up
on the user's machine. **It downloads nothing on its own**: when the model is missing
it says so and explains how to install it. A plugin that silently pulls weights off
the internet is the opposite of what its permission sheet promises.

Engines are tried in order. The first one present wins.
"""
import argparse, json, os, shlex, shutil, subprocess, sys, tempfile

CONFIG_KEYS = ("transcribe", "transcribe_model", "transcribe_lang")

# Un modelo solo-ingles sobre audio en español devuelve basura sin avisar, que es peor
# que un error. Estos nombres se rechazan de entrada.
SOLO_INGLES = ("base.en", "small.en", "tiny.en", "medium.en",
               "parakeet-tdt-0.6b-v2-int8", "zipformer-streaming-en-20m")

# Dos niveles, y nada mas: uno que entre en cualquier equipo y uno para cuando hay con
# que. El resto del catalogo es de un solo idioma o no cubre español.
CALIDAD = {
    "minima": {"orca": "whisper-tiny", "local": "tiny",
               "mb": 146, "nota": "corre en cualquier equipo, pero en español destroza "
                                  "nombres y pedidos: solo si no hay con que, y no "
                                  "decidas nada leyendo su texto"},
    "optima": {"orca": "parakeet-tdt-0.6b-v3-int8", "local": "small",
               "mb": 639, "nota": "25 idiomas con puntuacion; el recomendado"},
}


_AJUSTES = None


def ajustes():
    """Los ajustes se le preguntan a wa-scope, que ya sabe que el panel manda sobre el
    scope.db. Leer el sqlite directo se saltaba el panel: la calidad que el usuario
    elegia ahi no llegaba nunca a la transcripcion. Se resuelve una vez por proceso."""
    global _AJUSTES
    if _AJUSTES is None:
        _AJUSTES = {}
        cli = os.path.join(os.path.dirname(os.path.abspath(__file__)), "wa-scope")
        try:
            p = subprocess.run([cli, "config", "--json"], capture_output=True,
                               text=True, timeout=30)
            if p.returncode == 0:
                _AJUSTES = {r["key"]: r["value"] for r in json.loads(p.stdout or "[]")
                            if isinstance(r, dict) and r.get("key")}
        except (OSError, ValueError, TypeError, subprocess.SubprocessError):
            _AJUSTES = {}
    return _AJUSTES


def setting(key, fallback):
    """Si wa-scope falta o falla, se transcribe con los valores de fabrica: quedarse sin
    voz porque no se pudo leer un ajuste es peor que usar el default."""
    value = ajustes().get(key)
    return value if value else fallback


def a_wav(origen):
    """Los motores quieren PCM 16 kHz mono; WhatsApp guarda opus."""
    if not shutil.which("ffmpeg"):
        return None, "ffmpeg is missing (brew install ffmpeg)"
    destino = os.path.join(tempfile.mkdtemp(prefix="wa-tx."), "audio.wav")
    p = subprocess.run(["ffmpeg", "-nostdin", "-loglevel", "error", "-y", "-i", origen,
                        "-ar", "16000", "-ac", "1", "-c:a", "pcm_s16le", destino],
                       capture_output=True, text=True)
    if p.returncode != 0 or not os.path.exists(destino):
        return None, f"ffmpeg failed: {p.stderr.strip()[:200]}"
    return destino, None


def modelo_local(nombre):
    """Busca los pesos donde los dejan whisper.cpp y Homebrew. No los descarga."""
    candidatos = [
        os.path.expanduser(f"~/.cache/whisper/ggml-{nombre}.bin"),
        os.path.expanduser(f"~/Library/Caches/whisper/ggml-{nombre}.bin"),
        f"/opt/homebrew/share/whisper-cpp/ggml-{nombre}.bin",
        f"/usr/local/share/whisper-cpp/ggml-{nombre}.bin",
    ]
    return next((c for c in candidatos if os.path.exists(c)), None)


def idioma():
    return setting("transcribe_lang", "auto")


def calidad():
    """`optima` por defecto; `minima` para un equipo sin cómputo."""
    elegida = setting("transcribe_quality", "optima")
    return CALIDAD.get(elegida, CALIDAD["optima"])


# Hay un userData por build de Orca, y cada uno tiene SUS modelos descargados.
# Preguntarle al equivocado devuelve "sin motor" teniendo los modelos.
USER_DATA_DIRS = ("orca", "orca-dev", "zzorcanametest")
PLUGIN_DATA = "plugins-data"


def user_data_roots():
    """Todos los userData de Orca que existen en este equipo."""
    if sys.platform == "darwin":
        base = os.path.expanduser("~/Library/Application Support")
    elif os.name == "nt":
        base = os.environ.get("APPDATA", os.path.expanduser("~"))
    else:
        base = os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))
    declarado = os.environ.get("ORCA_USER_DATA_PATH", "").strip()
    if declarado:
        return [declarado]
    return [os.path.join(base, d) for d in USER_DATA_DIRS
            if os.path.isdir(os.path.join(base, d))]


# Lo pone orca_con_modelo(): el Orca que hay no conoce el comando de voz.
_ORCA_SIN_COMANDO = False


def orca_cmd():
    """Solo el binario. Con que userData llamarlo lo decide quien pregunta."""
    declarado = os.environ.get("ORCA_CLI_COMMAND", "").strip()
    if declarado:
        return shlex.split(declarado)
    exe = shutil.which("orca")
    return [exe] if exe else None


def orca_con_modelo():
    """El userData de Orca que YA tiene bajado el modelo de la calidad elegida.

    Hay un userData por build y cada uno tiene sus modelos. No se puede saber por
    entorno en cual corre el plugin: el worker recibe una allowlist estricta
    (plugin-worker-env.ts) sin ORCA_CLI_COMMAND ni ORCA_USER_DATA_PATH. Y
    adivinarlo por fecha de modificacion elegia el build equivocado. Asi que se
    preguntan todos y gana el que tenga el modelo: si alguno puede transcribir,
    este equipo puede transcribir.
    """
    cmd = orca_cmd()
    if not cmd:
        return None
    quiero = calidad()["orca"]
    global _ORCA_SIN_COMANDO
    _ORCA_SIN_COMANDO = False
    for raiz in user_data_roots():
        env = dict(os.environ, ORCA_USER_DATA_PATH=raiz)
        try:
            p = subprocess.run(cmd + ["speech", "models", "list", "--json"],
                               capture_output=True, text=True, timeout=30, env=env)
            d = json.loads(p.stdout or "{}")
        except (OSError, ValueError, subprocess.SubprocessError):
            continue
        # Un Orca anterior al comando de voz responde "Unknown command". Eso no es
        # falta de modelo, es falta de version: decir "instala whisper-cpp" ahi
        # manda al usuario a resolver un problema que no tiene.
        err = d.get("error") or {}
        if isinstance(err, dict) and "Unknown command" in str(err.get("message", "")):
            _ORCA_SIN_COMANDO = True
            continue
        modelos = (d.get("result") or d).get("models") or []
        if any(m.get("id") == quiero and m.get("status") == "ready" for m in modelos):
            return env
    return None


def orca_listo():
    """Si algun Orca de este equipo puede transcribir con la calidad elegida."""
    return orca_con_modelo() is not None


def por_orca(origen):
    """Primero Orca: ya tiene motor y modelos administrados. Si no esta lista, se
    devuelve el codigo tal cual para que el panel sepa QUE falta, no solo que fallo."""
    env = orca_con_modelo()
    if env is None:
        return None
    cmd = orca_cmd()
    try:
        p = subprocess.run(cmd + ["speech", "transcribe", origen,
                            "--model", calidad()["orca"],
                            "--language", idioma(), "--json"],
                           capture_output=True, text=True, timeout=900, env=env)
    except (OSError, subprocess.SubprocessError):
        return None
    try:
        d = json.loads(p.stdout or "{}")
    except ValueError:
        return None
    # Un CLI sin el comando devuelve "Unknown command": eso no es un fallo de voz.
    err = (d.get("error") or {}) if isinstance(d.get("error"), dict) else {}
    # Un Orca sin el comando responde method_not_found o invalid_argument: eso no es
    # un problema de voz, es un Orca viejo. Se cae al motor local.
    if err.get("code") in ("method_not_found", "invalid_argument"):
        return None
    if d.get("ok") and (d.get("result") or {}).get("text"):
        r = d["result"]
        return {"ok": True, "motor": "orca", "modelo": r.get("model"),
                "texto": " ".join(r["text"].split()), "local": True}
    if err.get("code"):
        d = err.get("data") or {}
        # Cada codigo se arregla distinto; un mensaje generico no le sirve a nadie.
        acciones = {
            "voice_not_configured":
                f"Settings -> Voice in Orca, and download "
                f"{d.get('recommendedModelId', 'the recommended model')}",
            "model_not_downloaded":
                f"orca speech models download {d.get('modelId', '')}".strip(),
            "model_language_mismatch":
                "the chosen model does not cover that language: use the multilingual "
                "one in Settings -> Voice",
            "decoder_missing": "brew install ffmpeg",
            "audio_too_long": "the audio is longer than the cap; listen to it by hand",
            "file_too_large": "the file exceeds the cap; listen to it by hand",
            "speech_busy": "speech is busy, retry in a moment",
        }
        pasos = d.get("nextSteps")
        return {"ok": False, "codigo": err["code"], "razon": err.get("message"),
                "como": acciones.get(err["code"]) or
                        (pasos[0] if isinstance(pasos, list) and pasos
                         else "Settings -> Voice in Orca"),
                "detalle": {k: v for k, v in d.items()
                            if k in ("modelId", "recommendedModelId", "requestedLanguage")}}
    return None


def motores():
    """Que hay instalado, en orden de preferencia."""
    out = []
    for exe in ("whisper-cli", "whisper-cpp", "main"):
        ruta = shutil.which(exe)
        if ruta and exe != "main":
            out.append(("whisper.cpp", ruta))
            break
    try:
        import mlx_whisper  # noqa: F401
        out.append(("mlx-whisper", sys.executable))
    except ImportError:
        pass
    if shutil.which("whisper"):
        out.append(("openai-whisper", shutil.which("whisper")))
    return out


def con_whisper_cpp(exe, wav, nombre):
    pesos = modelo_local(nombre)
    if not pesos:
        return None, (f"the model '{nombre}' is missing. Download it once with: "
                      f"whisper-cpp --model {nombre} --help  (o pongalo en "
                      f"~/.cache/whisper/ggml-{nombre}.bin)")
    p = subprocess.run([exe, "-m", pesos, "-f", wav, "-l", idioma(), "-nt", "-np"],
                       capture_output=True, text=True, timeout=600)
    if p.returncode != 0:
        return None, p.stderr.strip()[:200]
    return " ".join(p.stdout.split()), None


def con_mlx(wav, nombre):
    mapa = {"base": "mlx-community/whisper-base-mlx",
            "small": "mlx-community/whisper-small-mlx",
            "turbo": "mlx-community/whisper-large-v3-turbo"}
    code = ("import json,mlx_whisper,sys;"
            f"print(json.dumps(mlx_whisper.transcribe(sys.argv[1], path_or_hf_repo={mapa.get(nombre, mapa['base'])!r})))")
    p = subprocess.run([sys.executable, "-c", code, wav], capture_output=True,
                       text=True, timeout=900)
    if p.returncode != 0:
        return None, p.stderr.strip()[-200:]
    try:
        return " ".join(json.loads(p.stdout)["text"].split()), None
    except (ValueError, KeyError) as exc:
        return None, str(exc)


def con_openai_whisper(exe, wav, nombre):
    carpeta = tempfile.mkdtemp(prefix="wa-tx-out.")
    p = subprocess.run([exe, wav, "--model", nombre, "--output_format", "txt",
                        "--output_dir", carpeta, "--fp16", "False"],
                       capture_output=True, text=True, timeout=1800)
    if p.returncode != 0:
        return None, p.stderr.strip()[-200:]
    txt = next((os.path.join(carpeta, f) for f in os.listdir(carpeta)
                if f.endswith(".txt")), None)
    if not txt:
        return None, "produced no output"
    with open(txt, encoding="utf-8") as fh:
        return " ".join(fh.read().split()), None


def transcribir(origen):
    modo = setting("transcribe", "local")
    if modo == "off":
        return {"ok": False, "razon": "transcription is turned off",
                "como": "wa-scope config transcribe local"}
    if modo == "api":
        return {"ok": False, "razon": "the api mode is not implemented yet",
                "como": "use 'local', which sends the audio nowhere"}
    # El modelo local sale de la calidad elegida, salvo que se fije uno a mano.
    nombre = setting("transcribe_model", "") or calidad()["local"]
    if nombre in SOLO_INGLES:
        return {"ok": False, "codigo": "modelo_solo_ingles",
                "razon": f"the model '{nombre}' only understands English and the audio "
                         "mixes Spanish and English",
                "como": "wa-scope config transcribe_model base"}
    # 1) Orca, si sabe. 2) lo que haya en el equipo.
    v = por_orca(origen)
    if v is not None:
        return v
    disponibles = motores()
    if not disponibles:
        return {"ok": False, "codigo": "sin_motor",
                "razon": "no transcription engine is available",
                "como": "Turn voice on in Orca's Settings -> Voice, or install one: "
                        "brew install whisper-cpp"}
    wav, err = a_wav(origen)
    if err:
        return {"ok": False, "razon": err}
    for motor, exe in disponibles:
        if motor == "whisper.cpp":
            texto, err = con_whisper_cpp(exe, wav, nombre)
        elif motor == "mlx-whisper":
            texto, err = con_mlx(wav, nombre)
        else:
            texto, err = con_openai_whisper(exe, wav, nombre)
        if texto:
            return {"ok": True, "motor": motor, "modelo": nombre, "texto": texto,
                     "local": True}
        ultimo = err
    return {"ok": False, "razon": f"no engine could do it: {ultimo}"}


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("audio", nargs="?")
    ap.add_argument("--check", action="store_true",
                    help="says whether this machine can transcribe, without transcribing")
    ap.add_argument("--json", action="store_true")
    a = ap.parse_args()

    if a.check:
        info = {"modo": setting("transcribe", "local"),
                "orca": orca_listo(),
                "orca_sin_comando": _ORCA_SIN_COMANDO,
                "idioma": idioma(),
                "calidad": setting("transcribe_quality", "optima"),
                "modelo_orca": calidad()["orca"],
                "multilingue": (setting("transcribe_model", "") or calidad()["local"])
                               not in SOLO_INGLES,
                "modelo": setting("transcribe_model", "") or calidad()["local"],
                "ffmpeg": bool(shutil.which("ffmpeg")),
                "motores": [m for m, _ in motores()],
                "pesos": bool(modelo_local(setting("transcribe_model", "") or calidad()["local"]))}
        # Basta con UNA de las dos vias. Orca va primero en por_orca(), asi que si su
        # modelo esta listo no hace falta ningun motor local ni ffmpeg.
        info["puede"] = bool(info["orca"] or (
            info["ffmpeg"] and info["motores"]
            and (info["pesos"] or "mlx-whisper" in info["motores"])))
        print(json.dumps(info, ensure_ascii=False, indent=2) if a.json
              else "\n".join(f"{k}: {v}" for k, v in info.items()))
        sys.exit(0 if info["puede"] else 1)

    if not a.audio:
        ap.error("the audio file is missing (or use --check)")
    if not os.path.exists(a.audio):
        sys.exit(f"does not exist: {a.audio}")
    r = transcribir(a.audio)
    if a.json:
        print(json.dumps(r, ensure_ascii=False, indent=2))
    elif r["ok"]:
        print(r["texto"])
    else:
        print(f"{r['razon']}" + (f"\n  {r['como']}" if r.get("como") else ""),
              file=sys.stderr)
    sys.exit(0 if r["ok"] else 1)


if __name__ == "__main__":
    main()
