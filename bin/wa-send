#!/usr/bin/env python3
"""wa-send — writes (and optionally sends) a message in WhatsApp.

  wa-send "<chat>" "text"            -> leaves the text WITHOUT sending it
  wa-send "<chat>" "text" --send     -> sends it

Right now it sends nothing: the two routes it used to write through —the desktop
app's window by accessibility, and a WhatsApp Web tab by the DOM— were removed, and
the sidecar that replaces them pairs the line but does not carry messages yet. Every
call ends in `send-no-transport`, exit 1, with the reason on the first line of stderr.

What still runs, and runs FIRST, because none of it depends on the transport:

  the signature   every message the agent writes goes signed, so that there is never
                  any doubt about whether the person or her agent wrote it. Without an
                  agent name configured, this refuses before anything else. --raw is
                  the exception, for when she writes herself.
  the line        the same group can exist on two lines. Picking "the first one"
                  writes to the wrong conversation, and that cannot be undone, so an
                  ambiguous reference is REFUSED (`send-ambiguous-line`) instead of
                  resolved in silence. --line says which one.

Refusing in that order is the point: the caller gets told the first thing that is
wrong with what it asked, not a generic failure at the end.
"""
import argparse, os, sqlite3, sys

# Sin esto Python deja un __pycache__ DENTRO de bin/, y el directorio del plugin
# instalado esta direccionado por hash.
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from wa_settings import ajuste, scope_db  # noqa: E402

SCOPE_DB = scope_db()


def signature():
    """El nombre sale del registro, no del codigo: cada quien nombra a su agente.

    Por la cadena compartida y no por la base a secas: el nombre puesto DESDE EL PANEL
    vive en el almacen del plugin, y leyendo solo el sqlite `wa-scope agent` lo veia y
    quien escribe salia con "no agent name is configured"."""
    nombre = ajuste("agent_name")
    return f"-- {nombre}" if nombre else None


# Motivos estables: los lee el worker (la primera linea de stderr termina en el panel).
# El texto se puede reescribir; el codigo no, o el panel se desincroniza en silencio.
LINEA_EQUIVOCADA = "send-wrong-line"
# La ambiguedad se rechaza, nunca se resuelve en silencio: dos lineas tuyas pueden
# tener la MISMA conversacion, y escribirle a la equivocada no se deshace.
LINEA_AMBIGUA = "send-ambiguous-line"
# No hay por donde mandar nada todavia. Es un motivo propio y no un fallo generico
# porque lo que el usuario tiene que hacer es distinto: no es reintentar ni revisar la
# conversacion, es esperar al almacen de mensajes.
SIN_TRANSPORTE = "send-no-transport"
SIN_TRANSPORTE_DETALLE = (
    "there is no message transport yet: the two old write routes were removed and the "
    "sidecar that replaces them pairs the line but does not carry messages yet. "
    "Nothing was written and nothing was opened.")
# La conversacion que no esta en ninguna linea registrada. Sigue siendo el caso por
# defecto del registro y no un transporte: quien no registro la linea igual tiene una.
CUENTA_LOCAL = "local"


def cuentas_registradas(ref):
    """De que LINEA(S) es esta conversacion segun el registro.

    Devuelve la lista y no una sola porque un grupo del mismo nombre puede existir en
    dos lineas: elegir "la primera" ahi es escribirle a la conversacion equivocada, y
    eso no se deshace. Con mas de una, quien llama tiene que decir cual."""
    try:
        con = sqlite3.connect(f"file:{SCOPE_DB}?mode=ro", uri=True)
        filas = con.execute(
            "select distinct account from chat_scope where chat_jid=? "
            "or lower(trim(chat_name))=lower(trim(?))",
            (ref.replace("‎", "").strip(), ref.replace("‎", ""))).fetchall()
        con.close()
    except Exception:
        return []
    return sorted(f[0] for f in filas if f[0])


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("chat", help="exact name of the chat or group")
    ap.add_argument("text", help="the message")
    ap.add_argument("--send", action="store_true",
                    help="besides writing it, send it (by default it is only written)")
    ap.add_argument("--raw", action="store_true",
                    help="do not sign: the message goes out as is, without the agent signature")
    ap.add_argument("--line", help="the line to write from, when the conversation "
                                   "exists on more than one (see `wa-scope accounts`)")
    a = ap.parse_args()
    # Todo mensaje del agente va firmado, para que nunca haya duda de si escribe la
    # persona o su agente. --raw es la excepcion, para cuando escribe ella.
    sig = signature()
    if not a.raw:
        if not sig:
            sys.exit("no agent name is configured. Set it with "
                     "`wa-scope agent \"<name>\"`, or use --raw to write unsigned.")
        if not a.text.rstrip().endswith(sig):
            a.text = f"{a.text.rstrip()}\n{sig}"

    # La linea se decide ANTES de tocar nada. El mismo grupo puede existir en dos
    # lineas, y elegir "la primera" ahi le escribe a la conversacion equivocada.
    cuentas = cuentas_registradas(a.chat)
    if a.line:
        if cuentas and a.line not in cuentas:
            sys.exit(f"wa-send: {LINEA_EQUIVOCADA}\n{a.chat!r} is not registered on the line "
                     f"{a.line!r}; it is on {', '.join(cuentas)}.")
    elif len(cuentas) > 1:
        sys.exit(f"wa-send: {LINEA_AMBIGUA}\n{a.chat!r} exists on {len(cuentas)} lines "
                 f"({', '.join(cuentas)}), so there is no way to tell which one you "
                 "mean; pick it with --line <id>.")

    # Y recien aca se dice que no hay por donde. Va al final a proposito: quien llama
    # necesita saber lo PRIMERO que esta mal con lo que pidio —que no firmo, que la
    # conversacion esta en dos lineas—, no un fallo generico que tape todo lo demas.
    sys.exit(f"wa-send: {SIN_TRANSPORTE}\n{SIN_TRANSPORTE_DETALLE}")


if __name__ == "__main__":
    main()
