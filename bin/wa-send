#!/usr/bin/env python3
"""wa-send — writes a message in WhatsApp, and sends it when it is allowed to.

  wa-send "<chat>" "text"            -> leaves it as a DRAFT, waiting for approval
  wa-send "<chat>" "text" --send     -> sends it, where the registry says `responder`
  wa-send --drafts                   -> the drafts waiting for you, oldest first
  wa-send --approve <id>             -> sends one of those drafts

HOW IT SENDS. The line is a Baileys socket, and the socket belongs to the sidecar —a
separate process, because the worker of the plugin has no sockets at all. This tool is
Python and cannot call into that process, so it leaves the request in the message store
(`~/.wa-inbox/capture.db`, table `envio`), which both sides already open, and waits
there for the verdict. The whole reasoning is in `sidecar/src/envio.js`.

Three things this path guarantees, and they are the point:

  once          the request is keyed by its `--id`. Sending the SAME id twice delivers
                once: the second call reads the verdict of the first. A duplicate
                message to a client's group cannot be taken back.
  an answer     it is a short-lived command, so it always ends: a verdict, or a plazo
                that expired with its own reason code. It never hangs.
  the reason    "the sidecar is not running" and "WhatsApp rejected it" are DIFFERENT
                codes, because what the owner has to do about each is different.

What runs FIRST, and in this order, because the caller has to learn the first thing
wrong with what it asked and not a generic failure at the end:

  the signature   every message the agent writes goes signed, so that there is never
                  any doubt about whether the person or her agent wrote it. Without an
                  agent name configured, this refuses before anything else. --raw is
                  the exception, for when she writes herself.
  the line        the same group can exist on two lines. Picking "the first one"
                  writes to the wrong conversation, and that cannot be undone, so an
                  ambiguous reference is REFUSED (`send-ambiguous-line`) instead of
                  resolved in silence. --line says which one.
  the permission  deny by default: a chat that is not in the registry does not exist
                  for the agent. `responder` sends; `borrador` only drafts; `observar`
                  and `off` do not write at all (`send-denied`).
  the transport   and only then, whether there is anything to send through.
  the owner       a send to the owner's own chat (one of the numbers picked in the
                  settings, or the line's chat with itself) skips the rules and Jev:
                  only a secret-shaped value is still held. So does a send to the
                  direct chat of a person the owner marked operator or admin of that
                  chat; a group with an operator keeps its rules, customers read it.
  the review      a reply that is about to go out on `responder` goes through the
                  fixed floor first, with or without Jev: money, a credential or a
                  promised date or delivery keeps it as a DRAFT for the owner. With the
                  Jev key set, Jev reviews it too and can only ADD reasons: a status
                  nobody verified, or Jev not answering, also keeps it. Neither can
                  ever send a reply; the owner's `--approve` always can.

ABOUT `borrador`. It used to mean "leaves the text typed in the chat, unsent", and that
was only possible while the agent drove a screen: it typed into the WhatsApp window and
a human pressed Enter. WhatsApp's protocol has NO server-side draft, so over Baileys
that rung cannot do what its old description promised. It is not quietly downgraded to
`observar` either: the reply is written, stored and listed as a draft, and
`wa-send --approve <id>` —an explicit act of the owner— is what puts it on the wire.
"""
import argparse, os, sqlite3, sys, time, uuid

# Sin esto Python deja un __pycache__ DENTRO de bin/, y el directorio del plugin
# instalado esta direccionado por hash.
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import wa_store  # noqa: E402
import wa_jev  # noqa: E402
import wa_reglas  # noqa: E402
from wa_settings import ajuste, scope_db, scope_from_plugin  # noqa: E402

SCOPE_DB = scope_db()


def signature():
    """El nombre sale del registro, no del codigo: cada quien nombra a su agente.

    Por la cadena compartida y no por la base a secas: el nombre puesto DESDE EL PANEL
    vive en el almacen del plugin, y leyendo solo el sqlite `wa-scope agent` lo veia y
    quien escribe salia con "no agent name is configured"."""
    nombre = ajuste("agent_name")
    return f"-- {nombre}" if nombre else None


# Motivos estables: los lee el worker (la primera linea de stderr termina en el panel).
# El texto se puede reescribir; el codigo no, o el panel se desincroniza en silencio.
LINEA_EQUIVOCADA = "send-wrong-line"
# Cada numero, su linea (T9): la conversacion esta autorizada, pero para OTRO numero
# que no es el vinculado ahora. Mandar seria escribirle a un cliente desde un numero que
# nunca autorizo esa conversacion. Se niega como el permiso (sale 3): lo que lo cambia
# es el dueno, autorizandola para este numero o volviendo a vincular el otro.
OTRA_LINEA = "send-line-not-linked"
# La ambiguedad se rechaza, nunca se resuelve en silencio: dos lineas tuyas pueden
# tener la MISMA conversacion, y escribirle a la equivocada no se deshace.
LINEA_AMBIGUA = "send-ambiguous-line"
# La escalera de permisos dijo que no. Es un motivo propio y no un fallo generico
# porque no hay nada que reintentar: lo que cambia esto es el dueno, en el panel.
SIN_PERMISO = "send-denied"
# `borrador`: el texto quedo escrito y esperando el visto del dueno. NO es "denegado" a
# secas —hay algo hecho, y hay algo que hacer con ello— y no es un envio.
NECESITA_VISTO = "send-needs-approval"
# No hay por donde mandar: el sidecar no esta corriendo, o nunca escribio su latido.
# Es un motivo propio y no un rechazo porque lo que el dueno tiene que hacer es
# distinto: abrir Orca para que la linea vuelva, no revisar la conversacion.
SIN_TRANSPORTE = "send-no-transport"
SIN_TRANSPORTE_DETALLE = (
    "the WhatsApp line is not running: nothing was queued and nothing was sent. The "
    "line lives in the plugin; open Orca and check the panel.")
# WhatsApp vio el mensaje y lo rechazo. El intento SALIO, asi que no se reintenta solo.
RECHAZADO = "send-rejected"
# El sidecar late pero no contesto a tiempo. La peticion queda en pie: se vuelve a
# preguntar con el MISMO --id, que es lo que impide mandar dos veces.
SIN_VEREDICTO = "send-timeout"
# Un --approve sobre algo que no esta.
SIN_BORRADOR = "send-no-draft"
# Un --approve (o un reintento) sobre un borrador que se cancelo: no hay nada que aprobar.
CANCELADO = "send-cancelled"
# El mismo --id con otro texto o para otra conversacion. No se manda ninguno de los
# dos: entregar el viejo es mandar lo que nadie pidio, y pisarlo es entregar dos veces.
ID_EN_USO = "send-id-conflict"

# Jev no contesto (sin red, error, timeout o una respuesta que no se entiende). Con la
# llave puesta eso deja borrador: Jev falla CERRADO (kanban-casos, "Jev").
JEV_NO_CONTESTA = "jev-unavailable"

# Salidas. `3` es la misma que la compuerta `wa-scope check`: denegado, se anota y se
# sigue. `4` es la misma que `wa-read` sin linea enlazada: no hay de donde, y no hay
# nada que reintentar. El resto sale 1.
SALIDA = {SIN_PERMISO: 3, NECESITA_VISTO: 3, OTRA_LINEA: 3, SIN_TRANSPORTE: 4}

# La conversacion que no esta en ninguna linea registrada. Sigue siendo el caso por
# defecto del registro y no un transporte: quien no registro la linea igual tiene una.
CUENTA_LOCAL = "local"

# Los estados de la bandeja de salida. Son los MISMOS de `sidecar/src/envio.js`: esa
# tabla la escriben los dos lados.
BORRADOR, PENDIENTE, ENVIADO, RECHAZADO_ = (
    "borrador", "pendiente", "enviado", "rechazado")
# El borrador que alguien retiro (`--cancel`): final, y el sidecar no lo toca nunca (solo
# toma `pendiente`). Se queda como fila, con su motivo: nada se borra.
CANCELADO_ = "cancelado"
# `enviando` es el quinto estado y no se nombra aca a proposito: lo escribe SOLO el
# sidecar al tomar la fila, y esta CLI no decide nada con el. Lo que espera es un final.
FINALES = (ENVIADO, RECHAZADO_, CANCELADO_)

# Cuanto vale el latido del sidecar. Vive en `wa_store`, que lo comparte con el
# `doctor`; es el MISMO numero que `LATIDO_VENCE_MS` en `sidecar/src/envio.js`, y
# `scripts/check-clis` compara los dos: dos constantes que nadie obliga a coincidir
# terminan no coincidiendo, y aca el sintoma seria decirle al dueno que arranque algo
# que ya esta corriendo.
LATIDO_VENCE_S = wa_store.LATIDO_VENCE_S
# Cuanto espera esta CLI un veredicto, y cada cuanto pregunta. Es un proceso corto que
# alguien mira: tiene que terminar aunque del otro lado no conteste nadie.
PLAZO_S = 30
SONDEO_S = 0.2

# Solo se autoriza el modo mas alto; los demas no escriben en WhatsApp.
RESPONDER, MODO_BORRADOR = "responder", "borrador"


def niega(codigo, detalle):
    """El contrato de dos lineas: el codigo primero, el detalle despues.

    Quien llama lee la PRIMERA linea de stderr y traduce por codigo (el panel y el
    worker hacen eso mismo). El detalle es para el humano y se puede reescribir."""
    print(f"wa-send: {codigo}", file=sys.stderr)
    print(detalle, file=sys.stderr)
    sys.exit(SALIDA.get(codigo, 1))


# ── El registro: de que linea es esta conversacion, y con que permiso ────────────────
def conversaciones_registradas(ref):
    """Las conversaciones del registro que esta referencia puede nombrar.

    Devuelve una lista y no una sola porque un grupo del mismo nombre puede existir en
    dos lineas: elegir "la primera" ahi es escribirle a la conversacion equivocada, y
    eso no se deshace. Con mas de una, quien llama tiene que decir cual.

    Se cruzan los DOS origenes, igual que `merged_scope` de wa-scope: la tabla del CLI y
    lo que el usuario acaba de tocar en el panel, que vive en el almacen del plugin. Es
    el mismo defecto del nombre del agente: mirar solo el sqlite dejaria al agente
    negandose sobre una conversacion que la pantalla muestra en `responder`."""
    objetivo = ref.replace("‎", "").strip()
    plano = objetivo.lower()
    filas = {}
    try:
        con = sqlite3.connect(f"file:{SCOPE_DB}?mode=ro", uri=True)
        con.row_factory = sqlite3.Row
        # `select *`: una base de antes de T22.3 no tiene `aprobacion`, y nombrarla haria
        # fallar la consulta entera, o sea negar el permiso de un chat autorizado.
        for r in con.execute(
                "select * from chat_scope "
                "where chat_jid=? or lower(trim(chat_name))=lower(trim(?))",
                (objetivo, objetivo.replace("‎", ""))):
            r = dict(r)
            cuenta, jid = r.get("account") or CUENTA_LOCAL, r["chat_jid"]
            filas[(cuenta, jid)] = {
                "account": cuenta, "chat_jid": jid,
                "chat_name": r.get("chat_name") or jid, "mode": r.get("mode") or "off",
                "niveles": wa_reglas.niveles(r.get("aprobacion")),
                "tone": r.get("tone"),
                # Los roles de esta conversacion (roles-por-numero); una base de antes no
                # tiene la columna y nadie tiene rol.
                "miembros": wa_store.miembros_de_columna(r.get("miembros"))}
        con.close()
    except Exception:                     # noqa: BLE001 - sin registro no hay permiso
        pass

    # El panel guarda por jid a secas y manda sobre la base, porque es lo que el usuario
    # acaba de tocar (la misma regla que `merged_scope`).
    try:
        del_panel = scope_from_plugin()
    except Exception:                     # noqa: BLE001 - un store ilegible no manda
        del_panel = {}
    for jid, entrada in del_panel.items():
        if not isinstance(entrada, dict):
            continue
        # Cada entrada del panel dice de que linea es; las de antes de T9 no lo dicen y
        # son de la linea de siempre, `local`.
        de_entrada = entrada.get("account")
        cuenta_panel = de_entrada if isinstance(de_entrada, str) and de_entrada \
            else CUENTA_LOCAL
        llave = (cuenta_panel, jid)
        nombre = (entrada.get("chatName") or "").replace("‎", "").strip()
        if jid != objetivo and nombre.lower() != plano and llave not in filas:
            continue
        # El MODO del panel manda siempre; el NOMBRE solo si es un nombre. El panel
        # guarda el jid como `chatName` cuando la conversacion se registro sin lista de
        # chats que consultar, y dejar que eso pise "Cliente Alfa" es la misma regla que
        # `anotarChat` ya escribe: un nombre vacio no es una eleccion y no puede borrar
        # el que ya se sabia. La llave, que es lo que decide a donde va el mensaje, no
        # depende de esto.
        previa = filas.get(llave, {})
        anterior = previa.get("chat_name")
        util = nombre if nombre and nombre != jid else None
        tono = entrada.get("tone")
        filas[llave] = {
            "account": cuenta_panel, "chat_jid": jid,
            "chat_name": util or anterior or nombre or jid,
            "mode": entrada.get("mode") or "off",
            # Los niveles del panel mandan cuando los dice (T22.3), como el modo.
            "niveles": (wa_reglas.niveles(entrada["approval"])
                        if isinstance(entrada.get("approval"), dict)
                        else previa.get("niveles") or wa_reglas.niveles(None)),
            "tone": tono if isinstance(tono, str) and tono.strip() else previa.get("tone"),
            # Los roles del panel mandan cuando los dice, como `approval`.
            "miembros": (wa_store.miembros_del_panel(entrada["members"])
                         if isinstance(entrada.get("members"), list)
                         else previa.get("miembros") or {})}
    return sorted(filas.values(), key=lambda f: (f["account"], f["chat_jid"]))


def resolver_conversacion(ref, linea):
    """La UNA conversacion a la que se va a escribir, o una negativa con su motivo."""
    filas = conversaciones_registradas(ref)
    # Cada numero, su linea (T9). Con un numero vinculado, solo sus autorizaciones
    # valen: las de otro numero —o las de antes, `local`— siguen guardadas pero no
    # mandan nada desde este. Un almacen sin linea anotada (de antes de esto) sigue la
    # regla de siempre.
    activa = wa_store.linea_activa_en_disco()
    if activa:
        if linea and linea != activa:
            niega(OTRA_LINEA,
                  f"the line {linea!r} is not the one linked now ({activa!r}); a "
                  "message can only leave from the linked number.")
        ajenas = sorted({f["account"] for f in filas if f["account"] != activa})
        filas = [f for f in filas if f["account"] == activa]
        if not filas and ajenas:
            niega(OTRA_LINEA,
                  f"{ref!r} is authorized for {', '.join(ajenas)}, not for the number "
                  f"linked now ({activa!r}). Authorize it for this number in the panel, "
                  "or link that number again.")
    cuentas = sorted({f["account"] for f in filas})
    if linea:
        if cuentas and linea not in cuentas:
            niega(LINEA_EQUIVOCADA,
                  f"{ref!r} is not registered on the line {linea!r}; it is on "
                  f"{', '.join(cuentas)}.")
        filas = [f for f in filas if f["account"] == linea]
    elif len(cuentas) > 1:
        niega(LINEA_AMBIGUA,
              f"{ref!r} exists on {len(cuentas)} lines ({', '.join(cuentas)}), so there "
              "is no way to tell which one you mean; pick it with --line <id>.")
    if len(filas) > 1:
        # Dos conversaciones DISTINTAS con el mismo nombre en la misma linea. Es el
        # mismo error de clase y tampoco se resuelve en silencio: se pide el jid.
        jids = ", ".join(f["chat_jid"] for f in filas)
        niega(LINEA_AMBIGUA,
              f"{ref!r} names {len(filas)} conversations on that line ({jids}); pass the "
              "JID instead of the name.")
    return filas[0] if filas else None


# ── La bandeja de salida ────────────────────────────────────────────────────────────
def almacen():
    """El almacen, ABIERTO PARA ESCRIBIR, o `None` cuando no hay ninguno.

    No se crea: un archivo vacio creado aca se veria como una linea lista y dejaria la
    peticion esperando a un sidecar que nunca la va a mirar. Sin almacen —o con uno de
    antes de la bandeja de salida— la respuesta correcta es `send-no-transport`."""
    ruta = wa_store.store_db_path()
    if not os.path.exists(ruta):
        return None
    try:
        con = sqlite3.connect(f"file:{ruta}?mode=rw", uri=True, timeout=10)
        con.row_factory = sqlite3.Row
        con.execute("pragma busy_timeout=10000")
        # La tabla la crea el sidecar al abrir. Que falte es exactamente "todavia no
        # corrio nunca", y eso es lo mismo que no tener transporte.
        con.execute("select 1 from envio limit 1").fetchone()
        return con
    except sqlite3.Error:
        return None


def sidecar_vivo(con):
    """Si hay alguien del otro lado. Sin esto, un sidecar apagado y uno ocupado se ven
    igual —una fila que no avanza— y las dos cosas contestarian "se vencio el plazo",
    que manda al dueno a mirar lo que no esta roto. La regla vive en `wa_store`: el
    `doctor` usa la misma."""
    return wa_store.sidecar_vivo(con)


def con_transporte():
    """El almacen con el sidecar vivo del otro lado, o la negativa."""
    con = almacen()
    if con is None or not sidecar_vivo(con):
        niega(SIN_TRANSPORTE, SIN_TRANSPORTE_DETALLE)
    return con


def encolar(con, fila, texto, req_id, estado):
    """Deja la peticion, o devuelve la que ya estaba con ese id.

    `do nothing` y no `do update`: el mismo `req_id` es el MISMO pedido. Esto es lo que
    hace que un reintento —o dos corridas del agente sobre la misma tarjeta— entreguen
    una sola vez."""
    con.execute(
        "insert into envio (req_id, account, chat_jid, chat_name, body, estado, "
        "created_at) values (?,?,?,?,?,?,?) on conflict(req_id) do nothing",
        (req_id, fila["account"], fila["chat_jid"], fila["chat_name"], texto, estado,
         int(time.time())))
    con.commit()
    previa = con.execute("select * from envio where req_id=?", (req_id,)).fetchone()
    if previa["body"] != texto or previa["chat_jid"] != fila["chat_jid"]:
        niega(ID_EN_USO,
              f"the id {req_id!r} already names another request, for a different "
              "conversation or with a different text. Nothing was sent: pick a new id.")
    return previa


def esperar(con, req_id, plazo_s):
    """El veredicto, o `None` cuando se vencio el plazo. Nunca se queda colgado."""
    limite = time.time() + plazo_s
    while True:
        fila = con.execute("select * from envio where req_id=?", (req_id,)).fetchone()
        if fila is not None and fila["estado"] in FINALES:
            return fila
        if time.time() >= limite:
            return None
        time.sleep(SONDEO_S)


def veredicto(con, req_id, plazo_s, salida_json):
    """Espera, y traduce lo que haya pasado a la salida de esta CLI."""
    fila = esperar(con, req_id, plazo_s)
    if fila is None:
        # El plazo se vencio. Cual de las dos cosas fue lo dice el latido, y son
        # acciones distintas del dueno.
        if not sidecar_vivo(con):
            niega(SIN_TRANSPORTE, SIN_TRANSPORTE_DETALLE)
        niega(SIN_VEREDICTO,
              f"no verdict in {plazo_s:g}s. The request is still queued: ask again with "
              f"--id {req_id} and it will NOT be sent twice.")
    if fila["estado"] == RECHAZADO_:
        niega(RECHAZADO, f"WhatsApp refused it: {fila['motivo'] or 'no reason given'}. "
                         "Nothing was delivered.")
    if fila["estado"] == CANCELADO_:
        niega(CANCELADO, f"this draft was cancelled ({fila['motivo'] or 'no reason given'}): "
                         "nothing was sent and it cannot be approved.")
    informa(salida_json, {"req_id": req_id, "estado": ENVIADO,
                          "chat": fila["chat_name"], "stanza_id": fila["stanza_id"]},
            f"sent · {fila['chat_name']} · {req_id}")
    sys.exit(0)


def informa(salida_json, dato, linea):
    """Lo que sale por stdout. Nunca lleva el cuerpo del mensaje: quien lo escribio ya
    lo tiene, y esto puede terminar en un log."""
    if salida_json:
        import json
        print(json.dumps(dato, ensure_ascii=False))
    else:
        print(linea)


def revision_jev(texto, tono=None):
    """Lo que frena el envio segun Jev: None sin llave (manda el modo, como siempre), una
    lista vacia si el texto pasa, y los motivos si no. Un error es un motivo. `tono` es el
    del chat o el global (T22.5): con ese registro se juzga."""
    clave = wa_jev.llave()
    if not clave:
        return None
    revision = wa_jev.revisa_borrador(texto, clave, tono=tono)
    if revision is None:
        return [JEV_NO_CONTESTA]
    return list(revision["flags"])


def revision_piso(texto, niv=None):
    """Lo que frena el envio segun el piso fijo (`wa_reglas`): siempre corre, haya o no
    llave de Jev. Solo los NOMBRES de las excepciones, nunca el texto que las disparo.

    Con los niveles del chat (T22.3) lo que esta en Permitir no frena. Un valor con forma
    de secreto frena siempre, como `secret`: es el control destructivo y no tiene nivel."""
    niv = niv or wa_reglas.niveles(None)
    secreto = wa_reglas.secreto(texto)
    halladas = [e for e in wa_reglas.excepciones(texto, wa_reglas.SALIDA)
                if not (e == "credential" and secreto)
                and niv.get(e) != wa_reglas.PERMITIR]
    return halladas + ([wa_reglas.SECRETO] if secreto else [])


def jev_permitido(jev, niv):
    """Las banderas de Jev que siguen frenando con los niveles del chat. Lo que no tiene
    nivel (una credencial, Jev sin contestar) frena siempre."""
    if jev is None:
        return None
    return [c for c in jev if wa_reglas.nivel_de_motivo("jev", c, niv) != wa_reglas.PERMITIR]


def jev_hace_falta(niv):
    """Si a Jev le queda algo que revisar en este chat. Con la calidad y el compromiso en
    Permitir, lo unico que preguntaria es la credencial, y esa la frena el piso fijo por su
    forma: no se manda el texto de un cliente afuera para nada."""
    return not (niv["quality"] == wa_reglas.PERMITIR
                and niv["commitment"] == wa_reglas.PERMITIR)


def motivos_de(piso, jev):
    """Los motivos para el dueno, cada uno con quien lo dijo: `rule` es el piso fijo,
    `jev` es Jev. Una lista vacia es que nada lo freno."""
    return ([f"rule: {', '.join(piso)}"] if piso else []) + \
        ([f"jev: {', '.join(jev)}"] if jev else [])


def para_el_agente(piso, jev, niv):
    """Si todo lo que freno es de nivel "Que el agente lo revise" en este chat: entonces
    quien lo escribio lo reescribe, y el dueno solo lo ve si el agente no lo arregla."""
    motivos = [("rule", c) for c in piso] + [("jev", c) for c in (jev or [])]
    return bool(motivos) and all(wa_reglas.nivel_de_motivo(q, c, niv) == wa_reglas.AGENTE
                                 for q, c in motivos)


def anotar_borrador(fila, req_id, frenado=None):
    """El borrador, anotado donde el dueno mira: la bitacora que el panel ya muestra.

    Va el ID y NO el texto. El panel publica `detail` recortado en su lista de actividad
    y eso termina en el almacen del plugin: el cuerpo de un mensaje a un cliente no
    tiene por que estar ahi. Lo que el dueno necesita ver es que hay algo esperandolo y
    con que comando aprobarlo; el texto lo lee con `wa-send --drafts`, en su terminal.

    Si falla, no se pierde nada: el borrador ya esta en la bandeja de salida y
    `--drafts` lo lista igual. Por eso no tumba la corrida."""
    try:
        con = sqlite3.connect(SCOPE_DB, timeout=10)
        con.execute(
            "insert into agent_action (ts, chat_jid, chat_name, action, detail) "
            "values (?,?,?,?,?)",
            (time.strftime("%Y-%m-%d %H:%M"), fila["chat_jid"], fila["chat_name"],
             "draft", (f"held by {'; '.join(frenado)} · " if frenado else "")
             + f"{req_id} · approve with `wa-send --approve {req_id}`"))
        con.commit()
        con.close()
    except sqlite3.Error:
        pass


def retirar_de_actividad(req_id):
    """Quita de la bitacora la fila `draft` de un pedido que ya no espera al dueno
    (aprobado o retirado): seguiria pidiendo "approve with" algo que ya se hizo o que ya
    no se puede hacer. Se reconoce por el final que le puso `anotar_borrador`. Si falla,
    queda la fila: es una nota, no el estado del envio."""
    cola = f"`wa-send --approve {req_id}`"
    try:
        con = sqlite3.connect(SCOPE_DB, timeout=10)
        con.execute("delete from agent_action where action='draft' "
                    "and substr(detail, -?) = ?", (len(cola), cola))
        con.commit()
        con.close()
    except sqlite3.Error:
        pass


def deja_borrador(con, fila, texto, req_id, salida_json, pedia_envio, frenado=None,
                  reescribir=False):
    """Escribe el borrador y dice como se aprueba. No manda nada."""
    encolar(con, fila, texto, req_id, BORRADOR)
    anotar_borrador(fila, req_id, frenado)
    if frenado:
        # `responder` y `--send`, pero el piso fijo o Jev lo frenaron (o Jev no
        # contesto). El mismo codigo que el borrador —hay algo escrito esperando al
        # dueno— y el motivo en el detalle. Con todo en "Que el agente lo revise" (T22.3)
        # el detalle le dice a quien lo escribio que lo reescriba.
        niega(NECESITA_VISTO,
              f"Held this reply to {fila['chat_name']!r} ({'; '.join(frenado)}): it "
              f"was written and is waiting for you, not sent. "
              + ("This chat leaves these reasons to the agent: rewrite the reply without "
                 f"them and send it again (cancel this one with `wa-send --cancel {req_id}`)."
                 if reescribir else
                 f"Approve it with `wa-send --approve {req_id}`."))
    if pedia_envio:
        # `--send` sobre una conversacion en `borrador`. No se calla y no se degrada a
        # "no hice nada": hay algo escrito y hay algo que hacer con ello.
        niega(NECESITA_VISTO,
              f"{fila['chat_name']!r} is on `borrador`: the reply was written and is "
              f"waiting for you, not sent. WhatsApp has no draft of its own, so nothing "
              f"was typed into the chat. Approve it with `wa-send --approve {req_id}`.")
    informa(salida_json,
            {"req_id": req_id, "estado": BORRADOR, "chat": fila["chat_name"]},
            f"draft · {fila['chat_name']} · approve with `wa-send --approve {req_id}`")
    sys.exit(0)


def listar_borradores(salida_json):
    """Los borradores que esperan. Aca SI va el texto: es la terminal del dueno, que es
    quien lo tiene que leer antes de aprobarlo, y sin verlo la aprobacion seria a
    ciegas."""
    con = almacen()
    if con is None:
        niega(SIN_TRANSPORTE, SIN_TRANSPORTE_DETALLE)
    filas = con.execute(
        "select req_id, chat_name, body, created_at from envio where estado=? "
        "order by created_at, rowid", (BORRADOR,)).fetchall()
    if salida_json:
        import json
        print(json.dumps([{"req_id": f["req_id"], "chat": f["chat_name"],
                           "text": f["body"], "created_at": f["created_at"]}
                          for f in filas], ensure_ascii=False, indent=2))
        sys.exit(0)
    if not filas:
        print("no drafts waiting")
        sys.exit(0)
    for f in filas:
        cuando = time.strftime("%Y-%m-%d %H:%M", time.localtime(f["created_at"]))
        print(f"{f['req_id']}  {cuando}  {f['chat_name']}")
        for renglon in (f["body"] or "").splitlines():
            print(f"    {renglon}")
        print(f"    -> wa-send --approve {f['req_id']}")
    sys.exit(0)


def aprobar(req_id, plazo_s, salida_json):
    """El visto del dueno: lo unico que pone un borrador en la linea.

    Aprobar dos veces no entrega dos veces: el estado solo pasa de `borrador` a
    `pendiente` si todavia era borrador, y lo que ya tiene veredicto contesta ese
    veredicto."""
    con = con_transporte()
    fila = con.execute("select * from envio where req_id=?", (req_id,)).fetchone()
    if fila is None:
        niega(SIN_BORRADOR, f"there is no request with the id {req_id!r}. "
                            "`wa-send --drafts` lists what is waiting.")
    # Desde aca ya no espera la aprobacion: sale, ya salio, o ya no se puede aprobar.
    retirar_de_actividad(req_id)
    if fila["estado"] == ENVIADO:
        informa(salida_json, {"req_id": req_id, "estado": ENVIADO,
                              "chat": fila["chat_name"], "stanza_id": fila["stanza_id"]},
                f"already sent · {fila['chat_name']} · {req_id}")
        sys.exit(0)
    if fila["estado"] == RECHAZADO_:
        niega(RECHAZADO, f"WhatsApp refused it: {fila['motivo'] or 'no reason given'}. "
                         "Nothing was delivered.")
    if fila["estado"] == CANCELADO_:
        niega(CANCELADO, f"this draft was cancelled ({fila['motivo'] or 'no reason given'}): "
                         "nothing was sent and it cannot be approved.")
    con.execute("update envio set estado=? where req_id=? and estado=?",
                (PENDIENTE, req_id, BORRADOR))
    con.commit()
    veredicto(con, req_id, plazo_s, salida_json)


def cancelar(req_id, motivo, salida_json):
    """Retira un borrador: pasa de `borrador` a `cancelado`, y solo de ahi. Lo que ya salio,
    o esta saliendo, no se toca: cancelar no puede deshacer un envio. No borra la fila."""
    con = almacen()
    if con is None:
        informa(salida_json, {"req_id": req_id, "estado": None, "cancelled": False},
                f"nothing to cancel · {req_id}")
        sys.exit(0)
    cur = con.execute("update envio set estado=?, motivo=?, settled_at=? where req_id=? "
                      "and estado=?", (CANCELADO_, (motivo or "cancelled")[:200],
                                       int(time.time()), req_id, BORRADOR))
    con.commit()
    if cur.rowcount == 1:
        retirar_de_actividad(req_id)
    fila = con.execute("select estado from envio where req_id=?", (req_id,)).fetchone()
    informa(salida_json, {"req_id": req_id, "estado": fila["estado"] if fila else None,
                          "cancelled": cur.rowcount == 1},
            f"{'cancelled' if cur.rowcount == 1 else 'nothing to cancel'} · {req_id}")
    sys.exit(0)


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("chat", nargs="?", help="exact name of the chat or group")
    ap.add_argument("text", nargs="?", help="the message")
    ap.add_argument("--send", action="store_true",
                    help="besides writing it, send it (by default it is only drafted)")
    ap.add_argument("--raw", action="store_true",
                    help="do not sign: the message goes out as is, without the agent signature")
    ap.add_argument("--line", help="the line to write from, when the conversation "
                                   "exists on more than one (see `wa-scope accounts`)")
    ap.add_argument("--id", dest="req_id",
                    help="the id of this request. The SAME id delivers once: use it to "
                         "retry without ever sending twice")
    ap.add_argument("--timeout", type=float, default=PLAZO_S, metavar="S",
                    help=f"how long to wait for the verdict, in seconds "
                         f"(default {PLAZO_S:g})")
    ap.add_argument("--drafts", action="store_true",
                    help="list the drafts waiting for approval, and exit")
    ap.add_argument("--approve", metavar="ID",
                    help="send a draft that was waiting: the explicit approval that "
                         "`borrador` needs")
    ap.add_argument("--cancel", metavar="ID",
                    help="withdraw a draft that was waiting: it can no longer be approved "
                         "or sent (a request already sent is not touched)")
    ap.add_argument("--reason", default="", help="why, with --cancel (kept with the row)")
    ap.add_argument("--json", action="store_true", help="machine-readable output")
    a = ap.parse_args()

    if a.drafts:
        listar_borradores(a.json)
    if a.approve:
        aprobar(a.approve, a.timeout, a.json)
    if a.cancel:
        cancelar(a.cancel, a.reason, a.json)
    if not a.chat or a.text is None:
        ap.error("the chat and the text are required (or use --drafts / --approve)")

    # El piso fijo mira la respuesta, no la firma: el nombre del agente lo eligio el dueno
    # y no es algo que la respuesta prometa.
    sin_firma = a.text
    # Todo mensaje del agente va firmado, para que nunca haya duda de si escribe la
    # persona o su agente. --raw es la excepcion, para cuando escribe ella.
    sig = signature()
    if sig and sin_firma.rstrip().endswith(sig):
        sin_firma = sin_firma.rstrip()[:-len(sig)]
    if not a.raw:
        if not sig:
            sys.exit("no agent name is configured. Set it with "
                     "`wa-scope agent \"<name>\"`, or use --raw to write unsigned.")
        if not a.text.rstrip().endswith(sig):
            a.text = f"{a.text.rstrip()}\n{sig}"

    # La linea se decide ANTES de tocar nada. El mismo grupo puede existir en dos
    # lineas, y elegir "la primera" ahi le escribe a la conversacion equivocada.
    fila = resolver_conversacion(a.chat, a.line)

    # Y despues el permiso, que tambien es sobre lo que se pidio. Denegar por defecto:
    # una conversacion que no esta en el registro no existe para el agente.
    modo = (fila or {}).get("mode") or "off"
    if modo not in (RESPONDER, MODO_BORRADOR):
        niega(SIN_PERMISO,
              f"{a.chat!r} is on `{modo}`" + ("" if fila else " (it is not in the registry)")
              + ": it does not write in WhatsApp. Authorize it with "
                "`wa-scope mode \"<chat>\" borrador` or `... responder`.")

    # Recien aca se mira si hay por donde. Va al final a proposito: quien llama
    # necesita saber lo PRIMERO que esta mal con lo que pidio —que no firmo, que la
    # conversacion esta en dos lineas, que no la autorizo—, no un fallo del entorno
    # que tape todo lo demas.
    con = con_transporte()
    req_id = a.req_id or uuid.uuid4().hex

    # Sin `--send` no se manda, sea cual sea el permiso: eso ya era asi y es lo correcto
    # sin nadie mirando. Con `--send` en `borrador`, tampoco — pero se dice distinto.
    if modo == MODO_BORRADOR or not a.send:
        deja_borrador(con, fila, a.text, req_id, a.json,
                      pedia_envio=a.send and modo == MODO_BORRADOR)

    # La revision, solo sobre lo que de verdad va a salir: el piso fijo siempre, y Jev
    # con la llave. Cualquiera de los dos que lo frene (o Jev sin contestar) lo deja
    # borrador; ninguno lo manda. Nunca al reves: un borrador no llega aca.
    # Con los niveles del chat (T22.3): lo que esta en Permitir no frena, y lo que esta en
    # "Que el agente lo revise" frena para que quien lo escribio lo reescriba.
    niv = fila.get("niveles") or wa_reglas.niveles(None)
    if wa_store.chat_del_dueno(con, fila["account"], fila["chat_jid"]) \
            or wa_store.directo_sin_reglas(con, fila["account"], fila["chat_jid"],
                                           wa_store.duenos(),
                                           {fila["chat_jid"]: fila.get("miembros") or {}}):
        # El chat del dueno (T22.1): un numero suyo o la linea consigo misma. Lo que se le
        # manda no protege a ningun tercero, asi que no pasa por las reglas ni por Jev (un
        # aviso de la sesion de otro proyecto, por ejemplo). Lo mismo en el directo con un
        # operador o un admin de ese chat (roles-por-numero, M10): ahi no lee ningun
        # cliente; en un grupo con un operador, si, y las reglas quedan. Solo queda el
        # control destructivo: nunca repetir un secreto.
        piso = [wa_reglas.SECRETO] if wa_reglas.secreto(sin_firma) else []
        jev = None
    else:
        piso = revision_piso(sin_firma, niv)
        tono = (fila.get("tone") or "").strip() or ajuste("tone")
        jev = jev_permitido(revision_jev(a.text, tono) if jev_hace_falta(niv) else None, niv)
    frenado = motivos_de(piso, jev)
    if frenado:
        deja_borrador(con, fila, a.text, req_id, a.json, pedia_envio=True,
                      frenado=frenado, reescribir=para_el_agente(piso, jev, niv))

    encolar(con, fila, a.text, req_id, PENDIENTE)
    veredicto(con, req_id, a.timeout, a.json)


if __name__ == "__main__":
    main()
