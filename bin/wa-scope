    c.set_defaults(fn=cmd_caso_proyecto)

    c = muta("clasificar", help="kind and priority; moves recibido -> clasificado")
    c.add_argument("id", type=int); c.add_argument("--clase", required=True)
    c.add_argument("--prioridad", required=True, choices=list(PRIORIDADES_CASO))
    c.set_defaults(fn=cmd_caso_clasificar)

    c = muta("propuesta", help="stores the proposal and moves the case to decision; "
                               "prints its version (sha256 of the canonical JSON)")
    c.add_argument("id", type=int)
    c.add_argument("--tipo", required=True, choices=list(TIPOS_PROPUESTA))
    c.add_argument("--respuesta", help="the reply text (required for responder)")
    c.add_argument("--instrucciones", help="the work to do (required for trabajar)")
    c.add_argument("--repo", help="where the work happens")
    c.set_defaults(fn=cmd_caso_propuesta)

    c = caso("aprobar", help="the owner's approval of ONE proposal version; refused if "
                             "the current version is another one. --actor regla is the "
                             "owner's rule, refused (E_EXCEPTION) when the case has an "
                             "exception or its chat is on borrador")
    c.add_argument("id", type=int)
    c.add_argument("--version", required=True,
                   help="the propuesta_version the owner saw")
    # El actor queda en `dueno` para que el evento diga quien firmo. Es solo una bandera:
    # cualquiera que corra este CLI puede escribirla. La compuerta real del clic es el
    # canal panel -> worker (kanban-casos, T4), no este flag.
    c.add_argument("--actor", required=True, choices=list(FIRMANTES_CASO))
    c.set_defaults(fn=cmd_caso_aprobar)

    c = caso("resultado", help="the deployed worker's result: resuelto or necesita move "
                               "trabajo -> listo and its reply becomes a new responder "
                               "proposal (new version, approval cleared); bloqueado moves "
                               "trabajo -> bloqueado and nothing is sent")
    c.add_argument("id", type=int)
    c.add_argument("--estado", choices=list(ESTADOS_RESULTADO), default="resuelto",
                   help="resuelto: done, the reply asks the customer to verify; necesita: "
                        "the reply asks the customer for what is missing, and the answer "
                        "comes back to the project agent; bloqueado: nothing is sent, the "
                        "owner sees --resumen as the reason")
    c.add_argument("--respuesta", help="the reply for the customer (required unless "
                                       "--estado bloqueado)")
    c.add_argument("--resumen", required=True, help="what was done and its evidence, or why "
                                                    "it is blocked, for the card")
    # Solo el trabajador: es su reporte, y cualquier otro firmandolo seria un resultado
    # de un trabajo que no hizo.
    c.add_argument("--actor", required=True, choices=["trabajador"])
    c.set_defaults(fn=cmd_caso_resultado)

    c = muta("unir", help="joins two cases of the same chat: the origin's messages go to "
                          "the destination and the origin is closed")
    c.add_argument("destino", type=int); c.add_argument("origen", type=int)
    c.set_defaults(fn=cmd_caso_unir)

    c = muta("separar", help="moves some messages of a case to a NEW case in recibido")
    c.add_argument("id", type=int); c.add_argument("stanzas", nargs="+")
    c.set_defaults(fn=cmd_caso_separar)

    c = muta("asignar", help="the grouping rule: joins the open case of the same chat "
                             "moved in the last case_window_hours, or opens a new one")
    c.add_argument("stanza"); c.add_argument("--chat", required=True)
    c.set_defaults(fn=cmd_caso_asignar)

    c = caso("listar", help="the cases of the active line, newest first")
    c.add_argument("--etapa", choices=list(ETAPAS_CASO)); c.add_argument("--chat")
    c.set_defaults(fn=cmd_caso_listar)

    c = caso("ver", help="one case with its messages and its events")
    c.add_argument("id", type=int); c.set_defaults(fn=cmd_caso_ver)

    try:
        a = ap.parse_args()
        if getattr(a, "json_sub", False):
            a.json = True
        try:
            con = db()
            try:
                rows = a.fn(con, a)
            finally:
                # Despues de cada mutacion de un caso, el tablero del panel al dia. sync
                # ya lo escribe en su propio empuje.
                if _TABLERO_SUCIO and a.cmd != "sync":
                    if con.in_transaction:
                        con.rollback()
                    publica_tablero(con)
            con.close()
        except sqlite3.OperationalError as exc:
            # Solo para el tablero: la base tomada es un error con codigo, no un traceback.
            if a.cmd != "caso" or not base_tomada(exc):
                raise
            caso_falla("E_BUSY", f"the case database is busy: {exc}")
    except CasoFalla as falla:
        print(json.dumps({"error": falla.error, "detail": falla.detail},
                         ensure_ascii=False), file=sys.stderr)
        sys.exit(2)
    if rows is None:                     # el comando ya escribio su propia salida (tick)
        return
    if a.json:
        print(json.dumps(rows, ensure_ascii=False, indent=2)); return
    if not rows:
        print("(empty registry — no chat authorized, which is the safe default)"); return
    for r in rows:
        print(" | ".join(f"{v}" for v in r.values() if v not in (None, "")))


if __name__ == "__main__":
    main()
