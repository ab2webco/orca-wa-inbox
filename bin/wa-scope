                         "WhatsApp: check your conversations in Settings.",
           "conflicto": "The conversation with {quien} is authorized under both of its "
                        "WhatsApp ids; they were not merged: keep just one in Settings."},
    "pt": {"movido": "O WhatsApp moveu a conversa com {quien} para um id novo; a "
                     "autorizacao passou sozinha.",
           "dentro": "{n} mensagens recentes entram agora como casos.",
           "fuera": "{n} mensagens sem resposta desde {fecha} nao sao respondidas sozinhas: "
                    "confira no WhatsApp.",
           "sin_copia": "O que chegou no id novo desde {fecha} nao ficou guardado: confira a "
                        "conversa no WhatsApp.",
           "fantasma": "A conversa autorizada com {quien} nao recebe mensagens desde {fecha} "
                       "e ha outra ativa com a mesma pessoa: confira suas conversas em "
                       "Ajustes.",
           "no_aparece": "A conversa autorizada com {quien} nao aparece no WhatsApp: confira "
                         "suas conversas em Ajustes.",
           "conflicto": "A conversa com {quien} esta autorizada com os dois ids do WhatsApp; "
                        "nao foram unidas: deixe so uma em Ajustes."},
}


def textos_lid():
    """El idioma del panel cuando se eligio el numero: aca tambien portugues, que el panel
    tiene y los avisos de casos todavia no."""
    crudo = plugin_store_raw().get("approvalLang")
    return TEXTOS_LID[crudo if crudo in TEXTOS_LID else idioma_aprobacion()]


def es_directo(jid):
    """Un uno a uno: por telefono o por LID. Un grupo nunca cambia de jid."""
    return str(jid or "").endswith(("@s.whatsapp.net", "@lid"))


def telefono_lid(jid):
    usuario, _, servidor = str(jid or "").partition("@")
    return f"+{usuario}" if servidor == "s.whatsapp.net" and usuario.isdigit() else None


def dias_fantasma(con):
    """Cuanto puede callar una conversacion autorizada mientras su gemela habla: la misma
    ventana de la bandeja (`inbox_days`). Lo que calla mas que eso ya no llega al agente."""
    valor = merged_settings(con).get("inbox_days")
    if valida_ajuste("inbox_days", valor):
        valor = DEFAULT_CONFIG["inbox_days"]
    return max(1, int(str(valor).strip()))


def foto_lid(fuente, cuenta):
    """Lo que hace falta del almacen, leido una vez: los pares de ESTA linea (jid -> las
    otras formas) y cada chat con su ultima actividad. Una tabla que no existe es un
    almacen de antes: sin pares no se mueve nada."""
    pares = {}
    try:
        for f in fuente.execute("select lid, pn from lid_telefono where account=?", (cuenta,)):
            pares.setdefault(f["lid"], set()).add(f["pn"])
            pares.setdefault(f["pn"], set()).add(f["lid"])
    except sqlite3.Error:
        pares = {}
    chats = {f["chat_jid"]: dict(f) for f in fuente.execute(
        "select chat_jid, chat_name, is_group, last_ts, first_seen from chat where account=?",
        (cuenta,))}
    return {"pares": pares, "chats": chats, "fuente": fuente, "cuenta": cuenta, "entradas": {}}


def ultima_entrada(foto, jid):
    """El ultimo mensaje recibido y guardado de un chat (epoch), o None."""
    if jid not in foto["entradas"]:
        fila = foto["fuente"].execute(
            "select max(ts) from mensaje where account=? and chat_jid=? and from_me=0 and "
            "revocado=0", (foto["cuenta"], jid)).fetchone()
        foto["entradas"][jid] = fila[0] if fila else None
    return foto["entradas"][jid]


def actividad(foto, jid):
    """La ultima vez que se vio el chat: lo que anota el sidecar aunque este en `off`."""
    return (foto["chats"].get(jid) or {}).get("last_ts")


def movidas_lid(con, cuenta):
    return [dict(r) for r in con.execute(
        "select * from lid_migracion where account=? order by id", (cuenta,))]


def par_ya_movido(movidas, a, b):
    return any({m["desde"], m["hacia"]} == {a, b} for m in movidas)


def dueno_o_aprobacion(jid, ids, numero):
    """El directo de un numero del dueno, o el de aprobacion: moverlo dejaria al canal de
    aprobacion apuntando a un jid que ya no esta en el alcance. Se dice, no se mueve."""
    return jid == numero or wa_store.es_dueno(jid, ids)


def estados_lid(con, foto, scope, movidas, ahora=None):
    """El estado de cada entrada autorizada de la linea: ok | migrated | ghost | conflict,
    con la forma pareada y, si toca, a donde se mueve (`mover`). No escribe nada."""
    ahora = time.time() if ahora is None else ahora
    corte = ahora - dias_fantasma(con) * 86400
    ids, numero = duenos(), numero_aprobacion()
    llegadas = {m["hacia"]: m for m in movidas}
    salida = []
    for jid in sorted(scope):
        entrada = scope[jid]
        if (entrada.get("mode") or "off") == "off":
            continue
        fila = {"jid": jid, "chat_name": entrada.get("chat_name") or jid,
                "mode": entrada.get("mode"), "kind": "directo" if es_directo(jid) else "grupo",
                "paired": [], "status": "ok", "mover": None}
        if not es_directo(jid):
            salida.append(fila)
            continue
        pareja = sorted(foto["pares"].get(jid, ()))
        fila["paired"] = pareja
        fila["phone"] = next((t for t in map(telefono_lid, [jid, *pareja]) if t), None)
        if jid in llegadas:
            fila["status"] = "migrated"
            fila["migrated_from"] = llegadas[jid]["desde"]
        autorizadas = [k for k in pareja if ((scope.get(k) or {}).get("mode") or "off") != "off"]
        if autorizadas:
            fila["status"] = "conflict"
            fila["conflicto"] = autorizadas
            salida.append(fila)
            continue
        propia = actividad(foto, jid)
        vivas = [k for k in pareja if k not in scope and actividad(foto, k)
                 and (jid not in foto["chats"] or not propia or actividad(foto, k) > propia)
                 and not par_ya_movido(movidas, jid, k)
                 and not dueno_o_aprobacion(jid, ids, numero)
                 and not dueno_o_aprobacion(k, ids, numero)]
        if vivas:
            fila["mover"] = max(vivas, key=lambda k: actividad(foto, k))
            salida.append(fila)
            continue
        if jid not in foto["chats"]:
            fila["status"] = "ghost"
            salida.append(fila)
            continue
        ultima = ultima_entrada(foto, jid) or propia or 0
        if ultima < corte:
            nombre = (foto["chats"][jid].get("chat_name") or "").strip().lower()
            gemelas = [k for k in pareja if (actividad(foto, k) or 0) >= corte]
            if nombre and "@" not in nombre:
                gemelas += [j for j, c in foto["chats"].items()
                            if j != jid and not c.get("is_group") and es_directo(j)
                            and (c.get("chat_name") or "").strip().lower() == nombre
                            and (c.get("last_ts") or 0) >= corte]
            if gemelas:
                fila["status"] = "ghost"
                fila["desde_ts"] = ultima
                fila["gemelas"] = sorted(set(gemelas))
        salida.append(fila)
    return salida


def quien_lid(foto, entrada, *jids):
    """El nombre y el telefono para un aviso, en una linea: un salto en el nombre no puede
    fingir una linea aparte. Un nombre con forma de secreto no viaja."""
    nombre = entrada.get("chat_name") or ""
    if "@" in nombre or not nombre.strip():
        nombre = next(((foto["chats"].get(j) or {}).get("chat_name") or "" for j in jids
                       if "@" not in ((foto["chats"].get(j) or {}).get("chat_name") or "@")),
                      "")
    nombre = recorta(nombre, LARGO_NOMBRE_LID)
    if wa_reglas.secreto(nombre):
        nombre = ""
    tel = next((t for t in map(telefono_lid, jids) if t), None)
    if nombre and tel:
        return f"{nombre} ({tel})"
    return nombre or tel or str(jids[0]).partition("@")[0]


def aviso_lid(con, req_id, texto):
    """Un aviso de alcance al numero de aprobacion, una vez por id. Sin numero, nada."""
    if con.execute("select 1 from aviso where req_id=?", (req_id,)).fetchone():
        return False
    return aviso_encola(con, req_id, TIPO_AVISO_LID, texto)


def sello_lid(*partes):
    return hashlib.sha256("|".join(partes).encode("utf-8")).hexdigest()[:16]


def hueco_lid(con, foto, hacia):
    """Lo recibido y sin contestar en el chat vivo: cuantos dentro de la ventana de casos
    (esos abren caso en esta misma corrida) y cuantos antes, desde cuando. Solo lo que la
    bandeja ve (`inbox_days`): lo de mas atras ya no es un pendiente de nadie."""
    base = time.time() - ventana_casos(con) * 3600
    piso = time.time() - dias_fantasma(con) * 86400
    fuente = foto["fuente"]
    mia = fuente.execute("select max(ts) from mensaje where account=? and chat_jid=? and "
                         "from_me=1 and revocado=0", (foto["cuenta"], hacia)).fetchone()[0] or 0
    filas = [r[0] for r in fuente.execute(
        "select ts from mensaje where account=? and chat_jid=? and from_me=0 and revocado=0 "
        "and ts > ? and ts >= ? order by ts", (foto["cuenta"], hacia, mia, piso))]
    dentro = sum(1 for t in filas if t >= base)
    fuera = [t for t in filas if t < base]
    return base, dentro, len(fuera), (wa_store.ts(fuera[0]) if fuera else None)


def mueve_entrada(con, cuenta, desde, hacia, nombre):
    """La entrada ENTERA pasa al jid vivo: la fila de la base (todas sus columnas, las de
    hoy y las que se agreguen) y la del panel, que queda con una sola fila."""
    persistir_panel(con)
    con.execute("update chat_scope set chat_jid=?, chat_name=?, updated_at=? where "
                "account=? and chat_jid=?", (hacia, nombre, time.strftime("%Y-%m-%d %H:%M"),
                                             cuenta, desde))
    con.commit()
    store = plugin_store_read()
    if desde in store and cuenta_de_entrada(store[desde]) == cuenta:
        store[hacia] = dict(store.pop(desde), chatName=nombre)
        plugin_store_write(store, agent_name_of(con))


def anota_movida(con, cuenta, desde, hacia, origen, base, dentro=0, fuera=0,
                 fuera_desde=None):
    return con.execute(
        "insert into lid_migracion (account, desde, hacia, origen, at, ingest_desde, dentro, "
        "fuera, fuera_desde) values (?,?,?,?,?,?,?,?,?)",
        (cuenta, desde, hacia, origen, ahora_caso(), base, dentro, fuera, fuera_desde)).lastrowid


def termina_movida_del_panel(con, foto, cuenta):
    """El panel ya guardo la conversacion en su jid vivo y quito la vieja de SU storage; la
    fila vieja sigue en la base, y la mezcla la volveria a autorizar. Se termina aca: la
    fila vieja se va, con su rastro y sin aviso (lo hizo el dueno)."""
    panel = {j for j, e in plugin_store_read().items()
             if isinstance(e, dict) and cuenta_de_entrada(e) == cuenta}
    if not panel:
        return 0
    hechas = 0
    for r in con.execute("select chat_jid from chat_scope where account=?",
                         (cuenta,)).fetchall():
        viejo = r["chat_jid"]
        if viejo in panel or not es_directo(viejo):
            continue
        nuevo = next((k for k in sorted(foto["pares"].get(viejo, ())) if k in panel), None)
        if not nuevo:
            continue
        con.execute("delete from chat_scope where account=? and chat_jid=?", (cuenta, viejo))
        anota_movida(con, cuenta, viejo, nuevo, ORIGEN_PANEL,
                     time.time() - ventana_casos(con) * 3600)
        con.commit()
        hechas += 1
    if hechas:
        persistir_panel(con)
    return hechas


def sigue_lid(con):
    """Una vez por corrida de ingest: la autorizacion de cada directo sigue a su forma viva,
    con su rastro y UN aviso; los conflictos y los fantasmas se avisan una vez. Barato: una
    lectura del almacen y nada que escribir cuando nada cambio. Devuelve cuantas movio."""
    cuenta = cuenta_activa()
    try:
        fuente = wa_store.abrir()
    except wa_store.SinFuente:
        return 0
    try:
        # Un almacen que no habla de esta linea no dice nada de sus conversaciones.
        if cuenta not in wa_store.lineas_activas(fuente):
            return 0
        foto = foto_lid(fuente, cuenta)
        movidas = termina_movida_del_panel(con, foto, cuenta)
        historial = movidas_lid(con, cuenta)
        scope = merged_scope(con)
        tx = textos_lid()
        for fila in estados_lid(con, foto, scope, historial):
            jid, hacia = fila["jid"], fila["mover"]
            if hacia:
                entrada = scope[jid]
                nombre = entrada.get("chat_name") or ""
                if not nombre.strip() or "@" in nombre:
                    nombre = (foto["chats"].get(hacia) or {}).get("chat_name") or hacia
                base, dentro, fuera, fuera_desde = hueco_lid(con, foto, hacia)
                mueve_entrada(con, cuenta, jid, hacia, nombre)
                mid = anota_movida(con, cuenta, jid, hacia, ORIGEN_AUTO, base, dentro, fuera,
                                   fuera_desde)
                # El nombre de la forma viva primero: es como WhatsApp la llama hoy.
                partes = [tx["movido"].format(quien=quien_lid(foto, entrada, hacia, jid))]
                if dentro:
                    partes.append(tx["dentro"].format(n=dentro))
                if fuera:
                    partes.append(tx["fuera"].format(n=fuera, fecha=fuera_desde))
                if not dentro and not fuera:
                    vista = actividad(foto, jid) or (foto["chats"].get(hacia) or {}).get(
                        "first_seen")
                    partes.append(tx["sin_copia"].format(fecha=wa_store.ts(vista) or "-"))
                req = f"aviso-lid-m-{sello_lid(cuenta, jid, hacia, str(mid))}"
                if aviso_lid(con, req, " ".join(partes)):
                    con.execute("update lid_migracion set aviso=? where id=?", (req, mid))
                con.commit()
                movidas += 1
            elif fila["status"] == "conflict":
                par = sorted([jid, *fila["conflicto"]])
                aviso_lid(con, f"aviso-lid-c-{sello_lid(cuenta, *par)}",
                          tx["conflicto"].format(quien=quien_lid(foto, scope[jid], *par)))
                con.commit()
            elif fila["status"] == "ghost":
                texto = (tx["fantasma"].format(quien=quien_lid(foto, scope[jid], jid,
                                                               *fila["paired"]),
                                               fecha=wa_store.ts(fila["desde_ts"]) or "-")
                         if fila.get("desde_ts") else
                         tx["no_aparece"].format(quien=quien_lid(foto, scope[jid], jid,
                                                                 *fila["paired"])))
                aviso_lid(con, f"aviso-lid-f-{sello_lid(cuenta, jid)}", texto)
                con.commit()
        return movidas
    finally:
        fuente.close()


def bases_lid(con):
    """La linea base de cada chat al que llego una autorizacion: lo recibido antes de ella
    ya no se contesta solo (el aviso dijo cuantos y desde cuando)."""
    bases = {}
    for m in movidas_lid(con, cuenta_activa()):
        if m["ingest_desde"]:
            bases[m["hacia"]] = max(bases.get(m["hacia"], 0), m["ingest_desde"])
    return bases


def cmd_doctor(con, a):
    """Cada entrada autorizada de la linea activa: su jid, la forma pareada, la ultima
    entrada y la ultima actividad de cada forma, el estado (ok | migrated | ghost |
    conflict) y el rastro de lo que se movio. Solo lee."""
    cuenta = cuenta_activa()
    historial = movidas_lid(con, cuenta)
    salida = {"account": cuenta, "entries": [], "migrations": [
        {k: m[k] for k in ("desde", "hacia", "origen", "at", "dentro", "fuera", "fuera_desde",
                           "aviso")} for m in historial]}
    try:
        fuente = wa_store.abrir()
    except wa_store.SinFuente as exc:
        salida["store"] = exc.reason
        fuente = None
    try:
        if fuente is not None and cuenta in wa_store.lineas_activas(fuente):
            foto = foto_lid(fuente, cuenta)
            for fila in estados_lid(con, foto, merged_scope(con), historial):
                formas = [fila["jid"], *fila["paired"]]
                entrada = {k: fila.get(k) for k in ("jid", "chat_name", "mode", "kind",
                                                    "phone", "paired", "status")}
                if fila.get("migrated_from"):
                    entrada["migrated_from"] = fila["migrated_from"]
                if fila["mover"]:
                    # Lo que la proxima corrida de ingest va a mover.
                    entrada["moves_to"] = fila["mover"]
                entrada["forms"] = [{"jid": j, "last_in": wa_store.ts(ultima_entrada(foto, j)),
                                     "last_seen": wa_store.ts(actividad(foto, j)),
                                     "in_store": j in foto["chats"]} for j in formas]
                salida["entries"].append(entrada)
        else:
            for jid, e in sorted(merged_scope(con).items()):
                if (e.get("mode") or "off") != "off":
                    salida["entries"].append({"jid": jid, "chat_name": e.get("chat_name"),
                                              "mode": e.get("mode"), "status": "unknown"})
    finally:
        if fuente is not None:
            fuente.close()
    if a.json:
        return [salida]
    for e in salida["entries"]:
        print(f"{e['status']:<9} {e['jid']}  {e.get('chat_name') or ''}"
              + (f"  <-> {', '.join(e['paired'])}" if e.get("paired") else ""))
    for m in salida["migrations"]:
        print(f"moved     {m['desde']} -> {m['hacia']}  ({m['origen']}, {m['at']})")
    return None


def cmd_ingest(con, a):
    """Los mensajes nuevos de las conversaciones autorizadas pasan a casos.

    Lee lo mismo que el agente (`wa-read inbox`) y lo que no esta en `caso_mensaje` lo
    resuelve en este orden: lo que el dueno marco en el panel, el juicio que el agente ya
    cacheo, las reglas deterministas (cuerpo vacio o solo audio: dudoso), y Jev (con la
    llave puesta). Lo que nada resuelve queda en `recibido` para el agente. La primera
    corrida en una linea solo toma lo de las ultimas `case_window_hours` (T15): lo de
    antes queda visto y se cuenta en `anteriores`.

    Cada mensaje es una transaccion: repetirlo no cambia nada y no escribe eventos.
    Deny by default: una conversacion que no esta en el alcance, o esta en `off`, no
    existe para esto. Una linea suelta de un grupo (`kind` grupo, que no nombra ni cita al
    dueno) no abre caso: se suma al caso abierto de ese grupo si lo hay y es de la
    ventana, y si no queda sin caso — se cuenta en `sin_caso` y el agente la ve en la
    bandeja como siempre. Las suyas se procesan DESPUES de las que si abren caso, para
    que un lote con una mencion y su chat alrededor sea un solo caso y no dos."""
    cuenta = cuenta_activa()
    total = dict.fromkeys(CONTEOS_INGEST, 0)
    casos = set()
    try:
        mensajes = ingest_lee()
    except wa_store.SinFuente as exc:
        return [dict(total, casos=[], sin_fuente=exc.reason)]
    # La autorizacion de un directo que WhatsApp movio a su otra forma la sigue ANTES de
    # mirar el alcance: lo que llego por la forma nueva entra en esta misma corrida. Una
    # falla aca no puede dejar sin ingest: se dice y se sigue.
    try:
        movidas = sigue_lid(con)
    except (sqlite3.Error, OSError) as exc:
        if con.in_transaction:
            con.rollback()
        movidas = 0
        print(f"wa-scope: lid follow-up skipped: {exc}", file=sys.stderr)
    scope = merged_scope(con)
    decisiones = decisions_read()
    horas = ventana_casos(con)
    desde = linea_base_ingest(con, horas)
    bases = bases_lid(con)
    ajustes_auto = merged_settings(con)
    # Los numeros del dueno (T22.1), leidos una vez: lo que escriben es una orden suya.
    ids_dueno = duenos()
    # El rol de quien escribe (roles-por-numero, M10): admin, operador o cliente, por su id
    # y por lo que el dueno guardo para esa conversacion. La aprobacion por WhatsApp sigue
    # siendo solo de los numeros del dueno (`es_dueno`, abajo).
    rol_de = roles_de_entrada(con)
    numero = numero_aprobacion()
    tono_global = ajustes_auto.get("tone") or DEFAULT_CONFIG["tone"]
    abren, sueltos = [], []
    # Del mas viejo al mas nuevo: el inbox viene al reves, y el primero de un pedido es
    # el que abre el caso.
    nuevos = []
    for m in reversed(mensajes):
        entrada = scope.get(m.get("chat_jid"))
        if m.get("account") != cuenta or not entrada or entrada.get("mode") == "off":
            continue
        total["vistos"] += 1
        if caso_de_mensaje(con, m["stanza_id"]):
            continue
        if anterior_a(m, max(desde, bases.get(m.get("chat_jid"), 0))):
            total["anteriores"] += 1
            continue
        # La respuesta del dueno a un aviso (T14), en el directo del numero de aprobacion
        # (en Automatico, el unico modo por el que el aviso pudo salir) y desde un numero
        # suyo: no es un pedido nuevo y no pasa por Jev. Lo que no tiene
        # forma de respuesta sigue siendo una orden suya, como siempre.
        if (numero and m.get("chat_jid") == numero and entrada.get("mode") == "responder"
                and wa_store.es_dueno(m.get("sender_jid"), ids_dueno)):
            if respuesta_vista(con, m["stanza_id"]):
                continue
            if atiende_respuesta(con, m):
                total["respuestas"] += 1
                continue
        nuevos.append(dict(
            m, modo=entrada.get("mode"),
            rol=rol_de(m),
            # Lo que Jev necesita del chat para juzgar (T22.5): como escribe el asistente
            # ahi y que hace, tal como el dueno lo configuro.
            tono=(entrada.get("tone") or "").strip() or tono_global,
            instrucciones=(entrada.get("instructions") or "").strip() or None,
            # En los modos del agente (Beta) el pedido nuevo tambien se reconoce: el primer
            # mensaje lo escribe el agente aunque el acuse fijo este apagado.
            primer=primer_modo(entrada, ajustes_auto)[0],
            auto_acuse=(auto_ajuste(entrada, ajustes_auto, "acuse")[0]
                        or primer_modo(entrada, ajustes_auto)[0] in MODOS_AGENTE_PRIMERO),
            auto_saludo=auto_ajuste(entrada, ajustes_auto, "saludo")[0],
            sticker_suelto=(m.get("media_type") == "sticker" and not (m.get("text") or "").strip())))
    nuevos = transcribe_nuevos(con, nuevos, horas, total)
    # Lo que ya tiene decision del dueno o juicio del agente se resuelve solo; el resto,
    # junto con lo que llego pegado en el mismo chat, se juzga como una rafaga.
    # El juicio de Jev queda en la cache bajo el primer mensaje de la rafaga: ese no la
    # saca de la rafaga. El juicio de un agente o del dueno si.
    sueltas = [m for m in nuevos if m["stanza_id"] in decisiones
               or (m.get("juicio") and m["juicio"].get("origen") != "jev")]
    libres = [m for m in nuevos if m not in sueltas]
    por_rafaga = {m["stanza_id"]: r for r in agrupa_rafagas(libres) for m in r}
    for m in nuevos:
        if m in sueltas:
            veredicto = veredicto_de(con_respuesta(con, m, horas),
                                     (decisiones.get(m["stanza_id"]) or {}).get("decision"), con)
            grupo = [m]
        else:
            grupo = por_rafaga[m["stanza_id"]]
            if grupo[0] is not m:
                continue
            base = mensaje_de_rafaga(grupo) if len(grupo) > 1 else m
            veredicto = veredicto_de(con_respuesta(con, base, horas), None, con)
        for x in grupo:
            if x.get("kind") == "grupo" and veredicto is None:
                sueltos.append((x, veredicto))
            else:
                abren.append((x, veredicto))
    for m, veredicto in abren + sueltos:
        hecho, case_id = ingest_mensaje(con, m, veredicto, horas)
        cancela_borradores()
        for k, v in hecho.items():
            total[k] += v
        if case_id is not None:
            casos.add(case_id)
            if veredicto and veredicto.get("accion") == "cerrar":
                # El resto de una rafaga que no pide nada se suma a ese mismo caso cerrado.
                veredicto.setdefault("al_caso", case_id)
    # Lo que Jev dejo con una credencial no pasa por el agente: va al dueno ya.
    casos_credencial_a_decision(con)
    # La confirmacion de lo que el dueno contesto sale ya, no al minuto siguiente: esta
    # mirando el telefono. Lo que no salga aca lo intenta el tick con el mismo id.
    if total["respuestas"]:
        envia_avisos(con)
    salida = dict(total, casos=sorted(casos))
    if movidas:
        salida["alcance_movido"] = movidas
    return [salida]


# ── El tablero en el storage del panel (kanban-casos, T4) ───────────────────────────
# Topes: el host lee el storage entero en cada pintada. Las abiertas son las que se
# trabajan; de las cerradas basta lo reciente para ver que paso.
TOPE_ABIERTAS = 200
TOPE_CERRADAS = 50
# Treinta dias: el periodo mas largo del tablero antes de "Todo" (informes-tablero, I1). El
# tope de arriba sigue mandando; lo que el periodo cuenta y no viaja lo dice `period_counts`.
DIAS_CERRADAS = 30
# El titulo que falta sale del primer mensaje: una linea que se lee de un vistazo.
LARGO_TITULO = 80
# Lo que el dueno puede hacer con la tarjeta en cada etapa. El panel pinta los botones;
# el canal panel -> worker (T6) es quien los valida de verdad.
ACCIONES_DE_ETAPA = {
    "recibido": ("atender", "ignorar", "reclasificar", "cerrar", "proyecto"),
    "clasificado": ("atender", "ignorar", "reclasificar", "cerrar", "proyecto"),
    "decision": ("enviar", "editar", "ejecutar", "autorizar", "reclasificar", "cerrar",
                 "proyecto"),
    "trabajo": ("cerrar",),
    "listo": ("enviar", "editar", "cerrar"),
    "respondido": ("cerrar", "reabrir"),
    "cerrado": ("reabrir",),
    "bloqueado": ("reclasificar", "cerrar", "reabrir", "proyecto"),
}
# Donde el dueno puede pedir que el agente lo atienda ya (lo que era "Tomar" en la
# bandeja): lo que todavia no tiene propuesta.
ETAPAS_ATENDER = ("recibido", "clasificado")
# Donde se le puede cambiar el proyecto: antes de que un trabajo aprobado salga a correr
# en el proyecto que tenia, y nunca sobre lo cerrado.
ETAPAS_PROYECTO = ("recibido", "clasificado", "decision", "bloqueado")
# Cuantos eventos de cada caso viajan en la tarjeta: la historia reciente, no la entera.
EVENTOS_EN_TARJETA = 20
# En decision, lo que se ejecuta depende de la propuesta: una respuesta se envia, un
# trabajo se ejecuta. Lo que no aplica no se ofrece.
ACCION_DE_TIPO = {"enviar": "responder", "ejecutar": "trabajar"}

_TABLERO_SUCIO = []


def ruta_de_tablero(caso, alcance, catalogo):
    """Lo que el tablero dice del proyecto de un caso, en `board.project_routes` (y no en la
    tarjeta, cuyo juego de llaves es contrato): por que tiene ese proyecto, o por que
    ninguno; quien lo eligio (rule | chat | agent | owner, o null); los proyectos del chat
    en su orden, y los ids de su lista que el dueno quito del catalogo
    (proyectos-por-chat, M3)."""
    elegido = proyecto_de_ruta(ruta_del_caso(caso), alcance.get(caso["chat_jid"]), catalogo)
    return dict({k: elegido[k] for k in ("why", "by", "candidates", "missing")},
                question=pregunta_de_tarjeta(ruta_del_caso(caso), catalogo))


def iso_caso(sello):
    """Un sello de los casos (hora local, a segundos) en ISO con su zona."""
    try:
        cuando = datetime.datetime.strptime(str(sello), "%Y-%m-%d %H:%M:%S")
    except (TypeError, ValueError):
        return None
    return cuando.astimezone().isoformat(timespec="seconds")


def acciones_de(etapa, tipo, con_excepciones=False, con_pregunta=False):
    acciones = ACCIONES_DE_ETAPA.get(etapa, ())
    if etapa == "respondido" and con_pregunta:
        # La pregunta "A o B?" espera al que escribio: el dueno puede contestarla eligiendo
        # el proyecto desde la tarjeta (proyectos-por-chat, M5).
        acciones = acciones + ("proyecto",)
    if etapa == "decision":
        acciones = tuple(x for x in acciones
                         if x not in ACCION_DE_TIPO or ACCION_DE_TIPO[x] == tipo)
        # Autorizar solo tiene sentido si hay excepciones de entrada que dispensar.
        if not con_excepciones:
            acciones = tuple(x for x in acciones if x != "autorizar")
    return list(acciones)


def titulos_de_mensajes(con, case_ids):
    """{case_id: titulo} para los casos sin titulo, del primer mensaje con texto. El
    texto vive en capture.db y se lee en solo lectura; sin almacen no hay titulo."""
    if not case_ids:
        return {}
    cuenta = cuenta_activa()
    de_caso = {}
    for i in range(0, len(case_ids), 500):
        parte = case_ids[i:i + 500]
        de_caso.update((r["stanza_id"], r["case_id"]) for r in con.execute(
            f"select stanza_id, case_id from caso_mensaje where account=? and case_id in "
            f"({','.join('?' * len(parte))})", (cuenta, *parte)))
    if not de_caso:
        return {}
    try:
        fuente = wa_store.abrir()
    except wa_store.SinFuente:
        return {}
    primeros = {}
    try:
        stanzas = list(de_caso)
        for i in range(0, len(stanzas), 500):
            parte = stanzas[i:i + 500]
            for stanza, cuerpo, ts in fuente.execute(
                    f"select stanza_id, body, ts from mensaje where account=? and "
                    f"stanza_id in ({','.join('?' * len(parte))}) and trim(body) <> ''",
                    (cuenta, *parte)):
                cid = de_caso[stanza]
                if cid not in primeros or ts < primeros[cid][0]:
                    primeros[cid] = (ts, cuerpo)
    except sqlite3.Error:
        return {}
    finally:
        fuente.close()
    titulos = {}
    for cid, (_, cuerpo) in primeros.items():
        # Enmascarado: el titulo termina en el storage del panel, y una clave pegada en
        # el primer mensaje no tiene por que quedar ahi.
        texto = " ".join(wa_jev.mask(cuerpo).split())
        if len(texto) > LARGO_TITULO:
            texto = texto[:LARGO_TITULO].rstrip() + "…"
        titulos[cid] = texto
    return titulos


# Las etapas en que la tarjeta cuenta el despacho, y que estados del despacho dicen algo en
# cada una: en trabajo, el agente trabajando (o la respuesta del cliente por entregarle); en
# listo, lo que reporto; en respondido, que espera al cliente; en bloqueado, que lo bloqueo
# el agente o el despacho.
ESTADOS_DE_DESPACHO_EN = {
    "trabajo": ("lanzando", "activo", "esperando"),
    "listo": ("activo", "esperando", "reportado"),
    "respondido": ("esperando",),
    "bloqueado": ("bloqueado",),
}
ETAPAS_CON_DESPACHO = tuple(ESTADOS_DE_DESPACHO_EN)


def despacho_de_tarjeta(etapa, despacho):
    if not despacho or despacho["state"] not in ESTADOS_DE_DESPACHO_EN.get(etapa, ()):
        return None
    if etapa == "listo" and not despacho["outcome"]:
        return None
    return despacho


def tarjeta_de(caso, nombres, titulos, motivos, eventos=None, sin_agente=None,
               solo_leer=(), despachos=None, alcance=None, catalogo=None):
    """Un caso con la forma de una tarjeta del contrato `board`."""
    propuesta = json.loads(caso["propuesta"]) if caso["propuesta"] else None
    # El proyecto de la tarjeta es el que usaria el despacho (proyectos-por-chat, M3).
    elegido = proyecto_de_ruta(ruta_del_caso(caso), (alcance or {}).get(caso["chat_jid"]),
                               catalogo or [])
    tipo = (propuesta or {}).get("tipo")
    nombre = nombres.get(caso["chat_jid"]) or caso["chat_jid"]
    return {
        "case_id": caso["case_id"], "account": caso["account"],
        "chat_jid": caso["chat_jid"], "chat_name": nombre, "stage": caso["etapa"],
        "title": caso["titulo"] or titulos.get(caso["case_id"]) or nombre,
        "summary": caso["resumen"], "clase": caso["clase"], "prioridad": caso["prioridad"],
        "jev": json.loads(caso["jev"]) if caso["jev"] else None,
        "proposal": {"tipo": tipo,
                     "texto": propuesta.get("respuesta") or propuesta.get("instrucciones"),
                     "version": caso["propuesta_version"]} if propuesta else None,
        "exceptions": excepciones_de_tarjeta(caso),
        "blocked_reason": (motivos.get(caso["case_id"]) if caso["etapa"] == "bloqueado"
                           else None),
        # La regla de SIN_AGENTE por la que se cerro un caso sin pasar por el agente (su clave,
        # que el panel traduce), o None.
        "no_agent_rule": (regla_de_motivo((sin_agente or {}).get(caso["case_id"]))
                          if caso["etapa"] == "cerrado" else None),
        # Un caso de un chat `observar` que el agente no redacta (el dueno no apreto Atender
        # ahora): se ve en el tablero con la nota "Solo leer".
        "read_only": caso["case_id"] in solo_leer,
        "ticket": caso["plane_issue"] or None,
        "updated_at": iso_caso(caso["updated_at"]),
        "actions": acciones_de(caso["etapa"], tipo, bool(json.loads(caso["excepciones"] or "[]")),
                               pregunta_al_que_escribio(ruta_del_caso(caso))),
        "project": ({"id": elegido["id"], "name": elegido["name"]}
                    if elegido["id"] and not elegido["quitado"] else None),
        "needs_agent": bool(caso["necesita_agente"]),
        # El ultimo despacho del caso al agente del proyecto (T8), mientras dice algo de la
        # etapa en que esta: a que proyecto, desde cuando, su estado y lo que reporto el
        # agente (resuelto | necesita | bloqueado). Sin despacho que contar, null.
        "dispatch": despacho_de_tarjeta(caso["etapa"], (despachos or {}).get(caso["case_id"])),
        # El caso anterior del mismo chat, si este abrio aparte de uno que ya estaba.
        "related_case": caso["relacionado"],
        # La historia del caso (`caso_evento`): de que etapa a cual, quien y cuando. Sin
        # `detalle`: es texto de maquina en ingles y el panel no lo muestra.
        "events": [dict({"de": e["de"], "a": e["a"], "actor": e["actor"],
                         "at": iso_caso(e["at"])},
                        **({"que": e["que"]} if e.get("que") else {}),
                        **({"args": e["args"]} if e.get("args") else {}))
                   for e in (eventos or {}).get(caso["case_id"], [])],
    }


# El detalle de un evento, traducido a un codigo estable para la historia del tablero
# (T22): "llego un sticker", "Jev: necesita agente", "envio retenido: <motivo>". Solo
# codigos y nombres de excepciones o motivos: nunca el texto de un mensaje.
RE_EV_MENSAJE = re.compile(r"^mensaje (\S+)")
RE_EV_PROPUESTA = re.compile(r"^(responder|trabajar|escalar|descartar) [0-9a-f]{64}$")
RE_EV_CLASE = re.compile(r"^(card|alert|doubtful|nothing) · ")
RE_EV_LISTA = re.compile(r"[a-z_-]+")
RE_EV_PROYECTO_AGENTE = re.compile(r"^proyecto ([a-z0-9][a-z0-9-]*) · agente: ")


def _codigos(texto):
    return [c for c in RE_EV_LISTA.findall(texto or "")][:8]


def que_del_evento(detalle, medios=None):
    """(codigo, [argumentos]) de un detalle de `caso_evento`, o (None, []) si no se sabe
    decir: el panel entonces muestra "actualizado", como antes."""
    d = detalle.strip()
    m = RE_EV_MENSAJE.match(d)
    if m:
        tipo = (medios or {}).get(m.group(1))
        return ({"sticker": "sticker", "audio": "audio"}.get(tipo, "message"), [])
    if d.startswith("jev: "):
        partes = []
        if "necesita agente" in d:
            partes.append("agent")
        exc = re.search(r"excepciones ([a-z, ]+)", d)
        partes += _codigos(exc.group(1)) if exc else []
        return "jev", partes
    if d.startswith("regla fija:"):
        return "rule", [c for c in _codigos(d.split(":", 1)[1])
                        if c in wa_jev.ORDEN_EXCEPCIONES]
    if d.startswith("envio frenado:"):
        return "held", list(dict.fromkeys(c for _, c in motivos_del_freno(d)))
    if " veces (" in d and "lo decide el dueno" in d:
        return "owner_decides", _codigos(d.split("(", 1)[1].split(")", 1)[0])
    if d.startswith(REVISIONES):
        prefijo = next(p for p in REVISIONES if d.startswith(p))
        return "revision", _codigos(d[len(prefijo):].split("·")[0])
    if d.startswith(ESPERA_DUENO):
        return "work_waits", _codigos(d[len(ESPERA_DUENO):].split("·")[0])
    if d.startswith(RESPUESTA_ESPERA):
        return "reply_waits", _codigos(d[len(RESPUESTA_ESPERA):].split("·")[0])
    if d.startswith((AVISO_ENVIADO, AVISO_BLOQUEO)):
        return "wa_notice", []
    if d.startswith("aprobada ") and d.endswith(POR_WHATSAPP):
        return "wa_approved", []
    if d == RECHAZO_WHATSAPP:
        return "wa_rejected", []
    if d.startswith(CORRECCION_WHATSAPP):
        return "wa_correction", []
    if "propuesta anterior, no enviada" in d:
        return "withdrawn", []
    if d.startswith("aprobada "):
        return "approved", []
    if d.startswith("enviado "):
        return "sent", []
    if d.startswith("ruta "):
        return "route", []
    m = RE_EV_PREGUNTA.match(d)
    if m:
        return "project_question", [m.group(1)]
    if d.startswith(PREGUNTA_AL_DUENO):
        return "project_question", ["owner"]
    if d.startswith(RESPUESTA_PREGUNTA):
        return "project_answer", []
    m = RE_EV_PROYECTO_AGENTE.match(d)
    if m:
        # La eleccion del agente: el id y quien. El porque es texto suyo y va en la ruta.
        return "project", [m.group(1), "agent"]
    if d.startswith("proyecto "):
        return "project", []
    if d.startswith("autorizadas:"):
        return "authorized", []
    if d == DETALLE_ATENDER:
        return "attend", []
    if "titulo y resumen nuevos" in d:
        return "retitled", []
    m = RE_EV_PROPUESTA.match(d)
    if m:
        return "proposal", [m.group(1)]
    m = RE_EV_CLASE.match(d)
    if m:
        return "classified", [m.group(1)]
    return None, []


def medios_de_eventos(eventos):
    """{stanza: 'sticker' | 'audio' | ...} de los mensajes que nombran los eventos, en una
    lectura del almacen. Sin almacen, vacio: la historia dice "llego un mensaje"."""
    stanzas = sorted({m.group(1) for lista in eventos.values() for e in lista
                      if (m := RE_EV_MENSAJE.match((e.get("detalle") or "").strip()))})
    if not stanzas:
        return {}
    try:
        fuente = wa_store.abrir()
    except wa_store.SinFuente:
        return {}
    salida = {}
    try:
        for i in range(0, len(stanzas), 500):
            parte = stanzas[i:i + 500]
            for r in fuente.execute(
                    f"select stanza_id, media_type from mensaje where account=? and "
                    f"stanza_id in ({','.join('?' * len(parte))})", (cuenta_activa(), *parte)):
                tipo = (r["media_type"] or "").lower()
                salida[r["stanza_id"]] = ("audio" if tipo in TIPOS_AUDIO else tipo)
    except sqlite3.Error:
        return {}
    finally:
        fuente.close()
    return salida


def entrada_a_etapa(eventos, caso):
    """Cuando entro el caso a la etapa en que esta: su ULTIMA entrada (un caso reabierto y
    vuelto a cerrar esta cerrado desde la segunda). Un evento sin cambio de etapa no cuenta;
    sin ninguno que la diga, su ultima actualizacion."""
    for e in reversed(eventos or []):
        if e["a"] == caso["etapa"] and e["de"] != e["a"]:
            return e["at"]
    return caso["updated_at"]


def cuentas_por_periodo(con, cuenta, ahora):
    """Respondido y Cerrado de la linea activa por periodo del tablero, contados por la hora
    en que el caso entro a esa etapa, con los mismos limites que los informes."""
    entradas = []
    for r in con.execute(
            "select c.etapa, coalesce((select max(e.at) from caso_evento e where "
            "e.case_id = c.case_id and e.a = c.etapa and e.de is not e.a), c.updated_at) desde "
            "from caso c where c.account=? and c.etapa in ('respondido', 'cerrado')", (cuenta,)):
        entradas.append((r["etapa"], _epoch_local(r["desde"])))
    salida = {}
    for clave, p in periodos_del_informe(ahora).items():
        salida[clave] = {e: sum(1 for etapa, t in entradas
                                if etapa == e and (p["desde"] is None or
                                                   (t is not None and t >= p["desde"])))
                         for e in ("respondido", "cerrado")}
    return salida


def build_board(con, ahora=None):
    """El tablero de la linea activa, con la forma del contrato `board`: hasta 200
    abiertas (las mas recientes) mas las cerradas de los ultimos 30 dias hasta 50, y
    `counts` sobre TODO, no solo sobre lo que se manda. Cada tarjeta dice desde cuando esta
    en su etapa (`stage_at`) y `period_counts` cuenta Respondido y Cerrado por periodo."""
    ahora = time.time() if ahora is None else ahora
    cuenta = cuenta_activa()
    counts = dict.fromkeys(ETAPAS_CASO, 0)
    for r in con.execute("select etapa, count(*) n from caso where account=? "
                         "group by etapa", (cuenta,)):
        if r["etapa"] in counts:
            counts[r["etapa"]] = r["n"]
    abiertas = con.execute(
        "select * from caso where account=? and etapa <> 'cerrado' "
        "order by updated_at desc, case_id desc limit ?",
        (cuenta, TOPE_ABIERTAS + 1)).fetchall()
    desde = time.strftime("%Y-%m-%d %H:%M:%S",
                          time.localtime(ahora - DIAS_CERRADAS * 86400))
    cerradas = con.execute(
        "select * from caso where account=? and etapa = 'cerrado' and updated_at >= ? "
        "order by updated_at desc, case_id desc limit ?",
        (cuenta, desde, TOPE_CERRADAS + 1)).fetchall()
    truncado = len(abiertas) > TOPE_ABIERTAS or len(cerradas) > TOPE_CERRADAS
    casos = abiertas[:TOPE_ABIERTAS] + cerradas[:TOPE_CERRADAS]
    alcance = merged_scope(con)
    catalogo = proyectos_del_dueno(con)
    nombres = {jid: r.get("chat_name") for jid, r in alcance.items()}
    titulos = titulos_de_mensajes(con, [c["case_id"] for c in casos if not c["titulo"]])
    bloqueados = [c["case_id"] for c in casos if c["etapa"] == "bloqueado"]
    motivos = {}
    if bloqueados:
        # El ultimo motivo con que cada uno entro a bloqueado.
        for r in con.execute(
                f"select case_id, detalle from caso_evento where a='bloqueado' and "
                f"case_id in ({','.join('?' * len(bloqueados))}) order by id",
                bloqueados):
            motivos[r["case_id"]] = r["detalle"] or None
    modos = {jid: r.get("mode") for jid, r in merged_scope(con).items()}
    solo_leer = {c["case_id"] for c in casos
                 if c["etapa"] in ("recibido", "clasificado") and modos.get(c["chat_jid"]) == "observar"
                 and not atendido_por_dueno(con, c["case_id"])}
    sin_agente = {}
    cerrados = [c["case_id"] for c in casos if c["etapa"] == "cerrado"]
    for i in range(0, len(cerrados), 500):
        parte = cerrados[i:i + 500]
        for r in con.execute(
                f"select case_id, detalle from caso_evento where a='cerrado' and detalle like ? "
                f"and case_id in ({','.join('?' * len(parte))}) order by id",
                (PREFIJO_SIN_AGENTE + "%", *parte)):
            sin_agente[r["case_id"]] = r["detalle"]
    eventos = {}
    ids = [c["case_id"] for c in casos]
    for i in range(0, len(ids), 500):
        parte = ids[i:i + 500]
        for r in con.execute(
                f"select case_id, de, a, actor, detalle, at from caso_evento where case_id in "
                f"({','.join('?' * len(parte))}) order by id", parte):
            eventos.setdefault(r["case_id"], []).append(dict(r))
    # Con la historia ENTERA, antes de recortarla: la entrada a la etapa puede ser vieja.
    entradas = {c["case_id"]: iso_caso(entrada_a_etapa(eventos.get(c["case_id"]), c))
                for c in casos}
    eventos = {k: v[-EVENTOS_EN_TARJETA:] for k, v in eventos.items()}
    # Lo que paso en cada evento, en un codigo que el panel traduce (T22): el detalle es
    # texto de maquina y no viaja. Un mensaje dice si fue un sticker o un audio.
    medios = medios_de_eventos(eventos)
    for lista in eventos.values():
        for e in lista:
            e["que"], e["args"] = que_del_evento(e.pop("detalle", "") or "", medios)
    esperan = casos_para_agente(con)
    despachos = {}
    con_despacho = [c["case_id"] for c in casos if c["etapa"] in ETAPAS_CON_DESPACHO]
    for i in range(0, len(con_despacho), 500):
        parte = con_despacho[i:i + 500]
        for r in con.execute(
                f"select case_id, proyecto, estado, resultado, created_at, updated_at, "
                f"cuenta_etiqueta, respaldo from "
                f"caso_despacho where case_id in ({','.join('?' * len(parte))}) order by id",
                parte):
            despachos[r["case_id"]] = {"project": r["proyecto"], "state": r["estado"],
                                       "outcome": r["resultado"],
                                       "at": iso_caso(r["created_at"]),
                                       "updated_at": iso_caso(r["updated_at"]),
                                       # Con que cuenta de Claude se abrio, y por que no
                                       # con la del bot si fue otra (RESPALDOS_CUENTA).
                                       "account": r["cuenta_etiqueta"],
                                       "fallback": r["respaldo"]}
    return {"v": 1,
            "updated_at": datetime.datetime.now().astimezone().isoformat(timespec="seconds"),
            "truncated": truncado, "counts": counts,
            # Respondido y Cerrado por periodo (informes-tablero, I1): las cuentas que el
            # panel muestra con un periodo elegido, sobre TODO y no solo sobre lo que viaja.
            "period_counts": cuentas_por_periodo(con, cuenta, ahora),
            # Los casos que esperan al agente: los mismos que `pending --needs-agent`.
            "agent_waiting": len(esperan),
            # La ultima vez que se lanzo al agente de casos: si fallo, el panel lo dice en
            # las tarjetas que lo esperan y en la linea de la revision, con su motivo.
            "agent_launch": agente_del_tablero(con),
            # Los espacios del plugin que la limpieza no pudo quitar tras sus intentos: el
            # panel lo dice en la linea de la revision, para que el dueno los quite a mano.
            "workspaces_stuck": espacios_atascados(con),
            # Lo retenido que no es de ningun caso: el dueno lo aprueba o lo retira desde el
            # panel (approve-solo-dueno).
            "held_drafts": retenidos_del_tablero(con, cuenta),
            # El proyecto de cada tarjeta, con su porque y los del chat: {case_id: {...}}.
            "project_routes": {str(c["case_id"]): ruta_de_tablero(c, alcance, catalogo)
                               for c in casos},
            "cards": [dict(tarjeta_de(c, nombres, titulos, motivos, eventos, sin_agente,
                                      solo_leer, despachos, alcance, catalogo),
                           # Lo cuenta `agent_waiting`: el panel le pone la falla de
                           # `agent_launch` a estas tarjetas.
                           waits_agent=c["case_id"] in esperan,
                           # Desde cuando esta en su etapa: el periodo acota lo terminado
                           # por esta hora.
                           stage_at=entradas.get(c["case_id"]))
                      for c in casos]}


# Los retenidos fuera de un caso (approve-solo-dueno): cuantos viajan al panel, y los ids
# que NO son de ellos. `caso-...` se aprueba en su tarjeta, con su version; `aviso-...` es
# del plugin al dueno.
TOPE_RETENIDOS = 50
PREFIJOS_DEL_MOTOR = ("caso-", "aviso-")


def motivos_de_retenido(detalle):
    """Por que se freno, en los codigos de excepcion que el panel ya traduce, de la fila
    `draft` que dejo `wa-send`: `held by rule: money, secret; jev: x · <req> · ...` ->
    ["money", "credential", "jev"]. Un secreto es una credencial; lo de Jev es "jev"."""
    if not str(detalle or "").startswith("held by "):
        return []
    salida = []
    for tramo in detalle[len("held by "):].split(" · ", 1)[0].split(";"):
        quien, _, codigos = tramo.strip().partition(": ")
        for c in (c.strip() for c in codigos.split(",") if c.strip()):
            salida.append("jev" if quien == "jev" else
                          "credential" if c == wa_reglas.SECRETO else c)
    return list(dict.fromkeys(salida))


def retenidos_del_tablero(con, cuenta):
    """Los borradores de la linea activa que esperan al dueno y no son de ningun caso: el
    aviso de la sesion de un proyecto que el piso freno, por ejemplo. Sin esto nadie los
    podia aprobar: `wa-send --approve` ya no es de los agentes. Va el texto, como la
    propuesta de una tarjeta: aprobar sin leerlo seria a ciegas. Del mas viejo al mas nuevo."""
    ruta = wa_store.store_db_path()
    if not os.path.exists(ruta):
        return []
    try:
        fuente = sqlite3.connect(f"file:{ruta}?mode=ro", uri=True, timeout=10)
        fuente.row_factory = sqlite3.Row
        filas = fuente.execute(
            "select req_id, chat_jid, chat_name, body, created_at from envio where "
            "estado='borrador' and account=? and req_id not like 'caso-%' and req_id not like "
            "'aviso-%' order by created_at, rowid limit ?", (cuenta, TOPE_RETENIDOS)).fetchall()
        fuente.close()
    except sqlite3.Error:
        return []
    salida = []
    for f in filas:
        nota = con.execute("select detail from agent_action where action='draft' and "
                           "instr(detail, ?) > 0 order by id desc limit 1",
                           (f" · {f['req_id']} · ",)).fetchone()
        salida.append({"req_id": f["req_id"], "chat_jid": f["chat_jid"], "account": cuenta,
                       "chat": f["chat_name"] or f["chat_jid"], "text": f["body"] or "",
                       "at": datetime.datetime.fromtimestamp(int(f["created_at"] or 0))
                       .astimezone().isoformat(timespec="seconds"),
                       "reasons": motivos_de_retenido(nota["detail"] if nota else "")})
    return salida


def publica_tablero(con):
    """El tablero (y su insignia) al storage del panel, despues de una mutacion."""
    _TABLERO_SUCIO.clear()
    return plugin_store_write(None, extra={"board": build_board(con)})


# ── Los informes (odd/tasks/informes-tablero.md, I3) ──────────────────────────────────
# El panel no puede leer las bases: los numeros de la pestana Informes salen de aca, en el
# mismo sync que el tablero, a UNA clave del storage (`reports`). Solo agregados, ids de
# caso y nombres de chat; el titulo del caso (que sale del texto del cliente) solo en la
# lista corta de fallas de la meta, que el panel muestra. Nunca el texto de un mensaje.
#
# Las definiciones (las mismas que dice la pestana):
# - Primera respuesta: del primer mensaje del cliente del caso a la primera salida en ese
#   chat despues de el y antes del caso siguiente del chat (acuse, primer mensaje del
#   agente o respuesta). Una salida ANTERIOR (el reloj de un telefono) no es su respuesta,
#   ni la que contesta al caso siguiente. Cuenta en el periodo en que se creo el caso.
# - Resolucion: de la creacion del caso a su PRIMERA entrada en respondido o cerrado; nunca
#   negativa (un evento antes de la creacion, por el reloj, es cero).
# - Resuelto: un caso cuya primera entrada en respondido o cerrado cae en el periodo.
# - Espera del cliente: por cada rafaga de mensajes seguidos del cliente en un chat del
#   alcance, el tiempo hasta la siguiente salida; la mediana del periodo en que empezo la
#   rafaga. Las que siguen sin salida no entran a la mediana: se cuentan (`unanswered`).
# - SLA: cumple el caso cuya primera respuesta llego dentro de la meta
#   (`sla_first_reply_minutes`); falla el que llego despues, o el que sigue sin respuesta
#   con la meta ya vencida (pendiente mientras no vence). Un caso cerrado sin respuesta, o
#   sin mensajes del cliente en el almacen, no entra.
# - Trafico y volumen de mensajes: solo los chats del alcance (modo distinto de off) de la
#   linea activa, sin los mensajes revocados. Los casos son los de la linea activa.
# La hora es la LOCAL del equipo: los periodos empiezan a la medianoche local, y el periodo
# anterior es el de la misma duracion justo antes (hoy se compara con ayer hasta la misma
# hora).
PERIODOS_INFORME = (("today", 1), ("7d", 7), ("30d", 30), ("all", None))
ETAPAS_RESUELTAS = ("respondido", "cerrado")
# Los topes que acotan la clave: el storage se reescribe en cada sync y el panel lo lee
# entero.
TOPE_SEMANAS_INFORME = 104
TOPE_FALLAS_SLA = 50
TOPE_CASOS_INFORME = 500
TOPE_PROYECTOS_INFORME = 50
CLAVES_VOLUMEN = ("chats", "received", "sent", "created", "resolved")


def _medianoche(dia):
    return time.mktime((dia.year, dia.month, dia.day, 0, 0, 0, 0, 0, -1))


def _iso_epoch(t):
    return (datetime.datetime.fromtimestamp(t).astimezone().isoformat(timespec="seconds")
            if t is not None else None)


def _epoch_local(sello):
    """Un sello de los casos (hora local, a segundos) en epoch, o None."""
    try:
        return time.mktime(time.strptime(str(sello), "%Y-%m-%d %H:%M:%S"))
    except (TypeError, ValueError, OverflowError):
        return None


def _dia(t):
    return time.strftime("%Y-%m-%d", time.localtime(t))


def _hora(t):
    return time.strftime("%Y-%m-%d %H", time.localtime(t))


def _lunes(fecha):
    """El lunes de la semana de una fecha 'YYYY-MM-DD'."""
    d = datetime.date.fromisoformat(fecha)
    return (d - datetime.timedelta(days=d.weekday())).isoformat()


def _mediana(valores):
    if not valores:
        return None
    orden = sorted(valores)
    mitad = len(orden) // 2
    medio = orden[mitad] if len(orden) % 2 else (orden[mitad - 1] + orden[mitad]) / 2
    return int(round(medio))


def _delta_pct(actual, previo):
    """El cambio contra el periodo anterior, en porcentaje entero; None sin base (nunca
    se divide por cero)."""
    if actual is None or previo is None or previo == 0:
        return None
    return int(round((actual - previo) * 100 / previo))


def periodos_del_informe(ahora):
    """{clave: {desde, hasta, previo (desde, hasta) | None, cubeta, filas, cubetas}}."""
    lt = time.localtime(ahora)
    hoy = datetime.date(lt.tm_year, lt.tm_mon, lt.tm_mday)
    salida = {}
    for clave, dias in PERIODOS_INFORME:
        if dias is None:
            salida[clave] = {"desde": None, "hasta": ahora, "previo": None,
                             "cubeta": "week", "filas": "weekday", "fechas": None}
            continue
        inicio = hoy - datetime.timedelta(days=dias - 1)
        antes = hoy - datetime.timedelta(days=dias)
        fin_previo = time.mktime((antes.year, antes.month, antes.day, lt.tm_hour,
                                  lt.tm_min, lt.tm_sec, 0, 0, -1))
        salida[clave] = {
            "desde": _medianoche(inicio), "hasta": ahora,
            "previo": (_medianoche(inicio - datetime.timedelta(days=dias)), fin_previo),
            "cubeta": "hour" if dias == 1 else "day",
            "filas": "date" if dias <= 7 else "weekday",
            "fechas": [(inicio + datetime.timedelta(days=i)).isoformat()
                       for i in range(dias)]}
    return salida


def _en(t, desde, hasta, cerrado=True):
    """Si t cae en [desde, hasta] (o [desde, hasta) con cerrado False). desde None = siempre."""
    if t is None or (desde is not None and t < desde):
        return False
    return t <= hasta if cerrado else t < hasta


def _cubeta(t, cubeta):
    if cubeta == "hour":
        return _hora(t)
    if cubeta == "day":
        return _dia(t)
    return _lunes(_dia(t))


def informe_mensajes(cuenta, chats, periodos):
    """Lo que sale del almacen, agregado en SQL: recibidos y enviados por hora local, chats
    con actividad por dia y por hora de hoy, los totales de cada periodo y su anterior, y
    las rafagas del cliente con su respuesta. Sin almacen, None."""
    try:
        fuente = wa_store.abrir()
    except wa_store.SinFuente:
        return None
    alcance = json.dumps(sorted(chats))
    filtro = ("account = ? and revocado = 0 and chat_jid in "
              "(select value from json_each(?))")
    try:
        por_hora = {r[0]: (r[1], r[2]) for r in fuente.execute(
            f"select strftime('%Y-%m-%d %H', ts, 'unixepoch', 'localtime') k, "
            f"sum(from_me = 0), sum(from_me = 1) from mensaje where {filtro} group by k",
            (cuenta, alcance))}
        chats_dia = {}
        for d, chat in fuente.execute(
                f"select distinct date(ts, 'unixepoch', 'localtime'), chat_jid from mensaje "
                f"where {filtro}", (cuenta, alcance)):
            chats_dia.setdefault(d, set()).add(chat)
        hoy0 = periodos["today"]["desde"]
        chats_hora = {r[0]: r[1] for r in fuente.execute(
            f"select strftime('%Y-%m-%d %H', ts, 'unixepoch', 'localtime') k, "
            f"count(distinct chat_jid) from mensaje where {filtro} and ts >= ? group by k",
            (cuenta, alcance, hoy0))}
        # Los totales de los siete rangos (cuatro periodos y tres anteriores) en UNA pasada.
        rangos, columnas, params = [], [], []
        for clave, per in periodos.items():
            rangos.append((clave, "actual"))
            columnas.append("(ts >= ? and ts <= ?)")
            params += [per["desde"] if per["desde"] is not None else -1, per["hasta"]]
            if per["previo"]:
                rangos.append((clave, "previo"))
                columnas.append("(ts >= ? and ts < ?)")
                params += list(per["previo"])
        partes = []
        for cond in columnas:
            partes += [f"count(distinct case when {cond} then chat_jid end)",
                       f"coalesce(sum({cond} and from_me = 0), 0)",
                       f"coalesce(sum({cond} and from_me = 1), 0)"]
        orden = []
        for cond_params in zip(params[0::2], params[1::2]):
            orden += list(cond_params) * 3
        fila = fuente.execute(f"select {', '.join(partes)} from mensaje where {filtro}",
                              (*orden, cuenta, alcance)).fetchone()
        totales = {rango: {"chats": fila[3 * i], "received": fila[3 * i + 1],
                           "sent": fila[3 * i + 2]} for i, rango in enumerate(rangos)}
        # Las rafagas: el primer mensaje de cada tramo del mismo lado en un chat, y la ventana
        # siguiente sobre esos tramos, que alterna, da la salida que contesta cada rafaga.
        rafagas = fuente.execute(
            f"with m as (select chat_jid, ts, from_me, lag(from_me) over "
            f"(partition by chat_jid order by ts, stanza_id) previo from mensaje "
            f"where {filtro}), "
            f"tramo as (select chat_jid, ts, from_me from m where previo is null or "
            f"previo <> from_me), "
            f"sig as (select chat_jid, ts, from_me, lead(ts) over "
            f"(partition by chat_jid order by ts) despues from tramo) "
            f"select ts, despues from sig where from_me = 0",
            (cuenta, alcance)).fetchall()
    except sqlite3.Error:
        return None
    finally:
        fuente.close()
    return {"por_hora": por_hora, "chats_dia": chats_dia, "chats_hora": chats_hora,
            "totales": totales, "rafagas": [(r[0], r[1]) for r in rafagas]}


def primeras_respuestas(cuenta):
    """{case_id: (primer mensaje del cliente, primera salida despues | None)} en epoch, con
    scope.db adjunta en solo lectura al almacen: una busqueda por indice por caso.

    La salida que cuenta es la de ANTES del primer mensaje del caso siguiente del mismo
    chat: la que sale despues contesta a ese otro pedido. Sin el tope, un caso cerrado
    sin respuesta (un "gracias", un sticker) tomaba la respuesta de un caso de horas
    despues y salia como una falla de la meta."""
    try:
        fuente = wa_store.abrir()
    except wa_store.SinFuente:
        return {}
    try:
        fuente.execute("attach database ? as s",
                       (pathlib.Path(DB).resolve().as_uri() + "?mode=ro",))
        return {r[0]: (r[1], r[2]) for r in fuente.execute(
            "with x as (select c.case_id, c.account, c.chat_jid, (select min(m.ts) from "
            "s.caso_mensaje cm join mensaje m on m.account = cm.account and "
            "m.chat_jid = c.chat_jid and m.stanza_id = cm.stanza_id where "
            "cm.case_id = c.case_id and m.from_me = 0 and m.revocado = 0) primero "
            "from s.caso c where c.account = ?), "
            "y as (select x.*, lead(primero) over (partition by chat_jid order by primero, "
            "case_id) siguiente from x where primero is not null) "
            "select y.case_id, y.primero, (select min(o.ts) from mensaje o where "
            "o.account = y.account and o.chat_jid = y.chat_jid and o.from_me = 1 and "
            "o.revocado = 0 and o.ts >= y.primero and (y.siguiente is null or "
            "y.siguiente <= y.primero or o.ts < y.siguiente)) from y", (cuenta,))}
    except sqlite3.Error:
        return {}
    finally:
        fuente.close()


def casos_del_informe(con, cuenta, nombres, meta, ahora, chat_proyecto=None, catalogo=None):
    """Cada caso de la linea con lo que el informe necesita, en epoch.

    El proyecto se resuelve como lo despacha el tick (proyecto_efectivo): el de la ruta
    del caso; si no, ninguno cuando el dueno lo dejo sin proyecto; si no, el unico de su
    chat (`chat_proyecto` solo trae los chats de un proyecto). El nombre es el del catalogo
    aceptado. Solo sin ninguno vale el nombre que anoto el despacho (y su id, si el catalogo
    lo conoce). Asi un mismo proyecto es una sola fila de "Por proyecto"."""
    chat_proyecto = chat_proyecto or {}
    por_id = {p["id"]: p["name"] for p in catalogo or () if p.get("id")}
    por_nombre = {p["name"]: p["id"] for p in catalogo or () if p.get("id") and p.get("name")}
    casos = {r["case_id"]: dict(r) for r in con.execute(
        "select case_id, chat_jid, etapa, titulo, ruta, created_at from caso where account=?",
        (cuenta,))}
    resueltos = {r[0]: r[1] for r in con.execute(
        "select e.case_id, min(e.at) from caso_evento e join caso c on c.case_id = e.case_id "
        "where c.account = ? and e.a in ('respondido', 'cerrado') and "
        "(e.de is null or e.de <> e.a) group by e.case_id", (cuenta,))}
    # La decision del dueno: lo saco de decision con su mano, o lo firmo ahi ('aprobada
    # <ver>'). La firma basta: si la entrega del panel no llega a mover el caso, el tick
    # completa el envio y lo cierra como automatizacion, pero lo decidio el dueno.
    del_dueno = {r[0] for r in con.execute(
        "select distinct e.case_id from caso_evento e join caso c on c.case_id = e.case_id "
        "where c.account = ? and e.de = 'decision' and e.actor = 'dueno' and "
        "(e.a <> 'decision' or e.detalle like 'aprobada %')", (cuenta,))}
    frenados = set()
    for r in con.execute(
            "select e.case_id, e.detalle from caso_evento e join caso c on "
            "c.case_id = e.case_id where c.account = ? and (e.detalle like ? or "
            "e.detalle like ?)", (cuenta, "envio frenado:%", f"{REVISION}%")):
        detalle = r[1] or ""
        if detalle.startswith(REVISION) or any(q == "jev" for q, _ in
                                                motivos_del_freno(detalle)):
            frenados.add(r[0])
    despachos = {}
    for r in con.execute(
            "select d.case_id, d.proyecto, d.resultado from caso_despacho d join caso c on "
            "c.case_id = d.case_id where c.account = ? order by d.id", (cuenta,)):
        despachos[r[0]] = (r[1], r[2])
    respuestas = primeras_respuestas(cuenta)
    salida = []
    for cid, c in casos.items():
        creado = _epoch_local(c["created_at"])
        if creado is None:
            continue
        resuelto = _epoch_local(resueltos.get(cid))
        primero, salio = respuestas.get(cid, (None, None))
        primera = max(0, int(salio - primero)) if salio is not None else None
        if primera is not None:
            sla = "met" if primera <= meta else "missed"
        elif primero is None or c["etapa"] == "cerrado":
            sla = None
        else:
            sla = "missed" if ahora - primero > meta else "pending"
        try:
            ruta = json.loads(c["ruta"]) if c["ruta"] else {}
        except ValueError:
            ruta = {}
        proyecto, resultado = despachos.get(cid, (None, None))
        ruta = ruta if isinstance(ruta, dict) else {}
        pid = ruta.get("workspace") or (None if ruta.get("por_dueno")
                                        else chat_proyecto.get(c["chat_jid"]))
        if pid:
            pnombre = (por_id.get(pid) or (ruta.get("workspace") == pid
                                           and ruta.get("workspace_name")) or proyecto or pid)
        else:
            pid, pnombre = por_nombre.get(proyecto), proyecto or None
        salida.append({
            "case_id": cid, "chat": nombres.get(c["chat_jid"]) or c["chat_jid"],
            "title": c["titulo"] or nombres.get(c["chat_jid"]) or c["chat_jid"],
            "stage": c["etapa"], "creado": creado, "resuelto": resuelto,
            "resolucion": max(0, int(resuelto - creado)) if resuelto is not None else None,
            "primera": primera, "sla": sla, "project_id": pid, "project": pnombre,
            "resultado": resultado, "jev": cid in frenados,
            "dueno": cid in del_dueno or c["etapa"] == "decision"})
    salida.sort(key=lambda x: (x["creado"], x["case_id"]), reverse=True)
    return salida


def _claves_de(per, ahora, primera_fecha):
    """Las cubetas de las barras de un periodo, en orden."""
    if per["cubeta"] == "hour":
        dia = per["fechas"][0]
        return [f"{dia} {h:02d}" for h in range(time.localtime(ahora).tm_hour + 1)]
    if per["cubeta"] == "day":
        return list(per["fechas"])
    actual = datetime.date.fromisoformat(_lunes(_dia(ahora)))
    desde = datetime.date.fromisoformat(_lunes(primera_fecha or _dia(ahora)))
    semanas = []
    while actual >= desde and len(semanas) < TOPE_SEMANAS_INFORME:
        semanas.append(actual.isoformat())
        actual -= datetime.timedelta(days=7)
    return semanas[::-1]


def _tiempo(actuales, previos, claves, cubeta):
    """{value, n, prev, prev_n, delta_pct, bars}: actuales y previos son [(epoch, segundos)];
    previos None = el periodo no tiene anterior."""
    valor = _mediana([v for _, v in actuales])
    previo = _mediana([v for _, v in previos]) if previos is not None else None
    por_cubeta = {}
    for t, v in actuales:
        por_cubeta.setdefault(_cubeta(t, cubeta), []).append(v)
    return {"value": valor, "n": len(actuales), "prev": previo,
            "prev_n": len(previos) if previos is not None else None,
            "delta_pct": _delta_pct(valor, previo),
            "bars": [{"k": k, "value": _mediana(por_cubeta.get(k, [])),
                      "n": len(por_cubeta.get(k, []))} for k in claves]}


def _fila_vacia():
    return [0] * 24


def _mapa(cuentas_hora, per):
    """Mapa de calor desde {"YYYY-MM-DD HH": n}: una fila por fecha (hoy, 7 dias) o por dia
    de la semana, 1 = lunes (30 dias, todo)."""
    if per["filas"] == "date":
        filas = {f: _fila_vacia() for f in per["fechas"]}
    else:
        filas = {d: _fila_vacia() for d in range(1, 8)}
    desde = per["fechas"][0] if per["fechas"] else None
    for clave, n in cuentas_hora.items():
        fecha, hora = clave[:10], int(clave[11:13])
        if desde is not None and fecha < desde:
            continue
        if per["filas"] == "date":
            if fecha in filas:
                filas[fecha][hora] += n
        else:
            filas[datetime.date.fromisoformat(fecha).isoweekday()][hora] += n
    return [{"k": k, "h": h} for k, h in filas.items()]


def build_reports(con, ahora=None):
    """Los numeros de la pestana Informes para los cuatro periodos, con la forma del
    contrato `reports` (v 1, documentado en odd/tasks/informes-tablero.md)."""
    ahora = time.time() if ahora is None else ahora
    cuenta = cuenta_activa()
    ajustes = merged_settings(con)
    try:
        meta_min = int(ajustes.get("sla_first_reply_minutes")
                       or DEFAULT_CONFIG["sla_first_reply_minutes"])
    except (TypeError, ValueError):
        meta_min = int(DEFAULT_CONFIG["sla_first_reply_minutes"])
    meta = meta_min * 60
    alcance = merged_scope(con)
    nombres = {jid: r.get("chat_name") for jid, r in alcance.items()}
    chats = [jid for jid, r in alcance.items() if (r.get("mode") or "off") != "off"]
    periodos = periodos_del_informe(ahora)
    msj = informe_mensajes(cuenta, chats, periodos) or {
        "por_hora": {}, "chats_dia": {}, "chats_hora": {}, "totales": {}, "rafagas": []}
    catalogo = proyectos_del_dueno(con)
    unicos = {jid: proyecto_unico_del_chat(r, proyectos_del_chat(r, catalogo)[0])
              for jid, r in alcance.items()}
    casos = casos_del_informe(
        con, cuenta, nombres, meta, ahora,
        chat_proyecto={jid: pid for jid, pid in unicos.items() if pid}, catalogo=catalogo)

    etapas = dict.fromkeys(ETAPAS_CASO, 0)
    for r in con.execute("select etapa, count(*) from caso where account=? group by etapa",
                         (cuenta,)):
        if r[0] in etapas:
            etapas[r[0]] = r[1]
    espera_cliente = con.execute(
        "select count(distinct c.case_id) from caso c join caso_despacho d on "
        "d.case_id = c.case_id where c.account=? and c.etapa in ('respondido','trabajo') and "
        "d.id = (select max(id) from caso_despacho where case_id = c.case_id) and "
        "(d.estado='esperando' or (d.estado in ('lanzando','activo') and "
        "d.resultado='necesita'))", (cuenta,)).fetchone()[0]
    vivo = {"open": sum(n for e, n in etapas.items() if e not in ETAPAS_RESUELTAS),
            "decision": etapas["decision"], "waiting_customer": espera_cliente,
            "blocked": etapas["bloqueado"], "conversations": len(chats)}

    momentos = ([c["creado"] for c in casos]
                + [c["resuelto"] for c in casos if c["resuelto"] is not None])
    primera_fecha = min([_dia(t) for t in momentos] + list(msj["chats_dia"]), default=None)
    resueltos_hora = {}
    for c in casos:
        if c["resuelto"] is not None:
            k = _hora(c["resuelto"])
            resueltos_hora[k] = resueltos_hora.get(k, 0) + 1
    recibidos_hora = {k: v[0] for k, v in msj["por_hora"].items()}
    # Recibidos y enviados por dia, una vez: las barras de dia y de semana los suman.
    por_dia = {}
    for k, (recibidos, enviados) in msj["por_hora"].items():
        r_s = por_dia.setdefault(k[:10], [0, 0])
        r_s[0] += recibidos
        r_s[1] += enviados

    salida = {}
    for clave, per in periodos.items():
        desde, hasta, previo = per["desde"], per["hasta"], per["previo"]
        claves = _claves_de(per, ahora, primera_fecha)

        def del_periodo(pares, actual=True):
            if actual:
                return [(t, v) for t, v in pares if _en(t, desde, hasta)]
            if previo is None:
                return None
            return [(t, v) for t, v in pares if _en(t, previo[0], previo[1], False)]

        primeras = [(c["creado"], c["primera"]) for c in casos if c["primera"] is not None]
        resoluciones = [(c["resuelto"], c["resolucion"]) for c in casos
                        if c["resuelto"] is not None]
        esperas = [(t, int(d - t)) for t, d in msj["rafagas"] if d is not None]
        sin_respuesta = sum(1 for t, d in msj["rafagas"] if d is None and _en(t, desde, hasta))

        def totales_de(cual, lo, hi, cerrado):
            base = msj["totales"].get((clave, cual)) or {"chats": 0, "received": 0, "sent": 0}
            return dict(base,
                        created=sum(1 for c in casos if _en(c["creado"], lo, hi, cerrado)),
                        resolved=sum(1 for c in casos if _en(c["resuelto"], lo, hi, cerrado)))
        totales = totales_de("actual", desde, hasta, True)
        previos = totales_de("previo", previo[0], previo[1], False) if previo else None
        creados, cerrados = {}, {}
        for c in casos:
            if _en(c["creado"], desde, hasta):
                k = _cubeta(c["creado"], per["cubeta"])
                creados[k] = creados.get(k, 0) + 1
            if _en(c["resuelto"], desde, hasta):
                k = _cubeta(c["resuelto"], per["cubeta"])
                cerrados[k] = cerrados.get(k, 0) + 1
        barras = []
        for k in claves:
            if per["cubeta"] == "hour":
                r_s = msj["por_hora"].get(k, (0, 0))
                n_chats = msj["chats_hora"].get(k, 0)
            else:
                dias = ([k] if per["cubeta"] == "day" else
                        [(datetime.date.fromisoformat(k) + datetime.timedelta(days=i)).isoformat()
                         for i in range(7)])
                r_s = (sum(por_dia.get(d, (0, 0))[0] for d in dias),
                       sum(por_dia.get(d, (0, 0))[1] for d in dias))
                n_chats = len(set().union(*(msj["chats_dia"].get(d, set()) for d in dias)))
            barras.append({"k": k, "chats": n_chats, "received": r_s[0], "sent": r_s[1],
                           "created": creados.get(k, 0), "resolved": cerrados.get(k, 0)})

        def sla_de(lo, hi, cerrado):
            del_rango = [c for c in casos if _en(c["creado"], lo, hi, cerrado)]
            cumple = sum(1 for c in del_rango if c["sla"] == "met")
            falla = [c for c in del_rango if c["sla"] == "missed"]
            pendiente = sum(1 for c in del_rango if c["sla"] == "pending")
            tasa = (round(cumple * 100 / (cumple + len(falla)), 1)
                    if cumple + len(falla) else None)
            return cumple, falla, pendiente, tasa
        cumple, fallas, pendientes, tasa = sla_de(desde, hasta, True)
        tasa_previa = sla_de(previo[0], previo[1], False)[3] if previo else None

        grupos = {}
        for c in casos:
            if not _en(c["creado"], desde, hasta):
                continue
            llave = ("id", c["project_id"]) if c["project_id"] else ("nombre", c["project"])
            g = grupos.setdefault(llave, {
                "id": c["project_id"], "name": c["project"], "cases": 0, "resuelto": 0,
                "necesita": 0, "bloqueado": 0, "jev_held": 0, "owner_decision": 0})
            g["cases"] += 1
            if c["resultado"] in ("resuelto", "necesita", "bloqueado"):
                g[c["resultado"]] += 1
            g["jev_held"] += c["jev"]
            g["owner_decision"] += c["dueno"]
        proyectos = sorted(grupos.values(),
                           key=lambda g: (g["name"] is None and g["id"] is None, -g["cases"],
                                          str(g["name"] or "")))

        salida[clave] = {
            "from": _iso_epoch(desde), "to": _iso_epoch(hasta),
            "prev_from": _iso_epoch(previo[0]) if previo else None,
            "prev_to": _iso_epoch(previo[1]) if previo else None,
            "bucket": per["cubeta"], "rows": per["filas"],
            "first_response": _tiempo(del_periodo(primeras), del_periodo(primeras, False),
                                      claves, per["cubeta"]),
            "resolution": _tiempo(del_periodo(resoluciones), del_periodo(resoluciones, False),
                                  claves, per["cubeta"]),
            "customer_wait": dict(_tiempo(del_periodo(esperas), del_periodo(esperas, False),
                                          claves, per["cubeta"]), unanswered=sin_respuesta),
            "volume": {"totals": totales, "prev": previos,
                       "delta_pct": ({k: _delta_pct(totales[k], previos[k])
                                      for k in CLAVES_VOLUMEN} if previos else None),
                       "bars": barras},
            "traffic": {"received": _mapa(recibidos_hora, per),
                        "resolved": _mapa(resueltos_hora, per)},
            "sla": {"met": cumple, "missed": len(fallas), "pending": pendientes, "rate": tasa,
                    "prev_rate": tasa_previa,
                    "delta_pts": (round(tasa - tasa_previa, 1)
                                  if tasa is not None and tasa_previa is not None else None),
                    "misses": [{"case_id": c["case_id"], "title": c["title"], "chat": c["chat"],
                                "first_response_s": c["primera"], "project": c["project"]}
                               for c in fallas[:TOPE_FALLAS_SLA]],
                    "misses_more": max(0, len(fallas) - TOPE_FALLAS_SLA)},
            "projects": proyectos[:TOPE_PROYECTOS_INFORME],
        }
    # `account`: la linea del informe. Tras vincular otro numero, el panel no pinta el
    # informe de la linea anterior como si fuera de esta (como las tarjetas del tablero).
    # Las filas de `cases` no llevan titulo: sale del texto del cliente, el panel no lo
    # usa, y viajaria por casos que el tablero ya no muestra.
    return {"v": 1, "account": cuenta, "updated_at": _iso_epoch(ahora),
            "sla_minutes": meta_min, "live": vivo, "periods": salida,
            "cases": [{"case_id": c["case_id"], "chat": c["chat"],
                       "created": _iso_epoch(c["creado"]), "first_response_s": c["primera"],
                       "resolution_s": c["resolucion"], "stage": c["stage"],
                       "project": c["project"], "sla": c["sla"]}
                      for c in casos[:TOPE_CASOS_INFORME]],
            "cases_more": max(0, len(casos) - TOPE_CASOS_INFORME)}


def cmd_sync(con, a):
    """Deja el tablero y el panel al dia. La entrada corre primero —es local y barata— y
    una falla suya no puede dejar sin sync al panel: se dice y se sigue."""
    try:
        cmd_ingest(con, a)
    except (sqlite3.Error, OSError) as exc:
        print(f"wa-scope: ingest skipped: {exc}", file=sys.stderr)
    except SystemExit as exc:
        print(f"wa-scope: ingest skipped: {exc}", file=sys.stderr)
    return [{"synced": push_to_plugin(con, with_activity=True),
             "destinos": plugin_store_targets()}]


def cmd_record(con, a):
    con.execute("insert into agent_action (ts,chat_jid,chat_name,stanza_id,action,"
                "plane_issue,detail,account) values (?,?,?,?,?,?,?,?)",
                (time.strftime("%Y-%m-%d %H:%M"), a.chat, a.name, a.stanza,
                 a.action, a.issue, a.detail, cuenta_activa()))
    con.commit()
    return [{"ok": True}]


# ── El tick: la automatizacion solo-comando (kanban-casos, T7) ──────────────────────
# Orca corre `wa-scope tick` cada minuto con el runner del precheck: sin agente, sin
# terminal, sin modelo. Hace lo que no necesita lenguaje: la entrada de respaldo, la
# aprobacion por regla de lo que no es excepcion, el envio por la unica puerta de salida
# (`wa-send`, con Jev y el piso fijo) y el tablero al dia. Lo que necesita lenguaje lo
# marca `pending --needs-agent`, que es el precheck de la automatizacion del agente.

# El candado del tick es un archivo con flock y no una fila de `run_lock`: esa tabla es
# la del agente y el panel la pinta como "corriendo"; un tick cada minuto la tendria
# encendida sin que haya agente. Y un flock se suelta solo si el proceso muere.
CANDADO_TICK = "tick.lock"
# Cuanto espera `wa-send` el veredicto de cada envio (el mismo plazo que el tablero en
# acciones.mjs), y cuanto puede gastar el tick enviando: Orca corta el comando a los
# 300 s por defecto. Lo que no entra queda para el minuto siguiente, con el mismo id.
PLAZO_ENVIO_TICK_S = 25
PRESUPUESTO_TICK_S = 180
# Las etapas cuya propuesta `responder` el tick puede mandar: la decision y el resultado
# de un trabajo (`listo`). Las dos son aprobables (ETAPAS_APROBABLES).
ETAPAS_TICK = ("decision", "listo")
# Los motivos de `wa-send` (bin/wa-send) que el tick distingue. Son codigos estables.
ENVIO_FRENADO = "send-needs-approval"
ENVIO_SIN_LINEA = "send-no-transport"
# Lo que no se arregla reintentando: WhatsApp lo rechazo, o el mismo id ya nombra otro
# texto (cambio la firma entre el borrador y ahora). La tarjeta va a bloqueado con el
# motivo y la ve el dueno.
ENVIO_BLOQUEA = ("send-rejected", "send-id-conflict")
CONTEOS_TICK = ("enviados", "excepciones", "frenados", "esperando", "bloqueados",
                "errores", "pospuestos", "limpiados", "limpieza_error", "automaticas",
                "revisiones", "transcritos", "rancias", "despachados",
                "bloqueados_por_despacho", "respuestas_al_proyecto", "agente_lanzado",
                "agente_error", "trabajos_sin_clic", "limpieza_atascados", "avisos",
                "avisos_error", "preguntas_al_dueno")

# La limpieza de los espacios que dejan las corridas del plugin. Orca fuerza `new_per_run`
# en las automatizaciones de un plugin: cada corrida crea un hijo `::workspace:<uuid>` de
# la carpeta del plugin, con una terminal de shell adentro, y nunca lo cierra. La fuente es
# `worktree list` y no las corridas: los hijos de una automatizacion que Orca borro y
# recreo (ids nuevos al reactivar el plugin) ya no estan en ninguna lista de corridas. Mira
# a lo mas cada LIMPIEZA_CADA_S (LIMPIEZA_SIGUE_S si quedaron pendientes), solo lo que paso
# LIMPIEZA_GRACIA_S sin actividad, y no mas de LIMPIEZA_TOPE por vuelta. Visto en vivo:
# `worktree rm` contesto `removed: true` y el espacio seguia en la lista, con su terminal
# viva. Por eso cierra primero las terminales y despues vuelve a listar: lo que sigue ahi
# cuenta un intento, y a los LIMPIEZA_INTENTOS se dice (resumen y tablero) sin dejar de
# intentarlo, al final de la cola. `worktree rm` sobre un espacio de carpeta borra el
# registro y sus terminales, nunca los archivos; la raiz de la carpeta no tiene
# `::workspace:` y no se toca nunca.
PLUGIN_KEY = "ab2web.orca-wa-inbox"
AUTOMATIZACION_TRIAGE = "triage"
LIMPIEZA_CADA_S = 300
LIMPIEZA_SIGUE_S = 60
LIMPIEZA_GRACIA_S = 120
LIMPIEZA_TOPE = 10
LIMPIEZA_PLAZO_S = 15
LIMPIEZA_PRESUPUESTO_S = 60
LIMPIEZA_INTENTOS = 3
ESTADOS_EN_CURSO = ("pending", "dispatching", "dispatched")
MARCA_ESPACIO = "::workspace:"


def automatizacion_del_plugin(automatizaciones, cual):
    """La automatizacion `cual` de ESTE plugin (por su origen, nunca por el nombre), o
    None."""
    return next((a for a in automatizaciones if isinstance(a, dict)
                 and isinstance(a.get("pluginOrigin"), dict)
                 and a["pluginOrigin"].get("pluginKey") == PLUGIN_KEY
                 and a["pluginOrigin"].get("automationId") == cual
                 and isinstance(a.get("id"), str) and a.get("id")), None)


def id_triage(automatizaciones):
    """La automatizacion `triage` de ESTE plugin, o None."""
    return automatizacion_del_plugin(automatizaciones, AUTOMATIZACION_TRIAGE)


def carpeta_del_plugin(automatizaciones):
    """La ruta (comparable) donde corren las automatizaciones de este plugin, la de su
    `runContext`, o None. Es la misma para todas: `plugin-workspaces/<plugin>`."""
    for cual in (AUTOMATIZACION_TRIAGE, "tick"):
        contexto = (automatizacion_del_plugin(automatizaciones, cual) or {}).get("runContext")
        ruta = ruta_comparable(contexto.get("path")) if isinstance(contexto, dict) else None
        if ruta:
            return ruta
    return None


def orca_json(cli, args):
    """Una llamada a la CLI de Orca con `--json`: el sobre {ok, ...} o None si no hay CLI,
    se acabo el plazo o no devolvio JSON. Nunca imprime lo que contesto."""
    try:
        p = subprocess.run([cli, *args, "--json"], capture_output=True, text=True,
                           timeout=LIMPIEZA_PLAZO_S, env=orca_env())
        sobre = json.loads(p.stdout or "null")
    except (OSError, subprocess.SubprocessError, ValueError):
        return None
    return sobre if isinstance(sobre, dict) else None


def lista_de_orca(cli, args, clave):
    """La lista `clave` del resultado de Orca, o None si no contesto `ok` o llego cortada:
    con una lista incompleta no se sabe que hay en vuelo."""
    sobre = orca_json(cli, args)
    res = (sobre or {}).get("result")
    res = res if isinstance(res, dict) else {}
    lista = res.get(clave)
    if not sobre or sobre.get("ok") is not True or not isinstance(lista, list) \
            or res.get("truncated"):
        return None
    return [x for x in lista if isinstance(x, dict)]


def marca_s(valor):
    """Un sello de Orca (ms desde la epoca) en segundos, o None."""
    if isinstance(valor, bool) or not isinstance(valor, (int, float)) or valor < 1e12:
        return None
    return valor / 1000


def sin_id(selector):
    texto = str(selector or "")
    return texto[3:] if texto.startswith("id:") else texto


def en_vuelo_del_plugin(con):
    """(espacios, terminales) del agente de casos y de los despachos en vuelo: la limpieza
    no los toca nunca, esten donde esten."""
    filas = con.execute("select workspace_selector, terminal from agente_corrida where estado "
                        "in (?, ?)", AGENTE_EN_VUELO).fetchall()
    filas += con.execute(f"select workspace_selector, terminal from caso_despacho where estado "
                         f"in ({','.join('?' * len(DESPACHO_EN_VUELO))})",
                         DESPACHO_EN_VUELO).fetchall()
    return ({sin_id(r["workspace_selector"]) for r in filas if r["workspace_selector"]},
            {r["terminal"] for r in filas if r["terminal"]})


def intentos_de_limpieza(con):
    """{espacio: intentos fallidos} de lo que se quiso quitar y seguia en la lista."""
    fila = con.execute("select value from settings where key='limpieza_intentos'").fetchone()
    try:
        valor = json.loads(fila["value"]) if fila else {}
    except (TypeError, ValueError):
        valor = {}
    return {k: v for k, v in valor.items() if isinstance(k, str) and isinstance(v, int)} \
        if isinstance(valor, dict) else {}


def espacios_atascados(con):
    """Cuantos espacios del plugin no se pudieron quitar tras LIMPIEZA_INTENTOS."""
    return sum(1 for v in intentos_de_limpieza(con).values() if v >= LIMPIEZA_INTENTOS)


def guarda_ajuste(con, llave, valor):
    con.execute("insert into settings (key,value) values (?,?) on conflict(key) "
                "do update set value=excluded.value", (llave, valor))
    con.commit()


def espacios_a_limpiar(con, espacios, terminales, carpeta, en_curso, ahora):
    """[(id, terminales)] de los hijos de la carpeta del plugin que se pueden quitar: con
    `::workspace:` (la raiz no), quietos desde hace LIMPIEZA_GRACIA_S (un sello que no se
    lee es no saber, y no se toca), fuera de una corrida en vuelo y sin el agente de casos
    ni un despacho en vuelo adentro. Primero lo que menos se intento."""
    por_espacio = {}
    for t in terminales:
        por_espacio.setdefault(t.get("worktreeId"), []).append(t)
    vuelo_espacios, vuelo_terminales = en_vuelo_del_plugin(con)
    intentos = intentos_de_limpieza(con)
    hallados = []
    for w in espacios:
        ident = w.get("id")
        if not isinstance(ident, str) or MARCA_ESPACIO not in ident \
                or ruta_comparable(w.get("path")) != carpeta:
            continue
        suyas = por_espacio.get(ident, [])
        if ident in en_curso or ident in vuelo_espacios \
                or any(t.get("handle") in vuelo_terminales for t in suyas):
            continue
        marcas = [m for m in [marca_s(w.get(k)) for k in ("createdAt", "sortOrder",
                                                          "lastActivityAt")]
                  + [marca_s(t.get("lastOutputAt")) for t in suyas] if m]
        if not marcas or ahora - max(marcas) < LIMPIEZA_GRACIA_S:
            continue
        hallados.append((ident, suyas))
    return sorted(hallados, key=lambda h: intentos.get(h[0], 0))


def tick_limpia(con, resumen):
    """Quita de la barra lateral los espacios que dejan las corridas del plugin, y dice en
    `limpieza_atascados` cuantos no se pudieron quitar. Sin CLI o con un error el tick sigue
    y lo cuenta en `limpieza_error`."""
    try:
        limpia_espacios(con, resumen)
    finally:
        resumen["limpieza_atascados"] = espacios_atascados(con)


# Los titulos de las terminales de los agentes del plugin: el que les pone el plugin al
# abrirlas, o el que Claude les pone por el brief (`despachos/caso-<caso>-<fila>.md`,
# `despachos/agente-casos-<fila>.md`). Delante va el icono de estado de Claude. Claude a
# veces deja solo el nombre del brief ("caso-20-10"): ese cuenta solo si es todo el titulo,
# para no tomar una terminal del dueno que nombra un caso. Y lo escribe a su manera:
# "Caso-33-15" o "Caso 39-18" (visto en vivo, 2026-10-06), asi que da igual la mayuscula y
# si va guion o espacio despues de "caso".
TITULO_DE_AGENTE = re.compile(
    r"(?:Despacho caso-(?P<caso>\d+)-(?P<despacho>\d+)|Despacho agente-casos-(?P<corrida>\d+)"
    r"|^\W*caso[-\s](?P<caso_solo>\d+)-(?P<despacho_solo>\d+)"
    r"|^\W*agente-casos-(?P<corrida_sola>\d+)"
    r"|WhatsApp case #(?P<del_caso>\d+)|(?P<agente>WhatsApp: case agent))\s*$", re.IGNORECASE)


def cierra_huerfanas(con, cli, resumen):
    """Cierra las terminales de agentes del plugin que no son de nada en curso. Al reiniciar
    Orca las pestanas vuelven con handles nuevos y el plugin, que las seguia por el handle,
    las perdia: quedaban abiertas, y Orca hasta volvia a abrir Claude en ellas. Se reconocen
    por el titulo; una de un despacho o de una corrida en curso no se toca aunque su handle
    haya cambiado, y ninguna otra terminal del dueno tampoco. Nunca detiene un espacio."""
    terminales = lista_de_orca(cli, ["terminal", "list", "--limit", "1000"], "terminals")
    if terminales is None:
        return
    despachos = [dict(r) for r in con.execute(
        f"select id, case_id, terminal from caso_despacho where estado in "
        f"({','.join('?' * len(DESPACHO_EN_VUELO))})", DESPACHO_EN_VUELO)]
    corridas = [dict(r) for r in con.execute(
        f"select id, terminal from agente_corrida where estado in "
        f"({','.join('?' * len(AGENTE_EN_VUELO))})", AGENTE_EN_VUELO)]
    en_curso = {x["terminal"] for x in despachos + corridas if x["terminal"]}
    for t in terminales:
        handle, m = t.get("handle"), TITULO_DE_AGENTE.search(str(t.get("title") or ""))
        if not m or not isinstance(handle, str) or not handle or handle in en_curso:
            continue
        despacho = m["despacho"] or m["despacho_solo"]
        if despacho and any(d["id"] == int(despacho) for d in despachos):
            continue
        if m["del_caso"] and any(d["case_id"] == int(m["del_caso"]) for d in despachos):
            continue
        if (m["corrida"] or m["corrida_sola"] or m["agente"]) and corridas:
            continue
        cierra_terminal(cli, handle)
        resumen["limpiados"] += 1


def limpia_espacios(con, resumen):
    ahora = time.time()
    fila = con.execute("select value from settings where key='limpieza_at'").fetchone()
    try:
        if fila and ahora - float(fila["value"]) < LIMPIEZA_CADA_S:
            return
    except (TypeError, ValueError):
        pass
    guarda_ajuste(con, "limpieza_at", str(ahora))
    # La marca de antes daba por quitado lo que `rm` dijo quitar: no vale como intento.
    con.execute("delete from settings where key='limpieza_hecha'")
    con.commit()
    cli = orca_cli_path()
    if not cli:
        resumen["limpieza_error"] += 1
        return
    cierra_huerfanas(con, cli, resumen)
    automatizaciones = lista_de_orca(cli, ["automations", "list"], "automations")
    if automatizaciones is None:
        resumen["limpieza_error"] += 1
        return
    carpeta = carpeta_del_plugin(automatizaciones)
    if not carpeta:
        return
    en_curso = set()
    triage = (id_triage(automatizaciones) or {}).get("id")
    if triage:
        corridas = lista_de_orca(cli, ["automations", "runs", "--id", triage], "runs")
        if corridas is None:
            resumen["limpieza_error"] += 1
            return
        en_curso = {c.get("workspaceId") for c in corridas if c.get("status") in ESTADOS_EN_CURSO}
    espacios = lista_de_orca(cli, ["worktree", "list", "--limit", "1000"], "worktrees")
    terminales = lista_de_orca(cli, ["terminal", "list", "--limit", "1000"], "terminals") \
        if espacios is not None else None
    if espacios is None or terminales is None:
        resumen["limpieza_error"] += 1
        return
    candidatos = espacios_a_limpiar(con, espacios, terminales, carpeta, en_curso, ahora)
    intentos = intentos_de_limpieza(con)
    tocados = []
    for ident, suyas in candidatos:
        if len(tocados) >= LIMPIEZA_TOPE or time.time() - ahora > LIMPIEZA_PRESUPUESTO_S:
            break
        tocados.append(ident)
        # Primero sus terminales: con una viva adentro, `rm` dijo que si y el espacio quedo.
        for t in suyas:
            if isinstance(t.get("handle"), str) and t["handle"]:
                orca_json(cli, ["terminal", "close", "--terminal", t["handle"]])
        orca_json(cli, ["worktree", "rm", "--worktree", f"id:{ident}"])
    quedan = None
    if tocados:
        despues = lista_de_orca(cli, ["worktree", "list", "--limit", "1000"], "worktrees")
        if despues is None:
            resumen["limpieza_error"] += 1
        else:
            quedan = {w.get("id") for w in despues}
    for ident in tocados if quedan is not None else []:
        if ident in quedan:
            intentos[ident] = intentos.get(ident, 0) + 1
            resumen["limpieza_error"] += 1
        else:
            intentos.pop(ident, None)
            resumen["limpiados"] += 1
    # Solo lo que sigue en la lista: lo que ya no esta no se cuenta, y esto no crece.
    vigentes = {w.get("id") for w in espacios} if quedan is None else quedan
    guarda_ajuste(con, "limpieza_intentos", json.dumps(
        {k: v for k, v in intentos.items() if k in vigentes}, sort_keys=True))
    # Con pendientes que todavia no se intentaron, la vuelta siguiente es al minuto.
    if any(i not in tocados and intentos.get(i, 0) < LIMPIEZA_INTENTOS for i, _ in candidatos):
        guarda_ajuste(con, "limpieza_at", str(ahora - LIMPIEZA_CADA_S + LIMPIEZA_SIGUE_S))


def tick_toma():
    """El candado del tick, o None si otro tick lo tiene. No espera: un tick que llega
    mientras otro envia no tiene nada que hacer que el otro no este haciendo.

    Con varias lineas el candado es de cada una: la principal conserva el de siempre y
    otra linea tiene el suyo, asi un tick ocupado (o colgado) en una no frena a otra."""
    nombre = (CANDADO_TICK if es_linea_principal()
              else f"tick-{re.sub(r'[^A-Za-z0-9]', '-', cuenta_activa())}.lock")
    ruta = os.path.join(os.path.dirname(DB), nombre)
    os.makedirs(os.path.dirname(ruta), exist_ok=True)
    fh = open(ruta, "a+")
    try:
        if sys.platform == "win32":
            import msvcrt
            fh.seek(0)
            msvcrt.locking(fh.fileno(), msvcrt.LK_NBLCK, 1)
        else:
            import fcntl
            fcntl.flock(fh.fileno(), fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        fh.close()
        return None
    return fh


def id_envio_caso(case_id, version):
    """El id de la peticion a `wa-send` para esta version del caso. Es EL MISMO que arma
    el tablero (acciones.mjs, `entregar`): el tick, un reintento y el clic del dueno
    sobre la misma version nombran la misma peticion, y `wa-send` la entrega una vez."""
    return f"caso-{case_id}-{str(version)[:12]}"


def envios_del_almacen(req_ids):
    """{req_id: estado} de la bandeja de salida, en solo lectura, y si el sidecar late.
    Sin almacen no hay ni lo uno ni lo otro."""
    ruta = wa_store.store_db_path()
    if not os.path.exists(ruta):
        return {}, False
    try:
        fuente = sqlite3.connect(f"file:{ruta}?mode=ro", uri=True, timeout=10)
    except sqlite3.Error:
        return {}, False
    try:
        vivo = wa_store.sidecar_vivo(fuente)
        estados = {}
        ids = list(req_ids)
        for i in range(0, len(ids), 500):
            parte = ids[i:i + 500]
            estados.update(fuente.execute(
                f"select req_id, estado from envio where req_id in "
                f"({','.join('?' * len(parte))})", parte).fetchall())
        return estados, vivo
    except sqlite3.Error:
        return {}, False
    finally:
        fuente.close()


def candidatos_tick(con):
    """Los casos abiertos de la linea activa cuya propuesta vigente es una respuesta, en
    un chat `responder`: lo unico que el tick puede mandar solo. Del mas viejo al mas
    nuevo, para que nadie espere detras de lo que llego despues."""
    scope = merged_scope(con)
    marcas = ",".join("?" * len(ETAPAS_TICK))
    salida = []
    for row in con.execute(
            f"select * from caso where account=? and etapa in ({marcas}) and propuesta is "
            f"not null and propuesta_version is not null order by updated_at, case_id",
            (cuenta_activa(), *ETAPAS_TICK)):
        caso = dict(row)
        try:
            propuesta = json.loads(caso["propuesta"])
        except (TypeError, ValueError):
            continue
        if propuesta.get("tipo") != "responder" or not propuesta.get("respuesta"):
            continue
        if (scope.get(caso["chat_jid"]) or {}).get("mode") != "responder":
            continue
        salida.append((caso, propuesta["respuesta"]))
    return salida


def tick_cierra(con, case_id, hacia, detalle, firma=True):
    """Mueve el caso en su propia transaccion, releyendolo con la base tomada: entre la
    lectura y aca pudo moverlo el dueno. `firma=False` registra un envio que ya salio con
    la aprobacion del dueno en `wa-send --approve` (fuera del tablero): el mensaje esta
    en la linea, y negarse a anotarlo dejaria la tarjeta mintiendo."""
    caso_toma(con)
    try:
        caso = caso_de(con, case_id)
        if caso["etapa"] not in ETAPAS_TICK:
            con.rollback()
            return False
        if firma:
            caso_valida(caso, hacia, detalle)
        caso_mover(con, caso, hacia, "automatizacion", detalle)
        con.commit()
        return True
    except BaseException:
        con.rollback()
        raise


def tick_frena(con, case_id, detalle):
    """`wa-send` dejo el texto como borrador (Jev o el piso fijo lo frenaron). El caso
    sigue en su etapa SIN la firma de la regla: la que cuenta ahora es la del dueno."""
    caso_toma(con)
    try:
        caso = caso_de(con, case_id)
        caso_tocar(con, caso, "automatizacion", detalle, propuesta_aprobada=None)
        con.commit()
    except BaseException:
        con.rollback()
        raise


def tick_envia(caso, texto, req):
    """`wa-send --send` con el id del caso: (codigo, detalle). `None` es enviado. Nunca
    devuelve el texto del mensaje: lo que se lee de stderr es el codigo y su detalle."""
    args = [WA_SEND, f"--id={req}"]
    if caso.get("account"):
        args.append(f"--line={caso['account']}")
    args += ["--send", f"--timeout={PLAZO_ENVIO_TICK_S}", "--json", "--", caso["chat_jid"],
             texto]
    try:
        p = subprocess.run(args, capture_output=True, text=True,
                           timeout=PLAZO_ENVIO_TICK_S + 30)
    except (OSError, subprocess.SubprocessError) as exc:
        return "fallo", str(exc)[:200]
    if p.returncode == 0:
        return None, ""
    lineas = [l.strip() for l in (p.stderr or "").splitlines() if l.strip()]
    primera = lineas[0] if lineas else ""
    if primera.startswith("wa-send: "):
        return primera[len("wa-send: "):].split()[0], " ".join(lineas[1:])[:600]
    if "no agent name is configured" in primera:
        return "send-no-signature", primera[:200]
    return "fallo", primera[:200]


# ── La aprobacion por WhatsApp (T14) ─────────────────────────────────────────────────────
# Cuando un caso espera al dueno, el tick le escribe un aviso corto al numero de aprobacion
# que el usuario eligio en ajustes (`numero_aprobacion`, uno de sus numeros de confianza), y
# el dueno contesta en ese mismo directo: `si N` aprueba la version avisada, `no N` cierra el
# caso y `N <texto>` se lo devuelve al agente con su correccion. Sin numero elegido no se
# escribe nada y todo sigue como antes: el tablero es la via de siempre.
#
# Todo sale por `wa-send`, con un id por aviso (`aviso-...`): un reintento no entrega dos
# veces. Por eso el directo tiene que estar autorizado en `responder`, como cualquier chat al
# que el plugin le escribe; el panel lo dice al lado del numero. Nunca viaja una credencial:
# si el caso trae una, el aviso dice que la hay y que se aprueba en el tablero.
# Lo que `wa-send` contesta y se arregla solo: el minuto siguiente lo intenta con el mismo id.
AVISO_REINTENTA = (ENVIO_SIN_LINEA, "send-no-signature", "send-timeout", "fallo")
# El chat del numero de aprobacion sin autorizar (o autorizado para otra linea): lo
# arregla el dueno en el panel, asi que el aviso espera en vez de perderse.
AVISO_ESPERA_PERMISO = ("send-denied", "send-line-not-linked")
# Lo que la regla deja cuando no firma una respuesta (E_EXCEPTION): el gemelo de
# ESPERA_DUENO para lo que sale al chat. Una vez por version.
RESPUESTA_ESPERA = "respuesta espera al dueno:"
AVISO_ENVIADO = "aviso por WhatsApp"
AVISO_BLOQUEO = "aviso de bloqueo por WhatsApp"
POR_WHATSAPP = "por WhatsApp"
RECHAZO_WHATSAPP = "rechazado por WhatsApp"
CORRECCION_WHATSAPP = "correccion del dueno por WhatsApp:"
# Una respuesta tomada (`preparando`) que no llego a su confirmacion en este tiempo es de un
# proceso que murio a mitad: se confirma igual, mandando al tablero, y no se aplica de nuevo.
PREPARANDO_VENCE_S = 300
# Lo que queda pendiente para un numero que ya no es el de aprobacion no sale (T14).
AVISO_OTRO_NUMERO = "approval-number-changed"
# Lo pendiente que espero mas de `approval_hours` (el chat sin autorizar, un error que se
# reintenta) o el aviso de una version que ya no es la vigente: no sale, ya no es cierto.
AVISO_VENCIDO = "approval-expired"
AVISO_SUPERADO = "approval-superseded"
LARGO_PIDE = 140
LARGO_PROPUESTA = 300
LARGO_CORRECCION = 1000
TOPE_ESTADO = 15
ETAPAS_ESTADO = ("recibido", "clasificado", "decision", "trabajo", "listo", "respondido",
                 "bloqueado")
SI_NO = re.compile(r"^(si|sí|yes|ok|dale|no)(?:\s+#?(\d+))?$", re.I)
SOLO_CON_NUMERO = ("ok", "dale")
CORRIGE = re.compile(r"^#?(\d+)\s+(.+)$", re.S)
ESTADO = re.compile(r"^(estado|status)$", re.I)

# Los motivos de una espera, en palabras del chat. Lo que no esta aca sale con su codigo.
MOTIVOS_AVISO = {
    "es": {"money": "menciona dinero", "credential": "nombra una credencial",
           "commitment": "compromete una fecha", "jev": "Jev lo freno",
           "jev-unavailable": "Jev no contesto", "secret": "lleva un secreto",
           "borrador": "el chat pide su visto antes de enviar",
           "promises_a_date": "promete una fecha",
           "states_status_not_verified": "afirma un estado sin verificarlo",
           "contains_credential": "lleva una credencial", "delete": "borra algo",
           "deploy": "despliega a produccion", "force_push": "fuerza un push",
           "payment": "mueve un pago",
           "outside_project": "queda fuera de los proyectos del chat",
           "no_project": "no tiene proyecto",
           "project_question": "la pregunta de proyecto es suya",
           "mode": "el chat no responde solo", "stale": "la propuesta tiene mas de un dia",
           "exceptions": "el caso trae excepciones", "no_instructions": "no trae instrucciones"},
    "en": {"money": "it mentions money", "credential": "it names a credential",
           "commitment": "it commits to a date", "jev": "Jev held it",
           "jev-unavailable": "Jev did not answer", "secret": "it carries a secret",
           "borrador": "the chat asks for your OK before sending",
           "promises_a_date": "it promises a date",
           "states_status_not_verified": "it states a status it did not verify",
           "contains_credential": "it carries a credential", "delete": "it deletes something",
           "deploy": "it deploys to production", "force_push": "it forces a push",
           "payment": "it moves a payment",
           "outside_project": "it is outside the chat's projects",
           "no_project": "it has no project",
           "project_question": "the project question is yours",
           "mode": "the chat does not answer on its own",
           "stale": "the proposal is more than a day old",
           "exceptions": "the case carries exceptions", "no_instructions": "it has no instructions"},
}
