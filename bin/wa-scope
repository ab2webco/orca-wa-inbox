    s = add("caso", help="the case board: a case groups the messages of one request, "
                         "and every change leaves an event (odd/tasks/kanban-casos.md)")
    s.error = caso_args_falla
    casos = s.add_subparsers(dest="caso_cmd", required=True)

    def caso(name, **kw):
        # SUPPRESS: sin el flag, el subcomando no pisa un --json dicho antes.
        sp = casos.add_parser(name, **kw)
        sp.error = caso_args_falla
        sp.add_argument("--json", dest="json_sub", action="store_true",
                        default=argparse.SUPPRESS)
        return sp

    def muta(name, **kw):
        # Todo lo que cambia un caso dice quien lo cambio: sin actor no hay estadistica
        # de decisiones, y sin evento no hay nada que mostrar en la tarjeta.
        sp = caso(name, **kw)
        sp.add_argument("--actor", required=True, choices=list(ACTORES_CASO))
        return sp

    c = muta("crear", help="opens a case in recibido")
